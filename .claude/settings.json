{
  "permissions": {
    "deny": [
      "Read(/docs/redesign/**)",
      "Read(/dist/**)",
      "Read(/demo/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/stop-verify.sh\"",
            "timeout": 600,
            "statusMessage": "Verifying src/ changes..."
          }
        ]
      }
    ]
  }
}
