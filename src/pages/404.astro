---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { getBranches } from '../lib/site-data';
const branches = await getBranches();
---
<Base title="Lost luggage · Fatt Pundit" description="This page has gone missing in transit." noindex>
  <SiteHeader branches={branches} />
  <main id="content" class="lost surface-night">
    <div class="tag surface-day">
      <h1 class="tag-head">Lost luggage</h1>
      <p class="tag-code">404</p>
      <p class="tag-line">This page went missing somewhere between Guangdong and London.</p>
      <p class="did-you-mean" data-suggest hidden></p>
      <!-- Every task one tap away (ux-structure.md W8), in two short groups: stacked on phones, side by side from 720px. -->
      <div class="tag-routes">
        <div>
          <h2 class="tag-group">Rooms</h2>
          <ul class="tag-go">
            {branches.map((b) => <li><a href={`/${b.id}/`}>{b.shortName}<span aria-hidden="true">›</span></a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="tag-group">Do something</h2>
          <ul class="tag-go">
            {[
              { href: '/book/', label: 'Book a table' },
              { href: '/soho/menu/', label: 'Menus' },
              { href: '/our-story/', label: 'Our story' },
            ].map((d) => <li><a href={d.href}>{d.label}<span aria-hidden="true">›</span></a></li>)}
          </ul>
        </div>
      </div>
      <p class="fortune" data-fortune hidden></p>
    </div>
  </main>
  <SiteFooter branches={branches} />
</Base>

<script>
  const fortunes = [
    'Wrong door. The momos are this way.',
    'He who takes the wrong turn still finds dumplings.',
    'The page is lost. The chilli chicken is not.',
    'A wise guest books ahead. A wiser one checks the URL.',
    'This door leads nowhere. The next one leads to dinner.',
  ];
  const f = document.querySelector<HTMLElement>('[data-fortune]');
  if (f) { f.textContent = fortunes[Math.floor(Math.random() * fortunes.length)]; f.hidden = false; }

  // "Did you mean": nearest known route by edit distance (a prefix match counts as close).
  const routes = ['/', '/soho/', '/covent-garden/', '/dubai/', '/soho/menu/', '/covent-garden/menu/', '/book/', '/groups/', '/our-story/', '/allergens/', '/accessibility/', '/privacy/', '/booking-terms/'];
  const dist = (a: string, b: string) => {
    let prev = Array.from({ length: b.length + 1 }, (_, i) => i);
    for (let i = 1; i <= a.length; i++) {
      const cur = [i];
      for (let j = 1; j <= b.length; j++) cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
      prev = cur;
    }
    return prev[b.length];
  };
  const here = location.pathname.toLowerCase().replace(/\/?$/, '/');
  let best = '';
  let score = Infinity;
  for (const r of routes) {
    if (r === '/') continue;
    const d = here.startsWith(r) && r.length > 4 ? 0 : dist(here, r);
    if (d < score) { score = d; best = r; }
  }
  const box = document.querySelector<HTMLElement>('[data-suggest]');
  if (box && best && score <= 3) {
    const a = document.createElement('a');
    a.href = best;
    a.textContent = best;
    box.append('Did you mean ', a, '?');
    box.hidden = false;
  }
</script>

<style>
  /* Colours are surface roles: the wall is night, the tag is day (tokens.css). */
  .lost { min-height: 72svh; display: grid; place-items: center; padding: var(--space-8) var(--space-4) var(--section-pad); overflow: clip; border-bottom: var(--border-hair) solid var(--fp-rule); }
  /* The tag is the page's one object. Its shadow is a lift, not tiger (tiger means "press me").
     It hangs from its eyelet: it swings in once on arrival and settles a little off true. */
  .tag { position: relative; width: min(520px, 100% - 32px); box-sizing: border-box; padding: var(--space-7) var(--space-6) var(--space-6); border: var(--border-control) solid var(--fp-rule-strong); box-shadow: var(--lift-3); transform-origin: 50% 27px; transform: rotate(-1.5deg); animation: tag-swing var(--dur-story-long) both; text-align: center; }
  @keyframes tag-swing {
    0% { transform: rotate(-8deg); animation-timing-function: var(--curve-in-out); }
    38% { transform: rotate(3.5deg); animation-timing-function: var(--curve-in-out); }
    66% { transform: rotate(-3deg); animation-timing-function: var(--curve-in-out); }
    86% { transform: rotate(-0.8deg); animation-timing-function: var(--curve-in-out); }
    100% { transform: rotate(-1.5deg); }
  }
  @media (prefers-reduced-motion: reduce) { .tag { transform: none; animation: none; } }
  /* The eyelet, and the string it hangs by (it runs up behind the header; .lost clips the rest). */
  .tag::before { content: ''; position: absolute; top: 16px; left: 50%; width: 22px; height: 22px; margin-left: -11px; border-radius: 50%; background: var(--fp-fg); box-shadow: 0 0 0 5px var(--color-gold); }
  .tag::after { content: ''; position: absolute; bottom: 100%; left: 50%; width: 2px; height: 40svh; margin-left: -1px; background: var(--fp-bg); opacity: 0.7; }
  .tag-head { font-size: inherit; line-height: inherit; margin: 18px 0 0; font-weight: 700; letter-spacing: var(--tracking-title); text-transform: uppercase; color: var(--fp-label); }
  .tag-code { margin: var(--space-1) 0; font-size: clamp(72px, 16vw, 128px); font-weight: 700; line-height: 1; }
  .tag-line { margin: 0 auto var(--space-5); max-width: 22em; font-family: var(--font-note); font-style: italic; font-size: 21px; line-height: var(--lh-spoken); text-wrap: balance; }
  .tag-routes { display: grid; gap: var(--space-5) var(--space-6); }
  .tag-go { list-style: none; padding: 0; margin: 0; border-top: var(--border-control) solid var(--fp-rule-strong); text-align: left; }
  .tag-go a { display: flex; justify-content: space-between; align-items: center; min-height: 48px; padding: 0 var(--space-1); border-bottom: var(--border-hair) solid var(--fp-rule-strong); color: var(--fp-fg); font-weight: 700; text-decoration: none; transition: background-color var(--dur-fast) var(--curve-out); }
  .tag-go a span { transition: transform var(--dur-fast) var(--curve-out); }
  @media (hover: hover) {
    .tag-go a:hover { background: var(--fp-hover-tint); text-decoration: underline; text-underline-offset: 4px; }
    .tag-go a:hover span { transform: translateX(4px); }
  }
  .tag-group { margin: 0 0 6px; font-size: var(--step-fine); font-weight: 700; letter-spacing: var(--tracking-title); text-transform: uppercase; text-align: left; color: var(--fp-label); }
  .did-you-mean { margin: calc(-1 * var(--space-2)) 0 var(--space-4); font-weight: 700; }
  .did-you-mean :global(a) { color: var(--fp-fg); text-underline-offset: 4px; }
  .fortune { margin: var(--space-5) 0 0; font-family: var(--font-note); font-style: italic; text-wrap: balance; }
  /* Room to spare: the two groups sit side by side, so the whole tag fits one screen. */
  @media (min-width: 720px) {
    .tag { width: min(640px, 100% - 32px); padding-inline: var(--space-7); }
    .tag-routes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
