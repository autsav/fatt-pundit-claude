  .sg-pass { position: absolute; left: 20px; right: 20px; bottom: 0; height: 72px; display: grid; place-items: center; background: var(--color-paper-light); color: var(--color-ink); transform: translateY(100%); }
  .sg-pass.is-in { transform: none; transition: transform var(--dur-story) var(--curve-out); }
</style>

<script>
  import { bindDialogs } from '../../lib/dialog';
  bindDialogs();

  // Calm mode indicator.
  const mode = document.querySelector('[data-motion-mode]');
  if (mode) mode.textContent = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'calm (reduced motion)' : 'full motion';

  // Today's row in the hours table, on the restaurant's own clock.
  const table = document.querySelector<HTMLElement>('[data-hours-table]');
  if (table) {
    const day = new Intl.DateTimeFormat('en-GB', { timeZone: table.dataset.tz, weekday: 'short' }).format(new Date()).slice(0, 3).toLowerCase();
    const row = table.querySelector<HTMLElement>(`tr[data-day="${day}"]`);
    if (row) { row.setAttribute('aria-current', 'date'); row.querySelector<HTMLElement>('[data-today-word]')!.hidden = false; }
  }

  // Loading to done on a single button.
  const sendBtn = document.querySelector<HTMLButtonElement>('[data-demo-send]');
  const sendStatus = document.querySelector<HTMLElement>('[data-demo-status]');
  sendBtn?.addEventListener('click', () => {
    const label = sendBtn.textContent;
    sendBtn.setAttribute('aria-busy', 'true'); sendBtn.textContent = 'Sending'; if (sendStatus) sendStatus.textContent = 'Sending…';
    setTimeout(() => {
      sendBtn.removeAttribute('aria-busy'); sendBtn.dataset.state = 'done'; sendBtn.textContent = 'Sent'; if (sendStatus) sendStatus.textContent = 'Sent.';
      setTimeout(() => { delete sendBtn.dataset.state; sendBtn.textContent = label; if (sendStatus) sendStatus.textContent = ''; }, 2000);
    }, 1400);
  });

  // Demo form: errors after submit, then loading to done. Nothing is sent.
  const form = document.querySelector<HTMLFormElement>('[data-demo-form]');
  if (form) {
    const size = form.querySelector<HTMLOutputElement>('[data-size]')!;
    form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => {
      const n = Math.min(40, Math.max(5, Number(size.value) + Number(b.dataset.step)));
      size.value = String(n);
      form.querySelector<HTMLButtonElement>('[data-step="-1"]')!.disabled = n <= 5;
      form.querySelector<HTMLButtonElement>('[data-step="1"]')!.disabled = n >= 40;
    }));
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const check = (el: HTMLInputElement) => {
      const bad = !el.checkValidity();
      el.setAttribute('aria-invalid', String(bad));
      const msg = el.id ? form.querySelector<HTMLElement>(`#${el.id}-m`) : null;
      if (msg) msg.hidden = !bad;
      return !bad;
    };
    // Once a field has shown an error, re-check it while the guest types, never on blur: clearing a
    // message on blur moves the form under the finger just as it taps the next control.
    form.querySelectorAll<HTMLInputElement>('input[required]').forEach((el) => el.addEventListener('input', () => { if (el.getAttribute('aria-invalid') === 'true') check(el); }));
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fields = [...form.querySelectorAll<HTMLInputElement>('input[required]')];
      const bad = fields.filter((el) => !check(el));
      if (bad.length) {
        status.className = 'fp-status fp-msg fp-msg--error'; status.setAttribute('role', 'alert'); status.hidden = false;
        status.innerHTML = `<strong>${bad.length === 1 ? 'One thing' : `${bad.length} things`} to fix</strong> See the messages under the fields.`;
        bad[0].focus();
        return;
      }
      status.hidden = true; submit.setAttribute('aria-busy', 'true'); submit.textContent = 'Sending';
      setTimeout(() => {
        submit.removeAttribute('aria-busy'); submit.dataset.state = 'done'; submit.textContent = 'Sent';
        status.className = 'fp-status fp-msg fp-msg--success'; status.setAttribute('role', 'status'); status.hidden = false;
        status.innerHTML = '<strong>Enquiry sent</strong> (demo) The restaurant would reply by email.';
      }, 1400);
    });
  }

  // Motion demo: a pass slides up at --dur-story.
  const pass = document.querySelector<HTMLElement>('[data-demo-pass]');
  document.querySelector('[data-demo-motion="slide"]')?.addEventListener('click', () => {
    if (!pass) return;
    pass.classList.remove('is-in'); void pass.offsetWidth; pass.classList.add('is-in');
  });
</script>
