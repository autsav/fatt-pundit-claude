  .sg-measure { max-width: var(--measure); }
  .sg-intro h1 { overflow-wrap: anywhere; }
  .sg-toc { gap: 0 var(--space-5); }
  code { font-family: var(--font-body); font-size: 0.9em; font-weight: 700; white-space: nowrap; }
  .sg-swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .sg-swatch { display: grid; gap: 2px; min-height: 104px; padding: var(--space-3); align-content: end; box-shadow: inset 0 0 0 1px rgb(26 23 20 / 0.15); }
  .sg-surfaces { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr)); }
  .sg-surface { display: grid; gap: var(--space-3); align-content: start; padding: var(--space-5); box-shadow: inset 0 0 0 1px rgb(26 23 20 / 0.2); }
  .sg-surface p { margin: 0; }
  .sg-details summary { cursor: pointer; min-height: var(--target-min); display: flex; align-items: center; }
  .sg-scroll { max-height: 28rem; overflow: auto; margin-top: var(--space-3); }
  .sg-table { width: 100%; border-collapse: collapse; font-size: var(--step-fine); }
  .sg-table :is(th, td) { padding: 6px 10px 6px 0; border-bottom: 1px solid var(--fp-rule); text-align: left; white-space: nowrap; }
  .sg-chip { display: inline-block; width: 14px; height: 14px; margin-right: 3px; vertical-align: -2px; box-shadow: 0 0 0 1px rgb(0 0 0 / 0.3); }
  .sg-type { border-top: 0; }
  .sg-type-row { display: grid; gap: var(--space-3) var(--space-6); padding-block: var(--space-5); }
  @media (min-width: 1024px) { .sg-type-row { grid-template-columns: 15rem minmax(0, 1fr); align-items: baseline; } }
  .sg-type-meta { line-height: 1.5; }
  .sg-type-sample { margin: 0; overflow-wrap: anywhere; }
  .sg-grid-demo { display: grid; grid-template-columns: repeat(4, 1fr); column-gap: var(--grid-gutter); }
  .sg-grid-demo span { display: grid; place-items: center; height: 48px; background: rgb(241 93 61 / 0.18); box-shadow: inset 0 0 0 1px var(--color-tiger-deep); font-size: var(--step-fine); font-weight: 700; }
  .sg-grid-demo .sg-c8, .sg-grid-demo .sg-c12 { display: none; }
  @media (min-width: 640px) { .sg-grid-demo { grid-template-columns: repeat(8, 1fr); } .sg-grid-demo .sg-c8 { display: grid; } }
  @media (min-width: 1024px) { .sg-grid-demo { grid-template-columns: repeat(12, 1fr); } .sg-grid-demo .sg-c12 { display: grid; } }
  .sg-space { display: grid; gap: 6px; }
  .sg-space-row { display: grid; grid-template-columns: 6.5rem auto 3ch; gap: var(--space-3); align-items: center; justify-content: start; }
  .sg-space-row span { display: block; height: 14px; background: var(--color-ink); }
  .sg-spread { margin-top: var(--section-gap); }
  .sg-print { height: clamp(260px, 42vw, 560px); }
  .sg-ticket { max-width: 26rem; }
  @media (min-width: 1024px) { .sg-ticket { max-width: none; } }
  .sg-note { margin-top: var(--space-4); }
  .sg-matrix { padding: var(--space-5); box-shadow: inset 0 0 0 1px rgb(26 23 20 / 0.2); overflow-x: auto; }
  .sg-matrix p { margin: 0 0 var(--space-3); }
  .sg-matrix-grid { display: grid; grid-template-columns: 5.5rem repeat(7, max-content); gap: var(--space-4) var(--space-4); align-items: center; }
  .sg-two { display: grid; gap: var(--section-gap) var(--space-8); }
  @media (min-width: 1024px) { .sg-two { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; } }
  .sg-two p { margin: 0; }
  .sg-pad { display: grid; gap: var(--space-4); align-content: start; padding: var(--space-5); }
  .sg-nav { gap: 0 var(--space-5); }
  .sg-fields { display: grid; gap: var(--space-5) var(--space-4); grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr)); }
  .sg-form { max-width: 44rem; padding: clamp(20px, 4vw, 40px); box-shadow: var(--lift-2); }
  .sg-form p { margin: 0; }
