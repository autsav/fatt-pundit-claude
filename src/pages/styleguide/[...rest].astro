  .sg-news-row { flex-wrap: nowrap; }
  .sg-news-row .fp-input { flex: 1; min-width: 0; }
  @media (max-width: 479px) { .sg-news-row { flex-wrap: wrap; } .sg-news-row .fp-btn { width: 100%; } }
  .sg-motion { display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: center; }
