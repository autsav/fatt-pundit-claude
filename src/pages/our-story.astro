---
// Our story: "The tale of Fatt & Pundit" (data: src/data/story.ts). Each chapter plays as scroll scenes
// where it has them and the browser can (docs/STORY-MOTION-PLAN.md), and is otherwise told as the comic.
// The ending is the one thing the reference site lacked: somewhere real to go next.
import { listCta } from '../lib/waitlist';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import ChapterRail from '../components/site/ChapterRail.astro';
import StoryComic from '../components/story/StoryComic.astro';
import StoryOpening from '../components/story/StoryOpening.astro';
import ChooseTiger from '../components/story/ChooseTiger.astro';
import TastingStrip from '../components/story/TastingStrip.astro';
import ChapterCanton from '../components/story/scenes/ChapterCanton.astro';
import ChapterTangra from '../components/story/scenes/ChapterTangra.astro';
import ChapterSomethingNew from '../components/story/scenes/ChapterSomethingNew.astro';
import ChapterLondon from '../components/story/scenes/ChapterLondon.astro';
import ChapterNextStop from '../components/story/scenes/ChapterNextStop.astro';
import { getBranches } from '../lib/site-data';
import { chapters, STORY_TITLE, STORY_LEDE } from '../data/story';
import { stampSrc } from '../lib/stamp';
import stampTiger from '../assets/images/brand/logo-stamp-tiger.png';

const branches = await getBranches();
const open = branches.filter((b) => b.status === 'open');
const soon = branches.filter((b) => b.status !== 'open');
const stamp = await stampSrc(stampTiger, 240);
// Every chapter plays as scenes, one pinned stage each; the comic is the calm and "Read as a comic" telling.
const scenesFor: Partial<Record<string, typeof ChapterCanton>> = {
  canton: ChapterCanton,
  tangra: ChapterTangra,
  'something-new': ChapterSomethingNew,
  london: ChapterLondon,
  'next-stop': ChapterNextStop,
};
---

<Base
  title={`${STORY_TITLE} · Our story · Fatt Pundit`}
  description="How Indo-Chinese food began: a Hakka cook from Guangdong, a scholar in Calcutta's Chinatown, and the recipes that travelled on to Soho, Covent Garden and Dubai."
  og="home"
>
  <a class="skip" href="#content">Skip to the story</a>
  <!-- Before the scenes paint: a reader who chose the comic gets it straight away (global.css "Story scenes"). -->
  <script is:inline>try { if (localStorage.getItem('fp-story') === 'comic') document.documentElement.dataset.story = 'comic'; } catch {}</script>
  <SiteHeader branches={branches} />
  <main id="content">
    <header class="story-hero">
      <div class="wrap narrow stack center">
        <img class="story-stamp" src={stamp} alt="" width="120" height="120" />
        <p class="kicker">Our story</p>
        <h1 class="story-h1">{STORY_TITLE}</h1>
        <p class="story-lede">{STORY_LEDE}</p>
        <p class="story-note">Fatt is a common Chinese surname. Pundit is the Indian word for a scholar. Put them together and you have our name, and the story of the food.</p>
        <p class="story-cue" aria-hidden="true">Scroll to begin</p>
        <p class="story-mode" data-story-mode hidden><button type="button" aria-pressed="false" data-story-toggle>Read as a comic</button></p>
      </div>
    </header>
    <StoryOpening />

    <div class="sec story-body">
      {chapters.map((c) => {
        const Scenes = scenesFor[c.id];
        return (
          <div class="story-chapter" id={c.id} data-scenes={Scenes ? '' : undefined}>
            {Scenes && <Scenes />}
            <div class="wrap">
              <StoryComic mode="full" only={c.id} />
            </div>
          </div>
        );
      })}
    </div>

    <section id="end" class="sec gold-bg story-end" aria-labelledby="end-title">
      <div class="wrap narrow stack center">
        <p class="kicker">The end, or rather the start</p>
        <h2 id="end-title" class="h2">Come and taste the rest</h2>
        <div class="end-actions">
          {open.map((b) => (
            <a class="fp-btn fp-btn--primary" href={b.booking?.url ?? `/${b.id}/`} data-book={b.id}>Book at {b.shortName}</a>
          ))}
          {soon.map((b) => (
            <a class="fp-btn" href={listCta(b).href}>{listCta(b).label}</a>
          ))}
        </div>
        <p class="small">Or read the menus first: {open.map((b, i) => <>{i > 0 && ' · '}<a href={`/${b.id}/menu/`}>{b.shortName}</a></>)}.</p>
        <p>The story is best told by the food. Come and taste where it went.</p>
        <TastingStrip />
        <ChooseTiger />
      </div>
    </section>
  </main>

  <ChapterRail chapters={[...chapters.map((c) => [c.id, c.label] as [string, string]), ['end', 'Your table']]} after={0.6} />
  <SiteFooter branches={branches} />
</Base>

<style>
  .story-hero { padding: clamp(56px, 10vw, 120px) 0 clamp(32px, 6vw, 72px); background: var(--color-sand); text-align: center; }
  .story-stamp { width: clamp(84px, 9vw, 120px); height: auto; margin: 0 auto 6px; }
  .story-h1 { margin: 0; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: var(--tracking-title); font-size: clamp(40px, 7vw, 96px); line-height: 0.95; text-wrap: balance; }
  .story-lede { max-width: 40ch; margin: 0 auto; font-family: var(--font-note); font-style: italic; font-weight: 500; font-size: clamp(19px, 1.8vw, 23px); }
  .story-note { max-width: 52ch; margin: 0 auto; }
  .story-cue { margin: 8px 0 0; font-family: var(--font-note); font-style: italic; font-size: 16px; color: var(--color-gold-deep); }
  /* Where the scenes play, the opening stage replaces the hero's look: the h1, lede and note stay in the page as
     real text, clipped out of sight (the stage shows the same words, aria-hidden), and only the "Read as a comic"
     switch stays visible, floating at the stage's top right. The gate repeats global.css "Story scenes";
     plain display and position rules survive @supports here (animation-timeline would not). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(:root:not([data-story='comic'])) .story-hero { position: relative; z-index: 5; height: 0; padding: 0; background: none; }
      :global(:root:not([data-story='comic'])) .story-hero .wrap { position: static; }
      :global(:root:not([data-story='comic'])) .story-hero :is(.story-stamp, .kicker, .story-h1, .story-lede, .story-note, .story-cue) {
        position: absolute; width: 1px; height: 1px; margin: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      :global(:root:not([data-story='comic'])) .story-mode { position: absolute; top: 12px; right: clamp(12px, 3vw, 40px); margin: 0; }
      :global(:root:not([data-story='comic'])) .story-mode button { min-height: 44px; padding: 6px 12px; background: rgb(250 246 239 / 0.85); }
    }
  }
  .story-body { background: var(--color-sand); padding-top: 0; }
  .story-chapter + .story-chapter { margin-top: clamp(56px, 9vw, 120px); }
  .story-mode { margin: 4px 0 0; }
  .story-mode button { padding: 6px 4px; border: 0; background: none; color: var(--color-ink); font-family: var(--font-note); font-style: italic; font-size: 16px;
    text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .story-mode button[aria-pressed='true'] { text-decoration-style: solid; font-weight: 600; }
  .story-mode button:focus-visible { outline: 2px solid var(--fp-ring); outline-offset: 2px; }
  /* The last scene hands over to #end by tearing in over it, as every stage does (global.css "Between stages"). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(:root:not([data-story='comic'])) .story-end { position: relative; margin-top: calc(-1 * var(--edge-h));
        -webkit-mask: var(--torn-top) top / 100% var(--edge-h) no-repeat, linear-gradient(#000 0 0) 0 calc(var(--edge-h) - 1px) / 100% 100% no-repeat;
        mask: var(--torn-top) top / 100% var(--edge-h) no-repeat, linear-gradient(#000 0 0) 0 calc(var(--edge-h) - 1px) / 100% 100% no-repeat; }
    }
  }
  .end-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 8px; }
  /* Equal-width buttons: each takes the same share, never narrower than its label. */
  .end-actions > .fp-btn { flex: 1 1 14rem; max-width: 20rem; justify-content: center; text-align: center; }
</style>

<script>
  // "Read as a comic": only offered where the scenes can play. Swaps them for the comic and remembers it.
  const wrap = document.querySelector<HTMLElement>('[data-story-mode]');
  const btn = document.querySelector<HTMLButtonElement>('[data-story-toggle]');
  if (wrap && btn && CSS.supports('animation-timeline: view()') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const root = document.documentElement;
    const sync = () => btn.setAttribute('aria-pressed', String(root.dataset.story === 'comic'));
    btn.addEventListener('click', () => {
      const comic = root.dataset.story !== 'comic';
      if (comic) root.dataset.story = 'comic';
      else delete root.dataset.story;
      try {
        if (comic) localStorage.setItem('fp-story', 'comic');
        else localStorage.removeItem('fp-story');
      } catch {}
      sync();
    });
    sync();
    wrap.hidden = false;
  }
</script>
