---
// Homepage: the "Through the door" journey (plan: Creative concept, scenes 1–7).
import { getImage } from 'astro:assets';
import { stampSrc } from '../lib/stamp';
import Arrival from '../components/scenes/Arrival.astro';
import Doors from '../components/scenes/Doors.astro';
import HomeHero from '../components/scenes/HomeHero.astro';
import Voyage from '../components/scenes/Voyage.tsx';
import MenuBook from '../components/scenes/MenuBook.tsx';
import BarAfterDark from '../components/scenes/BarAfterDark.tsx';
import RoomContactSheet from '../components/scenes/RoomContactSheet.tsx';
import BoardingPasses from '../components/scenes/BoardingPasses.astro';
import Base from '../layouts/Base.astro';
import { getBranches, dish, priceOf, menuBooks, groupRules, onlineSummary } from '../lib/site-data';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

import tigerHead from '../assets/images/brand/tiger-head-left.png';
import stampLeft from '../assets/images/brand/logo-stamp-distressed-left.png';
import stampRight from '../assets/images/brand/logo-stamp-distressed-right.png';
import map from '../assets/images/brand/map.webp';
import voyageSea from '../assets/images/brand/voyage-sea.png';
import shipArt from '../assets/images/brand/ship.png';
import frameArt from '../assets/images/brand/frame.png';
import compassArt from '../assets/images/brand/compass.png';
import stampGoldArt from '../assets/images/brand/stamp-gold.png';
import stampOrangeArt from '../assets/images/brand/stamp-orange.png';
import mountainAArt from '../assets/images/brand/mountain-a.png';
import mountainsBArt from '../assets/images/brand/mountains-b.png';
import mountainsCArt from '../assets/images/brand/mountains-c.png';
import inside from '../assets/images/covent-garden/gallery-01.jpg';
import barSour from '../assets/images/journey/05-bar-guava-chilli-sour.jpg';
import barCocktail from '../assets/images/journey/05-bar-cocktail.jpg';
import imgSpinach from '../assets/images/dishes/crackling-spinach.jpg';
import imgOkra from '../assets/images/dishes/crispy-okra-salt-n-pepper.jpg';
import imgVegMomo from '../assets/images/dishes/momo-mix-vegetable.jpg';
import imgBrownie from '../assets/images/dishes/sizzling-brownie.jpg';
import g1 from '../assets/images/covent-garden/gallery-01.jpg';
import g2 from '../assets/images/covent-garden/gallery-02.jpg';
import g3 from '../assets/images/covent-garden/gallery-03.jpg';
import g4 from '../assets/images/covent-garden/gallery-04.jpg';
import g5 from '../assets/images/covent-garden/gallery-05.jpg';
import g6 from '../assets/images/covent-garden/gallery-06.jpg';
import g7 from '../assets/images/covent-garden/gallery-07.jpg';
import g8 from '../assets/images/covent-garden/gallery-08.jpg';

const branches = await getBranches();
const DRINK_IDS = ['guava-chilli-sour', 'white-tiger', 'hakka-garden', 'desi-dragon'];
const drinks = await Promise.all(DRINK_IDS.map(dish));
// Scene 6: the bar after dark.
const webp = async (src: ImageMetadata, width: number) => (await getImage({ src, width, format: 'webp', quality: 78 })).src;
const barRoom = { src: await webp(g3, 1400), alt: 'The bar at Covent Garden: copper shelves of bottles, brass lamps and arched mirrors over the booths' };
const barPrints: [{ src: string; alt: string }, { src: string; alt: string }] = [
  { src: await webp(barSour, 800), alt: 'Guava chilli sour with a chilli-salt rim, fresh guavas beside it' },
  { src: await webp(barCocktail, 700), alt: 'A deep red fruit cooler with mint and citrus' },
];
const barDrinks = drinks.map((d, i) => ({ id: DRINK_IDS[i], name: d.name, description: d.description, price: priceOf(d) }));
const barTiger = await stampSrc(tigerHead, 400);
// Scene 7: the room as a contact sheet. Thumbs for the sheet, large for the lightbox.
const ROOM: [ImageMetadata, string][] = [
  [g5, 'A tiger in a turban painted on the brick wall above a dining table'],
  [g3, 'The bar, lit by brass lamps, with tables leading to it'],
  [g2, 'Blue-and-white plates arranged on a plaster wall above green banquettes'],
  [g8, 'Hindi and Chinese lettering painted on the dining room wall'],
  [g4, 'Arched mirrors and pendant lights over the dining room'],
  [g7, 'The dining room with a red door and painted lettering'],
  [g6, 'Pink leather banquette against a green painted wall'],
  [g1, 'Pink booths and bentwood chairs under shelves of lamps and pots, against a green plaster wall'],
];
const sheet = await Promise.all(ROOM.map(async ([src, alt]) => ({ thumb: await webp(src, 640), full: await webp(src, 1600), alt })));
const stamps: Record<string, typeof stampLeft> = { soho: stampLeft, 'covent-garden': stampRight };
const rainSrc = (await getImage({ src: inside, width: 1800, format: 'webp', quality: 82 })).src;
const rainPoster = (await getImage({ src: inside, width: 640, format: 'webp', quality: 60 })).src;
const img = async (src: Parameters<typeof getImage>[0]['src'], width: number) => (await getImage({ src, width, format: 'webp', quality: 84 })).src;
// Every drawing in the voyage comes from the brand guidelines (p.24 menu map and stamps).
const voyageArt = {
  map: await img(map, 1295),
  // A picture, not the SVG: the browser re-rasterised the vector chart (a
  // 16-megapixel draw) whenever the camera zoomed, stalling scroll frames.
  sea: (await getImage({ src: voyageSea, width: 3200, format: 'avif', quality: 50 })).src,
  ship: await img(shipArt, 400),
  compass: await img(compassArt, 240),
  stampGold: await stampSrc(stampGoldArt, 280),
  stampOrange: await stampSrc(stampOrangeArt, 280),
  mountainA: await img(mountainAArt, 300),
  mountainsB: await img(mountainsBArt, 520),
  mountainsC: await img(mountainsCArt, 260),
};
// The menu book opens on the signature dishes. Photos only where we have the real dish; the rest are named.
const sigDish = async (id: string, photo?: { src: Parameters<typeof getImage>[0]['src']; alt: string; name?: string }) => {
  const d = await dish(id);
  return { name: photo?.name ?? d.name, price: priceOf(d) ?? undefined, image: photo ? await img(photo.src, 520) : undefined, alt: photo?.alt };
};
const signatureDishes = await Promise.all([
  sigDish('momo-mix-vegetable', { src: imgVegMomo, alt: 'Green spinach-dough vegetable momos with red chutney on a banana leaf' }),
  sigDish('momo-kid-goat'),
  sigDish('crackling-spinach', { src: imgSpinach, alt: 'Crackling spinach topped with yoghurt and pomegranate in a steel bowl' }),
  sigDish('popcorn-cauliflower'),
  sigDish('crispy-okra-salt-n-pepper', { src: imgOkra, alt: 'Crispy okra with chillies in a black and gold steamer pot, pink salt beside it' }),
  sigDish('hakka-chilly-paneer-lettuce-cups'),
  sigDish('malabar-monkfish-curry'),
  sigDish('bombay-chilly-prawns'),
  sigDish('snowflake-gelato-sizzling-brownie', { src: imgBrownie, alt: 'Sizzling brownie in a cast-iron skillet with vanilla ice cream and chocolate sauce', name: 'Sizzling brownie' }),
]);

// Scene 5: the menu book, straight from menus.json + dishes.json.
// Menu by location: every menu any branch serves, and each branch's own list.
const menuIds = [...new Set(branches.flatMap((b) => b.menus))];
const menuBooksHome = await menuBooks(menuIds);
const menuPlaces = await Promise.all(
  branches.map(async (b) => ({
    id: b.id,
    name: b.shortName,
    street: b.address.street,
    menus: b.menus,
    book: b.status === 'open' && b.booking ? { href: b.booking.url, label: `Book at ${b.shortName}` } : undefined,
    soon: b.status === 'open' ? undefined : { dishes: (await Promise.all((b.page.teaser ?? []).map(dish))).map((d) => d.name), href: `/${b.id}/#waitlist` },
  })),
);
const menuArt = { frame: await img(frameArt, 1000), stampGold: await stampSrc(stampGoldArt, 220), stampOrange: await stampSrc(stampOrangeArt, 300), map: await img(map, 1000) };
// Search engines: the group, with each restaurant as its own entity.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#org', Astro.site).href,
  name: 'Fatt Pundit',
  url: new URL('/', Astro.site).href,
  logo: new URL('/icon-512.png', Astro.site).href,
  description: "Indo-Chinese Hakka cooking from Tangra, Calcutta's Chinatown, in Soho, Covent Garden and Dubai.",
  sameAs: ['https://www.instagram.com/fattpundit/', 'https://www.facebook.com/fattpundit/', 'https://x.com/FattPundit'],
  subOrganization: branches.map((b) => ({ '@type': 'Restaurant', '@id': new URL(`/${b.id}/#restaurant`, Astro.site).href, name: b.name, url: new URL(`/${b.id}/`, Astro.site).href })),
};
---
<Base
  title="Fatt Pundit · Chinese-Indian Hakka restaurant · Soho, Covent Garden, Dubai"
  description="Indo-Chinese Hakka cooking from Tangra, Calcutta's Chinatown. Book a table at Fatt Pundit Soho or Covent Garden, London. Opening soon in Dubai."
  og="home"
>
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  <a class="skip" href="#tables">Skip to your table</a>
  <SiteHeader branches={branches} />

  <main>
    <!-- 0 · Arrival -->
    <Arrival />
    <!-- 1 · The window: name, restaurant board, Book; the room behind rainy glass -->
    <HomeHero branches={branches} rainSrc={rainSrc} rainPoster={rainPoster} />
    <!-- 2 · The doors -->
    <Doors />

    <!-- 3 · The voyage -->
    <Voyage client:idle art={voyageArt} />


    <!-- 5 · The menu book -->
    <MenuBook client:visible menus={menuBooksHome} art={menuArt} places={menuPlaces} signatures={signatureDishes} lists={branches.filter((b) => b.status === 'open').map((b) => ({ href: `/${b.id}/menu/`, label: `${b.shortName} menus` }))} next={{ href: '#bar', label: 'Continue to the bar' }} />

    <!-- 6 · The bar after dark -->
    <BarAfterDark client:visible room={barRoom} prints={barPrints} drinks={barDrinks} tiger={barTiger} />

    <!-- 7 · The room -->
    <section id="room" class="chapter room-halftone" aria-labelledby="room-title">
      <div class="wrap stack-lg">
        <div class="room-words">
          <header class="room-head reveal">
            <p class="fp-section-label"><span class="fp-section-no">04</span> The room</p>
            <h2 id="room-title" class="fp-h2"><span class="sr-only">The room: </span>Pull up a chair</h2>
            <p class="chapter-intro">Painted walls from old Tangra, a tiger on the brickwork, blue-and-white plates and warm brass light.</p>
          </header>
          <p class="rating reveal">
            <span class="rating-n fp-num">4.8<span class="rating-of"> / 5</span></span>
            <span class="rating-src">on Google at both restaurants: 20,030 reviews for Covent Garden and 16,000+ for Soho (November 2026)</span>
          </p>
        </div>
        <RoomContactSheet client:visible frames={sheet} picks={[0, 2]} />
      </div>
    </section>

    <!-- 8 · Your boarding pass -->
    <section id="tables" class="chapter gold-bg" aria-labelledby="tables-title">
      <div class="wrap">
        <header class="fp-section-head chapter-head reveal">
          <p class="fp-section-label"><span class="fp-section-no">05</span> Your table</p>
          <h2 id="tables-title" class="fp-h2"><span class="sr-only">Your table: </span>Choose your gate</h2>
          <p class="chapter-intro">Three passes, one for each room. Tear off a stub to book.</p>
        </header>
        <BoardingPasses branches={branches} stamps={stamps} />
        <p class="tables-note reveal">{onlineSummary(branches)}. {groupRules(branches[0])?.depositShort} {groupRules(branches[0])?.setMenu} <a href="/private-dining/">Plan a group</a>.</p>
      </div>
    </section>
  </main>

  <!-- Story rail: where you are in the visit. Lights up as you scroll, tap a stop to jump. Wide screens only;
       phones get the thin progress line under the header instead. -->
  <nav class="rail" aria-label="Chapters" data-rail hidden>
    {[['top', 'The window'], ['story', 'Our story'], ['menu', 'The menus'], ['bar', 'The bar'], ['room', 'The room'], ['tables', 'Your table']].map(([id, label]) => (
      <a href={`#${id}`} data-ch={id}><span class="rail-dot" aria-hidden="true"></span><span class="rail-lbl">{label}</span></a>
    ))}
  </nav>

  <SiteFooter branches={branches} home />
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // The Dubai list on its boarding pass (rendered only once PUBLIC_DUBAI_LIST_ENDPOINT is set).
  import { bindWaitlists } from '../lib/waitlist';
  bindWaitlists();
  // Story rail + reading line. Only transform/opacity change per frame.
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const bar = document.querySelector<HTMLElement>('.bar');
  if (rail && bar) {
    rail.hidden = false;
    const line = document.createElement('div');
    line.className = 'read-line';
    line.setAttribute('aria-hidden', 'true');
    bar.append(line);
    const links = new Map([...rail.querySelectorAll<HTMLAnchorElement>('[data-ch]')].map((a) => [a.dataset.ch!, a]));
    const order = [...links.keys()];
    const targets = order.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
    // Positions are measured only when the page changes size (a ResizeObserver runs after layout, so
    // measuring there is free). The scroll tick reads scrollY and nothing else: measuring sections on
    // every frame, after the voyage had moved its map, forced a full style and layout pass per frame
    // (about 1 s of forced layout across the voyage at 4x CPU).
    let tops: number[] = [];
    let max = 0;
    let vh = innerHeight;
    const measure = () => {
      vh = innerHeight;
      tops = targets.map((el) => el.getBoundingClientRect().top + window.scrollY);
      max = document.documentElement.scrollHeight - vh;
    };
    let raf = 0;
    let cur = -1;
    let on: boolean | null = null;
    // scrollY is read in the scroll event (before any frame callback writes), not inside the frame,
    // where reading it after another scene's writes would also force layout.
    let y = scrollY;
    const tick = () => {
      raf = 0;
      // The current chapter: the last one whose top has passed the middle of the screen.
      let now = 0;
      tops.forEach((t, i) => { if (t - y <= vh * 0.5) now = i; });
      line.style.transform = `scaleX(${max > 0 ? Math.min(1, y / max).toFixed(4) : 0})`;
      const show = y > vh * 0.8;
      if (show !== on) { on = show; rail.classList.toggle('is-on', show); }
      if (now === cur) return;
      cur = now;
      order.forEach((id, i) => {
        const a = links.get(id)!;
        a.classList.toggle('is-past', i < cur);
        a.classList.toggle('is-here', i === cur);
        if (i === cur) a.setAttribute('aria-current', 'step'); else a.removeAttribute('aria-current');
      });
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(tick); };
    new ResizeObserver(() => { y = scrollY; measure(); queue(); }).observe(document.body);
    addEventListener('scroll', () => { y = scrollY; queue(); }, { passive: true });
    addEventListener('resize', () => { measure(); queue(); });
    measure();
    tick();
  }

  // Reveal sections.
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
    { threshold: 0.18 },
  );
  document.querySelectorAll('.reveal').forEach((el) => (reduce ? el.classList.add('is-in') : io.observe(el)));

</script>

<style>
  p { margin: 0; }

  /* Bar */
  main { overflow-x: clip; }

  /* Room. Wide screens: the words (head, then the rating) beside the contact sheet, both from the top rule. */
  .room-words { display: grid; gap: var(--space-7); align-content: start; }
  .room-head { display: grid; gap: var(--space-4); }
  @media (min-width: 1100px) {
    #room > .wrap { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: clamp(32px, 4vw, 64px); align-items: start; }
    #room > .wrap > .room-words { grid-column: 1; }
    #room > .wrap :global(.room-sheet) { grid-column: 2; grid-row: 1; }
  }
  /* The rating as a ledger fact: the figure in the headline face, its source right under it. */
  .rating { display: grid; gap: var(--space-2); margin: 0; padding-block: var(--space-4); border-block: var(--border-rule) solid var(--fp-rule-strong); max-width: 30em; }
  .rating-n { font-weight: 300; font-size: clamp(44px, 4.4vw, 64px); line-height: 1; letter-spacing: -0.02em; }
  .rating-of { font-size: 0.45em; letter-spacing: 0; }
  .rating-src { font-size: var(--step-small); line-height: var(--lh-small); }
  .tables-note { margin: var(--space-7) 0 0; max-width: 46em; font-size: var(--step-small); line-height: var(--lh-small); }

  /* Reveal */
  .reveal { opacity: 0; transform: translateY(28px); transition: opacity .8s ease, transform .8s ease; }
  .reveal.is-in { opacity: 1; transform: none; }


  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; }
  }
  /* Story rail */
  .rail { position: fixed; z-index: 30; right: 18px; top: 50%; translate: 0 -50%; display: none; flex-direction: column; gap: 2px; padding: 10px 8px;
    background: rgb(44 41 37 / 0.88); border: 1px solid rgb(203 160 82 / 0.45); opacity: 0; pointer-events: none; transition: opacity .3s ease; }
  /* Only where the margin beside the 1240 column can hold it: from 1100px it sat on the content
     (the bar's prices, the passes) until about 1310px. */
  @media (min-width: 1320px) { .rail { display: flex; } }
  .rail.is-on { opacity: 1; pointer-events: auto; }
  /* 44px targets (were 28px); the dashed line joins one dot to the next. */
  .rail a { position: relative; display: grid; place-items: center; width: 44px; height: 44px; text-decoration: none; }
  .rail a::before { content: ''; position: absolute; left: 50%; top: -17px; height: 34px; border-left: 1px dashed rgb(203 160 82 / 0.5); }
  .rail a:first-child::before { display: none; }
  .rail-dot { width: 10px; height: 10px; border-radius: 50%; border: 1.5px dashed var(--color-gold); transition: background-color .25s, transform .25s cubic-bezier(.2, 1.6, .4, 1); }
  .rail a.is-past .rail-dot { background: var(--color-gold); border-style: solid; }
  .rail a.is-here .rail-dot { background: var(--color-tiger); border: 1.5px solid var(--color-tiger); transform: scale(1.3); }
  .rail-lbl { position: absolute; right: calc(100% + 14px); white-space: nowrap; padding: 4px 10px; background: var(--color-ink); border: 1px solid rgb(203 160 82 / 0.45); color: var(--color-sand);
    font-family: var(--font-note); font-style: italic; font-size: 15px; opacity: 0; translate: 6px 0; transition: opacity .2s, translate .2s; pointer-events: none; }
  .rail a:hover .rail-lbl, .rail a:focus-visible .rail-lbl { opacity: 1; translate: 0 0; }
  /* Wide screens: the chapter you're in is always named (the margin is wide enough not to cover content). */
  @media (min-width: 1600px) { .rail a.is-here .rail-lbl { opacity: 1; translate: 0 0; } }
  .rail { padding: 6px; }
  .rail a:focus-visible { outline: 2px solid var(--fp-ring); outline-offset: 1px; }
  :global(.read-line) { position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; background: var(--color-tiger); transform: scaleX(0); transform-origin: 0 50%; will-change: transform; pointer-events: none; }
</style>
