---
// Homepage: the "Through the door" journey (plan: Creative concept, scenes 1–7).
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatPrice } from '../lib/format';

import tigerLeft from '../assets/images/brand/tiger-head-left.png';
import tigerRight from '../assets/images/brand/tiger-head-right.png';
import stampLeft from '../assets/images/brand/logo-stamp-distressed-left.png';
import stampRight from '../assets/images/brand/logo-stamp-distressed-right.png';
import map from '../assets/images/brand/map.webp';
import inside from '../assets/images/covent-garden/gallery-01.jpg';
import momos from '../assets/images/journey/04-momos-chutney.jpg';
import barSour from '../assets/images/journey/05-bar-guava-chilli-sour.jpg';
import barCocktail from '../assets/images/journey/05-bar-cocktail.jpg';
import imgSpinach from '../assets/images/dishes/crackling-spinach.jpg';
import imgOkra from '../assets/images/dishes/crispy-okra-salt-n-pepper.jpg';
import imgVegMomo from '../assets/images/dishes/momo-mix-vegetable.jpg';
import imgBrownie from '../assets/images/dishes/sizzling-brownie.jpg';
import g2 from '../assets/images/covent-garden/gallery-02.jpg';
import g3 from '../assets/images/covent-garden/gallery-03.jpg';
import g4 from '../assets/images/covent-garden/gallery-04.jpg';
import g5 from '../assets/images/covent-garden/gallery-05.jpg';
import g6 from '../assets/images/covent-garden/gallery-06.jpg';
import g7 from '../assets/images/covent-garden/gallery-07.jpg';
import g8 from '../assets/images/covent-garden/gallery-08.jpg';

const branches = (await getCollection('branches')).sort((a, b) => a.data.order - b.data.order).map((b) => b.data);
const dish = async (id: string) => {
  const d = (await getEntry('dishes', id))?.data;
  if (!d) throw new Error(`dish ${id} missing from src/data/dishes.json`);
  return d;
};

const featured = [
  { d: await dish('momo-mix-vegetable'), img: imgVegMomo, alt: 'Green spinach-dough vegetable momos with red chutney on a banana leaf' },
  { d: await dish('crackling-spinach'), img: imgSpinach, alt: 'Crackling spinach topped with yoghurt and pomegranate in a steel bowl' },
  { d: await dish('crispy-okra-salt-n-pepper'), img: imgOkra, alt: 'Crispy okra with chillies in a black and gold steamer pot, pink salt beside it' },
  { d: await dish('snowflake-gelato-sizzling-brownie'), img: imgBrownie, alt: 'Sizzling brownie in a cast-iron skillet with vanilla ice cream and chocolate sauce', name: 'Sizzling brownie' },
];
const drinks = await Promise.all(['guava-chilli-sour', 'white-tiger', 'hakka-garden', 'desi-dragon'].map(dish));
const priceOf = (d: Awaited<ReturnType<typeof dish>>) =>
  d.price ? formatPrice(d.price, 'GBP') : d.options?.map((o) => `${o.label} ${formatPrice(o.price, 'GBP')}`).join(' · ');

const DAYS = [['mon', 'Mon'], ['tue', 'Tue'], ['wed', 'Wed'], ['thu', 'Thu'], ['fri', 'Fri'], ['sat', 'Sat'], ['sun', 'Sun']] as const;
const t = (s: string) => {
  const [h, m] = s.split(':').map(Number);
  const hh = h % 12 || 12;
  return `${hh}${m ? '.' + String(m).padStart(2, '0') : ''}${h < 12 ? 'am' : 'pm'}`;
};
// Group consecutive days with the same hours: "Mon–Fri 12–2.30pm, 5–10.30pm"
function hoursLines(hours: NonNullable<(typeof branches)[number]['hours']>) {
  const lines: { days: string; text: string }[] = [];
  for (const [key, label] of DAYS) {
    const text = hours[key].length ? hours[key].map(([a, b]) => `${t(a).replace(/(am|pm)$/, (x) => (t(b).endsWith(x) ? '' : x))}–${t(b)}`).join(', ') : 'Closed';
    const last = lines.at(-1);
    if (last && last.text === text) last.days = last.days.split('–')[0] + '–' + label;
    else lines.push({ days: label, text });
  }
  return lines;
}
const stamps: Record<string, typeof stampLeft> = { soho: stampLeft, 'covent-garden': stampRight };
---
<Base
  title="Fatt Pundit · Chinese-Indian Hakka restaurant · Soho, Covent Garden, Dubai"
  description="Indo-Chinese Hakka cooking from Tangra, Kolkata's Chinatown. Book a table at Fatt Pundit Soho or Covent Garden, London. Opening soon in Dubai."
  noindex
>
  <a class="skip" href="#tables">Skip to your table</a>
  <p class="preview-flag">Website preview for Fatt Pundit · not the live site · prices and photos to be confirmed</p>

  <header class="bar">
    <div class="wrap bar-in">
      <a class="brand" href="#top">FATT PUNDIT</a>
      <nav aria-label="Main" class="nav">
        <a href="#kitchen">Menus</a>
        <a href="#story">Our story</a>
        <a href="#tables">Locations</a>
        <a class="btn btn-orange btn-sm" href="#tables">Book a table</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- 1 + 2 · The street, the door -->
    <section id="top" class="hero" data-hero>
      <div class="hero-pin">
        <div class="wrap hero-grid">
          <div class="hero-copy reveal is-in">
            <p class="kicker gold">Soho · Covent Garden · Dubai</p>
            <h1 class="hero-title">Fatt<br />Pundit</h1>
            <p class="hero-lede">The Chinese-Indian Hakka restaurant you never knew you needed.</p>
            <div class="row">
              <a class="btn btn-orange" href="#tables">Book a table</a>
              <a class="btn btn-ghost-light" href="#kitchen">See the menus</a>
            </div>
            <p class="step-in" data-hint>Scroll to step inside ↓</p>
          </div>

          <div class="door-wrap">
            <div class="door" role="img" aria-label="The Fatt Pundit front door: two doors with the Indian and Chinese tigers open onto the dining room">
              <div class="door-sign">Est. Soho 2019</div>
              <div class="door-way">
                <Image src={inside} alt="" widths={[480, 800, 1100]} sizes="(min-width: 900px) 520px, 90vw" class="door-inside" loading="eager" />
                <div class="leaf leaf-l"><Image src={tigerLeft} alt="" width={360} class="leaf-tiger" loading="eager" /><span class="handle handle-l"></span></div>
                <div class="leaf leaf-r"><Image src={tigerRight} alt="" width={360} class="leaf-tiger" loading="eager" /><span class="handle handle-r"></span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 · The journey -->
    <section id="story" class="sec sand">
      <div class="wrap split rev">
        <figure class="map reveal" data-map>
          <Image src={map} alt="Hand-drawn map from the Fatt Pundit menu: the route from the Canton region of China, around the coast and across the Bay of Bengal, to Kolkata" widths={[600, 1000, 1295]} sizes="(min-width: 900px) 560px, 92vw" />
          <svg class="route" viewBox="0 0 1295 1320" aria-hidden="true">
            <path pathLength="1" d="M1038 718 C1000 900 950 1170 820 1170 C700 1170 640 1060 605 960 C578 880 548 805 505 752" />
            <circle class="pin pin-a" cx="1038" cy="718" r="16" />
            <circle class="pin pin-b" cx="505" cy="752" r="16" />
          </svg>
        </figure>
        <div class="stack reveal">
          <p class="kicker">The journey</p>
          <h2 class="h2">From Canton to Kolkata</h2>
          <p>The Hakka people sailed from China's Canton province to India and brought their cooking with them. In Tangra, Kolkata's Chinatown, Chinese wok technique met Indian spice.</p>
          <p>Indo-Chinese food was born there, new yet familiar. We cook it in London, and soon in Dubai.</p>
          <div class="name-cards">
            <div class="name-card"><p class="name-word">FATT</p><p>a common Chinese surname</p></div>
            <div class="name-card"><p class="name-word">PUNDIT</p><p>the Indian word for a scholar</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 · The kitchen -->
    <section id="kitchen" class="sec ink">
      <div class="wrap stack-lg">
        <div class="head-row reveal">
          <div class="stack">
            <p class="kicker gold">The kitchen</p>
            <h2 class="h2">All meals in Tangra start with momos</h2>
          </div>
          <a class="btn btn-orange" href="#kitchen">Full menu</a>
        </div>
        <div class="steam-photo reveal">
          <Image src={momos} alt="Steamed momos with a pot of red chutney, one held up on chopsticks" widths={[640, 1000, 1400]} sizes="(min-width: 1280px) 1200px, 94vw" />
          <span class="steam s1" aria-hidden="true"></span><span class="steam s2" aria-hidden="true"></span><span class="steam s3" aria-hidden="true"></span>
        </div>
        <ul class="dishes">
          {featured.map(({ d, img, alt, name }) => (
            <li class="dish reveal">
              <Image src={img} alt={alt} widths={[400, 700]} sizes="(min-width: 1100px) 290px, (min-width: 640px) 45vw, 92vw" class="dish-img" />
              <div class="dish-body">
                <div class="dish-top"><h3>{name ?? d.name}</h3><span class="price">{priceOf(d)}</span></div>
                {d.description && <p class="dish-desc">{d.description}</p>}
                {d.tags.length > 0 && <p class="tags">{d.tags.join(' · ')}</p>}
              </div>
            </li>
          ))}
        </ul>
        <div class="row chips reveal">
          <span class="note gold">Menus for every table:</span>
          {['Vegan', 'Halal', 'Gluten free', 'Dairy free', 'Pre-theatre'].map((m) => <a class="chip" href="#kitchen">{m}</a>)}
        </div>
      </div>
    </section>

    <!-- 5 · The bar -->
    <section class="sec ink bar-sec">
      <div class="wrap split">
        <div class="stack reveal">
          <p class="kicker gold">After dark</p>
          <h2 class="h2">The bar</h2>
          <p>Fruit coolers inspired by India's street fruit vendors, spiced and salted. Have one straight, or spike it with a paired spirit.</p>
          <ul class="drinks">
            {drinks.map((d) => (
              <li><div><h3>{d.name}</h3>{d.description && <p>{d.description}</p>}</div><span class="price">{priceOf(d)}</span></li>
            ))}
          </ul>
        </div>
        <div class="bar-photos reveal">
          <Image src={barSour} alt="Guava chilli sour with a chilli-salt rim, fresh guavas beside it" widths={[500, 900]} sizes="(min-width: 900px) 420px, 70vw" class="bp1" />
          <Image src={barCocktail} alt="A deep red fruit cooler with mint and citrus" widths={[400, 700]} sizes="(min-width: 900px) 300px, 55vw" class="bp2" />
        </div>
      </div>
    </section>

    <!-- 6 · The room -->
    <section class="sec sand">
      <div class="wrap stack-lg">
        <div class="stack reveal narrow">
          <p class="kicker">The room</p>
          <h2 class="h2">Pull up a chair</h2>
          <p>Painted walls from old Tangra, a tiger on the brickwork, blue-and-white plates and warm brass light.</p>
        </div>
        <div class="gallery reveal">
          <Image src={g5} alt="A tiger in a turban painted on the brick wall above a dining table" widths={[500, 900]} sizes="(min-width: 900px) 50vw, 92vw" class="ga" />
          <Image src={g3} alt="The bar, lit by brass lamps, with tables leading to it" widths={[400, 700]} sizes="(min-width: 900px) 25vw, 46vw" class="gb" />
          <Image src={g2} alt="Blue-and-white plates arranged on a plaster wall above green banquettes" widths={[400, 700]} sizes="(min-width: 900px) 25vw, 46vw" class="gc" />
          <Image src={g8} alt="Hindi and Chinese lettering painted on the dining room wall" widths={[400, 700]} sizes="(min-width: 900px) 25vw, 46vw" class="gd" />
          <Image src={g4} alt="Arched mirrors and pendant lights over the dining room" widths={[400, 700]} sizes="(min-width: 900px) 25vw, 46vw" class="ge" />
          <Image src={g7} alt="The dining room with a red door and painted lettering" widths={[500, 900]} sizes="(min-width: 900px) 50vw, 92vw" class="gf" />
          <Image src={g6} alt="Pink leather banquette against a green painted wall" widths={[500, 900]} sizes="(min-width: 900px) 50vw, 92vw" class="gg" />
        </div>
        <div class="rating reveal">
          <span class="rating-n">4.6 / 5</span>
          <span>from more than 1,170 diners on OpenTable (Soho, November 2026)</span>
        </div>
      </div>
    </section>

    <!-- 7 · Your table -->
    <section id="tables" class="sec gold-bg">
      <div class="wrap stack-lg">
        <div class="stack center reveal">
          <p class="kicker">Your table</p>
          <h2 class="h2">Choose your door</h2>
        </div>
        <div class="cards">
          {branches.map((b, i) => (
            <article class={`card stamp-in ${b.status === 'opening-soon' ? 'card-dark' : ''}`} style={`--d:${i * 120}ms`}>
              {stamps[b.id] && <Image src={stamps[b.id]} alt="" width={180} class="card-stamp" />}
              {b.status === 'opening-soon' && <p class="soon">Opening soon</p>}
              <h3 class="card-title">{b.shortName}</h3>
              <p>{b.address.street}<br />{b.address.city}{b.address.postcode ? ` ${b.address.postcode}` : ''}</p>
              {b.hours && (
                <dl class="hours">
                  {hoursLines(b.hours).map((l) => (<><dt>{l.days}</dt><dd>{l.text}</dd></>))}
                </dl>
              )}
              {b.status === 'open' && b.booking && (
                <div class="row card-actions">
                  <a class="btn btn-ink" href={b.booking.url} target="_blank" rel="noopener">Book {b.shortName}</a>
                  {b.phone && <a class="btn btn-line" href={`tel:${b.phone}`}>Call {b.phone.replace(/^\+44(\d{2})(\d{4})(\d{4})$/, '0$1 $2 $3')}</a>}
                </div>
              )}
              {b.status === 'opening-soon' && (
                <form class="waitlist" data-waitlist>
                  <p>Be first through the door. Leave your email and we'll tell you when bookings open.</p>
                  <label for={`wl-${b.id}`}>Email address</label>
                  <div class="row">
                    <input id={`wl-${b.id}`} type="email" required placeholder="you@example.com" autocomplete="email" />
                    <button class="btn btn-orange" type="submit">Join</button>
                  </div>
                  <p class="wl-msg" role="status" hidden>Thanks. (Demo only: nothing was sent.)</p>
                </form>
              )}
            </article>
          ))}
        </div>
        <p class="center small reveal">Five or more guests? Please call the restaurant. Larger bookings need a deposit.</p>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap stack-lg">
      <div class="foot-grid">
        <div class="stack-sm">
          <p class="brand">FATT PUNDIT</p>
          <p class="note gold">Hakka cooking from Tangra, Kolkata's Chinatown.</p>
        </div>
        {branches.map((b) => (
          <div class="stack-sm small">
            <p class="foot-h">{b.shortName}</p>
            <p>{b.address.street}{b.address.postcode ? `, ${b.address.postcode}` : ''}</p>
            <p>{b.phone ? b.phone.replace(/^\+44(\d{2})(\d{4})(\d{4})$/, '0$1 $2 $3') : 'Opening soon'}</p>
          </div>
        ))}
      </div>
      <nav aria-label="Footer" class="foot-nav">
        <a href="#kitchen">Menus</a><a href="#story">Our story</a><a href="#tables">Groups</a><a href="#tables">Gift vouchers</a>
        <a href="https://www.instagram.com/fattpundit/" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.facebook.com/fattpundit/" target="_blank" rel="noopener">Facebook</a>
        <a href="https://x.com/FattPundit" target="_blank" rel="noopener">X</a>
      </nav>
      <p class="tiny">We make every effort to avoid cross-contamination, but cannot guarantee dishes and drinks are allergen-free. Please tell us about any dietary requirements when you book. Website demo: prices and photos to be confirmed.</p>
    </div>
  </footer>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Doors: open as the hero scrolls. Pinned on wide screens, inline on phones.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const door = hero?.querySelector<HTMLElement>('.door-way');
  const hint = hero?.querySelector<HTMLElement>('[data-hint]');
  const wide = window.matchMedia('(min-width: 900px)');
  const clamp = (n: number) => Math.min(1, Math.max(0, n));
  function update() {
    if (!hero || !door) return;
    const vh = window.innerHeight;
    let p: number;
    if (wide.matches) {
      const r = hero.getBoundingClientRect();
      p = clamp(-r.top / Math.max(1, r.height - vh));
    } else {
      const r = door.getBoundingClientRect();
      p = clamp((vh * 0.85 - r.top) / (vh * 0.7));
    }
    const open = reduce ? 1 : 0.06 + p * 0.94;
    door.style.setProperty('--open', String(open));
    if (hint) hint.style.opacity = String(1 - Math.min(1, p * 3));
  }
  if (reduce) update();
  else {
    let ticking = false;
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { update(); ticking = false; }); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }

  // Reveal sections, draw the map route, drop the stamp cards.
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
    { threshold: 0.18 },
  );
  document.querySelectorAll('.reveal, [data-map], .stamp-in').forEach((el) => (reduce ? el.classList.add('is-in') : io.observe(el)));

  // Demo waitlist: no backend yet, so say so honestly.
  document.querySelectorAll<HTMLFormElement>('[data-waitlist]').forEach((f) =>
    f.addEventListener('submit', (ev) => {
      ev.preventDefault();
      f.querySelector<HTMLElement>('.wl-msg')?.removeAttribute('hidden');
    }),
  );
</script>

<style>
  .wrap { max-width: 1240px; margin: 0 auto; padding-inline: clamp(16px, 4vw, 40px); }
  .stack { display: flex; flex-direction: column; gap: 20px; }
  .stack-sm { display: flex; flex-direction: column; gap: 6px; }
  .stack-lg { display: flex; flex-direction: column; gap: clamp(32px, 4vw, 52px); }
  .row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .center { text-align: center; align-items: center; }
  .narrow { max-width: 720px; }
  .small { font-size: 15px; }
  .tiny { font-size: 13px; max-width: 760px; }
  p { margin: 0; }
  .sec { padding-block: clamp(72px, 10vw, 136px); }
  .sand { background: var(--color-sand); color: var(--color-ink); }
  .ink { background: var(--color-ink); color: var(--color-sand); }
  .gold-bg { background: var(--color-gold); color: var(--color-ink); }
  .gold { color: var(--color-gold); }
  .kicker, .note { font-family: var(--font-note); font-style: italic; font-weight: 500; font-size: 20px; letter-spacing: 0.02em; }
  .h2 { margin: 0; font-size: clamp(34px, 4.4vw, 58px); }
  body { font-size: 17px; line-height: 1.55; }

  .preview-flag { background: var(--color-gold); color: var(--color-ink); text-align: center; font-family: var(--font-label); font-weight: 700; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; padding: 6px 12px; }
  .skip { position: absolute; left: -999px; top: 8px; z-index: 50; background: var(--color-tiger); color: var(--color-ink); padding: 10px 16px; font-weight: 700; }
  .skip:focus { left: 8px; }

  /* Buttons */
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0 26px; font-weight: 700; font-size: 19px; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; border: 2px solid transparent; cursor: pointer; font-family: inherit; transition: transform .15s ease, background-color .15s ease; }
  .btn:hover { transform: translateY(-2px); }
  .btn-sm { min-height: 44px; padding: 0 18px; }
  .btn-orange { background: var(--color-tiger); color: var(--color-ink); }
  .btn-ink { background: var(--color-ink); color: var(--color-sand); font-size: 17px; }
  .btn-line { border-color: var(--color-ink); color: var(--color-ink); font-size: 15px; font-weight: 400; letter-spacing: 0.06em; text-transform: none; }
  .btn-ghost-light { border-color: var(--color-sand); color: var(--color-sand); }

  /* Header */
  .bar { position: sticky; top: 0; z-index: 40; background: var(--color-ink); color: var(--color-sand); border-bottom: 2px solid var(--color-gold); }
  .bar-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 28px; padding-block: 12px; }
  .brand { font-weight: 700; font-size: 22px; letter-spacing: 0.18em; color: var(--color-sand); text-decoration: none; }
  .nav { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; text-transform: uppercase; letter-spacing: 0.12em; font-size: 15px; }
  .nav a:not(.btn) { color: var(--color-sand); text-decoration: none; }
  .nav a:not(.btn):hover { color: var(--color-gold); }

  /* Hero + door */
  .hero { background: var(--color-ink); color: var(--color-sand); }
  .hero-pin { padding-block: clamp(40px, 6vw, 80px); }
  .hero-grid { display: flex; flex-wrap: wrap; align-items: center; gap: 40px 64px; }
  .hero-copy { flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 22px; }
  .hero-title { margin: 0; font-size: clamp(52px, 8vw, 104px); line-height: 0.92; }
  .hero-lede { font-size: clamp(20px, 2vw, 26px); line-height: 1.35; max-width: 520px; }
  .step-in { font-family: var(--font-note); font-style: italic; color: var(--color-gold); font-size: 19px; transition: opacity .2s; }
  .door-wrap { flex: 1 1 360px; min-width: 0; display: flex; justify-content: center; }
  .door { width: min(500px, 100%); background: var(--color-gold); padding: 12px; box-shadow: 0 30px 80px rgba(0,0,0,.45); }
  .door-sign { background: var(--color-ink); border: 2px solid var(--color-gold); color: var(--color-gold); text-align: center; font-family: var(--font-label); font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase; font-size: 14px; padding: 10px; margin-bottom: 10px; }
  .door-way { --open: 0.06; position: relative; aspect-ratio: 5 / 6; overflow: hidden; background: var(--color-ink); perspective: 1400px; }
  .door-inside { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(calc(1.15 - var(--open) * 0.15)); filter: brightness(calc(0.55 + var(--open) * 0.45)); }
  .leaf { position: absolute; top: 0; bottom: 0; width: 50%; background: var(--color-sand); border: 3px solid var(--color-ink); box-sizing: border-box; display: flex; align-items: center; justify-content: center; will-change: transform; }
  .leaf-l { left: 0; transform-origin: left center; transform: rotateY(calc(var(--open) * -96deg)); }
  .leaf-r { right: 0; transform-origin: right center; transform: rotateY(calc(var(--open) * 96deg)); }
  .leaf-tiger { width: 78%; height: auto; }
  .handle { position: absolute; top: 56%; width: 9px; height: 40px; background: var(--color-gold); }
  .handle-l { right: 10px; } .handle-r { left: 10px; }

