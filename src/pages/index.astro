---
// Homepage: the "Through the door" journey (plan: Creative concept, scenes 1–7).
import { getImage, Image } from 'astro:assets';
import Arrival from '../components/scenes/Arrival.astro';
import Doors from '../components/scenes/Doors.astro';
import RainHero from '../components/scenes/RainHero.tsx';
import Voyage from '../components/scenes/Voyage.tsx';
import Kitchen, { type KitchenDish } from '../components/scenes/Kitchen.tsx';
import MenuBook, { type MenuLite } from '../components/scenes/MenuBook.tsx';
import Base from '../layouts/Base.astro';
import { getBranches, dish, priceOf, hoursLines, menuBooks, prettyPhone } from '../lib/site-data';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

import stampLeft from '../assets/images/brand/logo-stamp-distressed-left.png';
import stampRight from '../assets/images/brand/logo-stamp-distressed-right.png';
import map from '../assets/images/brand/map.webp';
import worldLand from '../assets/images/brand/world-land.svg';
import shipArt from '../assets/images/brand/ship.png';
import compassArt from '../assets/images/brand/compass.png';
import frameArt from '../assets/images/brand/frame.png';
import stampGoldArt from '../assets/images/brand/stamp-gold.png';
import stampOrangeArt from '../assets/images/brand/stamp-orange.png';
import mountainAArt from '../assets/images/brand/mountain-a.png';
import mountainsBArt from '../assets/images/brand/mountains-b.png';
import mountainsCArt from '../assets/images/brand/mountains-c.png';
import greaseproofOrange from '../assets/images/brand/greaseproof-orange.png';
import inside from '../assets/images/covent-garden/gallery-01.jpg';
import barSour from '../assets/images/journey/05-bar-guava-chilli-sour.jpg';
import barCocktail from '../assets/images/journey/05-bar-cocktail.jpg';
import imgSpinach from '../assets/images/dishes/crackling-spinach.jpg';
import imgOkra from '../assets/images/dishes/crispy-okra-salt-n-pepper.jpg';
import imgVegMomo from '../assets/images/dishes/momo-mix-vegetable.jpg';
import imgBrownie from '../assets/images/dishes/sizzling-brownie.jpg';
import g2 from '../assets/images/covent-garden/gallery-02.jpg';
import g3 from '../assets/images/covent-garden/gallery-03.jpg';
import g4 from '../assets/images/covent-garden/gallery-04.jpg';
import g5 from '../assets/images/covent-garden/gallery-05.jpg';
import g6 from '../assets/images/covent-garden/gallery-06.jpg';
import g7 from '../assets/images/covent-garden/gallery-07.jpg';
import g8 from '../assets/images/covent-garden/gallery-08.jpg';

const branches = await getBranches();
const drinks = await Promise.all(['guava-chilli-sour', 'white-tiger', 'hakka-garden', 'desi-dragon'].map(dish));
const stamps: Record<string, typeof stampLeft> = { soho: stampLeft, 'covent-garden': stampRight };
const rainSrc = (await getImage({ src: inside, width: 1800, format: 'webp', quality: 82 })).src;
const img = async (src: Parameters<typeof getImage>[0]['src'], width: number) => (await getImage({ src, width, format: 'webp', quality: 84 })).src;
// Every drawing in the voyage comes from the brand guidelines (p.24 menu map and stamps).
const voyageArt = {
  map: await img(map, 1295),
  world: worldLand.src,
  ship: await img(shipArt, 400),
  compass: await img(compassArt, 240),
  frame: frameArt.src,
  stampGold: await img(stampGoldArt, 320),
  stampOrange: await img(stampOrangeArt, 340),
  mountainA: await img(mountainAArt, 300),
  mountainsB: await img(mountainsBArt, 520),
  mountainsC: await img(mountainsCArt, 260),
};
// Scene 4: signature dishes for the rail. Photos only where we have the real dish; the rest are order tickets.
const SECTION_NAMES: Record<string, string> = { momos: 'Momos', veg: 'Veg', seafood: 'Seafood', meat: 'Meat, game + poultry', rice: 'Bread, rice + noodles', sides: 'Sides', desserts: 'Desserts' };
const railDish = async (id: string, photo?: { src: Parameters<typeof getImage>[0]['src']; alt: string; name?: string }): Promise<KitchenDish> => {
  const d = await dish(id);
  return {
    id,
    name: photo?.name ?? d.name,
    note: d.description,
    price: priceOf(d) ?? undefined,
    tags: d.tags,
    image: photo ? await img(photo.src, 640) : undefined,
    imageAlt: photo?.alt,
    section: SECTION_NAMES[d.section] ?? d.section,
    signature: !!d.signature,
  };
};
const kitchenDishes = await Promise.all([
  railDish('momo-mix-vegetable', { src: imgVegMomo, alt: 'Green spinach-dough vegetable momos with red chutney on a banana leaf' }),
  railDish('momo-kid-goat'),
  railDish('crackling-spinach', { src: imgSpinach, alt: 'Crackling spinach topped with yoghurt and pomegranate in a steel bowl' }),
  railDish('popcorn-cauliflower'),
  railDish('crispy-okra-salt-n-pepper', { src: imgOkra, alt: 'Crispy okra with chillies in a black and gold steamer pot, pink salt beside it' }),
  railDish('hakka-chilly-paneer-lettuce-cups'),
  railDish('malabar-monkfish-curry'),
  railDish('bombay-chilly-prawns'),
  railDish('snowflake-gelato-sizzling-brownie', { src: imgBrownie, alt: 'Sizzling brownie in a cast-iron skillet with vanilla ice cream and chocolate sauce', name: 'Sizzling brownie' }),
]);
const kitchenArt = { greaseproof: greaseproofOrange.src, stampGold: await img(stampGoldArt, 200) };

// Scene 5: the menu book, straight from menus.json + dishes.json.
const menuBooksHome = await menuBooks(['a-la-carte', 'vegan', 'halal', 'gluten-free', 'dairy-free', 'drinks']);
const menuArt = { frame: frameArt.src, stampGold: await img(stampGoldArt, 220), stampOrange: await img(stampOrangeArt, 420), map: await img(map, 1000) };
const branchesLite = branches.map((b) => ({ shortName: b.shortName, timezone: b.timezone, hours: b.hours, status: b.status }));
---
<Base
  title="Fatt Pundit · Chinese-Indian Hakka restaurant · Soho, Covent Garden, Dubai"
  description="Indo-Chinese Hakka cooking from Tangra, Kolkata's Chinatown. Book a table at Fatt Pundit Soho or Covent Garden, London. Opening soon in Dubai."
  noindex
>
  <a class="skip" href="#tables">Skip to your table</a>
  <SiteHeader branches={branches} />

  <main>
    <!-- 0 · Arrival -->
    <Arrival />
    <!-- 1 · Rain on the window -->
    <section id="top" class="rain" aria-label="Fatt Pundit">
      <RainHero client:load src={rainSrc} branches={branchesLite} />
    </section>
    <!-- 2 · The doors -->
    <Doors />

    <!-- 3 · The voyage -->
    <Voyage client:visible art={voyageArt} />

    <!-- 4 · The kitchen -->
    <Kitchen client:visible dishes={kitchenDishes} art={kitchenArt} />

    <!-- 5 · The menu book -->
    <MenuBook client:visible menus={menuBooksHome} art={menuArt} />

    <!-- 5 · The bar -->
    <section class="sec ink bar-sec">
      <div class="wrap split">
        <div class="stack reveal">
          <p class="kicker gold">After dark</p>
          <h2 class="h2">The bar</h2>
          <p>Fruit coolers inspired by India's street fruit vendors, spiced and salted. Have one straight, or spike it with a paired spirit.</p>
          <ul class="drinks">
            {drinks.map((d) => (
              <li><div><h3>{d.name}</h3>{d.description && <p>{d.description}</p>}</div><span class="price">{priceOf(d)}</span></li>
            ))}
          </ul>
        </div>
        <div class="bar-photos reveal">
          <Image src={barSour} alt="Guava chilli sour with a chilli-salt rim, fresh guavas beside it" widths={[500, 900]} sizes="(min-width: 900px) 420px, 70vw" class="bp1" />
          <Image src={barCocktail} alt="A deep red fruit cooler with mint and citrus" widths={[400, 700]} sizes="(min-width: 900px) 300px, 55vw" class="bp2" />
        </div>
      </div>
    </section>

    <!-- 6 · The room -->
    <section class="sec sand">
      <div class="wrap stack-lg">
        <div class="stack reveal narrow">
          <p class="kicker">The room</p>
          <h2 class="h2">Pull up a chair</h2>
          <p>Painted walls from old Tangra, a tiger on the brickwork, blue-and-white plates and warm brass light.</p>
        </div>
        <div class="gallery reveal">
          <Image src={g5} alt="A tiger in a turban painted on the brick wall above a dining table" widths={[500, 900]} sizes="(min-width: 900px) 50vw, 92vw" class="ga" />
          <Image src={g3} alt="The bar, lit by brass lamps, with tables leading to it" widths={[400, 700]} sizes="(min-width: 900px) 25vw, 46vw" class="gb" />
          <Image src={g2} alt="Blue-and-white plates arranged on a plaster wall above green banquettes" widths={[400, 700]} sizes="(min-width: 900px) 25vw, 46vw" class="gc" />
          <Image src={g8} alt="Hindi and Chinese lettering painted on the dining room wall" widths={[400, 700]} sizes="(min-width: 900px) 25vw, 46vw" class="gd" />
          <Image src={g4} alt="Arched mirrors and pendant lights over the dining room" widths={[400, 700]} sizes="(min-width: 900px) 25vw, 46vw" class="ge" />
          <Image src={g7} alt="The dining room with a red door and painted lettering" widths={[500, 900]} sizes="(min-width: 900px) 50vw, 92vw" class="gf" />
          <Image src={g6} alt="Pink leather banquette against a green painted wall" widths={[500, 900]} sizes="(min-width: 900px) 50vw, 92vw" class="gg" />
        </div>
        <div class="rating reveal">
          <span class="rating-n">4.6 / 5</span>
          <span>from more than 1,170 diners on OpenTable (Soho, November 2026)</span>
        </div>
      </div>
    </section>

    <!-- 7 · Your table -->
    <section id="tables" class="sec gold-bg">
      <div class="wrap stack-lg">
        <div class="stack center reveal">
          <p class="kicker">Your table</p>
          <h2 class="h2">Choose your door</h2>
        </div>
        <div class="cards">
          {branches.map((b, i) => (
            <article class={`card stamp-in ${b.status === 'opening-soon' ? 'card-dark' : ''}`} style={`--d:${i * 120}ms; view-transition-name: branch-${b.id}`}>
              {stamps[b.id] && <Image src={stamps[b.id]} alt="" width={180} class="card-stamp" />}
              {b.status === 'opening-soon' && <p class="soon">Opening soon</p>}
              <h3 class="card-title"><a href={`/${b.id}/`} class="card-link">{b.shortName}</a></h3>
              <p>{b.address.street}<br />{b.address.city}{b.address.postcode ? ` ${b.address.postcode}` : ''}</p>
              {b.hours && (
                <dl class="hours">
                  {hoursLines(b.hours).map((l) => (<><dt>{l.days}</dt><dd>{l.text}</dd></>))}
                </dl>
              )}
              {b.status === 'open' && b.booking && (
                <div class="row card-actions">
                  <a class="btn btn-ink" href={b.booking.url} target="_blank" rel="noopener">Book {b.shortName}</a>
                  {b.phone && <a class="btn btn-line" href={`tel:${b.phone}`}>Call {prettyPhone(b.phone)}</a>}
                </div>
              )}
              <a class="card-more" href={`/${b.id}/`}>{b.status === 'open' ? `Step inside ${b.shortName}` : `See the ${b.shortName} gate`} →</a>
              {b.status === 'opening-soon' && (
                <form class="waitlist" data-waitlist>
                  <p>Be first through the door. Leave your email and we'll tell you when bookings open.</p>
                  <label for={`wl-${b.id}`}>Email address</label>
                  <div class="row">
                    <input id={`wl-${b.id}`} type="email" required placeholder="you@example.com" autocomplete="email" />
                    <button class="btn btn-orange" type="submit">Join</button>
                  </div>
                  <p class="wl-msg" role="status" hidden>Thanks. (Demo only: nothing was sent.)</p>
                </form>
              )}
            </article>
          ))}
        </div>
        <p class="center small reveal">Five or more guests? Please call the restaurant. Larger bookings need a deposit.</p>
      </div>
    </section>
  </main>

  <SiteFooter branches={branches} home />
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Stepping into a room: the card's stamp thuds before the page morphs (skipped in calm mode).
  for (const a of document.querySelectorAll<HTMLAnchorElement>('.card-link, .card-more')) {
    a.addEventListener('click', (e) => {
      if (reduce || e.metaKey || e.ctrlKey || e.shiftKey) return;
      const card = a.closest('.card');
      if (!card) return;
      e.preventDefault();
      card.classList.add('is-stamped');
      setTimeout(() => (location.href = a.href), 240);
    });
  }

  // Reveal sections, draw the map route, drop the stamp cards.
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
    { threshold: 0.18 },
  );
  document.querySelectorAll('.reveal, .stamp-in').forEach((el) => (reduce ? el.classList.add('is-in') : io.observe(el)));

  // Demo waitlist: no backend yet, so say so honestly.
  document.querySelectorAll<HTMLFormElement>('[data-waitlist]').forEach((f) =>
    f.addEventListener('submit', (ev) => {
      ev.preventDefault();
      f.querySelector<HTMLElement>('.wl-msg')?.removeAttribute('hidden');
    }),
  );
</script>

<style>
  p { margin: 0; }

  /* Journey */
  .split { display: flex; flex-wrap: wrap; align-items: center; gap: 48px 72px; }
  .split.rev { flex-wrap: wrap-reverse; }
  .split > * { flex: 1 1 420px; min-width: 0; }
  .map { position: relative; margin: 0; background: var(--color-ink); padding: 12px; }
  .map :global(img) { display: block; width: 100%; height: auto; }
  .route { position: absolute; inset: 12px; width: calc(100% - 24px); height: calc(100% - 24px); }
  .route path { fill: none; stroke: var(--color-tiger); stroke-width: 9; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 2.6s cubic-bezier(.6,0,.2,1) .3s; }
  .route .pin { fill: var(--color-tiger); opacity: 0; transition: opacity .4s; }
  .map.is-in .route path { stroke-dashoffset: 0; }
  .map.is-in .pin-a { opacity: 1; transition-delay: .2s; }
  .map.is-in .pin-b { opacity: 1; transition-delay: 2.8s; animation: pulse 1.6s ease-in-out 3s infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes pulse { 50% { transform: scale(1.6); opacity: .5; } }
  .name-cards { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 6px; }
  .name-card { flex: 1 1 200px; border: 2px solid var(--color-ink); padding: 16px 18px; font-size: 15px; }
  .name-word { font-weight: 700; font-size: 26px; letter-spacing: 0.14em; }

  .drinks h3 { margin: 0; font-size: 17px; letter-spacing: 0.08em; }
  .price { font-weight: 700; white-space: nowrap; }

  /* Bar */
  .bar-sec { padding-top: 0; }
  .bar-sec .wrap { border-top: 2px solid var(--color-gold); padding-top: clamp(64px, 8vw, 110px); }
  .drinks { list-style: none; margin: 6px 0 0; padding: 0; }
  .drinks li { display: flex; justify-content: space-between; gap: 18px; padding: 14px 0; border-bottom: 1px solid var(--color-gold); }
  .drinks p { font-size: 15px; }
  .drinks .price { white-space: normal; text-align: right; max-width: 42%; }
  main { overflow-x: clip; }
  .bar-photos { position: relative; min-height: 520px; }
  .bar-photos :global(.bp1) { position: absolute; top: 0; right: 0; width: 78%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border: 2px solid var(--color-gold); }
  .bar-photos :global(.bp2) { position: absolute; bottom: 0; left: 0; width: 56%; height: auto; aspect-ratio: 1; object-fit: cover; border: 8px solid var(--color-ink); outline: 2px solid var(--color-gold); }

  /* Room */
  .gallery { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(150px, 18vw, 240px); gap: 12px; }
  .gallery :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gallery :global(.ga) { grid-column: span 2; grid-row: span 2; }
  .gallery :global(.gf), .gallery :global(.gg) { grid-column: span 2; }
  @media (max-width: 700px) { .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } .gallery :global(.gf) { grid-column: span 2; } }
  .rating { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 20px; border-block: 2px solid var(--color-ink); padding-block: 20px; }
  .rating-n { font-weight: 700; font-size: 34px; letter-spacing: 0.06em; }

  /* Tables */
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 28px; }
  .card { background: var(--color-sand); color: var(--color-ink); padding: 28px; display: flex; flex-direction: column; gap: 14px; outline: 3px dashed var(--color-sand); outline-offset: 7px; }
  .card-dark { background: var(--color-ink); color: var(--color-sand); outline-color: var(--color-ink); }
  .card :global(.card-stamp) { width: 92px; height: auto; }
  .card.is-stamped :global(.card-stamp) { animation: card-thud .24s cubic-bezier(.2, 1.6, .4, 1); }
  @keyframes card-thud { 0% { transform: scale(1.7) rotate(-12deg); opacity: .4; } 100% { transform: none; opacity: 1; } }
  .card-title { margin: 0; font-size: 30px; }
  .card-link { color: inherit; text-decoration: none; }
  .card-link:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .card-more { font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; font-size: 15px; color: inherit; }
  .card-dark .card-more { color: var(--color-gold); }
  .soon { align-self: flex-start; border: 2px solid var(--color-gold); color: var(--color-gold); padding: 6px 12px; font-family: var(--font-label); font-weight: 700; font-size: 14px; letter-spacing: 0.24em; text-transform: uppercase; }
  .card-actions { margin-top: auto; padding-top: 6px; }
  .waitlist { display: flex; flex-direction: column; gap: 10px; margin-top: auto; }
  .waitlist label { font-size: 14px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-gold); }
  .waitlist input { flex: 1 1 170px; min-width: 0; min-height: 50px; padding: 0 14px; border: 2px solid var(--color-sand); background: var(--color-ink); color: var(--color-sand); font: inherit; font-size: 16px; }
  .wl-msg { color: var(--color-gold); }
  .card-dark .waitlist { margin-top: 8px; }
  .stamp-in { opacity: 0; transform: translateY(-40px) rotate(-4deg) scale(1.05); transition: opacity .5s ease var(--d), transform .6s cubic-bezier(.2,1.4,.4,1) var(--d); }
  .stamp-in.is-in { opacity: 1; transform: none; }

  /* Reveal */
  .reveal { opacity: 0; transform: translateY(28px); transition: opacity .8s ease, transform .8s ease; }
  .reveal.is-in { opacity: 1; transform: none; }

  @media (max-width: 640px) {
    .bar-photos { min-height: 400px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal, .stamp-in { opacity: 1; transform: none; }
    .steam { display: none; }
  }
</style>
