---
/**
 * One page per room: /soho/, /covent-garden/, /dubai/ (same URLs as the old site).
 * Same seven beats on every page (arrival, the room, born here, menus, visit, good to know,
 * the other rooms); what changes is the photos, colours, mark, signature moment and dish.
 * Everything printed comes from branches.json, dishes.json and menus.json.
 */
import type { GetStaticPaths, ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { stampSrc } from '../../lib/stamp';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/site/SiteHeader.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import NextStep from '../../components/site/NextStep.astro';
import { Image } from 'astro:assets';
import { dishPhoto } from '../../lib/dish-photos';
import momosChutney from '../../assets/images/journey/04-momos-chutney.jpg';
import BranchArrival from '../../components/branch/BranchArrival.tsx';
import VisitStrip from '../../components/branch/VisitStrip.astro';
import PlateWall from '../../components/branch/PlateWall.tsx';
import WalkTheRoom from '../../components/branch/WalkTheRoom.tsx';
import RoomContactSheet from '../../components/scenes/RoomContactSheet.tsx';
import TonightBoard from '../../components/branch/TonightBoard.tsx';
import { loadSpecials } from '../../lib/specials';
import { getEntry } from 'astro:content';
import LoopVideo from '../../components/site/LoopVideo.astro';
import LightsOn from '../../components/site/LightsOn.astro';
import lightsOnClip from '../../assets/video/cg-lights-on.mp4';
import lightsOffStill from '../../assets/video/cg-lights-on-off.jpg';
import lightsLitStill from '../../assets/video/cg-lights-on-lit.jpg';
import boothsLoop from '../../assets/video/cg-booths-glow.mp4';
import { appleMapsUrl, BOOKING_NAMES, directionsUrl, dish, fullAddress, getBranches, groupRules, hoursLines, preTheatreText, MENU_TABS, priceOf, type Branch } from '../../lib/site-data';
import stampLeft from '../../assets/images/brand/logo-stamp-distressed-left.png';
import stampRight from '../../assets/images/brand/logo-stamp-distressed-right.png';
import stampGoldArt from '../../assets/images/brand/stamp-gold.png';

export const getStaticPaths = (async () => {
  const branches = await getBranches();
  return branches.map((b) => ({ params: { branch: b.id }, props: { b, branches } }));
}) satisfies GetStaticPaths;

interface Props {
  b: Branch;
  branches: Branch[];
}
const { b, branches } = Astro.props;
const p = b.page;
const open = b.status === 'open';

// Branch photos live in src/assets/images/<branch>/<key>.jpg (checked by validate-data).
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/{soho,covent-garden,dubai}/*.jpg', { eager: true });
const photo = (key: string) => photos[`/src/assets/images/${b.id}/${key}.jpg`]?.default;
const ALTS: Record<string, string> = {
  'gallery-01': 'Pink booths and bentwood chairs under shelves of lamps and pots, against a green plaster wall',
  'gallery-02': 'A wall of blue-and-white plates above green booths, with brass pendant lamps',
  'gallery-03': 'The bar, its shelves of bottles lit by brass lamps, with tables leading to it',
  'gallery-04': 'Arched mirrors above long teal banquettes and wooden tables',
  'gallery-05': 'A painted tiger on brick above tables with yellow chairs',
  'gallery-06': 'A pink booth against a green plaster wall, glasses set for dinner',
  'gallery-07': 'Hindi and Chinese lettering on plaster walls above teal banquettes, a red door',
  'gallery-08': 'Hindi lettering over teal banquettes and wooden tables',
};
const heroImg = p.hero && photo(p.hero) ? await getImage({ src: photo(p.hero)!, width: 2000, format: 'webp', quality: 80 }) : null;
const heroSet = heroImg ? (await Promise.all([800, 1200, 1600, 2400].map(async (w) => `${(await getImage({ src: photo(p.hero!)!, width: w, format: 'webp', quality: 80 })).src} ${w}w`))).join(', ') : undefined;
// Video poster = the 800w hero, the same file a phone picks from the srcset,
// so the poster never downloads a second, bigger copy of the photo.
const heroPoster = heroImg ? (await getImage({ src: photo(p.hero!)!, width: 800, format: 'webp', quality: 80 })).src : undefined;
const gallery = p.gallery.map((k) => ({ key: k, src: photo(k)!, alt: ALTS[k] ?? '' })).filter((g) => g.src);

const LEAD = { tiger: 'var(--color-tiger)', gold: 'var(--color-gold)', slate: 'var(--color-slate)' }[p.lead];
// Small words in the branch colour on light paper use its text-safe partner.
const LEAD_TEXT = { tiger: 'var(--color-tiger-deep)', gold: 'var(--color-gold-deep)', slate: 'var(--color-slate-deep)' }[p.lead];
const markSrc = b.mark === 'tiger-indian' ? stampLeft : b.mark === 'tiger-chinese' ? stampRight : null;
// Brand rule: on dark, the stamp is printed in colour (negative logo), so it is drawn as a mask.
const mark = markSrc ? await stampSrc(markSrc, 240) : null;
const img = async (src: ImageMetadata, width: number) => (await getImage({ src, width, format: 'webp', quality: 84 })).src;
// The room's photos as the same contact sheet and lightbox the home page uses.
const sheet = await Promise.all(gallery.map(async (g) => ({ thumb: await img(g.src, 640), full: await img(g.src, 1600), alt: g.alt })));

// Beat 3: the dish this room is known for, or (Dubai) what is coming.
const signature = p.signature ? { ...p.signature, d: await dish(p.signature.dish) } : null;
const teaser = await Promise.all(p.teaser.map(dish));

// Covent Garden's plate wall: dishes from this kitchen, prices from the data.
const PLATES = ['momo-kid-goat', 'crackling-spinach', 'hakka-chilly-paneer-lettuce-cups', 'crunchy-pepper-crab', 'kolkata-chilli-duck', 'bombay-chilly-prawns', 'shredded-chilly-venison', 'lady-kenny', 'white-tiger'];
const plates = b.id === 'covent-garden' ? await Promise.all(PLATES.map(async (id) => { const d = await dish(id); return { id, name: d.name, price: priceOf(d) ?? undefined, kind: d.kind }; })) : [];

// Soho's walk through the room (DesignMyNight's description of the room). Photos to come.
const sohoStops = [
  { title: 'The door', zone: 'door' as const, note: 'On Berwick Street, just short of Oxford Street and Wardour Street.' },
  { title: 'The bar, on your left', zone: 'bar' as const, note: 'Stools and hanging lights.' },
  { title: 'Tables for two and four', zone: 'tables' as const, note: 'Along the right-hand wall, on a reclaimed wood and brick floor.' },
  { title: 'The graffiti wall', zone: 'graffiti' as const, note: 'Chinese lettering, teal paint, tiffin carriers on the shelves.' },
  { title: 'The kitchen', zone: 'kitchen' as const, note: 'At the end of the room, where the momos come from.' },
];

// Menus (Phase 7 §4.2): two short groups of links, the general menus and the dietary ones.
const menuRows = open ? (await Promise.all(b.menus.map((id) => getEntry('menus', id)))).filter(Boolean).map((m) => ({ id: m!.data.id ?? m!.id, title: MENU_TABS[m!.id] ?? m!.data.title, diet: m!.data.kind === 'diet' })) : [];
const menuGroups = [
  { key: 'main', label: 'Menus', rows: menuRows.filter((m) => !m.diet) },
  { key: 'diet', label: 'For dietary needs', rows: menuRows.filter((m) => m.diet) },
].filter((g) => g.rows.length > 0);

// What to order (Phase 7 §4.2): dishes on this room's à la carte that have an approved photograph.
// More join as the shoot delivers them (CLIENT-INPUTS #36, #46).
const ORDER = ['crackling-spinach', 'momo-mix-vegetable', 'crispy-okra-salt-n-pepper', 'momo-kid-goat', 'popcorn-cauliflower', 'hakka-chilly-paneer-lettuce-cups', 'bombay-chilly-prawns', 'malabar-monkfish-curry'];
const alaCarte = open && b.menus.includes('a-la-carte') ? (await getEntry('menus', 'a-la-carte'))!.data.sections.flatMap((sec) => sec.items.map((i) => i.dish)) : [];
// Where each photo's dish sits in the frame, so a square crop keeps the food.
const FOCUS: Record<string, string> = { 'momo-mix-vegetable': '92% 18%', 'crispy-okra-salt-n-pepper': '62% 50%' };
const toOrder = await Promise.all(ORDER.filter((id) => alaCarte.includes(id) && dishPhoto(id)).slice(0, 6).map(async (id) => ({ id, d: await dish(id), photo: dishPhoto(id)!, focus: FOCUS[id] ?? '50% 50%' })));
const rating = p.rating;
const preTheatre = preTheatreText(b);
const wallOff = (await getImage({ src: lightsOffStill, width: 1280, format: 'webp', quality: 80 })).src;
const wallLit = (await getImage({ src: lightsLitStill, width: 1280, format: 'webp', quality: 80 })).src;
// Bulb positions (% of each photo), measured from the frames.
const WALL_LAMPS = [{ x: 10.5, y: 13.3, size: 0.6 }, { x: 65.9, y: 13.3, size: 0.6 }];
const menuArt = { stampGold: await stampSrc(stampGoldArt, 220) };

// Tonight's board: every row for this branch goes to the page; the board picks today's.
const specials = open ? (await loadSpecials()).filter((r) => r.branch === b.id || r.branch === 'all') : [];
const others = branches.filter((o) => o.id !== b.id);
const words = open ? [b.shortName] : [b.shortName, 'The Hangout', 'Boarding soon'];
const pill = { shortName: b.shortName, timezone: b.timezone, hours: b.hours, status: b.status };
const hours = b.hours ? hoursLines(b.hours) : [];
// The Visit heading says how often we're open, so it doesn't repeat the address from the strip.
const daysOpen = b.hours ? (['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'] as const).filter((d) => (b.hours?.[d] ?? []).length > 0).length : 0;
const openDays = daysOpen === 7 ? 'Open every day.' : daysOpen > 0 ? `Open ${['', 'one', 'two', 'three', 'four', 'five', 'six'][daysOpen]} days a week.` : 'Opening hours.';
const rules = groupRules(b);
// The Dubai list sends through a form-to-email service once the Dubai address is verified (CLIENT-INPUTS #5, #10).
const listEndpoint = import.meta.env.PUBLIC_DUBAI_LIST_ENDPOINT as string | undefined;

// Chapters (Phase 6): every section after the facts row opens like the home chapters, a numbered label
// on a rule and a light headline (.fp-section-head). Numbers follow the sections this page actually shows.
const showRoom = open || gallery.length > 0;
const chapters = [
  showRoom && 'room',
  'signature',
  toOrder.length > 0 && 'order',
  menuRows.length > 0 && 'menus',
  open && 'visit',
  open && 'good',
  'others',
].filter(Boolean) as string[];
const no = (id: string) => String(chapters.indexOf(id) + 1).padStart(2, '0');
const roomLabel = p.opened ? `The room, since ${p.opened}` : 'The room, coming soon';
const sigLabel = signature ? (signature.label === 'only-here' ? `Only at ${b.shortName}` : `Born at ${b.shortName}`) : 'Coming with us';

// Search engines: one Restaurant per page.
const DAY_NAMES: Record<string, string> = { mon: 'Monday', tue: 'Tuesday', wed: 'Wednesday', thu: 'Thursday', fri: 'Friday', sat: 'Saturday', sun: 'Sunday' };
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': new URL(`/${b.id}/#restaurant`, Astro.site).href,
  name: b.name,
  url: new URL(`/${b.id}/`, Astro.site).href,
  parentOrganization: { '@id': new URL('/#org', Astro.site).href },
  ...(open ? { hasMenu: new URL(`/${b.id}/menu/`, Astro.site).href } : {}),
  ...(b.geo ? { geo: { '@type': 'GeoCoordinates', latitude: b.geo.lat, longitude: b.geo.lng } } : {}),
  ...(b.email ? { email: b.email } : {}),
  servesCuisine: ['Indo-Chinese', 'Hakka'],
  priceRange: '££',
  address: { '@type': 'PostalAddress', streetAddress: b.address.street, addressLocality: b.address.city, postalCode: b.address.postcode ?? undefined, addressCountry: b.address.country },
  ...(b.phone ? { telephone: b.phone } : {}),
  ...(heroImg ? { image: new URL(heroImg.src, Astro.site).href } : {}),
  ...(b.booking ? { acceptsReservations: b.booking.url } : {}),
  ...(b.hours
    ? { openingHoursSpecification: Object.entries(b.hours).flatMap(([d, spans]) => spans.map(([opens, closes]) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: DAY_NAMES[d], opens, closes }))) }
    : {}),
};
const title = open ? `Fatt Pundit ${b.shortName} · Indo-Chinese Hakka restaurant · ${b.address.street}` : `Fatt Pundit ${b.shortName} · Opening soon at ${b.address.street}`;
const description = `${p.lines.join(' ')} ${open ? `Book a table at ${fullAddress(b)}.` : 'Join the list for opening news.'}`;
---
<Base title={title} description={description} og={b.id}>
  {heroImg && <link slot="head" rel="preload" as="image" imagesrcset={heroSet} imagesizes="(min-width: 1024px) 62vw, 100vw" fetchpriority="high" />}
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <a class="skip" href={open ? '#visit' : '#waitlist'}>{open ? 'Skip to opening hours and directions' : 'Skip to the waiting list'}</a>
  <SiteHeader branches={branches} current={b} />

  <main class={`branch branch-${b.id}`} style={`--lead: ${LEAD}; --lead-text: ${LEAD_TEXT}; --second: ${p.second};`}>
    <!-- 1 · Arrival: the guest facts work before any animation. -->
    <section class="arrival" style={`view-transition-name: branch-${b.id}`} aria-labelledby="branch-title">
      <!-- Phones: a photo band shown at its true sharpness, then the facts on solid ink.
           Wider screens: the photo fills the hero behind a dark fade on the text side. -->
      <div class={`arrival-media ${heroImg ? 'is-photo' : 'is-art'}`}>
        {heroImg ? (
          <>
            <img class="arrival-bg" src={heroImg.src} srcset={heroSet} sizes="(min-width: 1024px) 62vw, 100vw" alt={ALTS[p.hero!] ?? ''} width={heroImg.attributes.width} height={heroImg.attributes.height} fetchpriority="high" />
            {b.id === 'covent-garden' && <LoopVideo src={boothsLoop} poster={heroPoster!} label={ALTS[p.hero!] ?? ''} class="arrival-bg" />}
          </>
        ) : b.id === 'soho' ? (
          <div class="arrival-bg art-soho" aria-hidden="true">
            <div class="street-sign"><span class="sign-name">Berwick Street</span><span class="sign-code">W1</span><span class="sign-city">City of Westminster</span></div>
          </div>
        ) : (
          <div class="arrival-bg art-gate" aria-hidden="true"><span class="gate-code">DXB</span></div>
        )}
      </div>
      <div class="arrival-shade" aria-hidden="true"></div>
      <div class:list={['wrap arrival-in', { 'has-board': specials.length > 0 }]}>
        {mark && <span class="mark-badge" aria-hidden="true"><span class="arrival-mark" style={`-webkit-mask-image: url(${mark}); mask-image: url(${mark});`}></span></span>}
        <h1 id="branch-title" class="sr-only">Fatt Pundit {b.shortName}</h1>
        <p class="arrival-brand" aria-hidden="true">Fatt Pundit</p>
        <div aria-hidden="true" class="board-slot"><BranchArrival client:idle words={words} branch={pill} /></div>
        {b.geo && <p class="branch-clock" data-branch-clock data-tz={b.timezone} data-lat={b.geo.lat} data-lng={b.geo.lng} data-name={b.shortName}></p>}
        <div class="fp-cluster arrival-actions">
          {open && b.booking && <a class="fp-btn fp-btn--primary" href={b.booking.url} data-book={b.id} target="_blank" rel="noopener">Book a table</a>}
          {open && <a class="fp-btn" href={`/${b.id}/menu/`}>See the menus</a>}
        </div>
        <!-- Opening soon: the list sits in the hero, the one thing a guest can do yet (Phase 7 §4.3). -->
        {!open && (
          <div id="waitlist" class="hero-list" role="group" aria-labelledby="wl-title">
            <h2 id="wl-title" class="hero-list-h">Be first through the door</h2>
            {listEndpoint ? (
              <>
                <form class="fp-form wl-form" data-waitlist data-list={b.id} action={listEndpoint} method="post" novalidate>
                  <input type="hidden" name="list" value={`${b.shortName} opening`} />
                  <div class="fp-field">
                    <label for="wl-email" class="fp-label">Email address</label>
                    <div class="wl-row">
                      <input id="wl-email" class="fp-input" name="email" type="email" required placeholder="you@example.com" autocomplete="email" aria-describedby="wl-email-msg" />
                      <button class="fp-btn fp-btn--primary" type="submit">Join the list</button>
                    </div>
                    <p id="wl-email-msg" data-wl-msg hidden></p>
                  </div>
                </form>
                <p class="fp-small">We'll only email you about the Dubai opening. Unsubscribe any time.</p>
              </>
            ) : (
              <p class="hero-list-note">The list opens soon. For the opening date, follow <a class="fp-link" href="https://www.instagram.com/fattpundit/" target="_blank" rel="noopener">@fattpundit on Instagram<span class="sr-only"> (opens in a new tab)</span></a>.</p>
            )}
          </div>
        )}
        <!-- Tonight's board hangs in the arrival, on the same ink, instead of a band of its own. -->
        {specials.length > 0 && <TonightBoard client:idle branch={b.id} name={b.shortName} tz={b.timezone} rows={specials} csvUrl={import.meta.env.PUBLIC_SPECIALS_CSV_URL} />}
      </div>
    </section>

    <!-- The essentials before the story: today's hours, address, call, directions, book. -->
    <VisitStrip branch={b} stations={p.stations} />

    <!-- 2 · The room: one chapter holds its head and everything about the room (Soho's walk on night ink,
         Covent Garden's wall, plates and contact sheet on sand). -->
    {showRoom && <section class={`chapter room${b.id === 'soho' ? ' ink' : ''}`} aria-labelledby="room-title">
      <div class="wrap">
        <!-- The brand's three lines: the first is the headline, the other two are the spoken line under it. -->
        <header class="fp-section-head chapter-head">
          <p class="fp-section-label"><span class="fp-section-no">{no('room')}</span> {roomLabel}</p>
          <h2 id="room-title" class="fp-h2"><span class="sr-only">The room: </span>{p.lines[0]}</h2>
          {p.lines.length > 1 && <p class="fp-spoken room-spoken">{p.lines.slice(1).join(' ')}</p>}
        </header>
        {(b.id === 'covent-garden' || gallery.length > 0) && (
          <div class="chapter-body room-wall">
            {b.id === 'covent-garden' && (
              <>
                <LightsOn src={lightsOnClip} off={wallOff} lit={wallLit} label={ALTS['gallery-02']} lamps={WALL_LAMPS} ratio={1760 / 1176} place="Maiden Lane" />
                <p class="wall-intro">Now turn the plates over: each one hides something from the kitchen.</p>
                <PlateWall client:visible dishes={plates} />
              </>
            )}
            {gallery.length > 0 && (
              <div class="gallery-sec room-sheet" role="group" aria-label={`Photos of ${b.shortName}`}>
                <RoomContactSheet client:visible frames={sheet} picks={[]} />
              </div>
            )}
          </div>
        )}
      </div>
      {b.id === 'soho' && <div class="room-walk"><WalkTheRoom client:visible stops={sohoStops} accent={p.second} /></div>}
    </section>}

    <!-- 3 · Born here / coming with us -->
    <section class="chapter signature" aria-labelledby="sig-title">
      <div class="wrap">
        <header class="fp-section-head chapter-head">
          <p class="fp-section-label"><span class="fp-section-no">{no('signature')}</span> {sigLabel}</p>
          <h2 id="sig-title" class="fp-h2">
            {signature
              ? <><span class="sr-only">{signature.label === 'only-here' ? 'Only here' : 'Born here'}: </span>{signature.d.name}</>
              : <>What we're packing for Dubai</>}
          </h2>
          {!signature && <p class="chapter-intro">London favourites named for the Dubai opening. Prices and the full menu come with the opening date.</p>}
        </header>
        {signature ? (
          <div class="chapter-body sig">
            <div class="sig-ticket">
              <p class="sig-no">{signature.label === 'only-here' ? 'Only here' : 'Born here'}</p>
              <p class="sig-name">{signature.d.name}</p>
              {priceOf(signature.d) && <p class="sig-price fp-num">{priceOf(signature.d)}</p>}
              <img src={menuArt.stampGold} alt="" class="sig-stamp" width="508" height="564" loading="lazy" decoding="async" />
            </div>
            <div class="fp-stack sig-text">
              {signature.d.description && <p class="fp-spoken">{signature.d.description}</p>}
              <p class="fp-body">{signature.story}</p>
              {signature.d.tags.length > 0 && <p class="fp-small fp-muted">Marked {signature.d.tags.join(', ')} on the menu.</p>}
              {open && <p><a class="fp-link fp-link--strong" href={`/${b.id}/menu/#${signature.d.kind === 'drink' ? 'drinks' : 'a-la-carte'}`}>Find it on the menu</a></p>}
            </div>
          </div>
        ) : (
          <div class="chapter-body">
            <ul class="teaser">
              {teaser.map((d) => (
                <li class="sig-ticket small-ticket">
                  <p class="sig-no">From London</p>
                  <p class="sig-name">{d.name}</p>
                  {d.description && <p class="teaser-desc">{d.description}</p>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>

    <!-- What to order: photographed dishes, with the room's public rating as proof. -->
    {toOrder.length > 0 && (
      <section id="order" class="chapter order" aria-labelledby="order-title">
        <div class="wrap">
          <header class="fp-section-head chapter-head">
            <p class="fp-section-label"><span class="fp-section-no">{no('order')}</span> What to order</p>
            <h2 id="order-title" class="fp-h2"><span class="sr-only">What to order: </span>Start with these.</h2>
          </header>
          <div class="chapter-body">
            <ul class="order-grid" role="list">
              {toOrder.map(({ d, photo: ph, focus }) => (
                <li class="order-dish">
                  <a href={`/${b.id}/menu/#a-la-carte`} class="order-link">
                    <span class="order-photo"><Image src={ph} alt="" widths={[360, 560, 800]} sizes="(min-width: 1024px) 22vw, (min-width: 640px) 33vw, 88vw" loading="lazy" style={`object-position:${focus}`} /></span>
                    <span class="order-name">{d.name}{priceOf(d) && <span class="order-price fp-num">{priceOf(d)}</span>}</span>
                    {d.description && <span class="order-desc">{d.description}</span>}
                  </a>
                </li>
              ))}
            </ul>
            {rating && (
              <div class="proof">
                <span class="proof-n fp-num">{rating.score}<span class="proof-of"> / 5</span></span>
                <span class="proof-src">on {rating.source}, from {rating.count} reviews of Fatt Pundit {b.shortName} ({rating.asOf})</span>
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- 4 · The menus here -->
    {menuRows.length > 0 && (
      <section id="menu" class="chapter menus-sec" aria-labelledby="menus-title">
        <div class="wrap">
          <header class="fp-section-head chapter-head">
            <p class="fp-section-label"><span class="fp-section-no">{no('menus')}</span> The menus</p>
            <h2 id="menus-title" class="fp-h2">Menus at {b.shortName}</h2>
            <p class="chapter-intro">Each one opens as a list, with search, diet filters and printing.</p>
          </header>
          <div class="chapter-body menu-groups">
            {menuGroups.map((g) => (
              <div class="menu-group">
                <h3 class="menu-group-h" id={`mg-${g.key}`}>{g.label}</h3>
                <ul class="menu-group-list" role="list" aria-labelledby={`mg-${g.key}`}>
                  {g.rows.map((m) => (
                    <li><a class="menu-group-link" href={`/${b.id}/menu/#${m.id}`}><span>{m.title}</span>{(m.id === 'pre-theatre' || m.id === 'vegetarian-pre-theatre') && preTheatre && <span class="menu-group-note">Seated {preTheatre}</span>}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 5 · Visit -->
    {open && <section id="visit" class="chapter ink visit" aria-labelledby="visit-title">
      <div class="wrap">
        <header class="fp-section-head chapter-head">
          <p class="fp-section-label"><span class="fp-section-no">{no('visit')}</span> Visit</p>
          <h2 id="visit-title" class="fp-h2"><span class="sr-only">Visit: </span>{openDays}</h2>
        </header>
        <!-- Address, stations and Call live once, in the strip under the hero (and the footer);
             this chapter holds what the strip can't: the week's hours, map apps, email, delivery. -->
        <div class="chapter-body visit-grid">
          <div class="fp-stack visit-hours">
            {hours.length > 0 ? (
              <table class="fp-hours" data-hours-tz={b.timezone}>
                <caption>Opening hours</caption>
                <tbody>
                  {hours.map((l) => (<tr data-days={l.keys.join(' ')}><th scope="row">{l.days}<span class="hours-today" hidden> (today)</span></th><td>{l.text}</td></tr>))}
                </tbody>
              </table>
            ) : (
              <p>Hours are announced with the opening date.</p>
            )}
          </div>
          <div class="fp-stack visit-where">
            <div class="fp-cluster">
              <a class="fp-btn" href={directionsUrl(b)} target="_blank" rel="noopener">Google Maps<span class="sr-only"> (opens in a new tab)</span></a>
              <a class="fp-btn" href={appleMapsUrl(b)} target="_blank" rel="noopener">Apple Maps<span class="sr-only"> (opens in a new tab)</span></a>
            </div>
            {b.email && <p><a class="fp-link fp-link--strong" href={`mailto:${b.email}`}>Email us</a></p>}
            {(b.delivery.length > 0 || b.clickAndCollectUrl) && (
              <p class="fp-small" id="at-home">
                {b.clickAndCollectUrl && <>Collect it yourself: <a class="fp-link" href={b.clickAndCollectUrl} target="_blank" rel="noopener">order for pickup<span class="sr-only"> (opens in a new tab)</span></a>. </>}
                {b.delivery.length > 0 && <>At home: {b.delivery.map((d, i) => (<>{i > 0 && ' or '}<a class="fp-link" href={d.url} target="_blank" rel="noopener">{d.provider === 'deliveroo' ? 'Deliveroo' : 'Uber Eats'}<span class="sr-only"> (opens in a new tab)</span></a></>))}.</>}
              </p>
            )}
          </div>
        </div>
      </div>
    </section>}

    <!-- 6 · Good to know (only what we actually know) -->
    {open && (
      <section class="chapter good" aria-labelledby="good-title">
        <div class="wrap">
          <header class="fp-section-head chapter-head">
            <p class="fp-section-label"><span class="fp-section-no">{no('good')}</span> Good to know</p>
            <h2 id="good-title" class="fp-h2"><span class="sr-only">Good to know: </span>Before you travel.</h2>
          </header>
          <ul class="chapter-body fp-grid-auto lug" role="list">
            <li class="fp-tag"><div class="fp-tag-in surface-paper-light">
              <h3 class="fp-h4">Dietary menus</h3>
              <p>{b.menus.filter((m) => !['a-la-carte', 'drinks'].includes(m)).map((m) => MENU_TABS[m] ?? m).join(', ')}.</p>
              <p class="tag-link"><a class="fp-link fp-link--strong" href={`/${b.id}/menu/`}>See every menu as a list</a></p>
            </div></li>
            <li class="fp-tag"><div class="fp-tag-in surface-paper-light">
              <h3 class="fp-h4">Allergies</h3>
              <p>Tell us when you book. We work hard to avoid cross-contamination but can’t promise a dish is allergen-free.</p>
              <p class="tag-link"><a class="fp-link fp-link--strong" href="/allergens/">Allergens and dietary needs</a></p>
            </div></li>
            <li class="fp-tag"><div class="fp-tag-in surface-paper-light">
              <h3 class="fp-h4">Groups</h3>
              <p>{rules ? `${rules.online} ${rules.call ?? ''} ${rules.setMenu} ${rules.depositShort}` : 'For larger tables, please call the restaurant.'}</p>
              <p class="tag-link"><a class="fp-link fp-link--strong" href="/private-dining/">Plan a group</a></p>
            </div></li>
          </ul>
        </div>
      </section>
    )}


    <!-- 7 · The other rooms -->
    <section class="chapter others" aria-labelledby="others-title">
      <div class="wrap">
        <header class="fp-section-head chapter-head">
          <p class="fp-section-label"><span class="fp-section-no">{no('others')}</span> {open ? 'The other rooms' : 'In London'}</p>
          <h2 id="others-title" class="fp-h2"><span class="sr-only">{open ? 'The other rooms: ' : 'In London: '}</span>{open ? 'Onward travel.' : 'Before then, in London.'}</h2>
        </header>
        <div class="chapter-body other-grid">
          {others.map((o) => (
            <a class="fp-postcard surface-paper other" href={`/${o.id}/`} style={`view-transition-name: branch-${o.id}`}>
              <span class="fp-small"><span class="other-no">{String(branches.indexOf(o) + 1).padStart(2, '0')}</span> {o.status === 'open' ? o.address.city : 'Opening soon'}</span>
              <span class="other-name">{o.shortName}</span>
              <span class="fp-body">{o.address.street}</span>
              <span class="other-go">{o.status === 'open' ? `Visit ${o.shortName}` : `See ${o.shortName}`}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {open && b.booking ? (
      <NextStep
        title={`Hungry already? Book at ${b.shortName}.`}
        line={`Book online with ${BOOKING_NAMES[b.booking.provider]}, or call us.`}
        actions={[{ href: b.booking.url, label: `Book at ${b.shortName}`, primary: true, book: b.id, external: true }, { href: `/${b.id}/menu/`, label: 'See the menus' }]}
        photo={b.id === 'covent-garden' && photo('gallery-03') ? photo('gallery-03') : momosChutney}
      />
    ) : (
      <NextStep
        title="Hungry before Dubai opens?"
        line="Both London rooms are open tonight."
        actions={[{ href: '/book/', label: 'Book in London', primary: true }, { href: '/soho/menu/', label: 'See the menus' }]}
        photo={dishPhoto('momo-mix-vegetable')}
      />
    )}
  </main>

  <SiteFooter branches={branches} />
</Base>

<script>
  // Branch clock: the time and light in this restaurant's own city.
  import { clockIn, daypart, ICON, WORD } from '../../lib/clock';
  {
    const el = document.querySelector<HTMLElement>('[data-branch-clock]');
    const tick = () => {
      if (!el) return;
      const part = daypart(+el.dataset.lat!, +el.dataset.lng!);
      const hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: el.dataset.tz!, hour: 'numeric', hourCycle: 'h23' }).format(new Date()));
      document.documentElement.dataset.daypart = part;
      document.documentElement.dataset.hour = String(hour);
      el.innerHTML = `${ICON[part]}<span>Local time in ${el.dataset.name}: ${clockIn(el.dataset.tz!)}, ${WORD[part]}</span>`;
    };
    tick();
    setInterval(tick, 60_000);
  }

  // Today's row in the hours table, in the branch's own time zone: aria-current="date" plus the word.
  for (const table of document.querySelectorAll<HTMLElement>('[data-hours-tz]')) {
    const day = new Intl.DateTimeFormat('en-GB', { timeZone: table.dataset.hoursTz, weekday: 'short' }).format(new Date()).slice(0, 3).toLowerCase();
    const row = table.querySelector(`[data-days~="${day}"]`);
    if (!row) continue;
    row.setAttribute('aria-current', 'date');
    const word = row.querySelector<HTMLElement>('.hours-today');
    if (word) word.hidden = false;
  }
  // The Dubai list: real states once PUBLIC_DUBAI_LIST_ENDPOINT is set (no form is rendered before that).
  import { bindWaitlists } from '../../lib/waitlist';
  bindWaitlists();
</script>

<style>
  .branch { overflow-x: clip; }
  .branch :global(p) { margin: 0; }
  .lead-text { color: var(--lead-text); }

  /* Arrival. Phones: media band + facts on ink. 900px and up: media fills, text sits on a dark fade. */
  .arrival { position: relative; display: flex; flex-direction: column; color: var(--color-sand); background: var(--color-ink); overflow: hidden; }
  .arrival-media { position: relative; overflow: hidden; }
  .arrival-media.is-photo { aspect-ratio: 3 / 2; }
  .arrival-media.is-art { aspect-ratio: 4 / 3; }
  .arrival :global(.arrival-bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .arrival-shade { display: none; }
  .arrival-in { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 16px; padding-block: 0 44px; width: 100%; }
  /* The stamp sits on a dark round badge, half over the picture, half on the ink. */
  .mark-badge { display: grid; place-items: center; width: 96px; aspect-ratio: 1; margin-top: -48px; border-radius: 50%; background: var(--color-ink); box-shadow: inset 0 0 0 2px var(--color-gold), 0 10px 30px rgb(0 0 0 / 0.45); }
  .arrival-mark { display: block; width: 56%; aspect-ratio: 0.764; background: var(--lead); -webkit-mask-size: contain; mask-size: contain; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-position: center; mask-position: center; }
  .arrival-in:not(:has(.mark-badge)) { padding-top: 32px; }
  .arrival-brand { margin: 0; font-family: var(--font-label); font-size: 14px; font-weight: 700; letter-spacing: 0.28em; text-transform: uppercase; color: var(--color-sand); }
  /* Full column width so the name board can size itself to it (container units). */
  .board-slot { min-height: 1.2em; align-self: stretch; container-type: inline-size; }
  .arrival-actions { margin-top: 4px; }
  .arrival-actions:empty { display: none; }
  .hero-list { display: grid; gap: var(--space-3); width: 100%; max-width: 34rem; margin-top: var(--space-3); padding-top: var(--space-4); border-top: 1px solid var(--color-gold); --fp-fg: var(--color-sand); --fp-link: var(--color-gold); }
  .hero-list-h { margin: 0; font-family: var(--font-display); font-weight: 300; font-size: clamp(26px, 3vw, 36px); line-height: 1.1; text-transform: none; letter-spacing: var(--tracking-display); color: var(--color-sand); }
  .hero-list-note { margin: 0; font-size: 17px; line-height: 1.5; color: var(--color-sand); }
  .hero-list .fp-link { color: var(--color-gold); }
  @media (min-width: 900px) {
    /* D4: top-aligned, so a slow first paint can't slide the words up as the rest of the hero arrives. */
    .arrival { display: grid; align-items: start; min-height: min(88svh, 860px); }
    .arrival-media, .arrival-media.is-photo, .arrival-media.is-art { position: absolute; inset: 0; aspect-ratio: auto; }
    .arrival-shade { display: block; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(44 41 37 / 0.94) 0%, rgb(44 41 37 / 0.82) 34%, rgb(44 41 37 / 0.2) 64%, transparent 80%), linear-gradient(0deg, rgb(44 41 37 / 0.7), transparent 40%); }
    .arrival-in { padding-block: 64px; }
    .arrival-in > * { max-width: 560px; }
    .mark-badge { width: 112px; margin-top: 0; }
    .arrival-in:not(:has(.mark-badge)) { padding-top: 64px; }
  }
  .arrival-media.is-art + .arrival-shade { background: linear-gradient(90deg, rgb(44 41 37 / 0.85), transparent 60%); }

  /* 1024px and up: a desk spread on the 12-column grid (design-direction.md §3) instead of text over a faded photo.
     Tracks: page edge | 12 content columns | page edge. Line 2 = content start, line 14 = content end.
     Photo hero: the photo bleeds off the left edge (to the end of col 7); the name card overlaps it (cols 7–12).
     Art hero (no photo yet): words on the left (cols 1–5), the art bleeds off the right edge (col 6 on). */
  @media (min-width: 1024px) {
    .arrival {
      grid-template-columns: minmax(var(--grid-margin), 1fr) repeat(12, minmax(0, calc((var(--grid-max) - 11 * var(--grid-gutter)) / 12))) minmax(var(--grid-margin), 1fr);
      column-gap: var(--grid-gutter);
      align-items: center;
      min-height: 0;
      padding-block: var(--space-8);
    }
    .arrival-shade { display: none; }
    .arrival-media, .arrival-media.is-photo, .arrival-media.is-art { position: relative; inset: auto; grid-row: 1; height: min(76svh, 720px); min-height: 520px; }
    .arrival-media.is-photo { grid-column: 1 / 9; }
    .arrival-media.is-art { grid-column: 7 / -1; }
    /* Stretch, top-aligned: on a slow load the browser can paint before the hero's HTML has all arrived;
       a centred column would then slide up as the rest (name board, Tonight's board) streams in. */
    .arrival-in { grid-row: 1; max-width: none; margin: 0; padding: 0; z-index: 1; }
    .arrival-in.has-board { align-self: stretch; }
    .arrival-in > * { max-width: none; }
    .arrival-media.is-photo ~ .arrival-in {
      grid-column: 8 / 14;
      padding: var(--space-8) var(--space-7);
      background: var(--color-ink);
      border: 1px solid var(--color-gold);
    }
    .arrival-media.is-art ~ .arrival-in { grid-column: 2 / 7; }
    .arrival-in:not(:has(.mark-badge)) { padding-top: 0; }
    .arrival-media.is-photo ~ .arrival-in:not(:has(.mark-badge)) { padding-top: var(--space-8); }
  }
  /* Small laptops: the card takes one more column and less padding so the actions stay above the fold. */
  @media (min-width: 1024px) and (max-width: 1439px) {
    .arrival-media.is-photo { grid-column: 1 / 8; }
    .arrival-media.is-photo ~ .arrival-in { grid-column: 7 / 14; padding: var(--space-6) var(--space-5); gap: 12px; }
    .arrival-media.is-photo ~ .arrival-in:not(:has(.mark-badge)) { padding-top: var(--space-6); }
    .mark-badge { width: 88px; }
  }

  /* Soho without photos: a Westminster street sign on a dark brick wall. */
  .art-soho { background:
      radial-gradient(60% 50% at 75% 30%, color-mix(in srgb, var(--second) 40%, transparent), transparent 70%),
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.28) 0 2px, transparent 2px 34px),
      repeating-linear-gradient(90deg, rgb(0 0 0 / 0.18) 0 2px, transparent 2px 72px),
      #3a2a24; display: grid; place-items: center; padding-left: 46%; padding-right: 4vw; }
  .street-sign { position: relative; z-index: 1; display: grid; grid-template-columns: auto auto; gap: 2px 18px; align-items: end; background: #fbfaf6; color: #1b1b1b; padding: 22px 30px 18px; border: 3px solid #1b1b1b; outline: 6px solid #fbfaf6; transform: rotate(-2deg); box-shadow: 0 30px 60px rgb(0 0 0 / 0.5); font-family: system-ui, sans-serif; }
  .sign-name { font-size: clamp(24px, 3.2vw, 50px); font-weight: 700; letter-spacing: 0.01em; text-transform: uppercase; line-height: 1; }
  .sign-code { font-size: clamp(24px, 3.2vw, 50px); font-weight: 700; color: #c8102e; line-height: 1; }
  .sign-city { grid-column: 1 / -1; font-size: clamp(10px, 1vw, 14px); letter-spacing: 0.3em; text-transform: uppercase; }
  @media (max-width: 899px) { .art-soho { place-items: center; padding: 0 0 10%; } }
  .art-soho::after, .art-gate::after { content: ''; position: absolute; inset: 45% 0 0; background: linear-gradient(180deg, transparent, rgb(44 41 37 / 0.9)); }

  /* Dubai: a departure gate in slate and gold. */
  .art-gate { background: radial-gradient(70% 60% at 70% 30%, rgb(203 160 82 / 0.28), transparent 70%), linear-gradient(160deg, #5f6e79, #2c2925 75%); display: grid; place-items: center end; padding-right: 6vw; }
  @media (max-width: 899px) { .art-gate { place-items: center; padding: 0 0 10%; } }
  .gate-code { font-size: clamp(110px, 22vw, 320px); font-weight: 700; letter-spacing: 0.06em; color: transparent; -webkit-text-stroke: 2px rgb(203 160 82 / 0.7); line-height: 1; }
  /* Desk spread (1024px+): the art now has its own column, so centre it there and let the sign grow. */
  @media (min-width: 1024px) {
    .art-soho, .art-gate { place-items: center; padding: 0 var(--grid-margin) 0 var(--space-7); }
    .sign-name, .sign-code { font-size: clamp(32px, 3.8vw, 60px); }
    .sign-city { font-size: clamp(11px, 1vw, 15px); }
    .street-sign { max-width: 100%; }
    .gate-code { font-size: clamp(160px, 17vw, 260px); }
  }

  /* Chapters (Phase 6): the home rhythm. Day chapters sit on sand; Visit is night; the Dubai list is gold. */
  .chapter:not(.ink, .gold-bg) { background: var(--color-sand); color: var(--color-ink); }
  /* Two sand chapters in a row share one gap, not two paddings (the old page had 256px holes). */
  .chapter:not(.ink, .gold-bg):has(.chapter-body) + .chapter:not(.ink, .gold-bg) { padding-top: 0; }

  /* The room */
  .room-spoken { color: var(--fp-fg-muted); }
  .room-wall { display: grid; gap: var(--space-6); }
  .wall-intro { font-size: var(--step-body); font-weight: 700; }


  /* Tonight's board in the arrival: no band, no centring; it lines up with the words above it. */
  .arrival-in :global(.tonight) { align-self: stretch; background: none; padding: 0; margin-top: var(--space-5); }
  .arrival-in :global(.tonight-board) { max-width: none; margin: 0; }

  /* Born here: the ticket (the one object) beside the words. */
  .sig { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: clamp(32px, 6vw, 80px); align-items: center; }
  .sig-text { --stack: var(--space-4); }
  @media (max-width: 760px) { .sig { grid-template-columns: 1fr; } }
  .sig-ticket { position: relative; background: var(--color-paper-light); padding: 26px 26px 34px; min-height: 300px; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 18px 30px -18px rgb(0 0 0 / 0.6); border-top: 2px dashed rgb(44 41 37 / 0.4); rotate: -1.5deg; }
  .sig-no { font-family: var(--font-note); font-style: italic; font-weight: 500; font-size: 19px; color: var(--color-tiger-deep); border-bottom: 2px dotted rgb(44 41 37 / 0.4); padding-bottom: 8px; }
  .sig-name { font-size: clamp(26px, 2.6vw, 34px); font-weight: 700; text-transform: uppercase; line-height: 1.05; letter-spacing: 0.03em; }
  .sig-price { font-weight: 700; font-size: 22px; color: var(--color-tiger-deep); }
  .sig-stamp { position: absolute; right: -12px; bottom: -14px; width: 104px; }
  .teaser { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 28px; }
  .small-ticket { min-height: 220px; }
  .small-ticket:nth-child(2) { rotate: 1deg; }
  .teaser-desc { font-family: var(--font-note); font-style: italic; font-size: 18px; }
  /* Phones: the three dishes as one short ticket strip, not three tall cards. */
  @media (max-width: 700px) {
    .teaser { gap: 0; background: var(--color-paper-light); box-shadow: 0 18px 30px -18px rgb(0 0 0 / 0.6); }
    .teaser .small-ticket { min-height: 0; padding: 16px 20px; gap: 4px; box-shadow: none; rotate: none; border-top: 0; }
    .teaser .small-ticket + .small-ticket { border-top: 2px dotted rgb(44 41 37 / 0.3); }
    .teaser .sig-no { display: none; }
    .teaser .sig-name { font-size: 20px; }
    .teaser-desc { font-size: 16px; margin: 0; }
  }

  /* Visit (night): where and how on the left, the hours table on the right. */
  .visit-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: var(--space-7) var(--space-8); align-items: start; }
  .visit-hours { --stack: var(--space-4); }
  .hours-today { font-weight: 400; }

  /* Good to know: three luggage tags (the system's .fp-tag), links pinned to the foot. */
  .lug { margin: 0; padding: 0; list-style: none; }
  .lug p { margin: 0; line-height: var(--lh-body); }
  .lug .tag-link { margin-top: auto; padding-top: var(--space-2); }

  /* The other rooms: postcards (the system's .fp-postcard). */
  .other-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: var(--grid-gutter); }
  .other-no { font-weight: 700; color: var(--fp-label); font-variant-numeric: tabular-nums; }
  .other-name { font-size: clamp(30px, 3.2vw, 46px); font-weight: 700; line-height: 1; letter-spacing: -0.02em; }
  .other-go { margin-top: var(--space-2); font-weight: 700; color: var(--fp-link); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }

  /* The Dubai list (gold): the system's field, the action in ink (tiger can't sit on gold). */
  .wl-body { display: grid; gap: var(--space-4); max-width: 40rem; }
  .wl-row { display: flex; gap: var(--space-2); }
  .wl-row > .fp-input { flex: 1; min-width: 0; }
  @media (max-width: 420px) { .wl-row { flex-direction: column; } }

  /* Menus ledger: the chevron rides with the note. */
  /* Menus: two short columns of links (Phase 7 §4.2), not a 10-row ledger. */
  .menu-groups { display: grid; gap: var(--space-6) var(--space-8); max-width: 58rem; }
  @media (min-width: 640px) { .menu-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .menu-group-h { margin: 0 0 var(--space-2); font-size: var(--step-small); font-weight: 700; letter-spacing: 0; text-transform: none; color: var(--fp-fg-muted); }
  .menu-group-list { margin: 0; padding: 0; list-style: none; border-top: var(--border-rule) solid var(--fp-rule-strong); }
  .menu-group-link { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0 12px; min-height: 48px; padding-block: 10px; border-bottom: 1px solid var(--fp-rule); font-size: var(--step-h4); font-weight: 700; color: var(--fp-fg); text-decoration: none; }
  .menu-group-link:hover > span:first-child { text-decoration: underline; text-underline-offset: 5px; }
  .menu-group-note { font-size: var(--step-small); font-weight: 400; color: var(--fp-fg-muted); }

  /* What to order: captioned photographs, then the rating as a ledger fact. */
  .order-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: var(--space-6); margin: 0; padding: 0; list-style: none; }
  /* Phones: a sideways row of cards (each a link, so the row is reachable by keyboard) instead of three tall squares. */
  @media (max-width: 639px) {
    .order-grid { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 74%; gap: var(--space-4); overflow-x: auto; scroll-snap-type: x mandatory; margin-inline: calc(-1 * clamp(16px, 4vw, 40px)); padding: 0 clamp(16px, 4vw, 40px) var(--space-3); scrollbar-width: thin; }
    .order-dish { scroll-snap-align: start; scroll-margin-inline: clamp(16px, 4vw, 40px); }
  }
  .order-link { display: grid; gap: var(--space-2); color: var(--fp-fg); text-decoration: none; }
  .order-photo { display: block; aspect-ratio: 1; overflow: hidden; border: 2px solid var(--color-ink); background: var(--color-ink); }
