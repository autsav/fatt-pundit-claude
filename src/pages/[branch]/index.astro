  .order-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); column-gap: var(--space-6); row-gap: var(--space-2); margin: var(--section-gap) 0 0; padding: 0; list-style: none; }
