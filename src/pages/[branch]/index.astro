---
/**
 * One page per room: /soho/, /covent-garden/, /dubai/ (same URLs as the old site).
 * Same seven beats on every page (arrival, the room, born here, menus, visit, good to know,
 * the other rooms); what changes is the photos, colours, mark, signature moment and dish.
 * Everything printed comes from branches.json, dishes.json and menus.json.
 */
import type { GetStaticPaths, ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/site/SiteHeader.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import BranchArrival from '../../components/branch/BranchArrival.tsx';
import PlateWall from '../../components/branch/PlateWall.tsx';
import WalkTheRoom from '../../components/branch/WalkTheRoom.tsx';
import VoyageToDubai from '../../components/branch/VoyageToDubai.tsx';
import MenuBook from '../../components/scenes/MenuBook.tsx';
import LoopVideo from '../../components/site/LoopVideo.astro';
import plateWallLoop from '../../assets/video/cg-plate-wall-lamps.mp4';
import plateWallPoster from '../../assets/video/cg-plate-wall-lamps-poster.jpg';
import boothsLoop from '../../assets/video/cg-booths-glow.mp4';
import { BOOKING_NAMES, directionsUrl, dish, fullAddress, getBranches, hoursLines, menuBooks, MENU_TABS, prettyPhone, priceOf, type Branch } from '../../lib/site-data';
import stampLeft from '../../assets/images/brand/logo-stamp-distressed-left.png';
import stampRight from '../../assets/images/brand/logo-stamp-distressed-right.png';
import stampGoldArt from '../../assets/images/brand/stamp-gold.png';
import stampOrangeArt from '../../assets/images/brand/stamp-orange.png';
import frameArt from '../../assets/images/brand/frame.png';
import map from '../../assets/images/brand/map.webp';
import worldLand from '../../assets/images/brand/world-land.svg';
import shipArt from '../../assets/images/brand/ship.png';
import compassArt from '../../assets/images/brand/compass.png';

export const getStaticPaths = (async () => {
  const branches = await getBranches();
  return branches.map((b) => ({ params: { branch: b.id }, props: { b, branches } }));
}) satisfies GetStaticPaths;

interface Props {
  b: Branch;
  branches: Branch[];
}
const { b, branches } = Astro.props;
const p = b.page;
const open = b.status === 'open';

// Branch photos live in src/assets/images/<branch>/<key>.jpg (checked by validate-data).
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/{soho,covent-garden,dubai}/*.jpg', { eager: true });
const photo = (key: string) => photos[`/src/assets/images/${b.id}/${key}.jpg`]?.default;
const ALTS: Record<string, string> = {
  'gallery-01': 'Pink booths and bentwood chairs under shelves of lamps and pots, against a green plaster wall',
  'gallery-02': 'A wall of blue-and-white plates above green booths, with brass pendant lamps',
  'gallery-03': 'The bar, its shelves of bottles lit by brass lamps, with tables leading to it',
  'gallery-04': 'Arched mirrors above long teal banquettes and wooden tables',
  'gallery-05': 'A painted tiger on brick above tables with yellow chairs',
  'gallery-06': 'A pink booth against a green plaster wall, glasses set for dinner',
  'gallery-07': 'Hindi and Chinese lettering on plaster walls above teal banquettes, a red door',
  'gallery-08': 'Hindi lettering over teal banquettes and wooden tables',
};
const heroImg = p.hero && photo(p.hero) ? await getImage({ src: photo(p.hero)!, width: 2000, format: 'webp', quality: 80 }) : null;
const gallery = p.gallery.map((k) => ({ key: k, src: photo(k)!, alt: ALTS[k] ?? '' })).filter((g) => g.src);

const LEAD = { tiger: 'var(--color-tiger)', gold: 'var(--color-gold)', slate: 'var(--color-slate)' }[p.lead];
const markSrc = b.mark === 'tiger-indian' ? stampLeft : b.mark === 'tiger-chinese' ? stampRight : null;
// Brand rule: on dark, the stamp is printed in colour (negative logo), so it is drawn as a mask.
const mark = markSrc ? (await getImage({ src: markSrc, width: 240, format: 'png' })).src : null;
const img = async (src: ImageMetadata, width: number) => (await getImage({ src, width, format: 'webp', quality: 84 })).src;

// Beat 3: the dish this room is known for, or (Dubai) what is coming.
const signature = p.signature ? { ...p.signature, d: await dish(p.signature.dish) } : null;
const teaser = await Promise.all(p.teaser.map(dish));

// Covent Garden's plate wall: dishes from this kitchen, prices from the data.
const PLATES = ['momo-kid-goat', 'crackling-spinach', 'hakka-chilly-paneer-lettuce-cups', 'crunchy-pepper-crab', 'kolkata-chilli-duck', 'bombay-chilly-prawns', 'shredded-chilly-venison', 'lady-kenny', 'white-tiger'];
const plates = b.id === 'covent-garden' ? await Promise.all(PLATES.map(async (id) => { const d = await dish(id); return { id, name: d.name, price: priceOf(d) ?? undefined, kind: d.kind }; })) : [];

// Soho's walk through the room (DesignMyNight's description of the room). Photos to come.
const sohoStops = [
  { title: 'The door', note: 'On Berwick Street, just short of Oxford Street and Wardour Street.' },
  { title: 'The bar, on your left', note: 'Stools and hanging lights.' },
  { title: 'Tables for two and four', note: 'Along the right-hand wall, on a reclaimed wood and brick floor.' },
  { title: 'The graffiti wall', note: 'Chinese lettering, teal paint, tiffin carriers on the shelves.' },
  { title: 'The kitchen', note: 'At the end of the room, where the momos come from.' },
];

const books = open ? await menuBooks(b.menus) : [];
const plateWallStill = (await getImage({ src: plateWallPoster, width: 1280, format: 'webp', quality: 80 })).src;
const menuArt = { frame: frameArt.src, stampGold: await img(stampGoldArt, 220), stampOrange: await img(stampOrangeArt, 420), map: await img(map, 1000) };
const dubaiArt = { world: worldLand.src, ship: await img(shipArt, 300), stampGold: await img(stampGoldArt, 260), compass: await img(compassArt, 240) };

const others = branches.filter((o) => o.id !== b.id);
const words = open ? [b.shortName] : [b.shortName, 'The Hangout', 'Boarding soon'];
const pill = { shortName: b.shortName, timezone: b.timezone, hours: b.hours, status: b.status };
const hours = b.hours ? hoursLines(b.hours) : [];

// Search engines: one Restaurant per page.
const DAY_NAMES: Record<string, string> = { mon: 'Monday', tue: 'Tuesday', wed: 'Wednesday', thu: 'Thursday', fri: 'Friday', sat: 'Saturday', sun: 'Sunday' };
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: b.name,
  url: new URL(`/${b.id}/`, Astro.site).href,
  servesCuisine: ['Indo-Chinese', 'Hakka'],
  priceRange: '££',
  address: { '@type': 'PostalAddress', streetAddress: b.address.street, addressLocality: b.address.city, postalCode: b.address.postcode ?? undefined, addressCountry: b.address.country },
  ...(b.phone ? { telephone: b.phone } : {}),
  ...(heroImg ? { image: new URL(heroImg.src, Astro.site).href } : {}),
  ...(b.booking ? { acceptsReservations: b.booking.url } : {}),
  ...(b.hours
    ? { openingHoursSpecification: Object.entries(b.hours).flatMap(([d, spans]) => spans.map(([opens, closes]) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: DAY_NAMES[d], opens, closes }))) }
    : {}),
};
const title = open ? `Fatt Pundit ${b.shortName} · Indo-Chinese Hakka restaurant · ${b.address.street}` : `Fatt Pundit ${b.shortName} · Opening soon at ${b.address.street}`;
const description = `${p.lines.join(' ')} ${open ? `Book a table at ${fullAddress(b)}.` : 'Join the list for opening news.'}`;
---
<Base title={title} description={description} noindex>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <a class="skip" href="#visit">Skip to opening hours and directions</a>
  <SiteHeader branches={branches} current={b} />

  <main class={`branch branch-${b.id}`} style={`--lead: ${LEAD}; --second: ${p.second};`}>
    <!-- 1 · Arrival: the guest facts work before any animation. -->
    <section class="arrival" style={`view-transition-name: branch-${b.id}`} aria-labelledby="branch-title">
      {heroImg ? (
        <>
          <img class="arrival-bg" src={heroImg.src} alt={ALTS[p.hero!] ?? ''} width={heroImg.attributes.width} height={heroImg.attributes.height} fetchpriority="high" />
          {b.id === 'covent-garden' && <LoopVideo src={boothsLoop} poster={heroImg.src} label={ALTS[p.hero!] ?? ''} class="arrival-bg" />}
        </>
      ) : b.id === 'soho' ? (
        <div class="arrival-bg art-soho" aria-hidden="true">
          <div class="street-sign"><span class="sign-name">Berwick Street</span><span class="sign-code">W1</span><span class="sign-city">City of Westminster</span></div>
        </div>
      ) : (
        <div class="arrival-bg art-gate" aria-hidden="true"><span class="gate-code">DXB</span></div>
      )}
      {heroImg && <div class="arrival-shade" aria-hidden="true"></div>}
      <div class="wrap arrival-in">
        {mark && <span class="arrival-mark" aria-hidden="true" style={`-webkit-mask-image: url(${mark}); mask-image: url(${mark});`}></span>}
        <h1 id="branch-title" class="arrival-h1">Fatt Pundit <span>{b.shortName}</span></h1>
        <div aria-hidden="true" class="board-slot"><BranchArrival client:load words={words} branch={pill} /></div>
        <p class="arrival-addr">{fullAddress(b)}</p>
        <div class="row arrival-actions">
          {open && b.booking ? (
            <a class="btn btn-orange" href={b.booking.url} target="_blank" rel="noopener">Book a table</a>
          ) : (
            <a class="btn btn-orange" href="#waitlist">Join the list</a>
          )}
          {b.phone && <a class="btn btn-ghost-light" href={`tel:${b.phone}`}>Call {prettyPhone(b.phone)}</a>}
          <a class="btn btn-ghost-light" href={directionsUrl(b)} target="_blank" rel="noopener">Directions</a>
        </div>
      </div>
    </section>

    <!-- 2 · The room -->
    <section class="sec room" aria-labelledby="room-title">
      <div class="wrap stack-lg">
        <div class="stack">
          <p class="kicker lead-text">{p.opened ? `The room · since ${p.opened}` : 'The room · coming soon'}</p>
          <h2 id="room-title" class="room-lines">{p.lines.map((l) => <span>{l}</span>)}</h2>
        </div>
        {b.id === 'covent-garden' && (
          <>
            <figure class="real-wall">
              <LoopVideo src={plateWallLoop} poster={plateWallStill} label={ALTS['gallery-02']} class="real-wall-video" />
              <figcaption><span class="lead-text">The real wall</span>, on Maiden Lane. Our photo, with only the lamplight brought to life.</figcaption>
            </figure>
            <p class="wall-intro">Now turn the plates over: each one hides something from the kitchen.</p>
            <PlateWall client:visible dishes={plates} />
          </>
        )}
      </div>
    </section>
    {b.id === 'soho' && <WalkTheRoom client:visible stops={sohoStops} accent={p.second} />}
    {b.id === 'dubai' && <VoyageToDubai client:visible art={dubaiArt} />}
    {gallery.length > 0 && (
      <section class="gallery-sec" aria-label={`Photos of ${b.shortName}`}>
        <div class="wrap">
          <ul class="contact">
            {gallery.map((g, i) => (
              <li>
                <a href={g.src.src} target="_blank" rel="noopener" class="frame">
                  <Image src={g.src} alt={g.alt} widths={[360, 640]} sizes="(min-width: 900px) 25vw, 50vw" loading="lazy" />
                  <span class="frame-no">{String(i + 1).padStart(2, '0')}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- 3 · Born here / coming with us -->
    <section class="sec sand signature" aria-labelledby="sig-title">
      <div class="wrap">
        {signature ? (
          <div class="sig">
            <div class="sig-ticket">
              <p class="sig-no">{signature.label === 'only-here' ? 'Only here' : 'Born here'}</p>
              <p class="sig-name">{signature.d.name}</p>
              {priceOf(signature.d) && <p class="sig-price">{priceOf(signature.d)}</p>}
              <img src={menuArt.stampGold} alt="" class="sig-stamp" />
            </div>
            <div class="stack">
              <p class="kicker lead-text">{signature.label === 'only-here' ? `Only at ${b.shortName}` : `Born at ${b.shortName}`}</p>
              <h2 id="sig-title" class="h2">{signature.d.name}</h2>
              {signature.d.description && <p class="sig-desc">{signature.d.description}</p>}
              <p>{signature.story}</p>
              {signature.d.tags.length > 0 && <p class="tags">{signature.d.tags.join(' · ')}</p>}
            </div>
          </div>
        ) : (
          <div class="stack-lg">
            <div class="stack center">
              <p class="kicker lead-text">Coming with us</p>
              <h2 id="sig-title" class="h2">What we're packing for Dubai</h2>
              <p class="narrow">London favourites named for the Dubai opening. Prices and the full menu come with the opening date.</p>
            </div>
            <ul class="teaser">
              {teaser.map((d) => (
                <li class="sig-ticket small-ticket">
                  <p class="sig-no">From London</p>
                  <p class="sig-name">{d.name}</p>
                  {d.description && <p class="teaser-desc">{d.description}</p>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>

    <!-- 4 · The menus here -->
    {books.length > 0 && <MenuBook client:visible menus={books} art={menuArt} />}

    <!-- 5 · Visit -->
    <section id="visit" class="sec ink visit" aria-labelledby="visit-title">
      <div class="wrap visit-grid">
        <div class="stack">
          <p class="kicker gold">Visit</p>
          <h2 id="visit-title" class="h2">{b.address.street.split(',')[0]}</h2>
          <p>{fullAddress(b)}</p>
          <p class="small">Nearest {p.stations.length > 1 ? 'stations' : 'station'}: {p.stations.join(', ')}</p>
          <div class="row">
            <a class="btn btn-orange btn-sm" href={directionsUrl(b)} target="_blank" rel="noopener">Directions</a>
            {b.phone && <a class="btn btn-ghost-light btn-sm" href={`tel:${b.phone}`}>{prettyPhone(b.phone)}</a>}
            {b.email && <a class="btn btn-ghost-light btn-sm" href={`mailto:${b.email}`}>Email</a>}
          </div>
        </div>
        <div class="stack">
          <h3 class="visit-h">Opening hours</h3>
          {hours.length > 0 ? (
            <dl class="hours hours-lg" data-tz={b.timezone}>
              {hours.map((l) => (<div data-days={l.keys.join(' ')}><dt>{l.days}</dt><dd>{l.text}</dd></div>))}
            </dl>
          ) : (
            <p>Hours are announced with the opening date.</p>
          )}
          {b.booking && <p class="small">Book online with {BOOKING_NAMES[b.booking.provider]}, or call us.</p>}
          {b.groupsNote && <p class="small">{b.groupsNote}</p>}
          {b.delivery.length > 0 && (
            <p class="small">At home: {b.delivery.map((d, i) => (<>{i > 0 && ' or '}<a href={d.url} target="_blank" rel="noopener">{d.provider === 'deliveroo' ? 'Deliveroo' : 'Uber Eats'}</a></>))}</p>
          )}
        </div>
      </div>
    </section>

    <!-- 6 · Good to know (only what we actually know) -->
    {open && (
      <section class="sec good" aria-labelledby="good-title">
        <div class="wrap stack-lg">
          <h2 id="good-title" class="h2">Good to know</h2>
          <dl class="faq">
            <div><dt>Dietary menus</dt><dd>{b.menus.filter((m) => !['a-la-carte', 'drinks'].includes(m)).map((m) => MENU_TABS[m] ?? m).join(', ')}. All in the menu book above.</dd></div>
            <div><dt>Allergies</dt><dd>Tell us when you book. We work hard to avoid cross-contamination but can't promise a dish is allergen-free.</dd></div>
            <div><dt>Groups</dt><dd>{b.groupsNote ?? 'For larger tables, please call the restaurant.'}</dd></div>
          </dl>
        </div>
      </section>
    )}

    {!open && (
      <section id="waitlist" class="sec gold-bg" aria-labelledby="wl-title">
        <div class="wrap narrow stack center">
          <h2 id="wl-title" class="h2">Be first through the door</h2>
          <p>Leave your email and we'll tell you when bookings open at The Hangout.</p>
          <form class="wl-form row" data-waitlist>
            <label for="wl-email" class="sr-only">Email address</label>
            <input id="wl-email" type="email" required placeholder="you@example.com" autocomplete="email" />
            <button class="btn btn-ink" type="submit">Join the list</button>
          </form>
          <p class="small">We'll only email you about the Dubai opening. Unsubscribe any time.</p>
          <p class="wl-msg" role="status" hidden>Thanks. (Demo only: nothing was sent.)</p>
        </div>
      </section>
    )}

    <!-- 7 · The other rooms -->
    <section class="sec sand others" aria-labelledby="others-title">
      <div class="wrap stack-lg">
        <h2 id="others-title" class="h2 center">The other rooms</h2>
        <div class="other-grid">
          {others.map((o) => (
            <a class="other" href={`/${o.id}/`} style={`view-transition-name: branch-${o.id}`}>
              <span class="other-k">{o.status === 'open' ? 'Next stop' : 'Boarding soon'}</span>
              <span class="other-name">{o.shortName}</span>
              <span class="other-addr">{o.address.street}</span>
              <span class="other-go">Step inside →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter branches={branches} />
</Base>

<script>
  // Today's line in the hours list, in the branch's own time zone.
  for (const dl of document.querySelectorAll<HTMLElement>('[data-tz]')) {
    const day = new Intl.DateTimeFormat('en-GB', { timeZone: dl.dataset.tz, weekday: 'short' }).format(new Date()).slice(0, 3).toLowerCase();
    dl.querySelector(`[data-days~="${day}"]`)?.classList.add('today');
  }
  // Demo waitlist: no data leaves the page.
  for (const f of document.querySelectorAll<HTMLFormElement>('[data-waitlist]')) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const msg = f.parentElement?.querySelector<HTMLElement>('.wl-msg');
      if (msg) msg.hidden = false;
      f.reset();
    });
  }
</script>

<style>
  .branch { overflow-x: clip; }
  .branch :global(p) { margin: 0; }
  .lead-text { color: var(--lead); }

  /* Arrival */
  .arrival { position: relative; min-height: min(88svh, 860px); display: grid; align-items: end; color: var(--color-sand); background: var(--color-ink); overflow: hidden; }
  .arrival :global(.arrival-bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .arrival-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(44 41 37 / 0.15) 0%, rgb(44 41 37 / 0.35) 40%, rgb(44 41 37 / 0.92) 100%); }
  .arrival-in { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 18px; padding-block: 56px; width: 100%; }
  .arrival-mark { display: block; width: clamp(72px, 8vw, 110px); aspect-ratio: 0.764; background: var(--lead); -webkit-mask-size: contain; mask-size: contain; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; }
  .arrival-h1 { margin: 0; font-size: clamp(18px, 1.8vw, 22px); letter-spacing: 0.24em; text-transform: uppercase; color: var(--color-sand); }
  .arrival-h1 span { color: var(--lead); }
  .board-slot { min-height: 1.2em; }
  .arrival-addr { font-family: var(--font-note); font-style: italic; font-size: 20px; }
  .arrival-actions { margin-top: 6px; }

  /* Soho without photos: a Westminster street sign on a dark brick wall. */
  .art-soho { background:
      radial-gradient(60% 50% at 75% 30%, color-mix(in srgb, var(--second) 40%, transparent), transparent 70%),
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.28) 0 2px, transparent 2px 34px),
      repeating-linear-gradient(90deg, rgb(0 0 0 / 0.18) 0 2px, transparent 2px 72px),
      #3a2a24; display: grid; place-items: center; padding-left: 46%; padding-right: 4vw; }
  .street-sign { position: relative; z-index: 1; display: grid; grid-template-columns: auto auto; gap: 2px 18px; align-items: end; background: #fbfaf6; color: #1b1b1b; padding: 22px 30px 18px; border: 3px solid #1b1b1b; outline: 6px solid #fbfaf6; transform: rotate(-2deg); box-shadow: 0 30px 60px rgb(0 0 0 / 0.5); font-family: system-ui, sans-serif; }
  .sign-name { font-size: clamp(24px, 3.2vw, 50px); font-weight: 700; letter-spacing: 0.01em; text-transform: uppercase; line-height: 1; }
  .sign-code { font-size: clamp(24px, 3.2vw, 50px); font-weight: 700; color: #c8102e; line-height: 1; }
  .sign-city { grid-column: 1 / -1; font-size: clamp(10px, 1vw, 14px); letter-spacing: 0.3em; text-transform: uppercase; }
  @media (max-width: 760px) { .art-soho { place-items: start center; padding: 22% 0 0; } }
  .art-soho::after, .art-gate::after { content: ''; position: absolute; inset: 45% 0 0; background: linear-gradient(180deg, transparent, rgb(44 41 37 / 0.9)); }

  /* Dubai: a departure gate in slate and gold. */
  .art-gate { background: radial-gradient(70% 60% at 70% 30%, rgb(203 160 82 / 0.28), transparent 70%), linear-gradient(160deg, #5f6e79, #2c2925 75%); display: grid; place-items: center end; padding-right: 6vw; }
  @media (max-width: 760px) { .art-gate { place-items: start center; padding: 10% 0 0; } }
  .gate-code { font-size: clamp(110px, 22vw, 320px); font-weight: 700; letter-spacing: 0.06em; color: transparent; -webkit-text-stroke: 2px rgb(203 160 82 / 0.7); line-height: 1; }

  /* The room */
  .room-lines { margin: 0; display: flex; flex-direction: column; gap: 0.2em; font-size: clamp(30px, 4.6vw, 62px); line-height: 1.05; text-transform: uppercase; letter-spacing: 0.03em; }
  .room-lines span:nth-child(2) { color: var(--lead); }
  .room-lines span:nth-child(3) { font-family: var(--font-note); font-style: italic; text-transform: none; font-size: 0.62em; letter-spacing: 0; color: color-mix(in srgb, var(--color-ink) 75%, transparent); }

  /* The real plate wall (photo loop), above the drawn one */
  .real-wall { margin: 0; display: flex; flex-direction: column; gap: 10px; max-width: 980px; width: 100%; margin-inline: auto; }
  .real-wall :global(.real-wall-video) { display: block; width: 100%; height: auto; aspect-ratio: 1760 / 1176; object-fit: cover; border: 2px solid var(--color-gold); background: #e9e1d3; }
  .real-wall figcaption { font-family: var(--font-note); font-style: italic; font-size: 17px; }
  .wall-intro { text-align: center; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; font-size: 17px; }

  /* Contact sheet of the room's photos */
  .gallery-sec { padding-bottom: clamp(56px, 8vw, 110px); }
  .contact { list-style: none; margin: 0; padding: 14px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; background: var(--color-ink); }
  .frame { position: relative; display: block; background: #111; padding: 6px 6px 24px; }
  .frame :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; transition: filter .2s ease; }
  .frame:hover :global(img) { filter: brightness(1.08); }
  .frame-no { position: absolute; left: 8px; bottom: 4px; font-family: var(--font-label); font-weight: 700; font-size: 12px; letter-spacing: 0.2em; color: var(--color-gold); }
