  </main>

  <SiteFooter branches={branches} />
</Base>

<script>
  // Branch clock: the time and light in this restaurant's own city.
  import { clockIn, daypart, ICON, WORD } from '../../lib/clock';
  {
    const el = document.querySelector<HTMLElement>('[data-branch-clock]');
    const tick = () => {
      if (!el) return;
      const part = daypart(+el.dataset.lat!, +el.dataset.lng!);
      const hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: el.dataset.tz!, hour: 'numeric', hourCycle: 'h23' }).format(new Date()));
      document.documentElement.dataset.daypart = part;
      document.documentElement.dataset.hour = String(hour);
      el.innerHTML = `${ICON[part]}<span>Local time in ${el.dataset.name}: ${clockIn(el.dataset.tz!)}, ${WORD[part]}</span>`;
    };
    tick();
    setInterval(tick, 60_000);
  }

  // Today's row in the hours table, in the branch's own time zone: aria-current="date" plus the word.
  for (const table of document.querySelectorAll<HTMLElement>('[data-hours-tz]')) {
    const day = new Intl.DateTimeFormat('en-GB', { timeZone: table.dataset.hoursTz, weekday: 'short' }).format(new Date()).slice(0, 3).toLowerCase();
    const row = table.querySelector(`[data-days~="${day}"]`);
    if (!row) continue;
    row.setAttribute('aria-current', 'date');
    const word = row.querySelector<HTMLElement>('.hours-today');
    if (word) word.hidden = false;
  }
  // The Dubai list: posts to the endpoint when there is one, otherwise opens an email to us (said on the page).
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-waitlist-form]')) {
    const msg = form.querySelector<HTMLElement>('[data-wl-msg]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const hasEndpoint = !form.action.startsWith('mailto:');
    const say = (text: string, kind: 'error' | 'success', role: 'alert' | 'status') => {
      msg.textContent = text;
      msg.className = `fp-msg fp-msg--${kind}`;
      msg.setAttribute('role', role);
      msg.hidden = false;
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const nameEl = form.elements.namedItem('name') as HTMLInputElement;
      const emailEl = form.elements.namedItem('email') as HTMLInputElement;
      nameEl.setAttribute('aria-invalid', String(!name));
      emailEl.setAttribute('aria-invalid', String(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)));
      if (!name) { say('Enter your name.', 'error', 'alert'); nameEl.focus(); return; }
      if (emailEl.getAttribute('aria-invalid') === 'true') { say('Enter an email address like name@example.com', 'error', 'alert'); emailEl.focus(); return; }
      if (data.get('website')) { say("You're on the list.", 'success', 'status'); return; } // honeypot filled: a bot, say nothing useful
      if (btn.getAttribute('aria-busy') === 'true') return;
      if (!hasEndpoint) {
        const to = form.dataset.email!;
        const body = `Please tell me when Fatt Pundit Dubai opens.\n\nName: ${name}\nEmail: ${email}`;
        location.href = `mailto:${to}?subject=${encodeURIComponent('Dubai opening list')}&body=${encodeURIComponent(body)}`;
        say(`Your email app should open with a message to ${to}. Send it to join the list: nothing is saved until you do. No email app? Write to ${to}.`, 'success', 'status');
        return;
      }
      btn.setAttribute('aria-busy', 'true');
      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        say(`You're on the list. We'll email ${email} when Dubai takes bookings.`, 'success', 'status');
        form.reset();
        window.dispatchEvent(new CustomEvent('fp:waitlist-joined', { detail: { list: form.dataset.list } }));
      } catch {
        say("We couldn't add you. Try again in a moment.", 'error', 'alert');
      } finally {
        btn.removeAttribute('aria-busy');
      }
    });
  }
</script>

