---
/**
 * One page per room: /soho/, /covent-garden/, /dubai/ (same URLs as the old site).
 * Phase 8 (docs/redesign/phase8/plan.md): five beats, each fact once. Arrival, the facts strip, what to
 * eat (signature, photographed dishes, every menu), the room, visit and book (with the other rooms).
 * Everything printed comes from branches.json, dishes.json and menus.json.
 */
import type { GetStaticPaths, ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import NextStep from '../../components/site/NextStep.astro';
import OpenNowPill from '../../components/scenes/OpenNowPill.tsx';
import { stampSrc } from '../../lib/stamp';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/site/SiteHeader.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import { Image } from 'astro:assets';
import { dishPhoto } from '../../lib/dish-photos';
import momosChutney from '../../assets/images/journey/04-momos-chutney.jpg';
import BranchArrival from '../../components/branch/BranchArrival.tsx';
import VisitStrip from '../../components/branch/VisitStrip.astro';
import PlateWall from '../../components/branch/PlateWall.tsx';
import WalkTheRoom from '../../components/branch/WalkTheRoom.tsx';
import RoomContactSheet from '../../components/scenes/RoomContactSheet.tsx';
import TonightBoard from '../../components/branch/TonightBoard.tsx';
import { loadSpecials } from '../../lib/specials';
import { getEntry } from 'astro:content';
import LoopVideo from '../../components/site/LoopVideo.astro';
import LightsOn from '../../components/site/LightsOn.astro';
import lightsOnClip from '../../assets/video/cg-lights-on.mp4';
import lightsOffStill from '../../assets/video/cg-lights-on-off.jpg';
import lightsLitStill from '../../assets/video/cg-lights-on-lit.jpg';
import boothsLoop from '../../assets/video/cg-booths-glow.mp4';
import { TAG_LABELS } from '../../lib/format';
import { appleMapsUrl, BOOKING_NAMES, directionsUrl, dish, fullAddress, getBranches, groupRules, hoursLines, preTheatreText, MENU_TABS, priceOf, type Branch } from '../../lib/site-data';
import stampGoldArt from '../../assets/images/brand/stamp-gold.png';

export const getStaticPaths = (async () => {
  const branches = await getBranches();
  return branches.map((b) => ({ params: { branch: b.id }, props: { b, branches } }));
}) satisfies GetStaticPaths;

interface Props {
  b: Branch;
  branches: Branch[];
}
const { b, branches } = Astro.props;
const p = b.page;
const open = b.status === 'open';

// Branch photos live in src/assets/images/<branch>/<key>.jpg (checked by validate-data).
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/{soho,covent-garden,dubai}/*.jpg', { eager: true });
const photo = (key: string) => photos[`/src/assets/images/${b.id}/${key}.jpg`]?.default;
const ALTS: Record<string, string> = {
  'gallery-01': 'Pink booths and bentwood chairs under shelves of lamps and pots, against a green plaster wall',
  'gallery-02': 'A wall of blue-and-white plates above green booths, with brass pendant lamps',
  'gallery-03': 'The bar, its shelves of bottles lit by brass lamps, with tables leading to it',
  'gallery-04': 'Arched mirrors above long teal banquettes and wooden tables',
  'gallery-05': 'A painted tiger on brick above tables with yellow chairs',
  'gallery-06': 'A pink booth against a green plaster wall, glasses set for dinner',
  'gallery-07': 'Hindi and Chinese lettering on plaster walls above teal banquettes, a red door',
  'gallery-08': 'Hindi lettering over teal banquettes and wooden tables',
};
// Soho has no approved room photo yet (CLIENT-INPUTS #35, #46): its hero is the momo photograph, with
// the Berwick Street sign on it, until the shoot.
const heroSrc: ImageMetadata | null = (p.hero ? photo(p.hero) : undefined) ?? (b.id === 'soho' ? momosChutney : null);
const heroAlt = p.hero && photo(p.hero) ? ALTS[p.hero] ?? '' : 'A momo lifted out of a pot of red chutney with chopsticks';
const heroImg = heroSrc ? await getImage({ src: heroSrc, width: 2000, format: 'webp', quality: 80 }) : null;
const heroSet = heroSrc ? (await Promise.all([800, 1200, 1600, 2400].map(async (w) => `${(await getImage({ src: heroSrc, width: w, format: 'webp', quality: 80 })).src} ${w}w`))).join(', ') : undefined;
// Video poster = the 800w hero, the same file a phone picks from the srcset,
// so the poster never downloads a second, bigger copy of the photo.
const heroPoster = heroSrc ? (await getImage({ src: heroSrc, width: 800, format: 'webp', quality: 80 })).src : undefined;
const gallery = p.gallery.map((k) => ({ key: k, src: photo(k)!, alt: ALTS[k] ?? '' })).filter((g) => g.src);

const LEAD = { tiger: 'var(--color-tiger)', gold: 'var(--color-gold)', slate: 'var(--color-slate)' }[p.lead];
// Small words in the branch colour on light paper use its text-safe partner.
const LEAD_TEXT = { tiger: 'var(--color-tiger-deep)', gold: 'var(--color-gold-deep)', slate: 'var(--color-slate-deep)' }[p.lead];
const img = async (src: ImageMetadata, width: number) => (await getImage({ src, width, format: 'webp', quality: 84 })).src;
// The room's photos as the same contact sheet and lightbox the home page uses.
const thumbSet = async (src: ImageMetadata) => (await Promise.all([360, 480, 640].map(async (w) => `${await img(src, w)} ${w}w`))).join(', ');
const sheet = await Promise.all(gallery.map(async (g) => ({ thumb: await img(g.src, 640), thumbSet: await thumbSet(g.src), full: await img(g.src, 1600), alt: g.alt })));

// Beat 3: the dish this room is known for, or (Dubai) what is coming.
const signature = p.signature ? { ...p.signature, d: await dish(p.signature.dish) } : null;
// Diet marks in words, not codes: "Dairy free and halal."
const tagNames = (signature?.d.tags ?? []).map((t, i) => { const w = TAG_LABELS[t as keyof typeof TAG_LABELS] ?? t; return i ? w.toLowerCase() : w; });
const tagWords = tagNames.length ? `${tagNames.slice(0, -1).join(', ')}${tagNames.length > 1 ? ' and ' : ''}${tagNames.at(-1)}.` : '';
const teaser = await Promise.all(p.teaser.map(dish));

// Covent Garden's plate wall: dishes from this kitchen, prices from the data.
const PLATES = ['momo-kid-goat', 'crackling-spinach', 'hakka-chilly-paneer-lettuce-cups', 'crunchy-pepper-crab', 'kolkata-chilli-duck', 'bombay-chilly-prawns', 'shredded-chilly-venison', 'lady-kenny', 'white-tiger'];
const plates = b.id === 'covent-garden' ? await Promise.all(PLATES.map(async (id) => { const d = await dish(id); return { id, name: d.name, price: priceOf(d) ?? undefined, kind: d.kind }; })) : [];

// Soho's walk through the room (DesignMyNight's description of the room). Photos to come.
const sohoStops = [
  { title: 'The door', zone: 'door' as const, note: 'On Berwick Street, just short of Oxford Street and Wardour Street.' },
  { title: 'The bar, on your left', zone: 'bar' as const, note: 'Stools and hanging lights.' },
  { title: 'Tables for two and four', zone: 'tables' as const, note: 'Along the right-hand wall, on a reclaimed wood and brick floor.' },
  { title: 'The graffiti wall', zone: 'graffiti' as const, note: 'Chinese lettering, teal paint, tiffin carriers on the shelves.' },
  { title: 'The kitchen', zone: 'kitchen' as const, note: 'At the end of the room, where the momos come from.' },
];

// Menus (Phase 7 §4.2): two short groups of links, the general menus and the dietary ones.
const menuRows = open ? (await Promise.all(b.menus.map((id) => getEntry('menus', id)))).filter(Boolean).map((m) => ({ id: m!.data.id ?? m!.id, title: MENU_TABS[m!.id] ?? m!.data.title, diet: m!.data.kind === 'diet' })) : [];
const menuGroups = [
  { key: 'main', label: 'Menus', rows: menuRows.filter((m) => !m.diet) },
  { key: 'diet', label: 'Dietary', rows: menuRows.filter((m) => m.diet) },
].filter((g) => g.rows.length > 0);

// What to order (Phase 7 §4.2): dishes on this room's à la carte that have an approved photograph.
// More join as the shoot delivers them (CLIENT-INPUTS #36, #46).
const ORDER = ['crackling-spinach', 'momo-mix-vegetable', 'crispy-okra-salt-n-pepper', 'momo-kid-goat', 'popcorn-cauliflower', 'hakka-chilly-paneer-lettuce-cups', 'bombay-chilly-prawns', 'malabar-monkfish-curry'];
const alaCarte = open && b.menus.includes('a-la-carte') ? (await getEntry('menus', 'a-la-carte'))!.data.sections.flatMap((sec) => sec.items.map((i) => i.dish)) : [];
// Where each photo's dish sits in the frame, so a square crop keeps the food.
const FOCUS: Record<string, string> = { 'momo-mix-vegetable': '92% 18%', 'crispy-okra-salt-n-pepper': '62% 50%' };
const toOrder = await Promise.all(ORDER.filter((id) => alaCarte.includes(id) && dishPhoto(id)).slice(0, 6).map(async (id) => ({ id, d: await dish(id), photo: dishPhoto(id)!, focus: FOCUS[id] ?? '50% 50%' })));
const rating = p.rating;
const preTheatre = preTheatreText(b);
const wallOff = (await getImage({ src: lightsOffStill, width: 1280, format: 'webp', quality: 80 })).src;
const wallLit = (await getImage({ src: lightsLitStill, width: 1280, format: 'webp', quality: 80 })).src;
// 800w and 1024w cover phones at 2x (a 412 px screen asks for 824); the 1280w stays for wide screens.
const wallLitSet = (await Promise.all([800, 1024].map(async (w) => `${(await getImage({ src: lightsLitStill, width: w, format: 'webp', quality: 80 })).src} ${w}w`))).join(', ') + `, ${wallLit} 1280w`;
// Bulb positions (% of each photo), measured from the frames.
const WALL_LAMPS = [{ x: 10.5, y: 13.3, size: 0.6 }, { x: 65.9, y: 13.3, size: 0.6 }];
const menuArt = { stampGold: await stampSrc(stampGoldArt, 220) };

// Tonight's board: every row for this branch goes to the page; the board picks today's.
// Phase 8: sample lines never show, in the preview either; the board appears once the sheet has real lines.
const specials = open ? (await loadSpecials()).filter((r) => !r.demo && (r.branch === b.id || r.branch === 'all')) : [];
const others = branches.filter((o) => o.id !== b.id);
const words = open ? [b.shortName] : [b.shortName, 'The Hangout', 'Boarding soon'];
const pillOf = (o: Branch) => ({ shortName: o.shortName, timezone: o.timezone, hours: o.hours, status: o.status });
const pill = { shortName: b.shortName, timezone: b.timezone, hours: b.hours, status: b.status };
const hours = b.hours ? hoursLines(b.hours) : [];
// The Visit heading says how often we're open, so it doesn't repeat the address from the strip.
const daysOpen = b.hours ? (['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'] as const).filter((d) => (b.hours?.[d] ?? []).length > 0).length : 0;
const openDays = daysOpen === 7 ? 'Open every day.' : daysOpen > 0 ? `Open ${['', 'one', 'two', 'three', 'four', 'five', 'six'][daysOpen]} days a week.` : 'Opening hours.';
const rules = groupRules(b);
// The Dubai list posts to a form-to-email service once PUBLIC_DUBAI_LIST_ENDPOINT is set (CLIENT-INPUTS #5, #10).
// Until then it opens an email to the Dubai address if branches.json has one; with neither, the #waitlist block
// points to Instagram for the date (AUDIT B-06: no reservations-address fallback, that inbox is the client's call).
const listEndpoint = import.meta.env.PUBLIC_DUBAI_LIST_ENDPOINT as string | undefined;
const listEmail = b.email ?? '';

const showRoom = open || gallery.length > 0;

// Search engines: one Restaurant per page.
const DAY_NAMES: Record<string, string> = { mon: 'Monday', tue: 'Tuesday', wed: 'Wednesday', thu: 'Thursday', fri: 'Friday', sat: 'Saturday', sun: 'Sunday' };
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': new URL(`/${b.id}/#restaurant`, Astro.site).href,
  name: b.name,
  url: new URL(`/${b.id}/`, Astro.site).href,
  parentOrganization: { '@id': new URL('/#org', Astro.site).href },
  ...(open ? { hasMenu: new URL(`/${b.id}/menu/`, Astro.site).href } : {}),
  ...(b.geo ? { geo: { '@type': 'GeoCoordinates', latitude: b.geo.lat, longitude: b.geo.lng } } : {}),
  ...(b.email ? { email: b.email } : {}),
  servesCuisine: ['Indo-Chinese', 'Hakka'],
  priceRange: '££',
  address: { '@type': 'PostalAddress', streetAddress: b.address.street, addressLocality: b.address.city, postalCode: b.address.postcode ?? undefined, addressCountry: b.address.country },
  ...(b.phone ? { telephone: b.phone } : {}),
  ...(heroImg ? { image: new URL(heroImg.src, Astro.site).href } : {}),
  ...(b.booking ? { acceptsReservations: b.booking.url } : {}),
  ...(b.hours
    ? { openingHoursSpecification: Object.entries(b.hours).flatMap(([d, spans]) => spans.map(([opens, closes]) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: DAY_NAMES[d], opens, closes }))) }
    : {}),
};
const title = open ? `Fatt Pundit ${b.shortName} · Indo-Chinese Hakka restaurant · ${b.address.street}` : `Fatt Pundit ${b.shortName} · Opening soon at ${b.address.street}`;
const description = `${p.lines.join(' ')} ${open ? `Book a table at ${fullAddress(b)}.` : 'Join the list for opening news.'}`;
---
<Base title={title} description={description} og={b.id}>
  {heroImg && <link slot="head" rel="preload" as="image" imagesrcset={heroSet} imagesizes="100vw" fetchpriority="high" />}
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <a slot="skip" class="skip" href={open ? '#visit' : '#waitlist'}>{open ? 'Skip to opening hours and directions' : 'Skip to the waiting list'}</a>
  <SiteHeader branches={branches} current={b} />

  <main id="content" class={`branch branch-${b.id}`} style={`--lead: ${LEAD}; --lead-text: ${LEAD_TEXT}; --second: ${p.second};`}>
    <!-- 1 · Arrival (Phase 8): the name on the departure board is the page's one bold thing; one Book,
         one link to the menus. Today's status lives once, in the facts strip directly below. -->
    <section class="arrival" data-room-hero style={`view-transition-name: branch-${b.id}`} aria-labelledby="branch-title">
      <div class={`arrival-media ${heroImg ? 'is-photo' : 'is-art'}`}>
        {heroImg ? (
          <>
            <img class="arrival-bg" src={heroImg.src} srcset={heroSet} sizes="100vw" alt={heroAlt} width={heroImg.attributes.width} height={heroImg.attributes.height} fetchpriority="high" />
            {b.id === 'covent-garden' && <LoopVideo src={boothsLoop} poster={heroPoster!} label={heroAlt} class="arrival-bg" />}
            {b.id === 'soho' && <div class="street-sign" aria-hidden="true"><span class="sign-name">Berwick Street</span><span class="sign-code">W1</span><span class="sign-city">City of Westminster</span></div>}
          </>
        ) : (
          <div class="arrival-bg art-gate" aria-hidden="true"><span class="gate-code">DXB</span></div>
        )}
      </div>
      <div class="arrival-shade" aria-hidden="true"></div>
      <div class="wrap arrival-in">
        <h1 id="branch-title" class="sr-only">Fatt Pundit {b.shortName}</h1>
        <div class="board-slot"><BranchArrival client:idle words={words} branch={pill} pill={false} address={open ? b.address.street : undefined} /></div>
        <!-- Local time only where it's news: a room in another time zone. -->
        {b.geo && b.timezone !== 'Europe/London' && <p class="branch-clock" data-branch-clock data-tz={b.timezone} data-lat={b.geo.lat} data-lng={b.geo.lng} data-name={b.shortName}></p>}
        {open && (
          <div class="arrival-actions">
            {b.booking && <a class="fp-btn fp-btn--primary" href={b.booking.url} data-book={b.id} target="_blank" rel="noopener">Book a table</a>}
            <a class="fp-link fp-link--strong arrival-menus" href={`/${b.id}/menu/`}>See the menus</a>
          </div>
        )}
        <!-- Opening soon: the list sits in the hero, the one thing a guest can do yet (Phase 7 §4.3). -->
        {!open && (
          <div id="waitlist" class="hero-list" role="group" aria-labelledby="wl-title">
            <h2 id="wl-title" class="hero-list-h">Be first through the door</h2>
            {(listEndpoint || listEmail) ? (<form class="fp-form wl-form" data-waitlist-form data-list={b.id} data-email={listEmail} action={listEndpoint ?? `mailto:${listEmail}`} method="post" enctype={listEndpoint ? undefined : 'text/plain'} novalidate>
              <input type="hidden" name="list" value={`${b.shortName} opening`} />
              <!-- Honeypot: people never see or fill this; bots do. -->
              <div class="wl-hp" aria-hidden="true"><label>Leave this empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
              <div class="fp-field">
                <label for="wl-name" class="fp-label">Your name</label>
                <input id="wl-name" class="fp-input" name="name" type="text" required autocomplete="name" aria-describedby="wl-msg" />
              </div>
              <div class="fp-field">
                <label for="wl-email" class="fp-label">Email address</label>
                <input id="wl-email" class="fp-input" name="email" type="email" required placeholder="you@example.com" autocomplete="email" aria-describedby="wl-msg" />
              </div>
              <button class="fp-btn fp-btn--primary" type="submit">Notify me</button>
              <p id="wl-msg" data-wl-msg hidden></p>
            </form>) : null}
            <p class="fp-small">{listEndpoint ? "We'll only email you about the Dubai opening. Unsubscribe any time." : listEmail ? <>"Notify me" opens an email to {listEmail} for you to send, and we add you by hand.</> : <>The list opens soon. For the opening date, follow <a class="fp-link" href="https://www.instagram.com/fattpundit/" target="_blank" rel="noopener">@fattpundit on Instagram<span class="sr-only"> (opens in a new tab)</span></a>.</>}</p>
          </div>
        )}
      </div>
    </section>

    <!-- The facts, once: today's hours and status, address, stations, Directions and Call. -->
    <VisitStrip branch={b} stations={p.stations} />

    <!-- 2 · What to eat: the dish this room is known for, the photographed dishes, then every menu in a short ledger. -->
    <section id="eat" class="chapter eat" aria-labelledby="eat-title">
      <div class="wrap">
        <header class="b-head">
          <h2 id="eat-title" class="fp-h2">{signature ? `What to eat at ${b.shortName}.` : "What we're packing for Dubai."}</h2>
          {!signature && <p class="chapter-intro">London favourites named for the Dubai opening. Prices and the full menu come with the opening date.</p>}
        </header>
        <div class="chapter-body eat-body">
          {signature ? (
            <div class="sig">
              <div class="sig-ticket">
                <p class="sig-no">{signature.label === 'only-here' ? 'Only here' : 'Born here'}</p>
                <p class="sig-name">{signature.d.name}</p>
                {signature.d.description && <p class="sig-desc">{signature.d.description}</p>}
                {priceOf(signature.d) && <p class="sig-price fp-num">{priceOf(signature.d)}</p>}
                <img src={menuArt.stampGold} alt="" class="sig-stamp" width="508" height="564" loading="lazy" decoding="async" />
              </div>
              <div class="sig-text">
                <p class="fp-spoken">{signature.story}</p>
                {tagWords && <p class="sig-tags">{tagWords}</p>}
              </div>
            </div>
          ) : (
            <ul class="teaser">
              {teaser.map((d) => (
                <li class="sig-ticket small-ticket">
                  <p class="sig-no">From London</p>
                  <p class="sig-name">{d.name}</p>
                  {d.description && <p class="teaser-desc">{d.description}</p>}
                </li>
              ))}
            </ul>
          )}

          {toOrder.length > 0 && (
            <ul class="order-grid" role="list" aria-label={`Dishes to order at ${b.shortName}`}>
              {toOrder.map(({ d, photo: ph, focus }) => (
                <li class="order-dish">
                  <a href={`/${b.id}/menu/#a-la-carte`} class="order-link">
                    <span class="order-photo"><Image src={ph} alt="" widths={[360, 560, 800]} sizes="(min-width: 1024px) 26vw, (min-width: 640px) 33vw, 80vw" loading="lazy" style={`object-position:${focus}`} /></span>
                    <span class="order-name">{d.name}</span>
                    <span class="order-price fp-num">{priceOf(d) ?? ''}</span>
                    <span class="order-desc">{d.description ?? ''}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}

          <!-- Tonight's board: only real lines from the client's sheet, never the samples (Phase 8). -->
          {specials.length > 0 && <div class="eat-tonight"><TonightBoard client:visible branch={b.id} name={b.shortName} tz={b.timezone} rows={specials} csvUrl={import.meta.env.PUBLIC_SPECIALS_CSV_URL} /></div>}

          {menuGroups.length > 0 && (
            <dl id="menu" class="menu-ledger">
              {menuGroups.map((g) => (
                <div>
                  <dt>{g.label}</dt>
                  <dd>
                    {g.rows.map((m) => <a class="ledger-link" href={`/${b.id}/menu/#${m.id}`}>{m.title}</a>)}
                    {g.key === 'main' && preTheatre && g.rows.some((m) => m.id.includes('pre-theatre')) && <span class="ledger-note">Pre-theatre: seated {preTheatre}.</span>}
                  </dd>
                </div>
              ))}
              <div>
                <dt>Allergies</dt>
                <dd><span class="ledger-text">Tell us when you book.</span> <a class="fp-link fp-link--strong" href="/allergens/">Allergens and dietary needs</a></dd>
              </div>
            </dl>
          )}
        </div>
      </div>
    </section>

    <!-- 3 · The room (Soho's walk on night ink; Covent Garden's wall, plates and contact sheet on sand). -->
    {showRoom && <section class={`chapter room${b.id === 'soho' ? ' ink' : ''}`} aria-labelledby="room-title">
      <div class="wrap">
        <header class="b-head">
          <h2 id="room-title" class="fp-h2"><span class="sr-only">The room: </span>{p.lines[0]}</h2>
          {p.lines.length > 1 && <p class="fp-spoken room-spoken">{p.lines.slice(1).join(' ')}</p>}
        </header>
        {(b.id === 'covent-garden' || gallery.length > 0) && (
          <div class="chapter-body room-wall">
            {b.id === 'covent-garden' && (
              <>
                <LightsOn src={lightsOnClip} off={wallOff} lit={wallLit} litSet={wallLitSet} label={ALTS['gallery-02']} lamps={WALL_LAMPS} ratio={1760 / 1176} place="Maiden Lane" />
                <p class="wall-intro fp-h3">Now turn the plates over: each one hides something from the kitchen.</p>
                <PlateWall client:visible dishes={plates} />
              </>
            )}
            {gallery.length > 0 && (
              <div class="gallery-sec room-sheet" role="group" aria-label={`Photos of ${b.shortName}`}>
                <RoomContactSheet client:visible frames={sheet} picks={[]} />
              </div>
            )}
          </div>
        )}
      </div>
      {b.id === 'soho' && <div class="room-walk"><WalkTheRoom client:visible stops={sohoStops} accent={p.second} /></div>}
    </section>}

    <!-- 4 · Visit and book: the week's hours, map apps, email, delivery; the one Book with its proof and the
         group rule beside it; the other rooms last. Address, stations and Call live in the strip above. -->
    {open ? (
      <section id="visit" class="chapter visit" aria-labelledby="visit-title">
        <div class="wrap">
          <header class="b-head">
            <p class="fp-section-label b-kicker">Visit · Hours</p>
            <h2 id="visit-title" class="fp-h2"><span class="sr-only">Visit: </span>{openDays}</h2>
          </header>
          <div class="chapter-body visit-grid">
            <div class="visit-hours">
              {hours.length > 0 ? (
                <table class="fp-hours" data-hours-tz={b.timezone}>
                  <caption>Opening hours</caption>
                  <tbody>
                    {hours.map((l) => (<tr data-days={l.keys.join(' ')}><th scope="row">{l.days}<span class="hours-today" hidden> (today)</span></th><td>{l.text}</td></tr>))}
                  </tbody>
                </table>
              ) : (
                <p>Hours are announced with the opening date.</p>
              )}
              <p class="visit-links">
