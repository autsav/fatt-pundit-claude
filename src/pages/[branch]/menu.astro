---
/**
 * /<branch>/menu/ — every menu for one room as a plain, searchable list.
 * Fast to scan on a phone, filters for diets, prints cleanly, and gives
 * search engines a real menu page per branch. One menu at a time (#hash), search
 * across all of them (Phase 4, ux-structure.md D2). The page-flip book stays on home.
 */
import type { GetStaticPaths } from 'astro';
import { getEntry } from 'astro:content';
import InfoShell from '../../layouts/InfoPage.astro';
import DishPassport from '../../components/site/DishPassport.astro';
import { Image } from 'astro:assets';
import { dishPhoto } from '../../lib/dish-photos';
import { dish, getBranches, MENU_TABS, preTheatreText, priceOf, type Branch } from '../../lib/site-data';

export const getStaticPaths = (async () => {
  const branches = await getBranches();
  return branches.filter((b) => b.status === 'open').map((b) => ({ params: { branch: b.id }, props: { b } }));
}) satisfies GetStaticPaths;

const { b } = Astro.props as { b: Branch };
const menus = await Promise.all(
  b.menus.map(async (id) => {
    const m = (await getEntry('menus', id))!.data;
    return {
      id,
      title: MENU_TABS[id] ?? m.title,
      intro: m.title,
      kind: m.kind,
      allergyNote: m.allergyNote,
      sections: await Promise.all(
        m.sections.map(async (sec) => ({
          title: sec.title,
          note: sec.note,
          items: await Promise.all(
            sec.items.map(async ({ dish: did }) => {
              const d = await dish(did);
              return { id: did, name: d.name, desc: d.description ?? '', price: m.showPrices ? priceOf(d) : null, tags: d.tags as string[], sig: !!d.signature, photo: d.signature ? dishPhoto(did) : undefined };
            }),
          ),
        })),
      ),
    };
  }),
);
// The menu switcher's two groups: general menus, then the dietary ones.
const groups = [
  { key: 'menus', label: 'Menus', items: menus.filter((m) => m.kind !== 'diet') },
  { key: 'diet', label: 'For dietary needs', items: menus.filter((m) => m.kind === 'diet') },
].filter((g) => g.items.length > 0);
const preTheatre = preTheatreText(b);
const TAGS = [
  ['V', 'Vegetarian'],
  ['VG', 'Vegan'],
  ['GF', 'Gluten free'],
  ['DF', 'Dairy free'],
  ['H', 'Halal'],
] as const;

// Search engines: the menu as schema.org Menu → sections → items.
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `Fatt Pundit ${b.shortName} menus`,
  url: new URL(`/${b.id}/menu/`, Astro.site).href,
  isPartOf: { '@id': new URL(`/${b.id}/#restaurant`, Astro.site).href },
  hasMenuSection: menus.map((m) => ({
    '@type': 'MenuSection',
    name: m.title,
    hasMenuItem: m.sections.flatMap((s) => s.items).map((i) => ({ '@type': 'MenuItem', name: i.name, ...(i.desc ? { description: i.desc } : {}) })),
  })),
};
---
<InfoShell
  title={`${b.shortName} menu`}
  description={`Every Fatt Pundit ${b.shortName} menu as a list: à la carte, set and pre-theatre menus, drinks, with vegetarian, vegan, gluten-free, dairy-free and halal marks.`}
  kicker={`Fatt Pundit ${b.shortName}`}
  heading={`${b.shortName} menus`}
  wide
  branch={b.id}
  crumbs={[{ href: `/${b.id}/`, label: b.shortName }, { label: 'Menus' }]}
  next={{
    label: 'Ready?',
    title: `Book at ${b.shortName}.`,
    line: b.address.street,
    actions: [
      { href: b.booking!.url, label: `Book at ${b.shortName}`, primary: true, book: b.id, external: true },
      { href: '#', label: 'Print this menu', print: true },
      { href: `/${b.id}/`, label: `Back to ${b.shortName}` },
    ],
    photo: dishPhoto('crispy-okra-salt-n-pepper'),
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="menu-layout" data-menu-layout>
  <!-- One-menu mode starts before the tools are parsed, so a slow connection never paints the full chip
       list (or no menu button) first and then shifts (CLS 0.18 on slow 4G before this). -->
  <script is:inline>
    (function () {
      document.currentScript.parentElement.classList.add('js-one');
      // A link straight to one menu (#drinks): show that one while the page arrives, not the first.
      var h = location.hash.slice(1);
      if (/^[a-z0-9-]+$/.test(h)) {
        var s = document.createElement('style');
        s.textContent = '.js-one:not(.js-ready) [data-menu-block]{display:none}.js-one:not(.js-ready) #' + h + '{display:block}';
        document.head.appendChild(s);
      }
    })();
  </script>
  <div class="menu-tools" data-menu-tools>
    <div class="menu-pickbar">
      <!-- Phones: one button names the menu you're reading and opens the list of menus. Shown by the script. -->
      <button type="button" class="menu-pick" data-menu-pick aria-expanded="false" aria-controls="menu-nav">Menu: <b data-menu-current>{menus[0]?.title}</b></button>
      <nav class="menu-jump" id="menu-nav" aria-label="Menus">
        {groups.map((g) => (
          <div class="mj-group">
            <p class="tool-lab" id={`mj-${g.key}`}>{g.label}</p>
            <ul aria-labelledby={`mj-${g.key}`}>
              {g.items.map((m) => <li><a href={`#${m.id}`} data-menu-link>{m.title}</a></li>)}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="menu-filter">
    <label class="menu-search">
      <span class="tool-lab">Search all menus</span>
      <input class="fp-input" type="search" placeholder="momo, chilli, paneer" data-menu-q autocomplete="off" />
    </label>
    <fieldset class="menu-diet">
      <legend class="tool-lab">Show only</legend>
      {TAGS.map(([t, label]) => <label class="fp-choice"><input type="checkbox" value={t} data-menu-tag /><span><b>{t}</b> {label}</span></label>)}
    </fieldset>
    <p class="menu-count" data-menu-count aria-live="polite"></p>
    <p class="menu-hint" data-menu-hint hidden>There's also a full <a href="#" data-menu-hint-link></a>.</p>
    <p class="menu-passport-tip" data-pp-tip>Tap the stamp beside a dish to collect it: your passport becomes tonight's shortlist, ready to show your server or send to the table. <button type="button" class="fp-btn fp-btn--text tip-x" data-pp-tip-x>Got it</button></p>
    <!-- Hidden before paint once dismissed, so the menu never jumps up. -->
    <script is:inline>try{if(localStorage.getItem('fp-pp-tip'))document.currentScript.previousElementSibling.hidden=true}catch(e){}</script>
    </div>
  </div>
  <div class="menu-list">

  {menus.map((m) => (
    <section class="menu-block" id={m.id} aria-labelledby={`${m.id}-h`} data-menu-block>
      <h2 id={`${m.id}-h`}>{m.title}</h2>
      {m.intro !== m.title && <p class="menu-intro">{m.intro}</p>}
      {m.kind === 'pre-theatre' && preTheatre && <p class="menu-intro">Seated between {preTheatre}.</p>}
      {m.sections.map((s) => (
        <div class="menu-sec" data-menu-sec>
          <h3>{s.title}</h3>
          {s.note && <p class="menu-note">{s.note}</p>}
          <ul>
            {s.items.map((i) => (
              <li class:list={['menu-item', { 'has-photo': i.photo }]} data-dish={i.id} data-tags={i.tags.join(' ')} data-text={`${i.name} ${i.desc}`.toLowerCase()}>
                {i.photo && <Image class="mi-photo" src={i.photo} alt="" width={112} height={112} loading="lazy" />}
                <div class:list={['mi-head', { 'mi-head--long': (i.price ?? '').length > 8 }]}>
                  <span class="mi-name">{i.name}{i.sig && <span class="mi-sig"> Born here</span>}</span>
                  {i.tags.length > 0 && <span class="mi-tags"><span aria-hidden="true">{i.tags.join(' · ')}</span><span class="sr-only">{i.tags.map((t) => TAGS.find(([k]) => k === t)?.[1] ?? t).join(', ')}</span></span>}
                  {i.price && <span class="mi-price">{i.price}</span>}
                </div>
                {i.desc && <p class="mi-desc">{i.desc}</p>}
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="menu-allergy">{m.allergyNote} <a href="/allergens/">Allergens and dietary needs</a>.</p>
    </section>
  ))}
  <!-- One menu at a time once the script runs; before it does, this picks the menu from the address so nothing jumps. -->
  <script is:inline>
    (function () {
      var l = document.querySelector('[data-menu-layout]'), bs = l.querySelectorAll('[data-menu-block]');
      var sel = document.getElementById(location.hash.slice(1));
      if (!sel || !sel.hasAttribute('data-menu-block')) sel = bs[0];
      l.classList.add('js-one', 'js-ready'); sel.classList.add('is-sel');
    })();
  </script>
  <div class="menu-empty" data-menu-empty hidden>
    <p data-menu-empty-text>No dishes match.</p>
    <p class="menu-empty-acts"><button type="button" class="fp-btn fp-btn--sm" data-menu-clear>Clear filters</button><button type="button" class="fp-btn fp-btn--sm" data-menu-all>Search all menus</button></p>
  </div>
  <DishPassport branch={b.id} name={b.shortName} />
  </div>
  </div>
</InfoShell>

<style>
  /* Phase 6: the page sits on the document desk (InfoPage layout="wide"). The tools are plain type on
     sand with the system's field and chips; the menu itself is the page's one object, the printed sheet. */
  .menu-tools { position: relative; z-index: 5; display: grid; gap: var(--space-3); margin-bottom: var(--space-4); }
  .menu-jump { display: grid; gap: 8px; }
  .mj-group { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .mj-group ul { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .menu-jump a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; border: 2px solid var(--color-ink); background: var(--color-paper-light); font-size: var(--step-small); font-weight: 700; text-decoration: none; color: var(--color-ink); white-space: nowrap; }
  .menu-jump a[aria-current='true'] { background: var(--color-ink); color: var(--color-sand); }
  .menu-search { display: grid; gap: var(--space-2); }
  .menu-diet { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; border: 0; padding: 0; margin: 0; min-width: 0; }
  .menu-diet legend { float: left; margin-right: 4px; padding: 0; }
  .menu-tools > * { min-width: 0; }
  .tool-lab { flex: none; margin: 0 4px 0 0; font-size: var(--step-small); font-weight: 700; color: var(--fp-fg); white-space: nowrap; }
  .menu-count { margin: 0; font-size: var(--step-small); min-height: 1em; font-weight: 700; }
  .menu-hint { margin: 0; font-size: var(--step-small); }
  .menu-hint a, .menu-empty a { color: var(--fp-link); font-weight: 700; }
  /* Body face, not Lora: its fallback is width-matched, so the tip keeps its line count when fonts land (D3). */
  .menu-passport-tip { margin: 0; font-size: var(--step-small); color: var(--fp-fg-muted); }
  .menu-pick { display: none; }
  /* One menu at a time (Phase 4 D2). Without JavaScript every menu shows, as before. */
  .js-one.js-ready [data-menu-block]:not(.is-sel):not(.is-match) { display: none; }
  /* While the page is still arriving, only the first menu shows (the chosen one is picked at the end). */
  .js-one:not(.js-ready) [data-menu-block] ~ [data-menu-block] { display: none; }

  /* The printed menu: paper, an ink edge and a hard shadow. Phones: edge to edge. */
  .menu-list { min-width: 0; padding: clamp(20px, 4vw, 48px); background: var(--color-paper-light); border: 2px solid var(--color-ink); box-shadow: 8px 8px 0 var(--color-ink); }
  @media (max-width: 639px) { .menu-list { margin-inline: calc(-1 * clamp(16px, 4vw, 40px)); border-inline: 0; box-shadow: none; } }

  /* Phones and tablets: the menu button stays under the header; the list of menus opens beneath it. */
  @media (max-width: 899px) {
    .menu-tools { display: contents; }
    .menu-tools > * { margin-top: 10px; }
    .js-one .menu-pickbar { position: sticky; top: var(--menu-bar, 56px); z-index: 6; margin: 10px calc(-1 * clamp(16px, 4vw, 40px)) 0; padding: 8px clamp(16px, 4vw, 40px); background: var(--color-sand); border-bottom: 2px solid var(--color-ink); }
    .js-one .menu-pick { display: flex; width: 100%; align-items: center; gap: 8px; min-height: 48px; padding: 0 14px; border: 2px solid var(--color-ink); background: var(--color-paper-light); color: var(--color-ink); font: inherit; font-size: 17px; cursor: pointer; }
    .js-one .menu-pick::after { content: ""; margin-left: auto; width: 8px; height: 8px; border: solid currentColor; border-width: 0 2px 2px 0; transform: translateY(-2px) rotate(45deg); }
    .js-one .menu-pick[aria-expanded='true']::after { transform: translateY(2px) rotate(-135deg); }
    .js-one .menu-jump { display: none; }
    .js-one .menu-jump.is-open { display: grid; position: absolute; left: clamp(16px, 4vw, 40px); right: clamp(16px, 4vw, 40px); top: calc(100% - 2px); max-height: 70svh; overflow-y: auto; padding: 14px; gap: 14px; background: var(--color-paper-light); border: 2px solid var(--color-ink); box-shadow: 6px 6px 0 var(--color-ink); }
    .js-one .menu-jump.is-open .mj-group { display: block; }
    .js-one .menu-jump.is-open ul { display: grid; gap: 0; margin-top: 4px; }
    .js-one .menu-jump.is-open a { width: 100%; border: 0; border-bottom: 1px dotted rgb(44 41 37 / 0.4); font-size: 17px; }
    .menu-block { scroll-margin-top: 140px; }
    .menu-list { margin-top: var(--space-5); }
  }
  .menu-block { padding-top: 0; scroll-margin-top: 200px; }
  .menu-block + .menu-block { margin-top: var(--space-8); }
  .menu-block h2 { margin: 0 0 6px; font-size: clamp(24px, 4vw, 32px); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 3px double var(--color-ink); padding-bottom: 8px; }
  .menu-intro, .menu-note { font-family: var(--font-note); font-style: italic; }
  .menu-sec h3 { margin: 22px 0 6px; font-size: 16px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-tiger-deep); }
  .menu-sec ul { list-style: none; padding: 0; margin: 0; }
  .menu-item { padding: 10px 0; border-bottom: 1px dotted rgb(44 41 37 / 0.4); }
  /* Name | price | passport stamp on the first line (a grid, so a long name wraps inside its own column
     instead of pushing the stamp onto a line of its own); diet marks on the second line. */
  .menu-item { container-type: inline-size; }
  .mi-head { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; grid-template-areas: 'name price stamp' 'tags tags tags'; align-items: baseline; gap: 2px 12px; }
  .mi-name { grid-area: name; font-weight: 700; font-size: 18px; }
  .mi-sig { font-size: 12px; font-weight: 700; color: var(--color-tiger-deep); white-space: nowrap; }
  .mi-tags { grid-area: tags; font-size: 13px; letter-spacing: 0.06em; color: var(--fp-fg-muted); }
  .mi-price { grid-area: price; font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .mi-head :global(.pp-stamp) { grid-area: stamp; align-self: center; }
  /* D1: a long price ("Veg £13, Chicken or beef £15") on a narrow row drops under the name, right-aligned,
     and may wrap, so the name never shrinks to a column of single letters. */
  @container (max-width: 560px) {
    .mi-head--long { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'name stamp' 'price .' 'tags tags'; }
    .mi-head--long .mi-price { justify-self: end; text-align: right; white-space: normal; }
  }
  .menu-item.has-photo { display: grid; grid-template-columns: 56px minmax(0, 1fr); column-gap: 14px; align-items: start; }
  .menu-item.has-photo > :not(.mi-photo) { grid-column: 2; }
  .mi-photo { grid-row: 1 / span 2; width: 56px; height: 56px; border-radius: 50%; object-fit: cover; border: 2px solid var(--color-ink); }
  .mi-desc { margin: 2px 0 0 !important; font-size: 16px; }
  .tip-x { min-height: 32px; padding: 0 4px; font-style: normal; }
  .menu-allergy { margin-top: 16px !important; font-size: 14px; }
  .menu-allergy a { color: var(--color-tiger-deep); font-weight: 700; }
  .menu-empty { margin-top: 24px; padding: 16px 18px; border-left: 4px solid var(--color-tiger-deep); background: var(--color-paper); }
  .menu-empty p { margin: 0 0 10px !important; font-family: var(--font-note); font-style: italic; }
  .menu-empty .menu-empty-acts { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 !important; font-style: normal; }
  [hidden] { display: none !important; }
  /* Tablet landscape: the tools ride along under the header while you read. */
  @media (min-width: 900px) and (max-width: 1023px) and (min-height: 700px) { .menu-tools { position: sticky; top: 66px; padding-block: var(--space-3); background: var(--color-sand); border-bottom: 2px solid var(--color-ink); } }
  .menu-filter { display: grid; gap: var(--space-3); min-width: 0; }
  @media (max-width: 899px) { .menu-filter { display: contents; } }
  /* Desktop: the menu index rides in the label rail like a contents list (3 of 12 columns); search and
     "Show only" sit as a toolbar above the printed menu, so the rail never outgrows the screen. */
  @media (min-width: 1024px) {
    .menu-layout { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); grid-template-rows: auto 1fr; gap: var(--space-6) calc(var(--grid-gutter) * 2); align-items: start; }
    .menu-tools { display: contents; }
    .menu-pickbar { grid-column: 1; grid-row: 1 / 3; position: sticky; top: 92px; padding-top: var(--space-3); border-top: var(--border-rule) solid var(--fp-rule-strong); max-height: calc(100svh - 120px); overflow-y: auto; }
    .menu-filter { grid-column: 2; grid-row: 1; max-width: 860px; padding-top: var(--space-3); border-top: var(--border-rule) solid var(--fp-rule-strong); grid-template-columns: minmax(0, 22rem) minmax(0, 1fr); gap: var(--space-3) var(--space-6); align-items: start; }
    .menu-filter > :not(.menu-search, .menu-diet) { grid-column: 1 / -1; }
    .menu-list { grid-column: 2; grid-row: 2; }
    .menu-jump { gap: 12px; }
    .mj-group { display: block; }
    .mj-group ul { display: grid; gap: 0; border-top: 1px solid var(--fp-rule); }
    .menu-jump a { width: 100%; border: 0; border-bottom: 1px solid var(--fp-rule); background: none; padding: 0 2px; font-size: 15px; }
    .menu-jump a:hover { text-decoration: underline; text-underline-offset: 4px; }
    .menu-jump a[aria-current='true'] { background: none; color: var(--color-ink); box-shadow: inset 4px 0 0 var(--color-ink); padding-left: 12px; }
    .menu-list { max-width: 860px; }
    .menu-block { scroll-margin-top: 100px; }
    .menu-block h2 { font-size: 40px; }
  }
  @media print {
    :global(.bar), :global(.preview-flag), :global(footer.foot), :global(.skip), :global(.crumbs), .menu-tools, .menu-empty, :global([data-dock]) { display: none !important; }
    :global(.info) { padding: 0 !important; background: none !important; }
    .menu-list { border: 0 !important; box-shadow: none !important; padding: 0 !important; margin: 0 !important; }
    .menu-block + .menu-block { break-before: page; }
    .menu-item { break-inside: avoid; }
  }
</style>

<script>
  // One menu at a time, chosen by the address (#vegan), so Back works and links can be shared.
  // Search looks across every menu; diet filters apply to the menu shown (or to all, on request).
  const layout = document.querySelector<HTMLElement>('[data-menu-layout]')!;
  const blocks = [...layout.querySelectorAll<HTMLElement>('[data-menu-block]')];
  const items = [...layout.querySelectorAll<HTMLElement>('[data-dish]')];
  const links = [...layout.querySelectorAll<HTMLAnchorElement>('[data-menu-link]')];
  const q = layout.querySelector<HTMLInputElement>('[data-menu-q]')!;
  const tags = [...layout.querySelectorAll<HTMLInputElement>('[data-menu-tag]')];
  const count = layout.querySelector<HTMLElement>('[data-menu-count]')!;
  const empty = layout.querySelector<HTMLElement>('[data-menu-empty]')!;
  const emptyText = layout.querySelector<HTMLElement>('[data-menu-empty-text]')!;
  const allBtn = layout.querySelector<HTMLButtonElement>('[data-menu-all]')!;
  const clearBtn = layout.querySelector<HTMLButtonElement>('[data-menu-clear]')!;
  const hint = layout.querySelector<HTMLElement>('[data-menu-hint]')!;
  const hintLink = layout.querySelector<HTMLAnchorElement>('[data-menu-hint-link]')!;
  const pick = layout.querySelector<HTMLButtonElement>('[data-menu-pick]')!;
  const nav = layout.querySelector<HTMLElement>('#menu-nav')!;
  const current = layout.querySelector<HTMLElement>('[data-menu-current]')!;
  const NAME = Object.fromEntries(links.map((a) => [a.hash.slice(1), a.textContent ?? '']));
  const DIET: Record<string, string> = { VG: 'vegan', GF: 'gluten-free', DF: 'dairy-free', H: 'halal' };
  let everyMenu = false;
  pick.hidden = false;

  const selected = () => blocks.find((b) => b.id === location.hash.slice(1))?.id ?? blocks[0].id;
  const run = () => {
    const words = q.value.toLowerCase().split(/\s+/).filter(Boolean);
    const need = tags.filter((t) => t.checked).map((t) => t.value);
    const all = everyMenu || words.length > 0;
    const sel = selected();
    const hit = new Set<string>();
    let shown = 0;
    for (const li of items) {
      const blk = li.closest<HTMLElement>('[data-menu-block]')!;
      const have = (li.dataset.tags ?? '').split(' ');
      const ok = (all || blk.id === sel) && need.every((t) => have.includes(t)) && words.every((w) => li.dataset.text!.includes(w));
      li.hidden = !ok;
      if (ok) { shown++; hit.add(blk.id); }
    }
    for (const sec of layout.querySelectorAll<HTMLElement>('[data-menu-sec]')) sec.hidden = !sec.querySelector('[data-dish]:not([hidden])');
    for (const blk of blocks) {
      blk.classList.toggle('is-sel', !all && blk.id === sel);
      blk.classList.toggle('is-match', all && hit.has(blk.id));
      blk.hidden = !hit.has(blk.id);
    }
    for (const a of links) a.setAttribute('aria-current', String(!all && a.hash.slice(1) === sel));
    current.textContent = all ? 'All menus' : NAME[sel];
    const filtering = words.length > 0 || need.length > 0;
    count.textContent = !filtering ? '' : shown === 0 ? 'No dishes match' : all ? `${shown} dish${shown === 1 ? '' : 'es'} in ${hit.size} menu${hit.size === 1 ? '' : 's'}` : `${shown} dish${shown === 1 ? '' : 'es'}`;
    empty.hidden = shown > 0;
    emptyText.textContent = `No dishes match${words.length ? ` "${q.value.trim()}"` : ''}${need.length ? ` with ${need.join(', ')} on` : ''}${all ? '' : ` in the ${NAME[sel]} menu`}.`;
    allBtn.hidden = all;
    clearBtn.hidden = !filtering;
    // A diet filter on a general menu: point to the full dietary menu when this room has one.
    const diet = need.length === 1 ? DIET[need[0]] : undefined;
    hint.hidden = !(diet && !all && diet !== sel && NAME[diet]);
    if (!hint.hidden) { hintLink.href = `#${diet}`; hintLink.textContent = `${NAME[diet!]} menu`; }
  };
  const show = (id: string) => {
    everyMenu = false;
    if (q.value) q.value = '';
    history.pushState(null, '', `#${id}`);
    run();
    nav.classList.remove('is-open'); pick.setAttribute('aria-expanded', 'false');
    document.getElementById(id)?.scrollIntoView({ block: 'start' });
  };
  layout.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('[data-menu-link], [data-menu-hint-link]');
    if (!a) return;
    e.preventDefault();
    show(a.hash.slice(1));
  });
  pick.addEventListener('click', () => {
    const open = !nav.classList.contains('is-open');
    nav.classList.toggle('is-open', open);
    pick.setAttribute('aria-expanded', String(open));
    if (open) nav.querySelector<HTMLElement>('[aria-current="true"]')?.focus();
  });
  nav.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav.classList.contains('is-open')) { nav.classList.remove('is-open'); pick.setAttribute('aria-expanded', 'false'); pick.focus(); } });
  allBtn.addEventListener('click', () => { everyMenu = true; run(); q.focus(); });
  clearBtn.addEventListener('click', () => { q.value = ''; tags.forEach((t) => (t.checked = false)); everyMenu = false; run(); q.focus(); });
  layout.querySelector('[data-pp-tip-x]')?.addEventListener('click', () => {
    const tip = layout.querySelector<HTMLElement>('[data-pp-tip]')!;
    try { localStorage.setItem('fp-pp-tip', '1'); } catch {}
    tip.hidden = true;
    q.focus();
  });
  q.addEventListener('input', () => { if (!q.value) everyMenu = false; run(); });
  tags.forEach((t) => t.addEventListener('change', run));
  addEventListener('popstate', () => { everyMenu = false; run(); });
  addEventListener('hashchange', () => { everyMenu = false; run(); });
  run();
  if (location.hash) document.getElementById(selected())?.scrollIntoView({ block: 'start' });
</script>
