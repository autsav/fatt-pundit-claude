---
/**
 * Groups (ux-structure.md §5, W6). There is no private dining (owner, 25 Nov 2026): big tables and set feasts
 * only; /private-dining/ redirects here (vercel.json). What's possible per room first (from branches.json
 * `groups`), then an enquiry that ends in a clear outcome.
 * Sending: PUBLIC_FORM_ENDPOINT (a form-to-email service, e.g. Formspree or Web3Forms) receives a normal
 * POST and emails the restaurant; the page shows "Enquiry sent" or keeps everything if it fails.
 * Until it is set there is no form (a form posting to mailto: is an insecure-form warning, AUDIT B-16): each
 * room offers "Email us" and a call. The service routes by the `restaurant` field on its side; the page sends
 * no inbox address (set the per-restaurant rules in the form service, CLIENT-INPUTS #5).
 * Arriving from the Book drawer, ?branch=&date=&guests=&time= fill the form in.
 */
import InfoPage from '../layouts/InfoPage.astro';
import tables from '../assets/images/covent-garden/gallery-04.jpg';
import setTable from '../assets/images/covent-garden/gallery-06.jpg';
import { Image } from 'astro:assets';
import { getBranches, groupRules, prettyPhone } from '../lib/site-data';
const open = (await getBranches()).filter((b) => b.status === 'open' && b.email);
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;
const setFrom = open[0]?.groups?.setMenuFrom ?? 8;
---
<InfoPage title="Groups" description="Birthdays, team dinners and big tables at Fatt Pundit Soho and Covent Garden. Send us your date and numbers." kicker="Bring everyone" heading="Groups" layout="full"
  intro="Big tables and set feasts for birthdays, team dinners and celebrations. Tell us the date and how many of you there are, and the restaurant will come back to you with what's possible."
  next={{ label: 'See the rooms', title: 'Two rooms in London.', line: 'Long banquettes at Covent Garden, the bar and the kitchen at Soho.', actions: [...open.map((b) => ({ href: `/${b.id}/`, label: b.shortName }))], photo: tables }}>
  <figure class="pd-photo">
    <Image src={setTable} alt="A pink booth against a green plaster wall, glasses set for dinner" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1240px) 1160px, 100vw" loading="eager" />
    <figcaption>Covent Garden, set for dinner.</figcaption>
  </figure>
  <!-- Phones and tablets: the form is far down, so one tap takes you there. -->
  <p class="pd-jump"><a class="fp-btn fp-btn--primary" href="#enquiry-title">Send an enquiry</a></p>
  <div class="pd">
  <section class="pd-rules" aria-labelledby="rules-h">
    <h2 id="rules-h" class="fp-h4">What's possible</h2>
    <ul class="fp-ledger rules" role="list">
      {open.map((b) => {
        const r = groupRules(b)!;
        return (
          <li>
            <strong class="fp-ledger-name">{b.shortName}</strong>
            <span>{r.online}{r.call && ` ${r.call}`} {r.setMenu}</span>
            <a class="fp-link fp-link--strong" href={`/${b.id}/menu/#set-menu`}>See the {b.shortName} set menu</a>
          </li>
        );
      })}
    </ul>
    <p class="pd-deposit">{groupRules(open[0])?.deposit} Ask about space for your group when you call or write.</p>
    <h2 class="fp-h4 pd-other-h">Prefer to talk?</h2>
    <ul class="fp-ledger pd-other" role="list">
      {open.map((b) => (
        <li><strong>{b.shortName}</strong><a class="fp-link fp-link--strong" href={`tel:${b.phone}`}>Call {prettyPhone(b.phone!)}</a><a class="fp-link pd-mail" href={`mailto:${b.email}`}>{b.email}</a></li>
      ))}
    </ul>
  </section>

  <section class="pd-sheet surface-paper-light" aria-labelledby="enquiry-title">
  <h2 id="enquiry-title" class="pd-sheet-h">Send an enquiry</h2>
  {!endpoint && (
    <div class="pd-contact">
      <p>Tell the restaurant your date, how many of you there are and anything we should know, and they'll come back to you with what's possible.</p>
      {open.map((b) => (
        <div class="pd-contact-room" data-contact-room>
          <p class="fp-h4">{b.shortName}</p>
          <div class="pd-contact-acts">
            <a class="fp-btn fp-btn--primary" href={`mailto:${b.email}?subject=${encodeURIComponent('Group enquiry')}`}>Email us<span class="sr-only"> at {b.shortName}</span></a>
            {b.phone && <a class="fp-btn" href={`tel:${b.phone}`}>Call {prettyPhone(b.phone)}</a>}
          </div>
        </div>
      ))}
    </div>
  )}
  {endpoint && <div class="status-slot" data-enquiry-top></div>}
  {endpoint && <form class="fp-form enquiry" data-enquiry aria-labelledby="enquiry-title" novalidate
    action={endpoint} method="post" data-endpoint="">
    <input type="hidden" name="_subject" value="Group enquiry" data-subject />
    <fieldset class="fp-fieldset">
      <legend class="fp-legend">Which restaurant?</legend>
      <div class="fp-choices">
        {open.map((b, i) => (
          <label class="fp-choice"><input type="radio" name="restaurant" value={b.shortName} data-id={b.id} data-email={b.email} data-phone={b.phone} data-phone-pretty={b.phone ? prettyPhone(b.phone) : undefined} data-tz={b.timezone} data-grid={b.booking?.slotGrid ?? 'opening'} data-hours={JSON.stringify(b.hours)} checked={i === 0} /><span>{b.shortName}</span></label>
        ))}
      </div>
    </fieldset>
    <div class="fp-form-row">
      <div class="fp-field">
        <label class="fp-label" for="eq-date">Date</label>
        <select class="fp-input" id="eq-date" name="date" required aria-describedby="eq-date-msg" data-eq-day><option value="">Choose a day</option></select>
        <p class="fp-msg fp-msg--error" id="eq-date-msg" hidden></p>
      </div>
      <div class="fp-field">
        <label class="fp-label" for="eq-guests">Guests</label>
        <input class="fp-input" id="eq-guests" name="guests" type="number" inputmode="numeric" min="5" max="200" required aria-describedby="eq-guests-msg eq-guests-hint" />
        <p class="fp-hint" id="eq-guests-hint">{setFrom} or more: set feast</p>
        <p class="fp-msg fp-msg--error" id="eq-guests-msg" hidden></p>
      </div>
    </div>
    <div class="fp-field">
      <label class="fp-label" for="eq-time">Time (optional)</label>
      <select class="fp-input" id="eq-time" name="time" data-eq-time><option value="">Any time</option></select>
    </div>
    <div class="fp-form-row">
      <div class="fp-field">
        <label class="fp-label" for="eq-name">Your name</label>
        <input class="fp-input" id="eq-name" name="name" autocomplete="name" required aria-describedby="eq-name-msg" />
        <p class="fp-msg fp-msg--error" id="eq-name-msg" hidden></p>
      </div>
      <div class="fp-field">
        <label class="fp-label" for="eq-email">Email</label>
        <input class="fp-input" id="eq-email" name="email" type="email" autocomplete="email" required aria-describedby="eq-email-msg" />
        <p class="fp-msg fp-msg--error" id="eq-email-msg" hidden></p>
      </div>
    </div>
    <div class="eq-trap" aria-hidden="true"><label>Leave this empty<input name="company" tabindex="-1" autocomplete="off" data-eq-trap /></label></div>
    <div class="fp-field">
      <label class="fp-label" for="eq-phone">Phone (optional)</label>
      <input class="fp-input" id="eq-phone" name="phone" type="tel" autocomplete="tel" />
    </div>
    <div class="fp-field">
      <label class="fp-label" for="eq-notes">The occasion, dietary needs, anything else (optional)</label>
      <textarea class="fp-input" id="eq-notes" name="notes" rows="4"></textarea>
    </div>
    <div>
      <button class="fp-btn fp-btn--primary" type="submit" data-enquiry-send>Send enquiry</button>
    </div>
    <p class="fp-hint">We'll reply by email as soon as we can.</p>
  </form>}
  </section>
  </div>
</InfoPage>

<style>
  /* Phones: what's possible, then the form. 1024+: rules (4 of the 10 columns) beside the form sheet (6). */
  .pd { display: grid; gap: var(--section-gap) var(--grid-gutter); align-items: start; }
  .pd-photo { margin: 0 0 var(--space-6); }
  .pd-photo :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 21 / 9; object-fit: cover; object-position: 50% 60%; border: 2px solid var(--color-ink); }
  .pd-photo figcaption { margin-top: var(--space-2); font-family: var(--font-note); font-style: italic; font-size: var(--step-small); }
  @media (max-width: 639px) { .pd-photo :global(img) { aspect-ratio: 4 / 3; } }
  .pd-jump { margin: 0 0 var(--space-6); }
  @media (min-width: 1024px) { .pd-jump { display: none; } }
  #enquiry-title { scroll-margin-top: 96px; }
  @media (min-width: 1024px) {
    .pd { grid-template-columns: repeat(10, minmax(0, 1fr)); }
    .pd-rules { grid-column: 1 / 5; position: sticky; top: 96px; }
    .pd-sheet { grid-column: 5 / 11; }
  }
  .pd-rules { display: grid; gap: var(--space-4); min-width: 0; font-size: var(--step-body); line-height: var(--lh-body); }
  .pd-rules p, .pd-rules h2 { margin: 0; }
  .rules, .pd-other { margin: 0; padding: 0; }
  .rules li { display: grid; gap: var(--space-1); padding-block: var(--space-4); }
  .pd-other-h { margin-top: var(--space-4) !important; }
  .pd-other li { display: flex; flex-wrap: wrap; gap: 0 var(--space-4); align-items: baseline; padding-block: var(--space-2); }
  .pd-other strong { min-width: 8em; }
  .pd-mail { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; overflow-wrap: anywhere; }
  /* The form is the page's one object: a sheet of paper. */
  .pd-sheet { display: grid; gap: var(--space-5); min-width: 0; padding: clamp(20px, 4vw, 48px); border: 2px solid var(--color-ink); box-shadow: 8px 8px 0 var(--color-ink); }
  @media (max-width: 639px) { .pd-sheet { box-shadow: 5px 5px 0 var(--color-ink); } }
  .pd-sheet-h { margin: 0; font-size: var(--step-h3); font-weight: 300; text-transform: none; line-height: 1.1; letter-spacing: var(--tracking-display); }
  .eq-trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .status-slot:empty { display: none; }
  .pd-contact { display: grid; gap: var(--space-5); }
  .pd-contact > p { margin: 0; }
  .pd-contact-room { display: grid; gap: var(--space-3); padding-top: var(--space-4); border-top: var(--border-rule) solid var(--fp-rule); }
  .pd-contact-room .fp-h4 { margin: 0; }
  .pd-contact-acts { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .status-slot :global(ul) { margin: 6px 0 0 !important; padding-left: 1.2em; }
  .status-slot :global(a) { color: inherit !important; }
</style>

<script>
  import { addDays, hhmm, local, prettyMin, slots, type Span, type SlotGrid } from '../lib/booking';
  const formEl = document.querySelector<HTMLFormElement>('[data-enquiry]');
  // The form exists only with PUBLIC_FORM_ENDPOINT set (AUDIT B-16).
  if (formEl) {
  const form: HTMLFormElement = formEl;
  const top = document.querySelector<HTMLElement>('[data-enquiry-top]')!;
  const send = form.querySelector<HTMLButtonElement>('[data-enquiry-send]')!;
  const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;

  // Arriving from the Book drawer: room, date, guests and time are already chosen.
  const q = new URLSearchParams(location.search);
  const room = q.get('branch');
  if (room) form.querySelectorAll<HTMLInputElement>('input[name="restaurant"]').forEach((r) => (r.checked = r.dataset.id === room));
  const picked = () => form.querySelector<HTMLInputElement>('input[name="restaurant"]:checked')!;

  // Date: the next 60 days as "Sat 29 Nov" (en-GB), submitted as YYYY-MM-DD.
  const daySel = form.querySelector<HTMLSelectElement>('[data-eq-day]')!;
  const timeSel = form.querySelector<HTMLSelectElement>('[data-eq-time]')!;
  const today = local(picked().dataset.tz!).ymd;
  for (let i = 0; i < 60; i++) {
    const ymd = addDays(today, i);
    daySel.add(new Option(new Date(`${ymd}T12:00:00Z`).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }), ymd));
  }
  // Time: the chosen room's opening hours that day, every half hour.
  const fillTimes = () => {
    const keep = timeSel.value, r = picked();
    const hours = JSON.parse(r.dataset.hours || 'null') as Record<string, Span[]> | null;
    const all = hours && daySel.value ? slots(hours, r.dataset.tz!, daySel.value, r.dataset.grid as SlotGrid) : [];
    timeSel.replaceChildren(new Option(daySel.value && !all.length ? 'Closed that day' : 'Any time', ''), ...all.map((m) => new Option(prettyMin(m), hhmm(m))));
    if (all.some((m) => hhmm(m) === keep)) timeSel.value = keep;
  };
  daySel.addEventListener('change', fillTimes);
  form.querySelectorAll('input[name="restaurant"]').forEach((r) => r.addEventListener('change', fillTimes));
  for (const k of ['date', 'guests']) { const v = q.get(k); if (v) field(k).value = v; }
  fillTimes();
  { const v = q.get('time'); if (v) timeSel.value = v; }

  // Messages say what to do. Checked on submit, then re-checked as the guest types (never on blur: lesson 63).
  const RULES: [string, (i: HTMLInputElement) => string][] = [
    ['date', (i) => (!i.value ? 'Choose a day' : '')],
    ['guests', (i) => (!i.value ? 'Enter how many guests' : Number(i.value) < 5 ? 'Enter 5 or more guests (for fewer, book a table)' : '')],
    ['name', (i) => (!i.value.trim() ? 'Enter your name' : '')],
    ['email', (i) => (!i.value.trim() ? 'Enter your email address' : !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(i.value.trim()) ? 'Enter an email address like name@example.com' : '')],
  ];
  const mark = (name: string, msg: string) => {
    const i = field(name);
    const out = document.getElementById(`eq-${name}-msg`)!;
    i.setAttribute('aria-invalid', String(Boolean(msg)));
    out.textContent = msg;
    out.hidden = !msg;
  };
  const check = () => RULES.map(([n, f]) => { const msg = f(field(n)); mark(n, msg); return [n, msg] as const; }).filter(([, m]) => m);
  for (const [n, f] of RULES) field(n).addEventListener('input', () => { if (field(n).getAttribute('aria-invalid') === 'true') mark(n, f(field(n))); });

  const status = (kind: 'error' | 'success' | 'info', html: string, role: 'alert' | 'status') => {
    top.innerHTML = `<div class="fp-status fp-msg fp-msg--${kind}" role="${role}" tabindex="-1">${html}</div>`;
    const box = top.firstElementChild as HTMLElement;
    box.focus();
    return box;
  };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (send.getAttribute('aria-busy') === 'true') return;
    const bad = check();
    if (bad.length) {
      status('error', `<strong>${bad.length === 1 ? '1 thing' : `${bad.length} things`} to fix</strong><ul>${bad.map(([n, m]) => `<li><a href="#eq-${n}">${esc(m)}</a></li>`).join('')}</ul>`, 'alert');
      return;
    }
    const pick = picked();
    const d = new FormData(form);
    const date = new Date(`${d.get('date')}T12:00`).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    const summary = `${pick.value} · ${date}${d.get('time') ? ` at ${timeSel.selectedOptions[0].text}` : ''} · ${d.get('guests')} guests`;
    const subject = `Group enquiry: ${d.get('guests')} guests on ${date} at ${pick.value}`;
    // Honeypot: a bot fills the hidden field; it sees "sent" and nothing is delivered.
    if (d.get('company')) { form.hidden = true; status('success', '<strong>Enquiry sent</strong>', 'status'); return; }
    form.querySelector<HTMLInputElement>('[data-subject]')!.value = subject;
    d.set('_subject', subject);
    // No inbox address from the page: the form service routes by the `restaurant` field (server-side rule).
    send.setAttribute('aria-busy', 'true');
    try {
      const res = await fetch(form.action, { method: 'POST', body: d, headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      form.hidden = true;
      const call = pick.dataset.phone ? `<p>Need an answer sooner? <a href="tel:${esc(pick.dataset.phone)}">Call ${esc(pick.dataset.phonePretty ?? pick.dataset.phone)}</a>.</p>` : '';
      status('success', `<strong>Enquiry sent</strong><span>You sent: ${esc(summary)}.</span> <span>We'll reply by email to ${esc(String(d.get('email')))}.</span>${call}`, 'status');
      window.dispatchEvent(new CustomEvent('fp:enquiry-sent', { detail: { branch: pick.dataset.id } }));
    } catch {
      status('error', `<strong>We couldn't send this</strong>Everything you typed is still here. Try again, or email <a href="mailto:${esc(pick.dataset.email!)}">${esc(pick.dataset.email!)}</a>.`, 'alert');
    } finally {
      send.removeAttribute('aria-busy');
    }
  });
  }
</script>
