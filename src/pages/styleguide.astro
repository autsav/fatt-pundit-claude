---
// Internal check page: proves fonts, brand tokens, images and menu data all load.
// Not linked anywhere and marked noindex. Delete before launch or keep behind auth.
import { Font, Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import '../styles/global.css';
import stamp from '../assets/images/brand/logo-stamp-distressed-left.png';
import { formatPrice, TAG_LABELS } from '../lib/format';

const branches = (await getCollection('branches')).sort((a, b) => a.data.order - b.data.order);
const menu = await getEntry('menus', 'a-la-carte');
if (!menu) throw new Error('a-la-carte menu missing');
const dishes = new Map((await getCollection('dishes')).map((d) => [d.id, d.data]));

const swatches = [
  ['ink', '#2C2925', 'bg-ink text-sand'],
  ['tiger', '#F15D3D', 'bg-tiger text-ink'],
  ['gold', '#CBA052', 'bg-gold text-ink'],
  ['sand', '#DAC7B5', 'bg-sand text-ink border border-ink'],
  ['slate', '#758591', 'bg-slate text-sand'],
] as const;
---
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Styleguide · Fatt Pundit</title>
    <Font cssVariable="--font-typewriter" preload />
    <Font cssVariable="--font-lora" />
  </head>
  <body class="mx-auto max-w-5xl px-6 py-12">
    <header class="flex items-center gap-6">
      <Image src={stamp} alt="Fatt Pundit stamp logo: a tiger in a turban inside a postage-stamp frame" width={120} />
      <div>
        <h1 class="text-4xl">Fatt Pundit</h1>
        <p class="note mt-2 text-lg">Styleguide and data check</p>
      </div>
    </header>

    <section class="mt-12">
      <h2 class="text-2xl">Type</h2>
      <p class="mt-4 font-display text-5xl font-bold uppercase tracking-[0.1em]">This is the main title</p>
      <p class="mt-2 text-2xl font-bold">This is a subtitle</p>
      <p class="mt-2 max-w-prose">Body copy in American Typewriter Regular. Originating from Kolkata, this unique cuisine was invented when the Hakka people migrated to India from the Chinese province of Canton. £7.50 · AED 45 · ’ “ ” é</p>
      <p class="mt-2 font-light">Light weight for long captions.</p>
      <p class="mt-2 font-label text-xl font-bold uppercase">Condensed bold — labels and stamps</p>
      <p class="note mt-2">You can easily add some notes too! (Lora Medium Italic)</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl">Colour</h2>
      <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-5">
        {swatches.map(([name, hex, cls]) => (
          <li class={`rounded p-4 ${cls}`}><span class="font-bold">{name}</span><br />{hex}</li>
        ))}
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl">Branches</h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-3">
        {branches.map(({ data: b }) => (
          <li class="border-2 border-ink p-4">
            <p class="font-bold uppercase">{b.shortName}</p>
            <p>{b.address.street}, {b.address.city} {b.address.postcode}</p>
            <p class="note">{b.status === 'opening-soon' ? 'Opening soon' : b.timezone}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl">{menu.data.title}</h2>
      {menu.data.sections.map((s) => (
        <div class="mt-6">
          <h3 class="text-xl">{s.title}</h3>
          {s.note && <p class="note mt-1 max-w-prose">{s.note}</p>}
          <ul class="mt-3 space-y-2">
            {s.items.map(({ dish }) => {
              const d = dishes.get(dish)!;
              const price = d.price ? formatPrice(d.price, 'GBP') : d.options?.map((o) => `${o.label} ${formatPrice(o.price, 'GBP')}`).join(' / ');
              return (
                <li class="flex justify-between gap-4 border-b border-ink/20 pb-2">
                  <span>
                    <span class="font-bold uppercase">{d.name}</span>
                    {d.description && <span> – {d.description}</span>}
                    {d.tags.length > 0 && <span class="ml-2 text-sm" title={d.tags.map((t) => TAG_LABELS[t]).join(', ')}>({d.tags.join(', ')})</span>}
                  </span>
                  <span class="shrink-0 font-bold">{price}</span>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
      <p class="note mt-8 max-w-prose text-sm">{menu.data.allergyNote}</p>
    </section>
  </body>
</html>
