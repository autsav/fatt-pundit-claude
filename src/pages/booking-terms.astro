---
import InfoPage from '../layouts/InfoPage.astro';
import { BOOKING_NAMES, getBranches, groupRules, prettyPhone } from '../lib/site-data';
const launched = import.meta.env.PUBLIC_LAUNCH === 'true';
const open = (await getBranches()).filter((b) => b.status === 'open');
// Deposit and group rules are the same at both rooms today; printed once from the first room's data.
const rules = groupRules(open[0]);
---
<InfoPage title="Booking terms" description="Booking a table at Fatt Pundit Soho or Covent Garden: groups, deposits, changes and lateness." kicker="Your table" heading="Booking terms"
  summary={rules ? [rules.deposit, rules.setMenu, 'Plans change? Tell us as early as you can, using your confirmation or by phone.'] : undefined}
  questions={{ related: [{ href: '/book/', label: 'Book a table' }, { href: '/private-dining/', label: 'Plan a group' }] }}>
  <p>Book online or by phone.</p>
  {open.map((b) => {
    const r = groupRules(b);
    return (
      <>
        <h2>{b.shortName}</h2>
        <ul>
          {b.booking && <li>Online through {BOOKING_NAMES[b.booking.provider]}: <a href={b.booking.url} target="_blank" rel="noopener">book {b.shortName}<span class="sr-only"> (opens in a new tab)</span></a>.</li>}
          {b.phone && <li>By phone: <a href={`tel:${b.phone}`}>{prettyPhone(b.phone)}</a>.</li>}
          {r && <li>{r.online}{r.call && ` ${r.call}`}</li>}
        </ul>
      </>
    );
  })}
  {rules && (
    <>
      <h2>Deposits</h2>
      <p>{rules.deposit} The same at both restaurants.</p>
      <h2>Groups</h2>
      <p>{rules.setMenu} <a href="/private-dining/">Send a group enquiry</a> or call the restaurant, and ask us about space for your group.</p>
    </>
  )}
  <h2>Changes and lateness</h2>
  <p>Plans change: please let us know as early as you can, using the link in your confirmation or by phone, so we can give the table to someone else.</p>
  {!launched && <p class="todo">Draft: hold time for late arrivals to be confirmed by Fatt Pundit.</p>}
</InfoPage>
