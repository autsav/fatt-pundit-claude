---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#2c2925" />
    <Font cssVariable="--font-typewriter" preload />
    <Font cssVariable="--font-typewriter-condensed" />
    <Font cssVariable="--font-lora" />
  </head>
  <body>
    <slot />
  </body>
</html>
