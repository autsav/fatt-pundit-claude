---
import { Font, getImage } from 'astro:assets';
// Tiger-orange stamp (alpha of the distressed logo): reads on light and dark tabs.
import stamp from '../assets/images/brand/logo-stamp-tiger.png';
import Analytics from '../components/site/Analytics.astro';
import '../styles/global.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  /** Hide this page from search even after launch. */
  noindex?: boolean;
  /** Share card id: public/og/<id>.png (made by scripts/make-og.mjs). */
  og?: string;
  /** Text pages: also preload the regular cut, so paragraphs do not re-wrap (layout shift) when it lands. */
  preloadBody?: boolean;
}
const { title, description, noindex = false, og = 'home', preloadBody = false } = Astro.props;
// Until launch the whole site is a preview: hidden from search, banner on.
// Set PUBLIC_LAUNCH=true in the host's build settings on launch day.
const launched = import.meta.env.PUBLIC_LAUNCH === 'true';
const hide = noindex || !launched;
const site = Astro.site ?? new URL('https://www.fattpundit.co.uk');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(`/og/${og}.png`, site).href;
const icon = await getImage({ src: stamp, width: 64, format: 'png' });
const touchIcon = await getImage({ src: stamp, width: 180, format: 'png' });
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {hide && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#2c2925" />
    <link rel="icon" type="image/png" href={icon.src} />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fatt Pundit" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A Fatt Pundit boarding pass with the tiger stamp" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // The guest's own "Pause motion" choice (footer button), applied before first paint.
      try { if (localStorage.getItem('fp-motion') === 'paused') document.documentElement.dataset.motion = 'paused'; } catch (e) {}
    </script>
    <script is:inline>
      // A fresh visit starts at the top. Some in-app viewers keep the last page's scroll offset,
      // which landed guests at the bottom of a shorter page. Back/forward and #links keep theirs.
      (() => {
        const nav = performance.getEntriesByType('navigation')[0];
        if ((nav && nav.type !== 'navigate') || location.hash) return;
        let touched = false;
        for (const t of ['wheel', 'touchstart', 'keydown', 'pointerdown']) addEventListener(t, () => (touched = true), { once: true, passive: true });
        const top = () => { if (!touched && scrollY > 0) { scrollTo({ top: 0, behavior: 'instant' }); window.__lenis?.scrollTo(0, { immediate: true }); } };
        addEventListener('DOMContentLoaded', top);
        addEventListener('pagereveal', top);
        addEventListener('load', () => { top(); setTimeout(top, 300); });
      })();
    </script>
    <script>
      import { initSmoothScroll } from '../lib/smooth-scroll';
      initSmoothScroll();
    </script>
    <script is:inline>
      // Page-to-page morphs: when the browser skips one (fast double click, calm mode), stay quiet.
      for (const t of ['pageswap', 'pagereveal']) addEventListener(t, (e) => { const v = e.viewTransition; if (v) for (const k of ['ready', 'finished', 'updateCallbackDone']) v[k]?.catch(() => {}); });
    </script>
    <!-- Preload only the bold cut: it sets every title on the first screen. -->
    <Font cssVariable="--font-typewriter" preload={preloadBody ? [{ weight: 700 }, { weight: 400 }] : [{ weight: 700 }]} />
    <!-- Lora italic sets the hero line and every board status: load it with
         the first paint so lines don't re-wrap (layout shift) when it lands. -->
    <Font cssVariable="--font-lora" preload />
    <slot name="head" />
    <Analytics />
    <!-- Instant page changes (Chrome/Edge): a branch page is rendered in the
         background once the guest hovers its link (desktop) or it sits on
         screen (phones). Other browsers ignore this and load normally. -->
    <script type="speculationrules" is:inline>
      {"prerender":[{"where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":"/our-story/"}},{"not":{"selector_matches":"[target=_blank], [download], [href*='#'], [rel~=nofollow]"}}]},"eagerness":"moderate"},{"where":{"href_matches":"/our-story/"},"eagerness":"conservative"}]}
    </script>
  </head>
  <body>
    <a class="skip" href="#footer">Skip to footer</a>
    <slot />
  </body>
</html>
