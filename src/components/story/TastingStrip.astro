---
/**
 * "Come and taste the rest": six dishes as a menu-card grid of uniform 4:5 photo prints (.fp-print: paper border),
 * cropped from the original dish photos (src/assets/images/story/menu-cards/, cut with sharp from assets/images/).
 * Names and one-liners come from src/data/dishes.json via site-data, so they stay true to the menu.
 * Static tilt per card; one rise as each card scrolls in (gated like global.css "Story scenes"); no scroller, no glide.
 */
import { getImage } from 'astro:assets';
import { dish } from '../../lib/site-data';
import crab from '../../assets/images/story/menu-cards/crunchy-pepper-crab.webp';
import kenny from '../../assets/images/story/menu-cards/lady-kenny.webp';
import rabbit from '../../assets/images/story/menu-cards/rabbit-wontons.webp';
import hakka from '../../assets/images/story/menu-cards/vegetable-hakka-noodles.webp';
import brownie from '../../assets/images/story/menu-cards/sizzling-brownie.webp';
import tea from '../../assets/images/story/menu-cards/saffron-masala-tea.webp';

const cards: [ImageMetadata, string][] = [
  [crab, 'crunchy-pepper-crab'], [kenny, 'lady-kenny'], [rabbit, 'rabbit-wontons'],
  [hakka, 'vegetable-hakka-noodles'], [brownie, 'snowflake-gelato-sizzling-brownie'], [tea, 'saffron-masala-tea'],
];
// Never wider than the source (Lady Kenny's crop is 600 px, the brownie's 740).
const items = await Promise.all(cards.map(async ([src, id]) => {
  const d = await dish(id);
  const widths = [360, 720, 960].filter((w) => w <= src.width);
  const imgs = await Promise.all(widths.map((width) => getImage({ src, width, format: 'webp', quality: 80 })));
  return { name: d.name, text: d.description, src: imgs[0].src, srcset: imgs.map((i, n) => `${i.src} ${widths[n]}w`).join(', ') };
}));
---

<ul class="menu-cards" aria-label="A taste of the menu">
  {items.map((it) => (
    <li>
      <figure class="dish">
        <div class="fp-print"><img src={it.src} srcset={it.srcset} sizes="(max-width: 899px) 45vw, 360px" width="4" height="5" alt="" loading="lazy" decoding="async" /></div>
        <figcaption><span class="dish-name">{it.name}</span>{it.text && <span class="dish-line">{it.text}</span>}</figcaption>
      </figure>
    </li>
  ))}
</ul>

<style>
  .menu-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6) var(--space-4); align-items: start; width: min(1120px, calc(100vw - 2 * var(--gutter, 16px))); margin: var(--space-4) 0; padding: 0; list-style: none; }
  @media (min-width: 900px) { .menu-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-7) clamp(var(--space-6), 4vw, 64px); } }
  .dish { margin: 0; display: grid; gap: var(--space-3); text-align: center; }
  .fp-print { padding: var(--space-3); }
  .fp-print img { height: auto; aspect-ratio: 4 / 5; filter: sepia(0.14) saturate(0.93) contrast(1.03); }
  @media (max-width: 639px) { .fp-print { padding: var(--space-2); } }
  .dish-name { display: block; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: var(--tracking-title); font-size: clamp(15px, 1.6vw, 20px); line-height: 1.1; text-wrap: balance; }
  .dish-line { display: block; margin-top: 4px; font-family: var(--font-note); font-style: italic; font-weight: 500; font-size: clamp(15px, 1.4vw, 17px); line-height: 1.3; text-wrap: balance; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; }
  /* A hand-laid spread: one small fixed tilt per print. */
  li:nth-child(3n + 1) .fp-print { rotate: -1.5deg; }
  li:nth-child(3n + 2) .fp-print { rotate: 0.8deg; }
  li:nth-child(3n) .fp-print { rotate: -0.6deg; }
  /* One rise as each card scrolls in: only where scroll timelines run, motion is welcome and the comic is not chosen. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(:root:not([data-story='comic'])) .dish { animation: dish-rise linear both; animation-timeline: view(block); animation-range: entry 0% entry 60%; }
    }
  }
  @keyframes dish-rise { from { opacity: 0; transform: translateY(32px); } to { opacity: 1; transform: none; } }
</style>
