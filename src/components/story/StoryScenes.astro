---
/**
 * Chapter one of the story as two scroll-driven scenes (the "paper puppet theatre", step 1).
 *
 * Each scene is a tall track with a sticky stage inside; cut-out layers move with the scroll through a
 * named view timeline on the track (CSS only, transform/opacity, plus the route's dashoffset). The
 * timelines, gate and keyframes live in global.css "Story scenes" (the scoped pipeline drops
 * animation-timeline nested in @supports/@media). Captions and bubbles are live text from
 * src/data/story.ts and share the comic's styles.
 *
 * Gate: with view timelines and no reduced-motion preference the scenes show and the comic's chapter 1
 * is hidden. Otherwise the scenes are display:none and the comic tells chapter 1 as before.
 * The root carries the chapter's anchor (#canton) in both modes; the comic renders its chapter 1 without it.
 */
import { getImage } from 'astro:assets';
import { chapters, type Panel } from '../../data/story';
import ship from '../../assets/images/brand/ship.png';
import mountainsB from '../../assets/images/brand/mountains-b.png';
import mountainsC from '../../assets/images/brand/mountains-c.png';
import compass from '../../assets/images/brand/compass.png';
import map from '../../assets/images/brand/map.webp';
import seaUrl from '../../assets/images/brand/voyage-sea.svg?url';

const chapter = chapters[0];
const panel = (id: string): Panel => {
  const p = chapter.panels.find((x) => x.id === id);
  if (!p) throw new Error(`StoryScenes: panel ${id} not found in chapter ${chapter.id}`);
  return p;
};
const harbour = panel('p01-harbour');
const packing = panel('p02-packing');
const atSea = panel('p03-at-sea');
// One sentence for screen readers: the first of the panel's scene note (it describes what is drawn here;
// the second sentence is about Fatt, whom the illustrator will add later).
const firstSentence = (s: string) => (s.match(/^.*?[.!?](?=\s|$)/)?.[0] ?? s);

// The ship and compass start off-screen sideways, where lazy loading never fires, so they load eagerly
// at low priority (a few KB). Sized webp sources, as StoryComic does. The brand cut-outs are small, so widths stop at the file's own.
const pic = async (src: ImageMetadata, widths: number[]) => {
  const ws = [...new Set([...widths.filter((w) => w < src.width), src.width])];
  const imgs = await Promise.all(ws.map((w) => getImage({ src, width: w, format: 'webp', quality: 72 })));
  return { src: imgs[imgs.length - 1].src, srcset: imgs.map((m, i) => `${m.src} ${ws[i]}w`).join(', '), w: src.width, h: src.height };
};
const [shipImg, mtnB, mtnC, compassImg, mapImg] = await Promise.all([
  pic(ship, [100]),
  pic(mountainsB, [180]),
  pic(mountainsC, [120]),
  pic(compass, [90]),
  pic(map, [800, 1400, 2000]),
]);
// The sea chart is a whole world; the strip shows only open Indian Ocean (an SVG view fragment).
const seaStrip = `${seaUrl}#svgView(viewBox(391,1324,1004,150);preserveAspectRatio(xMidYMid%20slice))`;
---

<div id={chapter.id} class="scenes-anchor">
  <div class="story-scenes" data-scenes>
    <header class="ch-head">
      <p class="ch-no">Chapter one</p>
      <h2 id={`${chapter.id}-scenes-title`} class="ch-title">{chapter.title}</h2>
    </header>

    <section class="scene scene-harbour" aria-label={chapter.label}>
      <div class="scene-stage">
        <p class="sr-only">{firstSentence(harbour.scene)}</p>
        <div class="layer sh-sun" aria-hidden="true"></div>
        <img class="layer sh-mtn-c" src={mtnC.src} srcset={mtnC.srcset} sizes="min(40vw, 460px)" width={mtnC.w} height={mtnC.h} alt="" loading="lazy" decoding="async" />
        <img class="layer sh-mtn-b" src={mtnB.src} srcset={mtnB.srcset} sizes="min(58vw, 640px)" width={mtnB.w} height={mtnB.h} alt="" loading="lazy" decoding="async" />
        <img class="layer scene-sea" src={seaStrip} alt="" loading="lazy" decoding="async" />
        <img class="layer scene-ship sh-ship" src={shipImg.src} srcset={shipImg.srcset} sizes="(max-width: 599px) 46vw, min(26vw, 300px)" width={shipImg.w} height={shipImg.h} alt="" loading="eager" fetchpriority="low" decoding="async" />
        <img class="layer sh-compass" src={compassImg.src} srcset={compassImg.srcset} sizes="110px" width={compassImg.w} height={compassImg.h} alt="" loading="eager" fetchpriority="low" decoding="async" />
        <div class="scene-text">
          <p class="cap sh-cap1">{harbour.caption}</p>
          <p class="cap sh-cap2">{packing.caption}</p>
        </div>
        {harbour.bubbles?.slice(0, 1).map((b) => (
          <p class="bubble tail-left scene-bubble sh-bubble"><span class="sr-only">{b.who} says: </span>{b.text}</p>
        ))}
      </div>
    </section>

    <section class="scene scene-sea-night" aria-label="At sea">
      <div class="scene-stage">
        <p class="sr-only">{firstSentence(atSea.scene)}</p>
        <img class="layer ss-map" src={mapImg.src} srcset={mapImg.srcset} sizes="100vw" width={mapImg.w} height={mapImg.h} alt="" loading="lazy" decoding="async" />
        <img class="layer scene-sea" src={seaStrip} alt="" loading="lazy" decoding="async" />
        <div class="layer ss-night" aria-hidden="true"></div>
        <svg class="layer ss-route" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <defs>
            <mask id="scene-route-reveal" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
              <path class="ss-route-draw" d="M88 30 C 72 14, 56 42, 40 30 S 22 26, 16 34" pathLength="1" />
            </mask>
          </defs>
          <path class="ss-route-line" d="M88 30 C 72 14, 56 42, 40 30 S 22 26, 16 34" mask="url(#scene-route-reveal)" />
        </svg>
        <p class="ss-place" aria-hidden="true"><span class="ss-dot"></span>Calcutta</p>
        <img class="layer ss-compass" src={compassImg.src} srcset={compassImg.srcset} sizes="96px" width={compassImg.w} height={compassImg.h} alt="" loading="eager" fetchpriority="low" decoding="async" />
        <div class="layer ss-ship-track" aria-hidden="true">
          <img class="scene-ship ss-ship" src={shipImg.src} srcset={shipImg.srcset} sizes="(max-width: 599px) 46vw, min(26vw, 300px)" width={shipImg.w} height={shipImg.h} alt="" loading="eager" fetchpriority="low" decoding="async" />
        </div>
        <div class="scene-text">
          <p class="cap ss-cap">{atSea.caption}</p>
        </div>
        {atSea.bubbles?.slice(0, 1).map((b) => (
          <p class="bubble tail-left scene-bubble ss-bubble"><span class="sr-only">{b.who} says: </span>{b.text}</p>
        ))}
      </div>
    </section>
  </div>
</div>

<style>
  /* Layout only; every movement is in global.css "Story scenes". */
  /* --floor: what the phone dock (site.css .dock, 640px and below) covers at the bottom of the stage. */
  .story-scenes { --gutter: clamp(16px, 4vw, 48px); --top: 96px; --ship-w: min(26vw, 300px); --sea-h: 26%; --floor: 0px;
    --sea-top: calc(var(--floor) + var(--sea-h));
    margin-bottom: clamp(56px, 9vw, 120px); background: var(--color-sand); }
  .story-scenes .ch-head { padding: clamp(24px, 4vw, 48px) var(--gutter) 0; }
  .scene { position: relative; }
  .scene-harbour { height: 220vh; }
  .scene-sea-night { height: 260vh; }
  .scene-stage { position: sticky; top: 0; height: 100svh; overflow: clip; contain: paint; background: var(--color-paper); }
  .layer { position: absolute; }

  /* Shared: the water strip and the ship's size. */
  .scene-sea { left: 0; right: 0; bottom: 0; width: 100%; height: var(--sea-top); max-width: none; }
  .scene-ship { width: var(--ship-w); height: auto; max-width: none; }

  /* Text: the narrator top-left, under the sticky header; one caption slot, captions take turns. */
  .scene-text { position: absolute; top: var(--top); left: var(--gutter); right: var(--gutter); display: grid; justify-items: start; z-index: 2; }
  .scene-text .cap { grid-area: 1 / 1; max-width: min(46ch, 100%); }
  .scene-bubble { z-index: 2; transform-origin: 18% 100%; max-width: min(34vw, 300px); }

  /* Scene 1, the harbour at dawn. */
  .sh-sun { left: 60%; top: 26%; width: clamp(110px, 16vw, 230px); aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle at 40% 38%, rgb(255 255 255 / 0.25), transparent 55%), var(--color-gold); box-shadow: 0 0 60px 18px rgb(203 160 82 / 0.35); }
  /* The hill cut-outs end in hard edges; a static fade at each side hides them. */
  .sh-mtn-c, .sh-mtn-b { bottom: calc(var(--sea-top) - 2px); height: auto; max-width: none; mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent); }
  .sh-mtn-c { left: 2%; width: min(40vw, 460px); opacity: 0.8; }
  .sh-mtn-b { right: -4%; width: min(58vw, 640px); }
  .sh-ship { left: 50%; bottom: calc(var(--sea-top) - var(--ship-w) * 0.22); translate: -50% 0; }
  .sh-compass { left: var(--gutter); bottom: calc(var(--sea-top) + 16px); width: clamp(64px, 7vw, 110px); height: auto; }
  /* Speech above the ship's mast, tail down-left at it. */
  .sh-bubble { left: calc(50% + 1vw); bottom: calc(var(--sea-top) + var(--ship-w) * 0.82); }

  /* Scene 2, at sea: day to night. */
  .ss-map { inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; opacity: 0.18; }
  .ss-night { inset: 0; background: var(--color-ink); }
  .ss-route { inset: 0; width: 100%; height: 100%; overflow: visible; }
  .ss-route-line { fill: none; stroke: var(--color-gold); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 2 10; vector-effect: non-scaling-stroke; }
  .ss-route-draw { fill: none; stroke: #fff; stroke-width: 14; stroke-dasharray: 1 2; stroke-dashoffset: 1; }
  .ss-place { position: absolute; left: 16%; top: 34%; z-index: 1; margin: 0; display: flex; align-items: center; gap: 8px; translate: -9px -50%;
    font-family: var(--font-note); font-style: italic; font-weight: 500; font-size: clamp(20px, 2.2vw, 30px); color: var(--color-sand);
    text-shadow: 0 0 2px var(--color-ink), 0 0 6px var(--color-ink), 0 1px 0 var(--color-ink); }
  .ss-dot { width: 14px; height: 14px; flex: none; border-radius: 50%; background: var(--color-tiger); box-shadow: 0 0 0 3px rgb(237 229 216 / 0.6); }
  .ss-compass { right: var(--gutter); top: calc(var(--top) + 8px); width: clamp(56px, 6vw, 96px); height: auto; }
  .ss-ship-track { left: 0; right: 0; bottom: calc(var(--sea-top) - var(--ship-w) * 0.22); height: auto; }
  /* The ship crosses left to right here, so it faces that way. */
  .ss-ship { display: block; translate: -100% 0; scale: -1 1; }
  .ss-bubble { left: 44%; bottom: calc(var(--sea-top) + var(--ship-w) * 0.82); }

  @media (max-width: 640px) {
    .story-scenes { --floor: calc(60px + env(safe-area-inset-bottom)); }
  }
  @media (max-width: 599px) {
    .story-scenes { --top: 84px; --ship-w: 46vw; --sea-h: 22%; }
    .scene-harbour { height: 180vh; }
    .scene-sea-night { height: 200vh; }
    .scene-bubble { max-width: 60vw; }
    .sh-bubble { left: 22%; }
    .ss-bubble { left: 30%; }
    .sh-sun { left: 58%; top: 34%; }
    .sh-mtn-c { width: 56vw; }
    .sh-mtn-b { width: 74vw; }
    .ss-place { left: 14%; }
    .ss-compass { top: auto; bottom: calc(var(--floor) + 4%); }
  }
</style>
