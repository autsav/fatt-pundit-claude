---
/**
 * "Where the recipes went": the full-screen finale that closes the story and leads into the gold #end
 * (docs/STORY-DIRECTOR-PLAN.md section 8, "Finale, full screen").
 * The stage is the whole viewport and the chart is RouteChart (the noodle road, world-route.json: night chart,
 * noodle, ship, stamps), framed on the whole journey, Guangdong to London with the Dubai spur.
 *
 * - The replay ("previously on"): on this section's own view timeline (--sm) the noodle redraws Guangdong >
 *   Calcutta (5-25), Calcutta > London (25-55), then the Dubai spur (58-72), the ship riding its head and a stamp
 *   landing at each place. The branch pins land as the line reaches them, and the title card ("Where the recipes
 *   went" + lede) arrives last (80-88). Scroll is never taken over: the section is a 300vh track with a sticky stage.
 * - Everywhere else (no scroll timelines, calm or reduced motion, the comic, no JS) it is the finished chart, still,
 *   at one screen high: noodle drawn, ship parked at Dubai, stamps shown, title card and pins in place.
 * - Each branch is a pin inside the chart's map box (RouteChart's slot), in % of the box so it stays on its place:
 *   a native <details><summary> (one open at a time through `name`) whose card holds the same booking / waitlist
 *   link the #end section builds. Soho and Covent Garden are a kilometre apart, so both sit on London: Soho above,
 *   Covent Garden below. The open card sits at the foot of the screen.
 * - The only script closes an open card on Esc and returns focus to its pin.
 *
 * Props: branches, the array from getBranches(), passed by the page. Place it just before #end.
 */
import type { Branch } from '../../lib/site-data';
import world from '../../data/world-route.json';
import { listCta } from '../../lib/waitlist';
import RouteChart from './RouteChart.astro';

interface Props {
  branches: Branch[];
}
const { branches } = Astro.props;

type Pt = [number, number];
type Side = 'right' | 'left' | 'up' | 'down';
const pts = world.points as Record<'canton' | 'kolkata' | 'london' | 'dubai', Pt>;

// A place in % of the map box (RouteChart's box is the whole world, world.w x world.h).
const pos = ([x, y]: Pt) => `--x: ${((x / world.w) * 100).toFixed(2)}%; --y: ${((y / world.h) * 100).toFixed(2)}%`;
// A layer's place in the replay, in % of the track (global.css "Story scenes").
const score = (from: number, to: number) => `--from: ${from}%; --to: ${to}%;`;

// Where each branch pins, which side of the dot its label goes, and when it lands. Unknown ids fall back to London.
const SPOTS: Record<string, { at: Pt; side: Side; lands: [number, number] }> = {
  soho: { at: pts.london, side: 'up', lands: [53, 56] },
  'covent-garden': { at: pts.london, side: 'down', lands: [54, 57] },
  dubai: { at: pts.dubai, side: 'left', lands: [70, 73] },
};
const spot = (id: string) => SPOTS[id] ?? { at: pts.london, side: 'right' as Side, lands: [54, 57] as [number, number] };

// The recap, fast: leg 1, leg 2, the Dubai spur. The stamps land as the noodle reaches each place.
const legs = [
  { lane: 'leg1' as const, from: 5, to: 25 },
  { lane: 'leg2' as const, from: 25, to: 55 },
  { lane: 'dubai' as const, from: 58, to: 72 },
];
const places = [
  { at: 'canton' as const, name: 'Guangdong', lands: 8, side: 'left' as const },
  { at: 'kolkata' as const, name: 'Calcutta', lands: 27, side: 'left' as const },
  { at: 'london' as const, name: 'London', lands: 56, side: 'right' as const },
  { at: 'dubai' as const, name: 'Dubai', lands: 73, side: 'left' as const },
];
---

<section class="story-map" aria-labelledby="story-map-title">
  <div class="sm-track">
    <div class="sm-stage">
      <!-- Framing: map box = zoom x stage width (capped at zoomMaxH x stage height), focus at the stage's centre x, y% down. -->
      <RouteChart id="finale" finished timeline="--sm" legs={legs} places={places}
        focus={[640, 700]} zoom={0.944} zoomMaxH={1.51} y={55}
        focusPhone={[689, 696]} zoomPhone={0.967} yPhone={40}>
        {branches.map((b) => {
          const s = spot(b.id);
          const isOpen = b.status === 'open';
          return (
            <details class="sm-pin" name="story-map" data-pin={b.id} data-side={s.side}>
              <summary class="fx fx-pop" style={`${pos(s.at)}; ${score(...s.lands)}`}>
                <span class="sm-dot" aria-hidden="true"></span>
                <span class="sm-label">{b.shortName}</span>
                <span class="sr-only">, {isOpen ? 'open' : 'opening soon'}. Show details</span>
              </summary>
              <div class="sm-card">
                <h3 class="sm-card-title">{b.name}</h3>
                <p class="sm-card-line">{b.address.street}, {b.address.locality}</p>
                <p class="sm-card-line sm-card-note">{isOpen ? (b.page.opened ? `Open since ${b.page.opened}` : 'Open now') : 'Opening soon'}</p>
                {isOpen ? (
                  <a class="fp-btn fp-btn--primary" href={b.booking?.url ?? `/${b.id}/`} data-book={b.id}>Book at {b.shortName}</a>
                ) : (
                  <a class="fp-btn" href={listCta(b).href}>{listCta(b).label}</a>
                )}
              </div>
            </details>
          );
        })}
      </RouteChart>

      <!-- The end card: arrives last, over the chart, clear of the pins. It steps aside while a pin's card is open. -->
      <div class="sm-end fx fx-fade-up" style={score(80, 88)}>
        <div class="sm-end-in">
          <h2 id="story-map-title" class="sm-title">Where the recipes went</h2>
          <p class="sm-lede">From a kitchen in Guangdong, by way of Calcutta, to London, and next to Dubai. Choose a branch to book or join its list.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Esc closes the open card and puts focus back on its pin.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = document.querySelector<HTMLDetailsElement>('.story-map details[open]');
    if (!open) return;
    open.open = false;
    open.querySelector('summary')?.focus();
  });
  // A keyboard user can tab to a pin before the replay has landed it: jump to the end of the track,
  // where the chart is finished and every pin is shown.
  document.addEventListener('focusin', (e) => {
    const pin = (e.target as Element | null)?.closest?.('.story-map .sm-pin summary');
    const track = pin?.closest<HTMLElement>('.sm-track');
    // Keyboard focus only: a mouse click on a pin that has landed should not jump the page.
    if (!pin || !track || track.offsetHeight <= innerHeight || !(pin as HTMLElement).matches(':focus-visible')) return;
    // After the browser's own scroll-to-focus, which would otherwise win.
    setTimeout(() => {
      const end = track.getBoundingClientRect().top + scrollY + track.offsetHeight - innerHeight;
      if (Math.abs(scrollY - end) <= 2) return;
      // With smooth wheel scrolling on (our-story.astro), jump through it so it does not glide back.
      const lenis = (window as unknown as { fpLenis?: { scrollTo: (y: number, o: { immediate: boolean }) => void } }).fpLenis;
      if (lenis) lenis.scrollTo(end, { immediate: true });
      else window.scrollTo({ top: end, behavior: 'instant' });
    }, 0);
  });
</script>

<style>
  .story-map { --gutter: clamp(16px, 4vw, 48px); background: var(--color-ink); color: var(--color-sand); --fp-ring: var(--color-sand); }
  /* The hand-off to the gold #end. */
  .story-map::after { content: ''; display: block; height: clamp(56px, 8vw, 96px); background: linear-gradient(180deg, var(--color-ink), var(--color-gold)); }
  /* The stage is the whole screen (static: one screen high; replay: sticky inside the tall track). */
  .sm-stage { position: relative; height: 100svh; overflow: clip; }

  /* The end card: an ink plate in the top third, to the right of London's pins; on phones in the bottom third above the dock. */
  .sm-end { position: absolute; z-index: 5; left: auto; right: max(var(--gutter), 6vw); top: max(104px, 12svh); width: min(460px, calc(100% - 2 * var(--gutter))); pointer-events: none; }
  .sm-end-in { padding: 16px 22px 18px; background: rgb(44 41 37 / 0.92); border: 2px solid var(--color-gold); text-align: center; transition: opacity var(--dur-fast) var(--curve-out); }
  .sm-stage:has(details[open]) .sm-end-in { opacity: 0; }
  .sm-title { margin: 0; font-family: var(--font-display); font-size: clamp(26px, 3.6vw, 46px); line-height: 1.05; }
  .sm-lede { margin: 10px auto 0; max-width: 44ch; font-size: clamp(15px, 1.4vw, 18px); line-height: 1.4; }

  /* A pin: its dot's centre is always the place (--x, --y); data-side says where the label goes.
     --r is the dot's radius, so each translate puts the dot, not the box, on the point. */
  .sm-pin summary { --r: 9px; position: absolute; left: var(--x); top: var(--y); margin: 0; display: flex; align-items: center; gap: 8px; pointer-events: auto;
    min-width: 44px; min-height: 44px; padding-inline: 0 10px; list-style: none; cursor: pointer; font-weight: 600;
    font-family: var(--font-note); font-style: italic; font-size: clamp(14px, 2vw, 26px); translate: calc(-1 * var(--r)) -50%; }
  .sm-dot { width: calc(2 * var(--r)); height: calc(2 * var(--r)); flex: none; border-radius: 50%; background: var(--color-tiger); box-shadow: 0 0 0 3px rgb(237 229 216 / 0.8); transition: scale var(--dur-fast) var(--curve-out); }
  [data-side="left"] summary { flex-direction: row-reverse; translate: calc(-100% + var(--r)) -50%; padding-inline: 10px 0; }
  /* The two London pins: dots touching on London, Soho's box above it, Covent Garden's below. */
  [data-side="up"] summary { align-items: flex-end; translate: calc(-1 * var(--r)) calc(-100% - 1px); }
  [data-side="down"] summary { align-items: flex-start; translate: calc(-1 * var(--r)) 1px; }
  .sm-pin summary::-webkit-details-marker { display: none; }
  .sm-pin summary:focus-visible { outline: 3px solid var(--fp-ring); outline-offset: 2px; }
  .sm-label { color: var(--color-sand); text-shadow: 0 0 2px var(--color-ink), 0 0 6px var(--color-ink), 0 0 12px var(--color-ink); }
  .sm-pin summary:hover .sm-dot, .sm-pin[open] .sm-dot { scale: 1.25; }
  /* Above its own card, so the open pin can always be clicked again to close it. */
  .sm-pin[open] summary { z-index: 4; }
  /* London's stamp (RouteChart) rides higher so it clears Soho's pin. */
  :global(.story-map .rc-stamp[data-at='london']) { translate: -50% calc(-100% - 52px); }
  /* London and Dubai are named by their branch pins here, so the chart's own names would only stack on them. */
  :global(.story-map .rc-name:is([data-at='london'], [data-at='dubai'])) { display: none; }

  /* The open card: centred on the stage and standing on its foot. The map box is moved with `translate`, so `fixed`
     would anchor to it, not the screen; instead top = the focus point (--rc-y, in the box) + the distance from the
     focus to the stage's foot (100 - --rc-ty svh), minus the margin, and the card rises from there. */
  .sm-card { --foot: 24px; position: absolute; z-index: 3; left: var(--rc-x); top: calc(var(--rc-y) + (100 - var(--rc-ty)) * 1svh - var(--foot)); translate: -50% -100%;
    width: min(340px, calc(100vw - 2 * var(--gutter))); display: grid; gap: 6px; justify-items: start; padding: 16px 18px; pointer-events: auto;
    background: var(--color-sand); color: var(--color-ink); --fp-ring: var(--color-ink); border: 2px solid var(--color-ink); box-shadow: 4px 4px 0 var(--color-ink); }
  .sm-card-title { margin: 0; font-family: var(--font-display); font-size: 22px; line-height: 1.1; }
  .sm-card-line { margin: 0; }
  .sm-card-note { font-family: var(--font-note); font-style: italic; }
  .sm-card .fp-btn { margin-top: 6px; }

  @media (prefers-reduced-motion: no-preference) {
    .sm-card { animation: sm-in var(--dur-panel) var(--curve-panel); }
    @keyframes sm-in { from { opacity: 0; translate: -50% calc(-100% + var(--rise)); } }
  }

  @media (max-width: 599px) {
    .sm-pin summary { --r: 7px; font-size: 13px; gap: 5px; }
    .sm-end { top: auto; bottom: 96px; left: var(--gutter); right: var(--gutter); width: auto; }
    .sm-end-in { padding: 12px 16px 14px; }
    .sm-title { font-size: 26px; }
    .sm-lede { font-size: 14px; }
    .sm-card { left: var(--rc-xp); top: calc(var(--rc-yp) + (100 - var(--rc-typ)) * 1svh - var(--foot)); --foot: 76px; }
    /* The stamps carry the names here: at this scale the plain names would run into the next place. */
    :global(.story-map .rc-name) { display: none; }
    :global(.story-map .rc-stamp[data-at='london']) { translate: -50% calc(-100% - 50px); }
  }

  /* The replay: where the story scenes play (global.css "Story scenes" gate), the section is a pinned track and its
     .fx layers run the engine's keyframes on this track's own timeline (--sm). The engine's own rules are scoped to
     .story-scene, so they are repeated here for this section. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(:root:not([data-story='comic'])) .sm-track { height: 300vh; view-timeline: --sm block; }
      :global(:root:not([data-story='comic'])) .sm-stage { position: sticky; top: 0; }
      /* Tears in over the last scene like the chapters do (global.css "Between stages"): no straight seam. */
      :global(:root:not([data-story='comic'])) .story-map { position: relative; margin-top: calc(-1 * var(--edge-h));
        -webkit-mask: var(--torn-top) top / 100% var(--edge-h) no-repeat, linear-gradient(#000 0 0) 0 calc(var(--edge-h) - 1px) / 100% 100% no-repeat;
        mask: var(--torn-top) top / 100% var(--edge-h) no-repeat, linear-gradient(#000 0 0) 0 calc(var(--edge-h) - 1px) / 100% 100% no-repeat; }
      :global(:root:not([data-story='comic']) .story-map .fx) { animation-name: fx-move; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: --sm; animation-range: contain var(--from, 0%) contain var(--to, 100%); }
      :global(:root:not([data-story='comic']) .story-map .fx.fx-draw) { animation-name: fx-draw; }
      /* Easing by role, as in the chapters (global.css): the route and the ship stay linear; names land softly; stamps overshoot and settle. */
      :global(:root:not([data-story='comic']) .story-map .fx:is(.fx-fade-up, .fx-fade)) { animation-timing-function: cubic-bezier(.165, .84, .44, 1); }
      :global(:root:not([data-story='comic']) .story-map .fx.fx-pop) { animation-timing-function: linear(0, .62 22%, 1.07 48%, .98 72%, 1); }
      /* A pin that has not landed yet is hidden, so it can be neither focused nor clicked. */
      @media (max-width: 599px) {
        :global(:root:not([data-story='comic'])) .sm-track { height: 240vh; }
      }
    }
  }
</style>
