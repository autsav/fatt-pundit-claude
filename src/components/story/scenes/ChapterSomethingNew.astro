---
/**
 * Chapter two, "Something new", as one scene: the wok at evening, the momo steamers, then the friends' table.
 * Layers and their motion; the engine is global.css "Story scenes" (docs/STORY-MOTION-PLAN.md).
 * Each moving layer's score (range and start/end) is in the style block below.
 */
import StoryScene from '../StoryScene.astro';
import SceneArt from '../SceneArt.astro';
import { chapterOf, panelOf, firstSentence, NUMBER_WORDS } from '../../../lib/story-scenes';
// The food: real photos only (the owner's own shots), each dish cut out whole along its rim (src/assets/images/story/food/).
import momosPlate from '../../../assets/images/story/food/momos-plate.png';
import hakkaBowl from '../../../assets/images/story/food/hakka-bowl.png';
import stickyPan from '../../../assets/images/story/food/sticky-pan.png';
import malabarPan from '../../../assets/images/story/food/malabar-pan.png';
import { susanDishes, susanCss } from '../../../lib/lazy-susan';

const { chapter, index } = chapterOf('something-new');
const wok = panelOf(chapter, 'p07-the-wok');
const momos = panelOf(chapter, 'p08-momos');
const friends = panelOf(chapter, 'p09-friends');
// p07 is too long for one cue: two cues split at the first sentence end (the comic keeps the whole line).
const cues = wok.caption.match(/^(.+?[.!?])\s+(.+)$/s)?.slice(1) ?? [wok.caption];
// The banquet's dishes, in the order they come to the centre (names as on the menu). Only whole, uncropped cut-outs; `w` is the
// dish's width in one shared unit, so a pan and a plate keep their real sizes side by side.
const dishes = susanDishes([
  { src: momosPlate, name: 'Momos', w: 1.05 }, { src: stickyPan, name: 'Sticky sesame vegetables', w: 0.82 },
  { src: malabarPan, name: 'Malabar curry', w: 1 }, { src: hakkaBowl, name: 'Vegetable Hakka noodles', w: 0.92 },
]);
// The title as letters: --i/--n drive the engine's staggered scatter (the h2 keeps one sr-only copy of the text).
const total = chapter.title.replace(/ /g, '').length;
const words = (() => { let n = 0; return chapter.title.split(' ').map((w) => [...w].map((ch) => ({ ch, style: `--i:${n++};--n:${total}` }))); })();
// Paper lanterns hung along the cord's sag (a quadratic, as ChapterTangra's rope: y = 2 + 40t(1-t) of a 20-unit box): [t along, colour].
const lanterns = ([[0.1, '#c0392b'], [0.26, '#d9a63a'], [0.74, '#c0392b'], [0.9, '#d9a63a']] as const).map(([t, c]) => ({ x: t * 100, y: ((2 + 40 * t * (1 - t)) / 20) * 100, c }));
const fatt = wok.bubbles?.find((b) => b.who === 'Fatt');
const pundit = wok.bubbles?.find((b) => b.who === 'Pundit');
---

<div class="story-scenes">
  <StoryScene label={chapter.label} sr={firstSentence(wok.scene)} h="330vh" hPhone="275vh">
    <div class="layer fx scene-title sn-title">
      <header class="ch-head">
        <p class="ch-no">Chapter {NUMBER_WORDS[index]}</p>
        <h2 id={`${chapter.id}-scenes-title`} class="ch-title"><span class="sr-only">{chapter.title}</span><span aria-hidden="true">{words.map((w, wi) => <>{wi > 0 && ' '}<span class="tl-word">{w.map((l) => <span class="fx tl" style={l.style}>{l.ch}</span>)}</span></>)}</span></h2>
      </header>
    </div>
    <div class="layer fx sn-wok-out">
      <SceneArt name="wok-street-night" widths={[800, 1400, 2000, 2688]} sizes="100vw" class="layer sn-backdrop" />
      <div class="layer sn-evening" aria-hidden="true"></div>
      <SceneArt name="wok-queue" note="A long queue of hungry neighbours" widths={[480, 960, 1400]} sizes="(max-width: 599px) 62vw, min(30vw, 440px)" class="layer fx fx-puppet sn-queue" warm />
      <div class="cast layer fx fx-fade sn-fatt">
        <SceneArt name="wok-fatt" note="Fatt tossing a roaring wok" widths={[600, 1000, 1600]} sizes="(max-width: 599px) 66vw, 36vw" class="cast-art fx-rock" />
        {fatt && <p class:list={['bubble scene-bubble fx fx-pop fx-then-out sn-bub-fatt', `tail-${fatt.tail}`]}><span class="sr-only">{fatt.who} says: </span>{fatt.text}</p>}
      </div>
      <p class="scene-sfx fx fx-pop fx-then-out sn-sizzle" aria-hidden="true">Sizzle!</p>
      <div class="cast layer fx fx-fade sn-pundit">
        <SceneArt name="wok-pundit" note="Pundit throwing in chillies" widths={[600, 1000, 1600]} sizes="(max-width: 599px) 46vw, 30vw" class="cast-art fx-rock" />
        {pundit && <p class:list={['bubble scene-bubble fx fx-pop fx-then-out sn-bub-pundit', `tail-${pundit.tail}`]}><span class="sr-only">{pundit.who} says: </span>{pundit.text}</p>}
      </div>
    </div>
    <div class="layer fx sn-photos">
      <div class="layer fx fx-late sn-steam-set">
        <span class="layer sn-spot" aria-hidden="true"></span>
        <SceneArt name="momos-plate" fallback={momosPlate} widths={[480, 612]} sizes="(max-width: 599px) 78vw, min(40vw, 560px)" class="layer sn-plate" />
        <SceneArt name="steamer-lid" note="The steamer lid" widths={[480, 800, 1026]} sizes="(max-width: 599px) 72vw, min(37vw, 520px)" class="layer fx sn-lid" />
        <span class="layer fx fx-then-out puff sn-puff sn-puff1" aria-hidden="true"></span>
        <span class="layer fx fx-then-out puff sn-puff sn-puff2" aria-hidden="true"></span>
        <span class="layer fx fx-then-out puff sn-puff sn-puff3" aria-hidden="true"></span>
        <span class="layer fx fx-then-out puff sn-puff sn-puff4" aria-hidden="true"></span>
        <p class="scene-sfx fx fx-pop fx-then-out sn-psshh" aria-hidden="true">Psshh</p>
      </div>
    </div>
    <!-- The banquet, side-on (docs/qa/STORY-100-ISSUES.md W4, audit-B Direction B): a long table edge-on at the stage's foot, Fatt and Pundit
         behind it from the waist up, the dishes in a row on its lip. One slide of the row, with a dwell on each dish, is the turn
         (src/lib/lazy-susan.ts). The cast art is cut at its own small table's line; the counter's top lip sits on that line. -->
    <div class="layer fx fx-fade z-prop sn-wall" aria-hidden="true"></div>
    <div class="layer fx fx-fade z-prop sn-lanterns" aria-hidden="true">
      <svg class="sn-cord" viewBox="0 0 100 20" preserveAspectRatio="none" focusable="false"><path d="M-2 2 Q50 22 102 2" /></svg>
      {lanterns.map((l) => <span class="sn-lant" style={`left:${l.x}%;top:${l.y}%;--c:${l.c}`}></span>)}
    </div>
    <div class="cast layer fx fx-fade-up sn-cast">
      <SceneArt name="friends-table" note="Fatt and Pundit at a long table after service, sharing a feast" widths={[600, 960, 1400]} sizes="(max-width: 599px) 125vw, (max-width: 1000px) 112vw, 66vw" class="cast-art fx-rock sn-cast-art" />
    </div>
    <div class="layer fx fx-fade-up z-prop-front sn-counter" aria-hidden="true"><span class="sn-cloth"></span><span class="sn-wood"></span></div>
    <div class="layer fx z-prop-front sn-row" style={`--x1:calc(var(--gap) * ${-(dishes.length - 1)})`}>
      {dishes.map((d) => (
        <div class="sn-dish" style={`--k:${d.i};--dw:${d.w}`}><div class="fx fx-fade sn-dish-drop" style={d.drop}><SceneArt name={`susan-${d.i}`} fallback={d.src} widths={[240, 480]} sizes="(max-width: 599px) 30vw, 200px" class="sn-dish-img" /></div></div>
      ))}
    </div>
    {dishes.map((d) => <p class="fx fx-fade-up fx-then-out z-prop-front sn-tag" style={d.tag} aria-hidden="true">{d.name}</p>)}
    <style is:inline set:html={susanCss(dishes.length)}></style>
    <div class="scene-text">
      <p class="sr-only">{wok.caption}</p>
      {cues.map((t, i) => <p class={`cap fx fx-fade-up fx-then-out sn-cap1-${i}`} aria-hidden="true">{t}</p>)}
      <p class="cap fx fx-fade-up fx-then-out sn-cap2">{momos.caption}</p>
      <p class="cap fx fx-fade-up fx-then-out sn-cap3">{friends.caption}</p>
    </div>
  </StoryScene>
</div>

<style>
  /* Colour: wok-fire amber. The wok scene is a dark evening lit from below by the glow; the steamers and table sit on warm amber. */
  .story-scenes { --sky: #f6dfb0; --ground: #ecb15a; --glow: #e8811f; }

  /* The title lifts away, then the wok scene builds behind it. */
  /* Bottom safe area: the card never reaches the floor line, so it cannot clip mid-transition. */
  .sn-title { padding-bottom: calc(var(--floor, 0px) + 24px); box-sizing: border-box; --o1: 0; --y1: -8%; --from: 1%; --to: 8%; }
  /* The momos slide in opaque over the wok (36-40), which is then removed under them (40-41): a cut, no ghost. */
  .sn-wok-out { inset: 0; --o0: 1; --o1: 0; --from: 40%; --to: 40.5%; }
  /* The painted Calcutta street at night fades in (8-14); the overlay only darkens the top a little for the captions. */
  .sn-backdrop { inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 50% 80%; }
  .sn-evening { inset: 0; background: linear-gradient(to bottom, rgb(44 41 37 / 0.5), transparent 55%); }
  /* The hiss as the flame flares (11-16), gone before the bubbles arrive (20): over the frame's top corner. */
  .sn-sizzle { left: 34%; top: 42%; rotate: -6deg; --from: 8%; --to: 11%; --out-from: 13%; --out-to: 15%; }
  /* The characters stay storyboard cards for now: smaller and see-through so the street and the wok read first. */
  /* The cast (tiger art from the approved sheets): Fatt centre-left, his wok out to the right; Pundit flinging chillies into it;
     the queue further right and higher, smaller for distance. All above the lower-third captions. */
  .sn-fatt { left: 30%; bottom: calc(var(--floor) + 19%); translate: -50% 0; width: calc(var(--u) * 36); aspect-ratio: 1813 / 1733; z-index: 2; --y0: 3vh; --from: 0%; --to: 6%; }
  .sn-fatt > .cast-art { --rock-from: 6%; --rock-to: 40%; --rock-a: 1.4; }
  /* The wok sits in the flame; it tosses a little with the scroll (10-38) inside a wrapper that fades in. */
  .sn-pundit { left: 64%; bottom: calc(var(--floor) + 19%); translate: -50% 0; width: calc(var(--u) * 30); aspect-ratio: 1922 / 1803; z-index: 2; --x0: 8vw; --from: 4%; --to: 10%; }
  .sn-pundit > .cast-art { --rock-from: 10%; --rock-to: 40%; --rock-a: 1.1; }
  .sn-queue { right: calc(var(--gutter) + 64px); bottom: calc(var(--floor) + 30%); width: min(30vw, 440px); aspect-ratio: 2436 / 1063; height: auto; max-width: none; z-index: 1; --x0: 40vw; --from: 6%; --to: 28%; --rock-from: 28%; --rock-to: 40%; --rock-a: 0.5; }
  /* Captions: 3% in, each holds until the next replaces it; the last holds to the end of the track. */
  .sn-cap1-0 { --from: 8%; --to: 11%; --out-from: 26%; --out-to: 29%; }
  .sn-cap1-1 { --from: 26%; --to: 29%; --out-from: 38%; --out-to: 41%; }
  /* The bubbles are in the cast groups (--bx/--by: where the tail points, % of the speaker's box), so they sit by the speakers at every width. */
  .sn-bub-pundit { --bx: 38%; --by: 14%; --from: 15%; --to: 18%; --out-from: 26%; --out-to: 29%; }
  .sn-bub-fatt { --bx: 62%; --by: 10%; --from: 20%; --to: 23%; --out-from: 34%; --out-to: 37%; }

  /* Momos (36-62): the real plate in a pool of warm light, low on the stage; the bamboo lid lifts off it (38-48) and the steam rises.
     --pw is the plate's width; the lid, steam and hiss are placed from it. */
  .story-scenes { --pw: min(40vw, 560px); --py: 64%; }
  .sn-photos { inset: 0; --o0: 1; --o1: 0; --from: 57.5%; --to: 58.5%; }
  .sn-steam-set { inset: 0; --y0: 12vh; --from: 36%; --to: 40%; }
  .sn-spot { inset: 0; background: radial-gradient(calc(var(--pw) * 0.9) calc(var(--pw) * 0.42) at 50% calc(var(--py) + 2%), rgb(255 240 205 / 0.85), rgb(255 226 170 / 0.35) 55%, transparent 75%),
    radial-gradient(calc(var(--pw) * 0.52) calc(var(--pw) * 0.12) at 50% calc(var(--py) + var(--pw) * 0.3), rgb(44 41 37 / 0.35), transparent 80%), linear-gradient(to bottom, var(--sky), var(--ground)); }
  .sn-plate { left: 50%; top: var(--py); translate: -50% -50%; width: var(--pw); height: auto; aspect-ratio: 612 / 416; max-width: none; }
  /* The lid sits on the plate (its rim over the momos), then lifts away. */
  .sn-lid { left: 50%; top: calc(var(--py) - var(--pw) * 0.2); translate: -50% -50%; width: calc(var(--pw) * 0.93); height: auto; aspect-ratio: 1026 / 736; max-width: none; --y1: -40vh; --x1: 6vw; --r1: -10deg; --o1: 0; --from: 41%; --to: 52%; }
  .sn-puff { left: 50%; top: calc(var(--py) - var(--pw) * 0.22); translate: -50% 0; --y1: -30vh; --o0: 0; --o1: 0.9; }
  .sn-puff1 { margin-left: calc(var(--pw) * -0.2); --from: 42%; --to: 50%; --out-from: 50%; --out-to: 53%; }
  .sn-puff2 { margin-left: calc(var(--pw) * 0.02); --from: 45%; --to: 52%; --out-from: 52%; --out-to: 55%; }
  .sn-puff3 { margin-left: calc(var(--pw) * 0.2); --from: 48%; --to: 54%; --out-from: 54%; --out-to: 56.5%; }
  .sn-puff4 { margin-left: calc(var(--pw) * -0.05); --from: 50%; --to: 56%; --out-from: 56%; --out-to: 57.5%; }
  /* The hiss, right of the lid, clear of the caption above. */
  .sn-psshh { left: calc(50% + var(--pw) * 0.34); top: calc(var(--py) - var(--pw) * 0.42); rotate: 5deg; --from: 42%; --to: 47%; --out-from: 53%; --out-to: 56%; }
  .sn-cap2 { --from: 38%; --to: 41%; --out-from: 63%; --out-to: 66%; }

  /* The banquet (58-100). --lip is the table's height from the stage's foot; --cw is the cast art's width, --q a 66th of it: the
     table, dishes and tags are all sized in --q so they keep their proportions with the tigers. The tigers are as big as the space
     under the caption allows, and the whole of them from the waist up shows from 64% on. */
  .story-scenes { --lip: clamp(130px, 21svh, 280px);
    --cw: min(calc(var(--u) * 66), calc((100svh - var(--floor) - var(--lip) - 220px) / 0.451)); --q: calc(var(--cw) / 66);
    --gap: calc(var(--cw) * 0.36); --dk: calc(var(--cw) * 0.2); --line: calc(var(--floor) + var(--lip)); }
  /* The back wall: warm light behind the tigers. The lantern string is its own layer below. */
  .sn-wall { inset: 0; --from: 58.5%; --to: 61%;
    background: radial-gradient(ellipse calc(var(--cw) * 0.55) calc(var(--cw) * 0.4) at 50% calc(100% - var(--line) - var(--cw) * 0.2), rgb(255 238 200 / 0.75), transparent 70%); }
  /* The lantern string, paper-cut like the tigers: an ink-brown cord with a gentle sag, ribbed crumpled-paper lanterns with a gold cap and
     tassel, a soft offset shadow. Above the heads, under the caption (same top as the old string). */
  .sn-lanterns { left: 0; right: 0; top: max(calc(var(--header-h) + 13svh), calc(100svh - var(--line) - var(--cw) * 0.62)); height: calc(var(--cw) * 0.1); --from: 58.5%; --to: 61%; }
  .sn-cord { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .sn-cord path { fill: none; stroke: #6b4a2b; stroke-width: 2.5; vector-effect: non-scaling-stroke; }
  .sn-lant { --w: max(calc(var(--cw) * 0.09), 38px); position: absolute; width: var(--w); height: calc(var(--w) * 1.2); translate: -50% 6%; border-radius: 50% / 46%;
    background: repeating-linear-gradient(to bottom, rgb(70 12 6 / 0.3) 0 1.5px, transparent 1.5px calc(var(--w) * 0.14)),
      radial-gradient(ellipse at 35% 30%, rgb(255 244 214 / 0.55), transparent 50%), radial-gradient(ellipse at 50% 50%, transparent 52%, rgb(70 12 6 / 0.4)),
      url("../../../assets/images/story/paper-crumpled.webp") 0 0 / 256px 256px, var(--c);
    background-blend-mode: normal, normal, normal, multiply, normal;
    filter: drop-shadow(calc(var(--q) * 0.5) calc(var(--q) * 0.5) 0 rgb(44 41 37 / 0.28)); }
  .sn-lant::before, .sn-lant::after { content: ''; position: absolute; left: 50%; translate: -50% 0; }
  .sn-lant::before { top: -7%; width: 46%; height: 9%; border-radius: 2px; background: linear-gradient(#e2bf6a, #b8903c); }
  .sn-lant::after { top: 100%; width: 6%; height: 30%; background: linear-gradient(#c9a24f 0 20%, #b8903c 20%); border-radius: 0 0 3px 3px; }
  /* The cast: Fatt and Pundit (their small table is cut off at its line) rise from behind the counter over 60.5-65, then rock with laughter.
     The art is clipped at 62% of its height, the counter's top lip covers 60-62%: nothing of their little table shows, even rocking. */
  .sn-cast { left: 50%; translate: -50% 0; width: var(--cw); bottom: calc(var(--line) - var(--cw) * 0.4 * 0.7523); --o0: 0; --y0: calc(var(--cw) * 0.16); --from: 61%; --to: 65%; }
  .sn-cast-art { clip-path: inset(0 0 38% 0); --rock-from: 65%; --rock-to: 100%; --rock-a: 0.4; }
  /* The counter: edge-on red paper cloth with a scalloped hem, a wooden top lip, gold paper-cut medallions, paper grain. */
  .sn-counter { left: -4vw; right: -4vw; bottom: var(--floor); height: var(--lip); --from: 58.5%; --to: 61%; --sc: calc(var(--q) * 1.5); --o0: 1; --y0: calc(var(--lip) * 1.1); }
  .sn-cloth { position: absolute; inset: calc(var(--q) * 1.2) 0 calc(var(--q) * 0.4); display: block;
    background: radial-gradient(circle at 50% 50%, #d9a63a 0 calc(var(--q) * 0.5), transparent calc(var(--q) * 0.55)) 0 40% / calc(var(--q) * 9) 100% repeat-x,
      url("../../../assets/images/story/paper-crumpled.webp") 0 0 / 512px 512px, #b3342a;
    background-blend-mode: normal, multiply, normal;
    -webkit-mask: linear-gradient(#000 0 0) 0 0 / 100% calc(100% - var(--sc)) no-repeat, radial-gradient(circle at 50% 0, #000 calc(var(--sc) - 0.5px), transparent var(--sc)) 0 100% / calc(var(--sc) * 2) var(--sc) repeat-x;
    mask: linear-gradient(#000 0 0) 0 0 / 100% calc(100% - var(--sc)) no-repeat, radial-gradient(circle at 50% 0, #000 calc(var(--sc) - 0.5px), transparent var(--sc)) 0 100% / calc(var(--sc) * 2) var(--sc) repeat-x; }
  .sn-wood { position: absolute; left: 0; right: 0; top: 0; height: calc(var(--q) * 1.6); display: block; background: linear-gradient(#c58a4e, #8a5a30); box-shadow: 0 calc(var(--q) * 0.35) 0 rgb(44 41 37 / 0.28); }
  /* The row: one wrapper on the lip's centre line, the dishes spaced by --gap and slid left as one (72-97), a dwell on each. */
  .sn-row { left: 50%; bottom: calc(var(--line) - var(--q) * 1.1); width: 0; height: 0; --x0: 0px; --from: 72%; --to: 97%; }
  .sn-dish { position: absolute; bottom: 0; left: calc(var(--k) * var(--gap)); width: calc(var(--dw) * var(--dk)); translate: -50% 0; }
  .sn-dish-drop::before { content: ''; position: absolute; left: 4%; right: 4%; bottom: calc(var(--q) * -0.5); height: calc(var(--q) * 1.4); border-radius: 50%; background: radial-gradient(rgb(44 41 37 / 0.42), transparent 70%); }
  .sn-dish-drop { --y0: -16vh; position: relative; }
  /* A paper-white die-cut edge (four 1-step shadows chain into an outline), then the flat contact shadow above. */
  .sn-dish-img { position: relative; display: block; width: 100%; height: auto; max-width: none;
    filter: drop-shadow(calc(var(--q) * 0.16) 0 0 #fbf6ea) drop-shadow(calc(var(--q) * -0.16) 0 0 #fbf6ea) drop-shadow(0 calc(var(--q) * 0.16) 0 #fbf6ea) drop-shadow(0 calc(var(--q) * -0.16) 0 #fbf6ea); }
  /* The name of the dish at the centre: on the cloth, under the lip, always inside the stage. */
  .sn-tag { position: absolute; left: 50%; bottom: calc(var(--floor) + var(--lip) * 0.3); translate: -50% 0; margin: 0; padding: 0.35em 0.9em; white-space: nowrap; rotate: -2deg;
    font: 700 clamp(13px, calc(var(--u) * 1.5), 22px) / 1.2 var(--font-display, Georgia, serif); letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--color-paper); background: var(--color-ink); box-shadow: 3px 3px 0 var(--color-tiger, #e8811f); }
  .sn-cap3 { --from: 63%; --to: 66%; --out-from: 97%; --out-to: 100%; }

  @media (max-width: 599px) {
    .sn-backdrop { object-position: 50% 100%; }
    .sn-fatt { left: 38%; bottom: calc(var(--floor) + 26%); width: 66vw; }
    .sn-pundit { left: 76%; bottom: calc(var(--floor) + 36%); width: 44vw; }
    /* Too narrow a stage for the queue too: the wok and the argument carry the beat on phones. */
    .sn-queue { display: none; }
    .sn-sizzle { left: 46%; top: 52%; }
    .story-scenes { --pw: 78vw; --py: 60%; }
    .sn-psshh { left: auto; right: 4%; top: calc(var(--py) - var(--pw) * 0.62); }
    /* Phones: the tigers run a little off both sides so their faces stay big; the dishes are bigger and further apart, so about two show. */
    .story-scenes { --lip: clamp(130px, 22svh, 280px); --cw: min(125vw, calc((100svh - var(--floor) - var(--lip) - 220px) / 0.451)); --gap: calc(var(--cw) * 0.4); --dk: calc(var(--cw) * 0.27); }
    .sn-tag { font-size: 13px; }
  }
  /* Portrait tablets: wider than the 16:9 unit, so the tigers fill the width. */
  @media (min-width: 600px) and (max-aspect-ratio: 1 / 1) {
    .story-scenes { --cw: min(112vw, calc((100svh - var(--floor) - var(--lip) - 220px) / 0.451)); --gap: calc(var(--cw) * 0.3); --dk: calc(var(--cw) * 0.24); }
  }
</style>
