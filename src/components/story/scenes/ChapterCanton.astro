---
/**
 * Chapter one, "A long way from home", as two scenes: the harbour at dawn, then the voyage by night.
 * Layers and their motion; the engine is global.css "Story scenes" (docs/STORY-MOTION-PLAN.md).
 * Each moving layer's score (range and start/end) is in the style block below.
 */
import StoryScene from '../StoryScene.astro';
import SceneArt from '../SceneArt.astro';
import { chapterOf, panelOf, firstSentence, NUMBER_WORDS } from '../../../lib/story-scenes';
import ship from '../../../assets/images/brand/ship.png';
import mountainsB from '../../../assets/images/brand/mountains-b.png';
import mountainsC from '../../../assets/images/brand/mountains-c.png';
import compass from '../../../assets/images/brand/compass.png';
import map from '../../../assets/images/brand/map.webp';
import seaUrl from '../../../assets/images/brand/voyage-sea.svg?url';

const { chapter, index } = chapterOf('canton');
const harbour = panelOf(chapter, 'p01-harbour');
const packing = panelOf(chapter, 'p02-packing');
const atSea = panelOf(chapter, 'p03-at-sea');
const shipSizes = '(max-width: 599px) 46vw, min(26vw, 300px)';
// The sea chart is a whole world; the strip shows only open Indian Ocean (an SVG view fragment).
const seaStrip = `${seaUrl}#svgView(viewBox(391,1324,1004,150);preserveAspectRatio(xMidYMid%20slice))`;
const route = 'M88 30 C 72 14, 56 42, 40 30 S 22 26, 16 34';
---

<div class="story-scenes">
  <StoryScene label={chapter.label} sr={firstSentence(harbour.scene)} h="240vh" hPhone="200vh">
    <div class="layer fx scene-title sh-title">
      <header class="ch-head">
        <p class="ch-no">Chapter {NUMBER_WORDS[index]}</p>
        <h2 id={`${chapter.id}-scenes-title`} class="ch-title">{chapter.title}</h2>
      </header>
    </div>
    <div class="layer fx sh-sun" aria-hidden="true"></div>
    <SceneArt name="harbour-hills-far" fallback={mountainsC} widths={[120]} sizes="min(40vw, 460px)" class="layer fx sh-hills sh-mtn-c" />
    <SceneArt name="harbour-hills-near" fallback={mountainsB} widths={[180]} sizes="min(58vw, 640px)" class="layer fx sh-hills sh-mtn-b" />
    <img class="layer scene-sea" src={seaStrip} alt="" loading="lazy" decoding="async" />
    <SceneArt name="harbour-ship" fallback={ship} widths={[100]} sizes={shipSizes} class="layer fx scene-ship sh-ship" warm />
    <SceneArt name="harbour-compass" fallback={compass} widths={[90]} sizes="110px" class="layer fx sh-compass" warm />
    <div class="scene-text">
      <p class="cap fx fx-fade-up fx-then-out sh-cap1">{harbour.caption}</p>
      <p class="cap fx fx-fade-up sh-cap2">{packing.caption}</p>
    </div>
    {harbour.bubbles?.slice(0, 1).map((b) => (
      <p class="bubble tail-left scene-bubble fx fx-pop fx-then-out sh-bubble"><span class="sr-only">{b.who} says: </span>{b.text}</p>
    ))}
  </StoryScene>

  <StoryScene label="At sea" sr={firstSentence(atSea.scene)} h="260vh" hPhone="200vh">
    <SceneArt name="at-sea-chart" fallback={map} widths={[800, 1400, 2000]} sizes="100vw" class="layer ss-map" />
    <img class="layer scene-sea" src={seaStrip} alt="" loading="lazy" decoding="async" />
    <div class="layer fx fx-fade ss-night" aria-hidden="true"></div>
    <svg class="layer ss-route" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <defs>
        <mask id="scene-route-canton" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
          <path class="fx fx-draw route-draw ss-route-draw" d={route} pathLength="1" />
        </mask>
      </defs>
      <path class="route-line" d={route} mask="url(#scene-route-canton)" />
    </svg>
    <p class="scene-place fx fx-fade-up ss-place" aria-hidden="true">Calcutta</p>
    <SceneArt name="at-sea-compass" fallback={compass} widths={[90]} sizes="96px" class="layer fx ss-compass" warm />
    <div class="layer fx ss-ship-track" aria-hidden="true">
      <SceneArt name="at-sea-ship" fallback={ship} widths={[100]} sizes={shipSizes} class="scene-ship ss-ship" warm />
    </div>
    <div class="scene-text">
      <p class="cap fx fx-fade-up ss-cap">{atSea.caption}</p>
    </div>
    {atSea.bubbles?.slice(0, 1).map((b) => (
      <p class="bubble tail-left scene-bubble fx fx-pop fx-then-out ss-bubble"><span class="sr-only">{b.who} says: </span>{b.text}</p>
    ))}
  </StoryScene>
</div>

<style>
  /* Scene 1, the harbour at dawn: the title lifts, sun up, hills drift (far ones slower), the ship comes in, then the words. */
  .sh-title { --o1: 0; --y1: -8%; --from: 4%; --to: 12%; }
  .sh-sun { left: 60%; top: 26%; width: clamp(110px, 16vw, 230px); aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle at 40% 38%, rgb(255 255 255 / 0.25), transparent 55%), var(--color-gold); box-shadow: 0 0 60px 18px rgb(203 160 82 / 0.35);
    --y0: 45%; --y1: -25%; }
  /* The hill cut-outs end in hard edges; a static fade at each side hides them. */
  .sh-hills { bottom: calc(var(--sea-top) - 2px); height: auto; max-width: none; mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent); }
  /* Its faintness is in the animation's values: a moving layer's opacity is the animation's. */
  .sh-mtn-c { left: 2%; width: min(40vw, 460px); --o0: 0.8; --o1: 0.8; --x1: -3vw; }
  .sh-mtn-b { right: -4%; width: min(58vw, 640px); --x1: -8vw; }
  .sh-ship { left: 50%; bottom: calc(var(--sea-top) - var(--ship-w) * 0.22); translate: -50% 0; --x0: 60vw; --to: 45%; }
  .sh-compass { left: var(--gutter); bottom: calc(var(--sea-top) + 16px); width: clamp(64px, 7vw, 110px); height: auto; --o0: 0; --x0: -30vw; --from: 70%; --to: 90%; }
  .sh-cap1 { --from: 20%; --to: 40%; --out-from: 64%; --out-to: 70%; }
  .sh-cap2 { --from: 70%; --to: 90%; }
  /* Speech above the ship's mast, tail down-left at it. */
  .sh-bubble { left: calc(50% + 1vw); bottom: calc(var(--sea-top) + var(--ship-w) * 0.82); --from: 45%; --to: 60%; --out-from: 64%; --out-to: 70%; }

  /* Scene 2, at sea: night falls, the course draws from Guangdong to Calcutta, the ship crosses. */
  .ss-map { inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; opacity: 0.18; }
  .ss-night { inset: 0; background: var(--color-ink); --o1: 0.9; --to: 30%; }
  .ss-route { inset: 0; width: 100%; height: 100%; overflow: visible; }
  .route-line { fill: none; stroke: var(--color-gold); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 2 10; vector-effect: non-scaling-stroke; }
  .route-draw { fill: none; stroke: #fff; stroke-width: 14; stroke-dasharray: 1 2; stroke-dashoffset: 1; }
  .ss-route-draw { --from: 10%; --to: 85%; }
  .ss-place { left: 16%; top: 34%; --from: 85%; }
  .ss-compass { right: var(--gutter); top: calc(var(--top) + 8px); width: clamp(56px, 6vw, 96px); height: auto; --r1: 180deg; }
  .ss-ship-track { left: 0; right: 0; bottom: calc(var(--sea-top) - var(--ship-w) * 0.22); height: auto; --x1: calc(100% + var(--ship-w)); }
  /* The ship crosses left to right here, so it faces that way. */
  .ss-ship { display: block; translate: -100% 0; scale: -1 1; }
  .ss-cap { --from: 15%; --to: 35%; }
  .ss-bubble { left: 44%; bottom: calc(var(--sea-top) + var(--ship-w) * 0.82); --from: 40%; --to: 55%; --out-from: 70%; --out-to: 78%; }

  @media (max-width: 599px) {
    .sh-bubble { left: 22%; }
    .ss-bubble { left: 30%; }
    .sh-sun { left: 58%; top: 34%; }
    .sh-mtn-c { width: 56vw; }
    .sh-mtn-b { width: 74vw; }
    .ss-place { left: 14%; }
    .ss-compass { top: auto; bottom: calc(var(--floor) + 4%); }
  }
</style>
