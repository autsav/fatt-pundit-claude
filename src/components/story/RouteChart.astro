---
/**
 * "The noodle road" (docs/STORY-DIRECTOR-PLAN.md section 5): one route chart for every story journey.
 * A night chart (voyage-sea.png, ink sea, sand land) with a thick noodle that draws itself along the true sea
 * lane (world-route.json) as the scene scrolls, a tiger-head token riding the head of the line, and big place
 * names that land with a passport-stamp slam. All decorative (aria-hidden). Transform, opacity and stroke
 * draws only; no script. Put it in a StoryScene slot; the engine is global.css "Story scenes".
 *
 * Framing: the map box is `zoom` x the stage width (capped at `zoomMaxH` x the stage height, so a short window
 * does not push the route into the strip below), and `focus` (map px) sits at x 50%, `y`% of the stage.
 * Scroll ranges (`from`, `to`, `lands`, `out`) are % of the scene track, like --from/--to in the engine.
 * `finished`: the base (ungated) state is the finished chart (noodle fully drawn, ship parked at the end of the
 * last leg, names and stamps shown), for a section that is also read still. Scenes leave it off.
 * The default slot is overlay content in the map box, positioned in % of the box (--x/--y), above the ship.
 * The `ship` slot rides the token: its children hang from the token's centre (a speech bubble, say).
 * It can read --rc-x/--rc-y (focus, % of the box), --rc-ty (stage y of the focus, in svh) and the -p phone twins.
 */
import { getImage } from 'astro:assets';
import world from '../../data/world-route.json';
import voyageSea from '../../assets/images/brand/voyage-sea.png';
// The token that rides the noodle: one tiger head from the logo (Pundit's turban) from Canton to Calcutta, then the two
// (Fatt's crown beside it) from Calcutta on, to London and Dubai.
import tokenOneArt from '../../assets/images/brand/token-tiger.png';
import tokenTwoArt from '../../assets/images/brand/token-tigers.png';

type Lane = 'leg1' | 'leg2' | 'dubai' | 'toDubai';
type Side = 'left' | 'right';
interface Props {
  /** Unique on the page: names the keyframes and the gated style. */
  id: string;
  /** Draw order. The ship rides the head of each; `face` is the way the ship looks (default: the way the lane runs). */
  legs: { lane: Lane; from: number; to: number; face?: Side; /** Already complete: the noodle is drawn from the first frame (no mask, no scroll draw). The ship still rides by from/to. */ drawn?: boolean }[];
  /** `lands`: the scroll % the stamp slams at (the name fades up over 4% before it). `side`: which side of the dot the name sits. */
  places: { at: keyof typeof world.points; name: string; lands: number; side?: Side; sidePhone?: Side }[];
  /** Map px put at the frame's horizontal centre and at `y` % of the stage height. */
  focus: [number, number];
  /** Phone focus (defaults to `focus`). */
  focusPhone?: [number, number];
  /** Map-box width as a multiple of the stage width, and on phones (under 600px). */
  zoom: number;
  zoomPhone: number;
  /** Cap on the map-box width as a multiple of the stage height (wide-and-short windows). */
  zoomMaxH?: number;
  zoomMaxHPhone?: number;
  y?: number;
  yPhone?: number;
  /** Fade the whole chart out over this scroll range. */
  out?: [number, number];
  /** The view timeline the animations run on (the engine's own is --scene). */
  timeline?: string;
  finished?: boolean;
}
const { id, legs, places, focus, focusPhone = focus, zoom, zoomPhone, zoomMaxH, zoomMaxHPhone, y = 50, yPhone = y, out, timeline = '--scene', finished = false } = Astro.props;

const { w: W, h: H, sea: SEA } = world;
const pct = (v: number, of: number) => +((v / of) * 100).toFixed(2);
const seaWs = [1600, 2400, 3200].filter((w) => w <= voyageSea.width);
const seaImgs = await Promise.all(seaWs.map((w) => getImage({ src: voyageSea, width: w, format: 'avif', quality: 50 })));
const sea = seaImgs[seaImgs.length - 1];
const seaSrcset = seaImgs.map((m, i) => `${m.src} ${seaWs[i]}w`).join(', ');
const tokOne = await getImage({ src: tokenOneArt, width: 200, format: 'webp', quality: 82 });
const tokTwo = await getImage({ src: tokenTwoArt, width: 260, format: 'webp', quality: 82 });
// Which token shows: one head on leg 1, two on every later lane; where both ride, they swap as leg 2 sets off.
const pairFrom = legs.findIndex((l) => l.lane !== 'leg1');
const hasOne = legs[0].lane === 'leg1';
const hasTwo = pairFrom >= 0;
// The sea's drawn width = the map box (zoom x stage, capped by zoomMaxH x stage height) x the sea's share of the map.
const seaShare = SEA.w / W;
const seaSize = (z: number, maxH?: number) => (maxH ? `min(${pct(z * seaShare, 1)}vw, ${pct(maxH * seaShare, 1)}svh)` : `${pct(z * seaShare, 1)}vw`);
const seaSizes = `(max-width: 599px) ${seaSize(zoomPhone, zoomMaxHPhone)}, ${seaSize(zoom, zoomMaxH)}`;
const seaStyle = `left:${pct(SEA.x, W)}%;top:${pct(SEA.y, H)}%;width:${pct(SEA.w, W)}%;height:${pct(SEA.h, H)}%`;
const at = ([x, yy]: number[]) => `left:${pct(x, W)}%;top:${pct(yy, H)}%`;
const width = (z: number, maxH?: number) => (maxH ? `min(${pct(z, 1)}%, ${pct(maxH, 1)}svh)` : `${pct(z, 1)}%`);
const box = `--rc-w:${width(zoom, zoomMaxH)};--rc-wp:${width(zoomPhone, zoomMaxHPhone)};--rc-top:${y}%;--rc-topp:${yPhone}%;--rc-ty:${y};--rc-typ:${yPhone};--rc-x:${pct(focus[0], W)}%;--rc-y:${pct(focus[1], H)}%;--rc-xp:${pct(focusPhone[0], W)}%;--rc-yp:${pct(focusPhone[1], H)}%`;

// The ship's path: each lane's cubic Bezier path sampled into a polyline, its keyframes at the share of the
// scroll range its length covers, so the ship is where the drawn line's head is (the draw is by path length too).
const sample = (d: string): [number, number][] => {
  const n = d.match(/-?\d+\.?\d*/g)!.map(Number);
  let [px, py] = [n[0], n[1]];
  const pts: [number, number][] = [[px, py]];
  for (let i = 2; i + 5 < n.length; i += 6) {
    const [ax, ay, bx, by, ex, ey] = n.slice(i, i + 6);
    for (let s = 1; s <= 4; s++) {
      const t = s / 4, m = 1 - t;
      pts.push([m ** 3 * px + 3 * m * m * t * ax + 3 * m * t * t * bx + t ** 3 * ex, m ** 3 * py + 3 * m * m * t * ay + 3 * m * t * t * by + t ** 3 * ey]);
    }
    [px, py] = [ex, ey];
  }
  return pts;
};
// The noodle draws in pieces: each cubic is cut into a few short segments that fade in one after another along
// the route (opacity per segment, no mask: the old stroke-draw mask repainted on the main thread every frame).
type Pt = [number, number];
const bez = (p: Pt[], t: number): Pt => { const m = 1 - t; return [0, 1].map((i) => m ** 3 * p[0][i] + 3 * m * m * t * p[1][i] + 3 * m * t * t * p[2][i] + t ** 3 * p[3][i]) as Pt; };
const cut = (p: Pt[], a: number, b: number): Pt[] => {
  // Sub-curve between a and b (exact, by Hermite handles).
  const d = (t: number): Pt => { const m = 1 - t; return [0, 1].map((i) => 3 * m * m * (p[1][i] - p[0][i]) + 6 * m * t * (p[2][i] - p[1][i]) + 3 * t * t * (p[3][i] - p[2][i])) as Pt; };
  const k = (b - a) / 3, pa = bez(p, a), pb = bez(p, b), da = d(a), db = d(b);
  return [pa, [pa[0] + da[0] * k, pa[1] + da[1] * k], [pb[0] - db[0] * k, pb[1] - db[1] * k], pb];
};
const pieces = (dd: string, target = 36) => {
  const n = dd.match(/-?\d+\.?\d*/g)!.map(Number);
  const curves: Pt[][] = [];
  let cur: Pt = [n[0], n[1]];
  for (let i = 2; i + 5 < n.length; i += 6) { const e: Pt = [n[i + 4], n[i + 5]]; curves.push([cur, [n[i], n[i + 1]], [n[i + 2], n[i + 3]], e]); cur = e; }
  const K = Math.max(1, Math.ceil(target / curves.length));
  const segs = curves.flatMap((c) => Array.from({ length: K }, (_, j) => cut(c, j / K, (j + 1) / K)));
  const len = segs.map((c) => Math.hypot(c[3][0] - c[0][0], c[3][1] - c[0][1]));
  const total = len.reduce((a, b) => a + b, 0);
  let acc = 0;
  return segs.map((c, i) => {
    const f0 = acc / total; acc += len[i];
    const f = (q: Pt) => `${+q[0].toFixed(1)},${+q[1].toFixed(1)}`;
    return { d: `M${f(c[0])}C${f(c[1])},${f(c[2])},${f(c[3])}`, f0, f1: acc / total };
  });
};
const S0 = legs[0].from;
const S1 = legs[legs.length - 1].to;
const scroll = (s: number) => (((s - S0) / (S1 - S0)) * 100).toFixed(2);
const faceOf = (l: (typeof legs)[number], pts: [number, number][]): Side => l.face ?? (pts[pts.length - 1][0] >= pts[0][0] ? 'right' : 'left');
const moves: string[] = [];
const faces: string[] = [];
let park = [0, 0];
const dirs = legs.map((l, li) => {
  const pts = sample(world[l.lane]);
  if (li) moves.push(`${scroll(l.from - 0.01)}%{translate:${pct(park[0], W)}% ${pct(park[1], H)}%}`);
  const cum = pts.reduce<number[]>((a, p, i) => [...a, i ? a[i - 1] + Math.hypot(p[0] - pts[i - 1][0], p[1] - pts[i - 1][1]) : 0], []);
  pts.forEach((p, i) => moves.push(`${scroll(l.from + ((l.to - l.from) * cum[i]) / cum[cum.length - 1])}%{translate:${pct(p[0], W)}% ${pct(p[1], H)}%}`));
  park = pts[pts.length - 1];
  const f = faceOf(l, pts);
  faces.push(`${scroll(l.from)}%,${scroll(l.to)}%{scale:${f === 'left' ? '1 1' : '-1 1'}}`);
  return f;
});
// The ship art looks left; a second keyframe set flips it between legs only when the legs differ.
const mixed = new Set(dirs).size > 1;
const shipFace = (finished ? dirs[dirs.length - 1] : dirs[0]) === 'left' ? '1 1' : '-1 1';
const parked = finished ? `translate:${pct(park[0], W)}% ${pct(park[1], H)}%` : undefined;
const gate = (rules: string) => `@supports (animation-timeline: view()){@media (prefers-reduced-motion: no-preference){:root:not([data-story='comic']){${rules}}}}`;
const swap = hasOne && hasTwo ? scroll(legs[pairFrom].from) : null;
const css =
  `@keyframes rcid-${id}-ship{${moves.join('')}}` +
  (swap ? `@keyframes rcid-${id}-one{0%,${swap}%{opacity:1}100%{opacity:0}}@keyframes rcid-${id}-two{0%,${swap}%{opacity:0}100%{opacity:1}}` : '') +
  (mixed ? `@keyframes rcid-${id}-face{${faces.join('')}}` : '') +
  // The ship bobs on the swell as it sails (rotate, so it composes with the face flip's scale).
  `@keyframes rcid-${id}-bob{0%,100%{rotate:-4deg}25%{rotate:4deg}50%{rotate:-2deg}75%{rotate:3deg}}` +
  gate(
    `.rcid-${id} .rc-ship{animation-name:rcid-${id}-ship;animation-timing-function:linear;animation-fill-mode:both;animation-timeline:${timeline};animation-range:contain ${S0}% contain ${S1}%}` +
      `.rcid-${id} .rc-ship-img{animation-name:${mixed ? `rcid-${id}-face,` : ''}rcid-${id}-bob;animation-timing-function:${mixed ? 'step-end,' : ''}ease-in-out;animation-iteration-count:${mixed ? '1,' : ''}6;animation-fill-mode:both;animation-timeline:${timeline};animation-range:contain ${S0}% contain ${S1}%}` +
      (swap ? `.rcid-${id} .rc-tok-one,.rcid-${id} .rc-tok-two{animation-timing-function:step-start;animation-fill-mode:both;animation-timeline:${timeline};animation-range:contain ${S0}% contain ${S1}%}.rcid-${id} .rc-tok-one{animation-name:rcid-${id}-one}.rcid-${id} .rc-tok-two{animation-name:rcid-${id}-two}` : '') +
      (timeline === '--scene' ? '' : `.rcid-${id} .fx,.rcid-${id}.fx{animation-timeline:${timeline}}`),
  );
const sideCls = (p: (typeof places)[number]) => {
  const d = p.side ?? 'right';
  return `rc-${d === 'left' ? 'l' : 'r'} rc-p${(p.sidePhone ?? d) === 'left' ? 'l' : 'r'}`;
};
---

<Fragment set:html={`<style>${css}</style>`} />
<div class:list={['layer', 'rc', `rcid-${id}`, finished && 'rc-done', out && 'fx fx-then-out']} style={`${box}${out ? `;--out-from:${out[0]}%;--out-to:${out[1]}%` : ''}`}>
  <div class="layer rc-map" style={`aspect-ratio:${W} / ${H}`}>
    <img class="rc-sea" src={sea.src} srcset={seaSrcset} sizes={seaSizes} width={SEA.w} height={SEA.h} alt="" style={seaStyle} loading="lazy" decoding="async" />
    <svg class="layer rc-svg rc-svg-dots" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
      {legs.map((l) => <path class="rc-dots" d={world[l.lane]} />)}
    </svg>
    {/* The noodle is its own compositor layer, so the sea never re-rasters with it. It draws as short segments fading in along the route. */}
    <svg class="layer rc-svg rc-svg-draw" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
      {legs.map((l) => l.drawn
        ? <g><path class="rc-ink" d={world[l.lane]} /><path class="rc-body" d={world[l.lane]} /><path class="rc-shine" d={world[l.lane]} /></g>
        : pieces(world[l.lane]).map((g) => (
          <g class="fx fx-fade" style={`--from:${(l.from + (l.to - l.from) * g.f0).toFixed(2)}%;--to:${(l.from + (l.to - l.from) * g.f1).toFixed(2)}%`}>
            <path class="rc-ink" d={g.d} /><path class="rc-body" d={g.d} /><path class="rc-shine" d={g.d} />
          </g>
        )))}
    </svg>
    <div class="layer rc-ship" style={parked} aria-hidden="true">
      {hasOne && <span class="rc-tok-one" style={hasTwo && finished ? 'opacity:0' : undefined}><img class="rc-ship-img" src={tokOne.src} width={tokOne.attributes.width} height={tokOne.attributes.height} alt="" style={`scale:${shipFace}`} loading="lazy" decoding="async" /></span>}
      {hasTwo && <span class="rc-tok-two" style={hasOne && !finished ? 'opacity:0' : undefined}><img class="rc-ship-img rc-ship-two" src={tokTwo.src} width={tokTwo.attributes.width} height={tokTwo.attributes.height} alt="" style={`scale:${shipFace}`} loading="lazy" decoding="async" /></span>}
      <slot name="ship" />
    </div>
    {places.map((p) => (
      <>
        <!-- The stamp carries the name; this is only the dot on the route. -->
        <p class:list={['rc-name', 'fx', 'fx-fade-up']} data-at={p.at} style={`${at(world.points[p.at])};--from:${p.lands - 4}%;--to:${p.lands}%`} aria-hidden="true"></p>
        <div class="rc-stamp fx fx-pop" data-at={p.at} aria-hidden="true" style={`${at(world.points[p.at])};--from:${p.lands - 3}%;--to:${p.lands}%`}><span style={`--n:${p.name.length}`}>{p.name}</span></div>
      </>
    ))}
    <!-- Not aria-hidden: callers may put interactive content here (pins). -->
    <div class="layer rc-slot"><slot /></div>
  </div>
</div>

<style>
  /* The night chart fills the stage; the ink behind it covers where a tall window runs past the chart's edge. */
  /* Self-contained: these do not lean on the story engine's scoped .layer / .scene-place, so the chart also works outside a scene. */
  .rc, .rc-map, .rc-svg, .rc-ship, .rc-slot { position: absolute; }
  .rc { inset: 0; z-index: 0; overflow: clip; background: var(--color-ink); pointer-events: none; }
  /* The map box: `zoom` x the stage wide, its focus point at the frame centre (translate % is of the box itself). */
  .rc-map { left: 50%; top: var(--rc-top); width: var(--rc-w); translate: calc(var(--rc-x) * -1) calc(var(--rc-y) * -1); }
  /* Static art on its own composited layer so the noodle's repaints never re-raster the 3200px sea. */
  .rc-sea { position: absolute; max-width: none; will-change: transform; contain: paint; }
  .rc-svg { inset: 0; width: 100%; height: 100%; overflow: visible; }
  .rc-svg-draw { will-change: transform; }
  /* Non-scaling strokes are in screen px: the road ahead as dots, the noodle as ink edge, cream body and a thin shine. */
  .rc-svg path { fill: none; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .rc-dots { stroke: var(--color-sand); stroke-opacity: 0.6; stroke-width: 4px; stroke-dasharray: 0.1 10; }
  .rc-ink { stroke: var(--color-ink); stroke-width: 11px; }
  .rc-body { stroke: var(--color-sand); stroke-width: 7px; }
  .rc-shine { stroke: var(--color-paper-light); stroke-opacity: 0.6; stroke-width: 2px; }
  /* Segments meet end to end on a smooth curve: butt caps, so one segment's ink cap never overlays its neighbour's body. */
  .rc-svg-draw path { stroke-linecap: butt; }
  /* The ship: the full-size overlay is what travels (translate % is of the map box); the ship hangs from its top-left corner. */
  .rc-ship { inset: 0; }
  /* Overlay for the section's own content (pins): its children turn pointer events back on. */
  .rc-slot { inset: 0; z-index: 3; }
  .rc-ship-img { position: absolute; left: 0; top: 0; width: clamp(60px, 6vw, 96px); height: auto; max-width: none; translate: -50% -50%;
    /* A game token: the logo's tiger head on a sand disc with an ink rim and a gold ring, so the eye can follow it. */
    box-sizing: border-box; padding: 6px; border-radius: 50%; background: var(--color-sand); border: 2px solid var(--color-ink); box-shadow: 0 0 0 4px rgb(203 160 82 / 0.7); }
  /* The pair rides an oval token, wider so both heads read at the same size as the one. */
  .rc-ship-img.rc-ship-two { width: clamp(84px, 8.4vw, 136px); border-radius: 50% / 50%; }

  /* Places: the name beside its dot (the global .scene-place look, larger), the round postmark slammed above it. */
  .rc-name { position: absolute; z-index: 1; margin: 0; display: flex; align-items: center; gap: 8px; translate: -9px -50%;
    font-family: var(--font-note); font-style: italic; font-weight: 500; color: var(--color-sand); font-size: clamp(20px, 2.4vw, 34px); text-shadow: 0 0 2px var(--color-ink), 0 0 6px var(--color-ink), 0 0 12px var(--color-ink), 0 1px 0 var(--color-ink); }
  .rc-name::before { content: ''; width: 14px; height: 14px; flex: none; border-radius: 50%; background: var(--color-tiger); box-shadow: 0 0 0 3px rgb(237 229 216 / 0.6); }
  .rc-stamp { position: absolute; z-index: 1; display: grid; place-items: center; box-sizing: border-box; width: clamp(76px, 8vw, 120px); aspect-ratio: 1; padding: 6px; translate: -50% calc(-100% - 22px);
    border: 3px double var(--color-tiger); border-radius: 50%; background: var(--color-sand); color: var(--color-ink); text-align: center;
    --s0: 1.6; --r0: -18deg; --r1: -6deg; }
  .rc-stamp span { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; line-height: 1.05; white-space: nowrap;
    /* Sized from the name's length (--n letters, set inline) so long names fit on one line. */
    font-size: min(clamp(9px, 0.95vw, 14px), calc(clamp(76px, 8vw, 120px) * 1.35 / (var(--n, 6) + 2))); }

  @media (max-width: 599px) {
    .rc-map { top: var(--rc-topp); width: var(--rc-wp); translate: calc(var(--rc-xp) * -1) calc(var(--rc-yp) * -1); }
    .rc-dots { stroke-width: 3px; }
    .rc-ink { stroke-width: 8px; }
    .rc-body { stroke-width: 5px; }
    .rc-shine { stroke-width: 1.5px; }
    .rc-pr { flex-direction: row; translate: -9px -50%; }
    .rc-stamp { width: 64px; padding: 3px; border-width: 2px; }
    .rc-stamp span { font-size: min(8px, calc(64px * 1.35 / (var(--n, 6) + 2))); letter-spacing: 0.02em; }
  }
</style>
