---
// "Which tiger are you?" (pending client approval of the tigers; see tigers.ts for removal).
// No JS: each choice is a plain link to its share page. With JS: the pick shows a result here, with Share + Book.
import { Image } from 'astro:assets';
import { TIGERS } from './tigers';

const tigers = Object.values(TIGERS);
---
<div class="tiger-pick" data-tiger-pick>
  <h3 id="tiger-title" class="tp-title">Which tiger are you?</h3>
  <ul class="tp-grid" aria-labelledby="tiger-title">
    {tigers.map((t) => (
      <li>
        <a class="tp-card" href={t.path} data-tiger={t.id} data-name={t.name} data-line={t.line}>
          <Image class="tp-img" src={t.image} alt="" width={160} densities={[1, 2]} loading="lazy" />
          <span class="tp-name">{t.name}</span>
          <span class="tp-trait">{t.trait}</span>
          <span class="tp-line">“{t.line}”</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="tp-msg" role="status" data-tiger-msg></p>
  <div class="tp-actions" data-tiger-actions hidden>
    <button type="button" class="fp-btn" data-tiger-share>Share</button>
    <a class="fp-btn fp-btn--primary" href="/book/" data-book="">Book a table</a>
  </div>
</div>

<style>
  .tiger-pick { display: grid; justify-items: center; gap: var(--space-4); width: 100%; margin-block: var(--space-4); }
  .tp-title { margin: 0; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: var(--tracking-title); font-size: clamp(24px, 3.4vw, 36px); line-height: 1; text-wrap: balance; }
  .tp-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); width: 100%; max-width: 560px; margin: 0; padding: 0; list-style: none; }
  .tp-card { box-sizing: border-box; display: grid; justify-items: center; align-content: start; gap: var(--space-1); min-height: var(--target-min); height: 100%; padding: var(--space-4);
    border: var(--border-control) solid var(--fp-rule-strong); background: var(--fp-field-bg); color: var(--fp-field-fg); text-decoration: none;
    transition: transform var(--dur-spring) var(--curve-spring), box-shadow var(--dur-fast) var(--curve-out), background-color var(--dur-fast) var(--curve-out), color var(--dur-fast) var(--curve-out); }
  /* The heads are black ink, so a chosen card keeps its paper and gets a thick ink frame instead of going dark. */
  .tp-card[aria-pressed='true'] { box-shadow: 0 0 0 4px var(--fp-rule-strong), var(--lift-2); }
  .tp-card:hover { transform: translateY(-3px); box-shadow: var(--lift-2); }
  .tp-card:active { transform: translateY(1px); box-shadow: none; transition-duration: var(--dur-press); }
  .tp-card:focus-visible { outline: var(--ring-width) solid var(--fp-ring); outline-offset: var(--ring-offset); }
  /* Same box for both heads (their art differs in proportion), so the names line up. */
  .tp-img { width: clamp(88px, 18vw, 140px); height: clamp(120px, 24vw, 190px); object-fit: contain; margin-bottom: var(--space-2); }
  .tp-name { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: var(--tracking-title); font-size: clamp(24px, 3.4vw, 32px); line-height: 1; }
  .tp-trait { font-weight: 700; text-transform: uppercase; letter-spacing: var(--tracking-title); font-size: 14px; }
  .tp-line { font-family: var(--font-note); font-style: italic; font-size: 18px; }
  .tp-msg { margin: 0; min-height: 1lh; font-family: var(--font-note); font-style: italic; font-weight: 500; font-size: clamp(19px, 1.8vw, 23px); }
  .tp-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .tp-actions:not([hidden]) { animation: tp-in var(--dur-panel) var(--curve-out) both; }
  @keyframes tp-in { from { opacity: 0; transform: translateY(var(--rise)); } }
  @media (prefers-reduced-motion: reduce) {
    .tp-card:is(:hover, :active) { transform: none; }
    .tp-actions:not([hidden]) { animation: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-tiger-pick]');
  if (root) {
    const cards = [...root.querySelectorAll<HTMLAnchorElement>('[data-tiger]')];
    const msg = root.querySelector<HTMLElement>('[data-tiger-msg]')!;
    const actions = root.querySelector<HTMLElement>('[data-tiger-actions]')!;
    const share = root.querySelector<HTMLButtonElement>('[data-tiger-share]')!;
    let url = '';
    let text = '';
    for (const c of cards) {
      // With script the links act as toggle buttons; without it they stay plain links to the share pages.
      c.setAttribute('role', 'button');
      c.setAttribute('aria-pressed', 'false');
      c.addEventListener('keydown', (e) => { if (e.key === ' ') { e.preventDefault(); c.click(); } });
      c.addEventListener('click', (e) => {
        // Let new-tab / modified clicks go to the share page as normal.
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        for (const o of cards) o.setAttribute('aria-pressed', String(o === c));
        url = new URL(c.getAttribute('href')!, location.origin).href;
        text = `You're a ${c.dataset.name}. ${c.dataset.line}`;
        msg.textContent = text;
        share.textContent = 'Share';
        share.removeAttribute('data-state');
        actions.hidden = false;
      });
    }
    share.addEventListener('click', async () => {
      try {
        if (navigator.share) await navigator.share({ title: 'Fatt Pundit', text, url });
        else {
          await navigator.clipboard.writeText(url);
          share.textContent = 'Link copied';
          share.dataset.state = 'done';
        }
      } catch {
        // Share sheet dismissed (AbortError) or clipboard blocked: nothing to do, the share page link is still the choice's href.
      }
    });
  }
</script>
