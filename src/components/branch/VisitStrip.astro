---
/**
 * The essentials, straight under the branch hero: today's hours, the address, the
 * nearest stations, and Call / Directions / Book. Facts are set as one ledger row
 * (design-system.md, "Phase 2 direction rules"): no cards, hairlines, tabular figures.
 * Without JavaScript the "today" cell points to the full hours further down.
 */
import { directionsUrl, fullAddress, prettyPhone, type Branch } from '../../lib/site-data';

interface Props { branch: Branch; stations: string[] }
const { branch: b, stations } = Astro.props;

---
<div class="visit-strip" data-visit-strip>
  <div class="wrap vs-in">
    <dl class="vs-facts">
      <div>
        <dt data-vs-day>Today</dt>
        {b.hours
          ? <dd data-vs-today data-hours={JSON.stringify(b.hours)} data-tz={b.timezone}><a href="#visit">See today's hours</a></dd>
          : <dd>Opening soon</dd>}
      </div>
      <div>
        <dt>Address</dt>
        <dd>{fullAddress(b)}</dd>
      </div>
      {stations.length > 0 && (
        <div class="vs-stations">
          <dt>Nearest {stations.length > 1 ? 'stations' : 'station'}</dt>
          <dd>{stations.join(', ')}</dd>
        </div>
      )}
    </dl>
    <!-- Directions and Call only: Book is the arrival's one primary action above (ux-structure.md F7). -->
    <p class="vs-act">
      <a href={directionsUrl(b)} target="_blank" rel="noopener">Directions<span class="sr-only"> (opens in a new tab)</span></a>
      {b.phone && <a href={`tel:${b.phone}`}>Call {prettyPhone(b.phone)}</a>}
    </p>
  </div>
</div>

<script>
  import { openStatus, prettyTime, statusLine, type Day, type Hours } from '../../lib/hours';

  for (const dd of document.querySelectorAll<HTMLElement>('[data-vs-today]')) {
    const hours = JSON.parse(dd.dataset.hours!) as Hours;
    const tz = dd.dataset.tz!;
    const paint = () => {
      const now = new Date();
      const long = new Intl.DateTimeFormat('en-GB', { timeZone: tz, weekday: 'long' }).format(now);
      const spans = hours[long.slice(0, 3).toLowerCase() as Day] ?? [];
      const s = openStatus(hours, tz, now);
      const dt = dd.closest('div')?.querySelector('[data-vs-day]');
      if (dt) dt.textContent = `Today · ${long}`;
      const status = document.createElement('span');
      status.className = s.open ? 'vs-open' : 'vs-shut';
      status.textContent = statusLine('', s);
      const times = spans.map(([a, z]) => `${prettyTime(a)} to ${prettyTime(z)}`).join(', ');
      dd.replaceChildren(status, ...(times ? [document.createTextNode(` · ${times}`)] : []));
    };
    paint();
    setInterval(paint, 60_000);
  }
</script>

<style>
  .visit-strip { background: var(--color-paper-light); color: var(--color-ink-deep); border-bottom: 1.5px solid var(--color-ink-deep); }
  .vs-in { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 28px; align-items: center; padding-block: 18px; }
  .vs-facts { display: grid; grid-template-columns: 1.7fr 1.1fr 1.3fr; column-gap: 28px; margin: 0; }
  .vs-facts dt { font-family: var(--font-label); font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #5b544b; }
  .vs-facts dd { margin: 2px 0 0; font-size: 17px; line-height: 1.35; font-variant-numeric: tabular-nums; }
  .vs-facts dd a { color: inherit; }
  /* The status is written by the script, so it carries no scope attribute. */
  .visit-strip :global(:is(.vs-open, .vs-shut)) { font-weight: 700; }
  .visit-strip :global(:is(.vs-open, .vs-shut))::before { content: ''; display: inline-block; width: 9px; height: 9px; margin-right: 8px; border-radius: 50%; background: #2f7d32; }
  .visit-strip :global(.vs-shut)::before { background: none; box-shadow: inset 0 0 0 2px #5b544b; }
  .vs-act { display: flex; align-items: center; gap: 22px; margin: 0; font-size: 16px; font-weight: 700; }
  .vs-act a:not(.btn) { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-ink-deep); text-underline-offset: 4px; }
  .visit-strip :global(*) { --fp-ring: var(--color-ink-deep); }
  @media (max-width: 1100px) { .vs-facts { grid-template-columns: 1.5fr 1fr; } .vs-stations { display: none; } }
  @media (max-width: 960px) { .vs-in { grid-template-columns: 1fr; row-gap: 8px; } }
  /* Phones: one fact per line, then Directions and Call (Book is in the hero and the dock). */
  @media (max-width: 760px) {
    .vs-in { padding-block: 16px; }
    .vs-facts { grid-template-columns: 1fr; row-gap: 10px; }
    .vs-act { flex-wrap: wrap; gap: 4px 22px; }
  }
</style>
