---
/**
 * The essentials, straight under the branch hero: today's hours, the address, the
 * nearest stations, and Directions / Call. Facts are set as one ledger row
 * (the system's .fp-facts + .fp-badge, design-system.md §5): sentence-case labels,
 * tabular figures, status as a dot or ring plus words.
 * Without JavaScript the "today" cell points to the full hours further down.
 */
import { directionsUrl, fullAddress, prettyPhone, type Branch } from '../../lib/site-data';

interface Props { branch: Branch; stations: string[] }
const { branch: b, stations } = Astro.props;

---
<div class="visit-strip surface-paper-light" data-visit-strip>
  <div class="wrap vs-in">
    <dl class="fp-facts vs-facts">
      <div>
        <dt data-vs-day>Today</dt>
        {b.hours
          ? <dd data-vs-today data-hours={JSON.stringify(b.hours)} data-tz={b.timezone}><a class="fp-link fp-link--quiet" href="#visit">See today's hours</a></dd>
          : <dd><span class="fp-badge fp-badge--soon">Opening soon</span></dd>}
      </div>
      <div>
        <dt>Address</dt>
        <!-- Street and postcode only (the city is in the page title and footer); the postcode never splits. -->
        <dd>{b.address.postcode ? <>{b.address.street}, <span class="vs-nowrap">{b.address.postcode}</span></> : fullAddress(b)}</dd>
      </div>
      {stations.length > 0 && (
        <div class="vs-stations">
          <dt>Nearest {stations.length > 1 ? 'stations' : 'station'}</dt>
          <dd>{stations.join(', ')}</dd>
        </div>
      )}
    </dl>
    <!-- Directions and Call only: Book is the arrival's one primary action above (ux-structure.md F7). -->
    <p class="vs-act">
      <a class="fp-link fp-link--strong" href={directionsUrl(b)} target="_blank" rel="noopener">Directions<span class="sr-only"> (opens in a new tab)</span></a>
      {b.phone && <a class="fp-link fp-link--strong" href={`tel:${b.phone}`}>Call {prettyPhone(b.phone)}</a>}
    </p>
  </div>
</div>

<script>
  import { openStatus, prettyTime, statusLine, type Day, type Hours } from '../../lib/hours';

  for (const dd of document.querySelectorAll<HTMLElement>('[data-vs-today]')) {
    const hours = JSON.parse(dd.dataset.hours!) as Hours;
    const tz = dd.dataset.tz!;
    const paint = () => {
      const now = new Date();
      const long = new Intl.DateTimeFormat('en-GB', { timeZone: tz, weekday: 'long' }).format(now);
      const spans = hours[long.slice(0, 3).toLowerCase() as Day] ?? [];
      const s = openStatus(hours, tz, now);
      const dt = dd.closest('div')?.querySelector('[data-vs-day]');
      if (dt) dt.textContent = `Today, ${long}`;
      const status = document.createElement('span');
      status.className = `fp-badge ${s.open ? 'fp-badge--open' : 'fp-badge--closed'}`;
      status.textContent = statusLine('', s);
      const times = spans.map(([a, z]) => `${prettyTime(a)} to ${prettyTime(z)}`).join(', ');
      const when = document.createElement('span');
      when.className = 'vs-times';
      when.textContent = times;
      dd.replaceChildren(status, ...(times ? [when] : []));
    };
    paint();
    setInterval(paint, 60_000);
  }
</script>

<style>
  .visit-strip { border-bottom: var(--border-rule) solid var(--fp-rule-strong); }
  .vs-in { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--space-6); align-items: center; padding-block: var(--space-5); }
  .vs-facts { grid-template-columns: 1.7fr 1.1fr 1.3fr; }
  /* Status and today's times on one line (Phase 8): "Opens 12pm  12pm to 10.30pm" read as one fact. */
  .vs-facts dd:has(> :global(.vs-times)) { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 12px; }
  .vs-nowrap { white-space: nowrap; }
  .vs-act { display: flex; align-items: center; gap: var(--space-5); margin: 0; }
  @media (max-width: 1100px) { .vs-facts { grid-template-columns: 1.5fr 1fr; } .vs-stations { display: none; } }
  @media (max-width: 960px) { .vs-in { grid-template-columns: 1fr; row-gap: var(--space-2); } }
  /* Phones: one fact per line, then Directions and Call (Book is in the hero and the dock). */
  @media (max-width: 760px) {
    .vs-in { padding-block: var(--space-4); }
    .vs-facts { grid-template-columns: 1fr; row-gap: var(--space-3); }
    .vs-act { flex-wrap: wrap; gap: 0 var(--space-5); }
  }
</style>
