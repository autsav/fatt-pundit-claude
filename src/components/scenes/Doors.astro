---
// Scene 2: the doors. Pinned while you scroll: the two tiger doors swing
// open on heavy hinges, the camera pushes through, and warm light floods in
// until the screen turns to sand (the next scene's paper).
import { Image } from 'astro:assets';
import { stampSrc } from '../../lib/stamp';
import tigerLeft from '../../assets/images/brand/tiger-head-left.png';
import tigerRight from '../../assets/images/brand/tiger-head-right.png';
import room from '../../assets/images/covent-garden/gallery-04.jpg';

// Used only as masks (alpha), so a palette PNG is all they need.
const tL = { src: await stampSrc(tigerLeft, 480) };
const tR = { src: await stampSrc(tigerRight, 480) };
---
<section class="doors" data-doors aria-label="Step inside">
  <div class="stage">
    <div class="camera" data-camera>
      <Image src={room} alt="" class="room" widths={[800, 1400, 2000]} sizes="100vw" data-room />
      <div class="dim" data-dim></div>
      <div class="glow" data-glow></div>
      <div class="frame">
        <div class="leaf left" data-leaf="l">
          <div class="panel">
            <span class="tiger" style={`-webkit-mask-image:url(${tL.src});mask-image:url(${tL.src})`}></span>
            <span class="plaque">Calcutta</span>
            <span class="handle"></span>
          </div>
          <span class="shade" data-shade></span>
        </div>
        <div class="leaf right" data-leaf="r">
          <div class="panel">
            <span class="tiger" style={`-webkit-mask-image:url(${tR.src});mask-image:url(${tR.src})`}></span>
            <span class="plaque">Guangdong</span>
            <span class="handle"></span>
          </div>
          <span class="shade" data-shade></span>
        </div>
      </div>
    </div>
    <div class="below" data-comein>
      <p class="come-in">Come in.</p>
      <a class="skip-story" href="#tables" data-skip-story>Skip the story: choose your table</a>
    </div>
    <div class="flood" data-flood>
      <!-- The light past the doors is where the story starts: the voyage picks it up next. -->
      <div class="opening">
        <p class="o-label"><span class="o-no">01</span> Our story</p>
        <p class="o-line">From Guangdong<br />to Calcutta</p>
        <p class="o-sub">Hakka families sailed from southern China with their recipes, and met the spices of India in Tangra, Calcutta's Chinatown.</p>
        <p class="o-cue" aria-hidden="true">Keep scrolling to follow the ship</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* 140vh (was 190): the swing reads the same, the guest reaches the story sooner (Phase 4 S-A). */
  .doors { position: relative; height: 140vh; background: var(--color-ink); --bar: 72px; --fb: clamp(10px, 1.6vw, 18px); }
  /* Soft drop shadow drawn once as a still gradient behind the frame (a 120px
     blur box-shadow inside the scaling camera cost a repaint per frame). */
  /* The frame fits the space below the sticky header with room for the line beneath it
     (it was sized to the full screen height, so the header clipped its top and its foot ran off screen). */
  .stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; display: grid; grid-template-rows: minmax(0, 1fr) auto; justify-items: center; align-items: center; padding: calc(var(--bar) + 16px) 16px 16px; box-sizing: border-box; }
  .camera { position: relative; container-type: inline-size; width: min(92vw, calc((100svh - var(--bar) - 112px) * 5 / 6)); aspect-ratio: 5 / 6; transform-origin: 50% 46%; will-change: transform; }
  /* Room, dark layer and glow start exactly where the door panels start (border + padding);
     at 4.5% they showed as a dark strip down both door edges. */
  .room { position: absolute; inset: calc(var(--fb) + 3.2cqw); width: calc(100% - 2 * (var(--fb) + 3.2cqw)); height: calc(100% - 2 * (var(--fb) + 3.2cqw)); object-fit: cover; }
  /* Darkness is a layer that fades (opacity = compositor only); a brightness
     filter here forced a full repaint of the photo every scroll frame. */
  .dim { position: absolute; inset: calc(var(--fb) + 3.2cqw); background: #000; opacity: 0.65; will-change: opacity; }
  .glow { position: absolute; inset: calc(var(--fb) + 3.2cqw); background: radial-gradient(60% 55% at 50% 50%, rgb(203 160 82 / 0.42), transparent 70%); opacity: 0; will-change: opacity; }
  /* A hard offset shadow, like the site's other objects (the soft radial glow behind it read as a muddy halo). */
  .frame { position: absolute; inset: 0; border: var(--fb) solid var(--color-gold); box-shadow: inset 0 0 0 3px var(--color-ink), 12px 12px 0 rgb(0 0 0 / 0.35); perspective: 1600px; display: flex; padding: 3.2%; box-sizing: border-box; }
  .leaf { position: relative; flex: 1 1 50%; transform-style: preserve-3d; will-change: transform; }
  .leaf.left { transform-origin: left center; }
  .leaf.right { transform-origin: right center; }
  .panel { position: absolute; inset: 0; background: var(--color-sand); border: 3px solid var(--color-ink); box-shadow: inset 0 0 0 10px var(--color-sand), inset 0 0 0 12px rgb(44 41 37 / 0.35); display: grid; place-items: center; backface-visibility: hidden; }
  .tiger { width: 78%; aspect-ratio: 3 / 4; background: var(--color-ink); -webkit-mask-position: center; mask-position: center; -webkit-mask-size: contain; mask-size: contain; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; }
  /* Brass plaques: which kitchen each tiger stands for (an object, so capitals are allowed). */
  .plaque { position: absolute; bottom: 7%; left: 50%; translate: -50% 0; padding: 0.35em 0.9em; background: var(--color-gold); color: var(--color-ink); border: 2px solid var(--color-ink); box-shadow: 3px 3px 0 rgb(44 41 37 / 0.35); font-family: var(--font-display); font-weight: 700; font-size: clamp(11px, 3.4cqw, 18px); letter-spacing: 0.16em; text-transform: uppercase; white-space: nowrap; }
  .handle { position: absolute; top: 55%; width: 10px; height: 54px; background: var(--color-gold); box-shadow: 0 2px 0 rgb(0 0 0 / 0.3); }
  .left .handle { right: 14px; } .right .handle { left: 14px; }
  /* Shade on the opening edge sells the weight of the door. */
  .shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, transparent 40%, rgb(0 0 0 / 0.55)); opacity: 0; will-change: opacity; }
  .right .shade { background: linear-gradient(270deg, transparent 40%, rgb(0 0 0 / 0.55)); }
  /* Below the doors, on ink: gold reads at about 6:1 here (it was gold on the sand doors, about 1.6:1, split by the door gap). */
  .below { display: grid; justify-items: center; gap: 4px; padding-top: 12px; will-change: opacity; }
  .come-in { margin: 0; font-family: var(--font-note); font-style: italic; color: var(--color-gold); font-size: clamp(18px, 2vw, 24px); }
  .skip-story { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-sand); font-size: 15px; text-decoration: underline; text-underline-offset: 4px; }
  .skip-story:hover { color: var(--color-gold); }
  .flood { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; background: radial-gradient(circle at 50% 46%, var(--color-sand) 0 30%, var(--color-gold) 70%); opacity: 0; pointer-events: none; will-change: opacity; }
  .opening { display: grid; justify-items: center; gap: clamp(14px, 2vw, 22px); max-width: min(100%, 1000px); text-align: center; color: var(--color-ink); }
  .opening p { margin: 0; }
  /* Chapter 01: the same numbered label (rule above, number, plain words) as the home chapters that follow. */
  .o-label { display: inline-flex; gap: var(--space-2); padding-top: var(--space-3); border-top: var(--border-rule) solid var(--color-ink); font-size: var(--step-label); font-weight: 700; line-height: 1.3; }
  .o-no { color: var(--color-tiger-deep); font-variant-numeric: tabular-nums; }
  .o-line { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: var(--tracking-title); font-size: clamp(40px, 6.4vw, 92px); line-height: 0.95; }
  .o-sub { font-size: clamp(16px, 1.4vw, 19px); line-height: 1.5; max-width: 44ch; }
  .o-cue { font-family: var(--font-note); font-style: italic; font-size: 16px; color: var(--color-gold-deep); }

  @media (max-width: 700px) { .doors { height: 130vh; } }
  /* Phones: keep the line under the doors clear of the fixed dock. */
  @media (max-width: 640px) { .doors { --bar: 64px; } .stage { padding-bottom: calc(68px + env(safe-area-inset-bottom)); } }
  @media (min-width: 641px) and (max-height: 700px) { .doors { --bar: 58px; } }
  @media (prefers-reduced-motion: reduce) {
    .doors { height: auto; }
    .stage { position: relative; height: 80svh; }
    /* No swing in calm mode: the light past the doors (and the opening of the story) is simply there. */
    .flood { opacity: 1; }
    .o-cue { display: none; }
    .left { transform: rotateY(-62deg); } .right { transform: rotateY(62deg); } .dim { opacity: 0; }
  }
</style>

<script>
  import { scroll } from 'motion';

  const section = document.querySelector<HTMLElement>('[data-doors]');
  const camera = section?.querySelector<HTMLElement>('[data-camera]');
  const stage = section?.querySelector<HTMLElement>('.stage');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const range = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
  // Heavy door: slow start, then swings, then settles.
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  // Decode the room photo before it is needed, so its first draw doesn't
  // land in the middle of a scroll frame.
  const room = section?.querySelector<HTMLImageElement>('[data-room]');
  if (section && room) {
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      room.loading = 'eager';
      room.decode().catch(() => {});
    }, { rootMargin: '150% 0px' });
    io.observe(section);
  }

  if (section && camera && stage && !calm) {
    // Write transform/opacity straight onto each element. Custom properties on
    // the camera made every child recalc style each frame.
    const q = <T extends Element>(sel: string) => [...section.querySelectorAll<T>(sel)];
    const [leafL, leafR] = q<HTMLElement>('[data-leaf]');
    const shades = q<HTMLElement>('[data-shade]');
    const dim = section.querySelector<HTMLElement>('[data-dim]')!;
    const glow = section.querySelector<HTMLElement>('[data-glow]')!;
    const comein = section.querySelector<HTMLElement>('[data-comein]')!;
    const flood = section.querySelector<HTMLElement>('[data-flood]')!;
    let last = -1;
    scroll(
      (p: number) => {
        if (Math.abs(p - last) < 0.0005) return;
        last = p;
        const open = ease(range(p, 0.04, 0.55));
        const push = ease(range(p, 0.3, 0.92));
        camera.style.transform = `scale(${(1 + push * 1.6).toFixed(4)})`;
        leafL.style.transform = `rotateY(${(open * -112).toFixed(2)}deg)`;
        leafR.style.transform = `rotateY(${(open * 112).toFixed(2)}deg)`;
        const shade = Math.min(1, open * 1.4).toFixed(3);
        for (const s of shades) s.style.opacity = shade;
        dim.style.opacity = (0.65 * (1 - range(p, 0.08, 0.6))).toFixed(3);
        glow.style.opacity = range(p, 0.2, 0.7).toFixed(3);
        const below = Math.max(0, 1 - open * 4);
        comein.style.opacity = below.toFixed(3);
        comein.style.visibility = below > 0.05 ? 'visible' : 'hidden';
        flood.style.opacity = ease(range(p, 0.72, 0.98)).toFixed(3);
      },
      { target: section, offset: ['start start', 'end end'] },
    );
  }
</script>
