---
/**
 * Home, first screen: rain on the restaurant window, full screen (the immersive hero, kept after the
 * Phase 5 review). The dining room glows behind fogged glass; the name, the restaurant board and Book
 * sit centred on a soft dark pool. Only the glass is a React island; the words are static HTML,
 * painted finished. Wiping works anywhere the words aren't (they let pointer events through).
 * Phones leave Book to the dock (one tiger action per view).
 */
import GateBoard from './GateBoard.astro';
import RainHero from './RainHero.astro';
import Namemark from '../site/Namemark.astro';
import type { Branch } from '@/lib/site-data';

interface Props {
  branches: Branch[];
  rainSrc: string;
  rainPoster: string;
  posterSrcset?: string;
  posterSizes?: string;
}
const { branches, rainSrc, rainPoster, posterSrcset, posterSizes } = Astro.props;
// The street plate at the foot of the window: you step back onto Maiden Lane before the door scene.
// From the data: "6 Maiden Lane" -> "Maiden Lane"; "WC2E 7NA" -> "WC2" (plates show the district).
const cg = branches.find((b) => b.id === 'covent-garden');
const plateStreet = cg?.address.street.replace(/^\d+\s*/, '');
const plateDistrict = cg?.address.postcode?.split(' ')[0].replace(/(\d)[A-Z]$/, '$1');
---
<!-- The hero's Book is on screen at first, so the header's Book waits (set before the header paints;
     without JavaScript the attribute is never set and the header's Book simply stays). -->
<script is:inline>document.documentElement.dataset.heroBook = 'in';</script>
<section id="top" class="hero rain" aria-labelledby="hero-title">
  <div class="hero-glass" role="img" aria-label="The dining room at Covent Garden through a rainy window: pink booths and bentwood chairs under shelves of brass lamps">
    <RainHero src={rainSrc} poster={rainPoster} posterSrcset={posterSrcset} posterSizes={posterSizes} />
    <!-- Direction C scene 2: the shelf lamps breathe (a warm pool over the top of the room). -->
    <span class="hero-lamps" aria-hidden="true"></span>
  </div>
  <!-- ...and the glass mists over as you leave the window for the street. -->
  <span class="hero-mist" aria-hidden="true"></span>
  <div class="hero-words">
    <p class="hero-kicker">Hakka cooking from Calcutta's Chinatown</p>
    <h1 id="hero-title" class="hero-title" data-hero-title><span class="sr-only">Fatt Pundit</span><Namemark class="hero-mark hero-mark--line" /><Namemark variant="stack" class="hero-mark hero-mark--stack" /></h1>
    <div class="hero-board"><GateBoard branches={branches} /></div>
    <div class="hero-actions">
      <a class="fp-btn fp-btn--primary hero-book" href="/book/" data-book="">Book a table</a>
    </div>
    <p class="hero-wipe" aria-hidden="true">Wipe the glass to look inside</p>
  </div>
  <!-- Decorative: the door scene names the street for screen readers. -->
  {plateStreet && (
    <div class="hero-plate fp-reveal" aria-hidden="true">
      <span class="plate-name">{plateStreet}{plateDistrict && <span class="plate-district">{plateDistrict}</span>}</span>
      <span class="plate-city">City of Westminster</span>
    </div>
  )}
</section>

<script>
  import { animate } from 'animejs';
  import { EASE, MS } from '@/lib/motion-tokens';

  // One Book in view: the header's Book steps aside while the hero's Book is on screen, and comes
  // back (stamped in) once the guest scrolls past it.
  const actions = document.querySelector<HTMLElement>('.hero-actions');
  const headerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 72;
  if (actions && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([e]) => { document.documentElement.dataset.heroBook = e.isIntersecting ? 'in' : 'out'; },
      { rootMargin: `-${headerH}px 0px 0px 0px` },
    );
    io.observe(actions);
  } else document.documentElement.dataset.heroBook = 'out';

  // The room behind the glass drifts a few pixels with the mouse (desktop, motion on, not paused): depth.
  // It uses the `translate` property, so it adds to the scroll drift on `transform` (global.css "Home hero").
  const glass = document.querySelector<HTMLElement>('.hero-glass');
  const hero = document.querySelector<HTMLElement>('#top');
  if (glass && hero && window.matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    let raf = 0, x = 0, y = 0;
    hero.addEventListener('pointermove', (e) => {
      if (document.documentElement.dataset.motion === 'paused') return;
      x = e.clientX / innerWidth - 0.5; y = e.clientY / innerHeight - 0.5;
      if (!raf) raf = requestAnimationFrame(() => { raf = 0; glass.style.translate = `${(-x * 14).toFixed(1)}px ${(-y * 8).toFixed(1)}px`; });
    }, { passive: true });
    hero.addEventListener('pointerleave', () => { glass.style.translate = ''; });
  }

  // The wipe hint appears once, after ~3s with no pointer input (a guest who is already wiping needs none).
  // Mouse and trackpad only: on touch, vertical swipes scroll the page, so the hint promised what a phone can't do (AUDIT B-20).
  const wipe = document.querySelector<HTMLElement>('.hero-wipe');
  if (wipe && window.matchMedia('(pointer: fine)').matches) {
    // Only when the glass is live (src/lib/rain-glass.ts shows its canvas); without a GPU the still can't be wiped.
    const live = () => document.querySelector<HTMLElement>('[data-rain-glass] canvas')?.style.opacity === '1';
    const t = window.setTimeout(() => { if (live()) wipe.classList.add('is-on'); }, 3000);
    window.addEventListener('pointerdown', () => window.clearTimeout(t), { once: true, passive: true });
    window.addEventListener('pointermove', () => window.clearTimeout(t), { once: true, passive: true });
  }

  // First visit only: the namemark rises out of a clip as the arrival shutter opens (it is approved
  // artwork, guidelines p.8, so it moves as one piece: never split into letters). Returning guests
  // (and calm mode, where the board never plays) get the name painted finished.
  const el = document.querySelector<HTMLElement>('[data-hero-title]');
  if (el && document.documentElement.dataset.arrival === 'play') {
    window.addEventListener(
      'fp:opening',
      () => {
        // Starts with the shutter, not after it, so the name is readable as the board opens. The soft
        // shadow is held off while it rises (the clip would cut it).
        const marks = el.querySelectorAll<HTMLElement>('.hero-mark');
        el.classList.add('is-rising', 'is-clipped');
        for (const m of marks) m.style.transform = 'translateY(110%)';
        animate(marks, {
          y: ['110%', '0%'],
          duration: MS.story,
          ease: EASE.animeOut,
          onComplete: () => {
            el.classList.remove('is-clipped');
            for (const m of marks) m.style.transform = '';
          },
        });
      },
      { once: true },
    );
  }
</script>

<style>
  .hero { position: relative; display: grid; grid-template-rows: 1fr auto; place-items: center; min-height: calc(100svh - var(--header-h, 72px)); overflow: hidden; background: var(--color-ink); color: var(--color-sand); }
  /* The glass dissolves into the street below over its last 20svh (no flat edge). */
  .hero-glass { position: absolute; inset: 0; transition: translate 900ms var(--curve-out); -webkit-mask-image: linear-gradient(#000 calc(100% - 20svh), transparent); mask-image: linear-gradient(#000 calc(100% - 20svh), transparent); }

  /* The words float on the glass: they let drags through to it, only their links take pointers. */
  .hero-words { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: var(--space-5); width: 100%; max-width: 64rem; padding: var(--space-8) var(--space-5); text-align: center; pointer-events: none; }
  .hero-words :is(a, .hero-board) { pointer-events: auto; }
  .hero-kicker { margin: 0; font-family: var(--font-note); font-style: italic; font-weight: 500; font-size: var(--step-h4); color: var(--color-gold); }
  /* The approved namemark (guidelines p.8), sized by font-size: the line mark is 10em wide, so 8.6vw keeps
     it inside the screen; phones get the stacked mark (5.6em wide). Sand on the dark pool, like the
     cream embroidery on the black apron (p.40). */
  .hero-title { margin: 0; font-size: min(clamp(52px, 8.6vw, 124px), 17svh); line-height: 0; color: var(--color-sand); }
  .hero-title :global(.hero-mark svg) { filter: drop-shadow(0 6px 30px rgb(0 0 0 / 0.55)); }
  .hero-title.is-clipped { overflow: clip; }
  .hero-title.is-clipped :global(.hero-mark svg) { filter: none; }
  .hero-title :global(.hero-mark--stack) { display: none; }
  @media (max-width: 639px) {
    .hero-title :global(.hero-mark--line) { display: none; }
    .hero-title :global(.hero-mark--stack) { display: inline-block; }
  }
  /* Held back while the arrival board is up; the script lets it rise as the board opens. */
  :global(html[data-arrival='play']) .hero-title:not(.is-rising) { opacity: 0; }
  .hero-board { width: 100%; margin-top: var(--space-2); }
  .hero-actions { display: flex; justify-content: center; width: 100%; }
  .hero-book { min-width: min(280px, 100%); }
  .hero-wipe { margin: 0; font-family: var(--font-note); font-style: italic; font-size: var(--step-small); color: rgb(218 199 181 / 0.8); opacity: 0; transition: opacity var(--dur-panel); }
  .hero-wipe.is-on { opacity: 1; }

  /* The street plate: white enamel, black letters, red district, two screws, on the dark of the wall
     (a London street name plate). Sits in the hero's bottom fade, above it (z-index). */
  .hero-plate { position: relative; z-index: 1; display: grid; justify-items: center; gap: 0.35em; margin-block: var(--space-4) clamp(20px, 5svh, 48px); padding: 0.75em 2.4em 0.6em; font-size: clamp(12px, 1vw + 8.5px, 17px); background: linear-gradient(#fdfcf8, #ece8df); color: #161412; border-radius: 0.45em; box-shadow: inset 0 0 0 0.28em #fdfcf8, inset 0 0 0 0.4em #161412, 0 0.6em 1.4em rgb(0 0 0 / 0.55), 0 0.1em 0.2em rgb(0 0 0 / 0.4); text-align: center; white-space: nowrap; }
  .hero-plate::before, .hero-plate::after { content: ''; position: absolute; top: 50%; width: 0.42em; height: 0.42em; margin-top: -0.21em; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #fff, #9a958c 70%); box-shadow: 0 1px 1px rgb(0 0 0 / 0.35); }
  .hero-plate::before { left: 0.95em; }
  .hero-plate::after { right: 0.95em; }
  .plate-name { font-family: var(--font-display); font-weight: 700; font-size: 1.5em; line-height: 1; letter-spacing: 0.06em; text-transform: uppercase; }
  .plate-district { margin-left: 0.5em; color: #c8241b; }
  .plate-city { font-family: var(--font-label); font-size: 0.6em; letter-spacing: 0.2em; text-transform: uppercase; color: #3a3631; }

  /* Header Book waits while the hero's is in view (≥640; on phones the dock holds Book). */
  :global(html[data-hero-book='in'] .bar .nav-book) { visibility: hidden; }
  :global(html[data-hero-book='out'] .bar .nav-book) { animation: hero-book-in var(--dur-spring) var(--curve-spring); }
  @keyframes hero-book-in { from { transform: translateY(-8px) scale(1.06); } to { transform: none; } }

  /* Phones: the dock carries Book, so the hero doesn't repeat it (one tiger action per view). */
  @media (max-width: 639px) {
    .hero-actions { display: none; }
    .hero-words { gap: var(--space-4); padding-block: var(--space-7); }
  }
  /* Wide but short screens (laptops at 150%): the board gives up a little height. */
  @media (min-width: 641px) and (max-height: 700px) {
    .hero-words { gap: var(--space-4); padding-block: var(--space-6); }
    .hero-board :global(.gate) { min-height: 60px; padding-block: 6px; }
  }
</style>
