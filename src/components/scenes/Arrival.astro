---
// Scene 0: arrival. First visit on this device only, ~1.5 s. Skip, a tap, a key or a scroll ends it.
// A departure board clatters into FATT PUNDIT, the tiger stamp thuds down,
// and the board splits open onto the rainy street.
import { stampSrc } from '../../lib/stamp';
import ArrivalBoard from './ArrivalBoard.tsx';
// Tiger-orange stamp as a plain picture (a CSS mask made the browser wait on
// scripts before it counted as painted).
import stamp from '../../assets/images/brand/logo-stamp-tiger.png';
// Negative logo = tiger orange on dark (guidelines p.15): drawn as a mask so the colour is exact.
const stampImg = { src: await stampSrc(stamp, 320) };
---
<script is:inline>
  // Decide before first paint, so returning guests never see a flash of the board.
  (function () {
    var d = document.documentElement, play = true;
    try { play = !(localStorage.getItem('fp-arrived') || sessionStorage.getItem('fp-arrived')); } catch (e) {}
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) play = false;
    d.dataset.arrival = play ? 'play' : 'skip';
  })();
</script>

<!-- The stamp is the biggest thing on the first screen: fetch it first. -->
<link rel="preload" as="image" href={stampImg.src} fetchpriority="high" />
<div class="arrival" data-arrival-overlay>
  <div class="half top"></div>
  <div class="half bottom"></div>
  <div class="center" aria-hidden="true">
    <p class="kicker">Now arriving</p>
    <div class="board"><ArrivalBoard client:load /></div>
    <p class="route">Guangdong, Calcutta, London, Dubai</p>
    <img class="stamp" data-stamp src={stampImg.src} alt="" width="329" height="430" fetchpriority="high" decoding="sync" />
  </div>
  <button class="skip-arrival" type="button" data-skip>Skip</button>
</div>

<style>
  .arrival { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; pointer-events: auto; }
  :global(html[data-arrival='skip']) .arrival { display: none; }
  .half { position: absolute; left: 0; right: 0; height: 50.5%; background: var(--color-ink); }
  .half.top { top: 0; border-bottom: 1px solid rgb(203 160 82 / 0.25); }
  .half.bottom { bottom: 0; }
  .center { position: relative; display: flex; flex-direction: column; align-items: center; gap: 22px; padding: 24px; text-align: center; }
  .kicker { margin: 0; font-family: var(--font-label); font-weight: 700; letter-spacing: 0.4em; text-transform: uppercase; color: var(--color-gold); font-size: 13px; }
  .route { margin: 0; font-family: var(--font-note); font-style: italic; color: rgb(218 199 181 / 0.88); font-size: 17px; letter-spacing: 0.04em; }
  /* Below the board, never over its letters. */
  .stamp { width: clamp(84px, 10vw, 130px); height: auto; margin-top: -4px; opacity: 0.92; pointer-events: none; }
  .skip-arrival { position: absolute; right: 20px; bottom: 20px; min-height: 44px; padding: 0 18px; background: transparent; border: 1px solid rgb(218 199 181 / 0.4); color: var(--color-sand); font: inherit; font-size: 14px; text-transform: uppercase; letter-spacing: 0.14em; cursor: pointer; }
  .skip-arrival:hover { border-color: var(--color-gold); color: var(--color-gold); }
</style>

<script>
  import { createTimeline } from 'animejs';

  const root = document.querySelector<HTMLElement>('[data-arrival-overlay]');
  const html = document.documentElement;

  function finish() {
    if (!root || !root.isConnected) return;
    root.remove();
    html.dataset.arrival = 'done';
    try { localStorage.setItem('fp-arrived', '1'); } catch {}
    window.dispatchEvent(new Event('fp:arrived'));
  }

  if (root && html.dataset.arrival === 'play') {
    document.body.style.overflow = 'hidden';
    // While the board is up, nothing behind it can take keyboard focus (only Skip can).
    const behind: HTMLElement[] = [];
    for (let el: HTMLElement = root; el.parentElement && el !== document.body; el = el.parentElement) {
      for (const s of el.parentElement.children) if (s !== el && s instanceof HTMLElement && !s.inert && !/^(SCRIPT|STYLE|LINK)$/.test(s.tagName)) { s.inert = true; behind.push(s); }
    }
    const ac = new AbortController();
    let started = false;
    const open = (fast = false) => {
      if (started) return;
      started = true;
      ac.abort();
      for (const s of behind) s.inert = false;
      // The shutter is about to open: give scrolling back now, not when the last frame lands.
      window.setTimeout(() => { document.body.style.overflow = ''; }, fast ? 0 : 760);
      // The board is leaving: take it out of the accessibility tree and the tab order now,
      // not when the last frame lands (a fading label is not content).
      root.setAttribute('aria-hidden', 'true');
      root.inert = true;
      // A choreographed intro with its own beats (a documented exception in docs/MOTION.md).
      const tl = createTimeline({
        onComplete: () => { document.body.style.overflow = ''; finish(); },
      });
      if (!fast) {
        // The stamp thuds onto the board…
        // Painted from the first frame (so the page's main picture is not held back
        // by the intro); the thud is a press, not an appearance.
        tl.add('[data-stamp]', { scale: [1, 1.14, 1], duration: 380, ease: 'inOutQuad' })
          // …the whole board jolts from the impact…
          .add('.arrival .center', { x: [0, -6, 5, -3, 0], y: [0, 4, -2, 0], duration: 260, ease: 'outQuad' }, '-=40')
          // …a breath, then it splits open like a station shutter.
          .add('.arrival .center', { opacity: [1, 0], scale: [1, 0.96], duration: 300, ease: 'inQuad' }, '+=100');
      }
      tl.add('.arrival .half.top', { y: ['0%', '-101%'], duration: fast ? 380 : 560, ease: 'inOutExpo' }, fast ? 0 : '-=120')
        .add('.arrival .half.bottom', { y: ['0%', '101%'], duration: fast ? 380 : 560, ease: 'inOutExpo' }, '<<')
        .add('.arrival .skip-arrival', { opacity: 0, duration: 150 }, '<<');
    };
    window.addEventListener('fp:board-done', () => open(false), { once: true });
    root.querySelector('[data-skip]')?.addEventListener('click', () => open(true));
    // Any attempt to get on with it ends the intro: a tap, a scroll, or a key (Tab still reaches Skip).
    for (const ev of ['pointerdown', 'wheel', 'touchmove'] as const) window.addEventListener(ev, () => open(true), { passive: true, signal: ac.signal });
    window.addEventListener('keydown', (e) => { if (e.key !== 'Tab' && e.key !== 'Shift') open(true); }, { signal: ac.signal });
    // Safety net: never trap a guest behind the board.
    window.setTimeout(() => open(true), 4500);
  } else {
    finish();
  }
</script>
