---
// Scene 0: arrival. First visit on this device only, at most 1.2 s (AUDIT B-04). Skip, a tap, a key or a scroll ends it.
// A departure board clatters into FATT PUNDIT, the tiger stamp thuds down,
// and the board splits open onto the rainy street.
import { stampSrc } from '../../lib/stamp';
// Tiger-orange stamp as a plain picture (a CSS mask made the browser wait on
// scripts before it counted as painted).
import stamp from '../../assets/images/brand/logo-stamp-tiger.png';
// Negative logo = tiger orange on dark (guidelines p.15): drawn as a mask so the colour is exact.
const stampImg = { src: await stampSrc(stamp, 320) };
---
<script is:inline>
  // Decide before first paint, so returning guests never see a flash of the board.
  (function () {
    var d = document.documentElement, play = true;
    try { play = !(localStorage.getItem('fp-arrived') || sessionStorage.getItem('fp-arrived')); } catch (e) {}
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) play = false;
    d.dataset.arrival = play ? 'play' : 'skip';
  })();
</script>

<noscript><style>[data-arrival-overlay] { display: none; }</style></noscript>
<div class="arrival" data-arrival-overlay>
  <div class="half top"></div>
  <div class="half bottom"></div>
  <div class="center" aria-hidden="true">
    <p class="kicker">Now arriving</p>
    <div class="board"></div>
    <p class="route">Guangdong, Calcutta, London, Dubai</p>
    <img class="stamp" data-stamp src={stampImg.src} alt="" width="329" height="430" loading="lazy" decoding="async" />
  </div>
  <button class="skip-arrival" type="button" data-skip>Skip</button>
</div>

<style>
  /* AUDIT B-01. Laid out only when the inline script chose to play it (never without JavaScript; the
     <noscript> style agrees), and whatever the scripts do, a pure-CSS fail-safe hides it 1.2 s after the
     page starts (the brief's budget), so a failed module can hold the page for 1.2 s at most.
     Not hidden until the module loads: that variant cost ~500 ms of lab LCP on home (P86 vs P90-93,
     interleaved runs, 24 Nov); real-user LCP was the same either way. */
  .arrival { position: fixed; inset: 0; z-index: 100; display: none; place-items: center; pointer-events: auto; }
  :global(html[data-arrival='play']) .arrival { display: grid; animation: arrival-failsafe 1ms linear 1.2s forwards; }
  /* Both ends hidden: a one-ended keyframe left visibility 'visible' and opacity at 1e-13 in Chromium. */
  @keyframes arrival-failsafe { from, to { opacity: 0; visibility: hidden; pointer-events: none; } }
  .half { position: absolute; left: 0; right: 0; height: 50.5%; background: var(--color-ink); }
  .half.top { top: 0; border-bottom: 1px solid rgb(203 160 82 / 0.25); }
  .half.bottom { bottom: 0; }
  .center { position: relative; display: flex; flex-direction: column; align-items: center; gap: 22px; padding: 24px; text-align: center; }
  .kicker { margin: 0; font-family: var(--font-label); font-weight: 700; letter-spacing: 0.4em; text-transform: uppercase; color: var(--color-gold); font-size: 13px; }
  .route { margin: 0; font-family: var(--font-note); font-style: italic; color: rgb(218 199 181 / 0.88); font-size: 17px; letter-spacing: 0.04em; }
  /* Below the board, never over its letters. */
  .stamp { width: clamp(84px, 10vw, 130px); height: auto; margin-top: -4px; opacity: 0.92; pointer-events: none; }
  .skip-arrival { position: absolute; right: 20px; bottom: 20px; min-height: 44px; padding: 0 18px; background: transparent; border: 1px solid rgb(218 199 181 / 0.4); color: var(--color-sand); font: inherit; font-size: 14px; text-transform: uppercase; letter-spacing: 0.14em; cursor: pointer; }
  .skip-arrival:hover { border-color: var(--color-gold); color: var(--color-gold); }
</style>

<script>
  import { createTimeline, spring } from 'animejs';
  import { SPRING, animeSpring } from '@/lib/motion-tokens';
  import { lockScroll, unlockScroll } from '@/lib/smooth-scroll';

  const root = document.querySelector<HTMLElement>('[data-arrival-overlay]');
  const html = document.documentElement;
  let board: { unmount(): void } | null = null;

  function finish() {
    if (!root || !root.isConnected) return;
    board?.unmount();
    board = null;
    root.remove();
    html.dataset.arrival = 'done';
    try { localStorage.setItem('fp-arrived', '1'); } catch {}
    window.dispatchEvent(new Event('fp:arrived'));
  }

  if (root && html.dataset.arrival === 'play') {
    // Skip takes the focus while the board is up (B-04).
    root.querySelector<HTMLElement>('[data-skip]')?.focus({ preventScroll: true });
    document.body.style.overflow = 'hidden';
    lockScroll();
    // While the board is up, nothing behind it can take keyboard focus (only Skip can).
    const behind: HTMLElement[] = [];
    for (let el: HTMLElement = root; el.parentElement && el !== document.body; el = el.parentElement) {
      for (const s of el.parentElement.children) if (s !== el && s instanceof HTMLElement && !s.inert && !/^(SCRIPT|STYLE|LINK)$/.test(s.tagName)) { s.inert = true; behind.push(s); }
    }
    // The board is mounted only here, so returning guests never download or hydrate it; the stamp
    // fetches at high priority only now.
    const stamp = root.querySelector<HTMLImageElement>('[data-stamp]');
    if (stamp) { stamp.loading = 'eager'; stamp.fetchPriority = 'high'; }
    const boardEl = root.querySelector<HTMLElement>('.board');
    if (boardEl) {
      Promise.all([import('react'), import('react-dom/client'), import('./ArrivalBoard.tsx')]).then(([{ createElement }, { createRoot }, { default: Board }]) => {
        if (!boardEl.isConnected) return;
        const r = createRoot(boardEl);
        r.render(createElement(Board));
        board = r;
      });
    }
    const ac = new AbortController();
    let started = false;
    let unlocked = false;
    const open = (fast = false) => {
      if (started) return;
      started = true;
      ac.abort();
      // The hero's name starts rising with the shutter, not after it.
      window.dispatchEvent(new Event('fp:opening'));
      for (const s of behind) s.inert = false;
      // The shutter is about to open: give scrolling back now, not when the last frame lands.
      window.setTimeout(() => { document.body.style.overflow = ''; if (!unlocked) { unlocked = true; unlockScroll(); } }, fast ? 0 : 520);
      // The board is leaving: take it out of the accessibility tree and the tab order now,
      // not when the last frame lands (a fading label is not content).
      // Skip had the focus: hand it back to the top of the page, so the next Tab is "Skip to content",
      // not whatever follows the board in the document.
      if (root.contains(document.activeElement)) {
        const b = document.body; b.tabIndex = -1; b.focus({ preventScroll: true }); b.removeAttribute('tabindex');
      }
      root.setAttribute('aria-hidden', 'true');
      root.inert = true;
      // A choreographed intro with its own beats (a documented exception in docs/MOTION.md).
      const tl = createTimeline({
        onComplete: () => { document.body.style.overflow = ''; if (!unlocked) { unlocked = true; unlockScroll(); } finish(); },
      });
      if (!fast) {
        // The stamp thuds onto the board (a spring: it has weight), the board jolts and the shutter
        // starts to split while the thud still rings, with no pause between beats.
        tl.add('[data-stamp]', { scale: [1.14, 1], ease: spring(animeSpring(SPRING.stamp)) }, 0)
          .add('.arrival .center', { x: [0, -6, 5, -3, 0], y: [0, 4, -2, 0], duration: 260, ease: 'outQuad' }, 60)
          .add('.arrival .center', { opacity: [1, 0], scale: [1, 0.96], duration: 300, ease: 'inQuad' }, 160);
      }
      tl.add('.arrival .half.top', { y: ['0%', '-101%'], duration: fast ? 300 : 400, ease: 'inOutExpo' }, fast ? 0 : 100)
        .add('.arrival .half.bottom', { y: ['0%', '101%'], duration: fast ? 300 : 400, ease: 'inOutExpo' }, '<<')
        .add('.arrival .skip-arrival', { opacity: 0, duration: 150 }, '<<');
    };
    window.addEventListener('fp:board-done', () => open(false), { once: true });
    root.querySelector('[data-skip]')?.addEventListener('click', () => open(true));
    // Any attempt to get on with it ends the intro: a tap, a scroll, or a key (Tab still reaches Skip).
    for (const ev of ['pointerdown', 'wheel', 'touchmove'] as const) window.addEventListener(ev, () => open(true), { passive: true, signal: ac.signal });
    window.addEventListener('keydown', (e) => { if (e.key !== 'Tab' && e.key !== 'Shift') open(true); }, { signal: ac.signal });
    // Budget (AUDIT B-04: the page is in by 1.2 s after navigation, not after this script loads): the
    // shutter starts by 0.65 s even if the flaps are still settling (0.1 + 0.4 s to clear), and a fast
    // open (0.3 s) at 0.85 s is the last resort. The CSS fail-safe above hides the board at 1.2 s regardless.
    const since = performance.now();
    window.setTimeout(() => open(false), Math.max(0, 650 - since));
    window.setTimeout(() => open(true), Math.max(0, 850 - since));
  } else {
    finish();
  }
</script>
