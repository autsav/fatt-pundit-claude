---
/**
 * fp-next (Phase 7 §3.7): the strip before every footer. One next step and a photograph, so a page
 * never ends on an empty band. The photo is decorative here (the words carry the action).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface NextAction {
  href: string;
  label: string;
  primary?: boolean;
  /** Branch id for the booking drawer / analytics (data-book). */
  book?: string;
  external?: boolean;
  /** A button that prints the page instead of a link. */
  print?: boolean;
}
interface Props {
  label?: string;
  title: string;
  line?: string;
  actions: NextAction[];
  photo?: ImageMetadata;
  /** Object position for the crop, e.g. "50% 60%". */
  focus?: string;
}
const { label = 'Next', title, line, actions, photo, focus = '50% 50%' } = Astro.props;
---
<section class:list={['fp-next', { 'has-photo': photo }]} aria-labelledby="fp-next-h">
  <div class="wrap fp-next-in">
    {photo && (
      <div class="fp-next-photo">
        <Image src={photo} alt="" widths={[400, 720, 1080]} sizes="(min-width: 1024px) 40vw, 100vw" loading="lazy" style={`object-position:${focus}`} />
      </div>
    )}
    <div class="fp-next-text">
      <p class="fp-section-label">{label}</p>
      <h2 id="fp-next-h" class="fp-h2">{title}</h2>
      {line && <p class="fp-spoken">{line}</p>}
      <p class="fp-next-acts">
        {actions.map((a) => a.print
          ? <button type="button" class="fp-btn fp-btn--text" onclick="print()">{a.label}</button>
          : <a class:list={['fp-btn', a.primary ? 'fp-btn--primary' : 'fp-btn--text']} href={a.href} data-book={a.book} {...(a.external ? { rel: 'noopener', ...(a.book === undefined ? { target: '_blank' } : {}) } : {})}>{a.label}{a.external && a.book === undefined && <><span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></>}</a>)}
      </p>
    </div>
  </div>
</section>

<style>
  .fp-next { background: var(--color-sand); color: var(--color-ink); padding-block: var(--section-gap) var(--section-pad); }
  .fp-next-in { display: grid; gap: var(--space-6); }
  .fp-next-photo { aspect-ratio: 16 / 10; overflow: hidden; border: 2px solid var(--color-ink); }
  .fp-next-photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .fp-next-text { display: grid; gap: var(--space-3); align-content: center; }
  .fp-next-text > * { margin: 0; }
  .fp-next-acts { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-6); margin-top: var(--space-3) !important; }
  @media (min-width: 768px) {
    .has-photo .fp-next-in { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--space-8); align-items: center; }
  }
  @media print { .fp-next { display: none; } }
</style>
