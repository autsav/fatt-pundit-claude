---
/**
 * A short silent loop made from a real photo (Higgsfield, camera locked, only light or steam moves).
 * Shows the photo first; plays only while on screen and never in calm mode (prefers-reduced-motion).
 */
interface Props {
  src: string;
  poster: string;
  /** What the photo shows, for screen readers. */
  label: string;
  class?: string;
}
const { src, poster, label, class: className } = Astro.props;
---
<video class={className} data-loop muted loop playsinline preload="none" poster={poster} aria-label={label} disablepictureinpicture>
  <source src={src} type="video/mp4" />
</video>

<script>
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) v.play().catch(() => {});
      else v.pause();
    }
  }, { threshold: 0.25 });
  // Loops are garnish: start watching only once the page has loaded and the
  // browser is idle, so they never compete with the first paint.
  const watch = () => { for (const v of document.querySelectorAll<HTMLVideoElement>('video[data-loop]')) io.observe(v); };
  const later = () => ('requestIdleCallback' in window ? requestIdleCallback(watch, { timeout: 3000 }) : setTimeout(watch, 1500));
  if (!calm) { if (document.readyState === 'complete') later(); else addEventListener('load', later, { once: true }); }
</script>
