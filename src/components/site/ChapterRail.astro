---
/**
 * Chapter rail: where you are on a long page. Dots light up as you scroll, tap one to jump.
 * From 1024px (narrow and tucked to the edge until 1320px, where the margin beside the 1240 column can hold the full rail); every width
 * also gets a thin reading line under the header.
 * Used by the home page (chapters of the visit) and /our-story/ (chapters of the comic).
 */
interface Props {
  chapters: [id: string, label: string][];
  /** Show the rail once the reader is this many screens down (the first screen is the hero). */
  after?: number;
}
const { chapters, after = 0.8 } = Astro.props;
---

<nav class="rail" aria-label="Chapters" data-rail data-after={after} hidden>
  {chapters.map(([id, label]) => (
    <a href={`#${id}`} data-ch={id}><span class="rail-dot" aria-hidden="true"></span><span class="rail-lbl">{label}</span></a>
  ))}
</nav>

<script>
  // Story rail + reading line. Only transform/opacity change per frame.
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const bar = document.querySelector<HTMLElement>('.bar');
  if (rail && bar) {
    rail.hidden = false;
    const after = Number(rail.dataset.after ?? 0.8);
    const line = document.createElement('div');
    line.className = 'read-line';
    line.setAttribute('aria-hidden', 'true');
    bar.append(line);
    // Where CSS can drive the line from the scroll position (animation-timeline), it does, off the main
    // thread; this script then only tracks the chapter. In calm mode the CSS rule is off and the line is
    // still written here (it is a position, not a movement).
    const cssLine = CSS.supports('animation-timeline: scroll()') && !matchMedia('(prefers-reduced-motion: reduce)').matches;
    const links = new Map([...rail.querySelectorAll<HTMLAnchorElement>('[data-ch]')].map((a) => [a.dataset.ch!, a]));
    const order = [...links.keys()];
    const targets = order.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
    // Positions are measured only when the page changes size (a ResizeObserver runs after layout, so
    // measuring there is free). The scroll tick reads scrollY and nothing else: measuring sections on
    // every frame, after the voyage had moved its map, forced a full style and layout pass per frame
    // (about 1 s of forced layout across the voyage at 4x CPU).
    let tops: number[] = [];
    let max = 0;
    let footTop = Infinity;
    let vh = innerHeight;
    const measure = () => {
      vh = innerHeight;
      tops = targets.map((el) => el.getBoundingClientRect().top + window.scrollY);
      max = document.documentElement.scrollHeight - vh;
      const foot = document.querySelector('footer.foot');
      footTop = foot ? foot.getBoundingClientRect().top + window.scrollY : Infinity;
    };
    let raf = 0;
    let cur = -1;
    let on: boolean | null = null;
    // scrollY is read in the scroll event (before any frame callback writes), not inside the frame,
    // where reading it after another scene's writes would also force layout.
    let y = scrollY;
    const tick = () => {
      raf = 0;
      // The current chapter: the last one whose top has passed the middle of the screen.
      let now = 0;
      tops.forEach((t, i) => { if (t - y <= vh * 0.5) now = i; });
      if (!cssLine) line.style.transform = `scaleX(${max > 0 ? Math.min(1, y / max).toFixed(4) : 0})`;
      // Hidden again once the footer would sit under it.
      const show = y > vh * after && y + vh < footTop;
      if (show !== on) { on = show; rail.classList.toggle('is-on', show); rail.inert = !show; }
      if (now === cur) return;
      cur = now;
      order.forEach((id, i) => {
        const a = links.get(id)!;
        a.classList.toggle('is-past', i < cur);
        a.classList.toggle('is-here', i === cur);
        if (i === cur) a.setAttribute('aria-current', 'step'); else a.removeAttribute('aria-current');
      });
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(tick); };
    new ResizeObserver(() => { y = scrollY; measure(); queue(); }).observe(document.body);
    addEventListener('scroll', () => { y = scrollY; queue(); }, { passive: true });
    measure();
    rail.inert = true;
    tick();
  }
</script>

<style>
  /* Story rail */
  .rail { position: fixed; z-index: 30; right: 18px; top: 50%; translate: 0 -50%; display: none; flex-direction: column; gap: 2px; padding: 6px;
    background: rgb(44 41 37 / 0.55); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border: 1px solid rgb(203 160 82 / 0.45); opacity: 0; pointer-events: none; transition: opacity var(--dur-panel) var(--curve-out); }
  /* From 1024px, tucked to the edge and narrow (28px targets inside the 41px+ page gutter, so it never sits
     on content); from 1320px, where the margin beside the 1240 column can hold it, the roomy 44px rail. */
  @media (min-width: 1024px) { .rail { display: flex; right: 0; padding: 4px 2px; } }
  @media (min-width: 1320px) { .rail { right: 18px; padding: 6px; } }
  .rail.is-on { opacity: 1; pointer-events: auto; }
  /* The rail carries the place at these widths, so the reading hairline under the header steps aside. */
  @media (min-width: 1024px) { :global(html:has(.rail.is-on) .read-line) { display: none; } }
  /* 28x44 targets (44 square from 1320px); the dashed line joins one dot to the next. */
  .rail a { position: relative; display: grid; place-items: center; width: 28px; height: 44px; text-decoration: none; }
  @media (min-width: 1320px) { .rail a { width: 44px; } }
  .rail a::before { content: ''; position: absolute; left: 50%; top: -17px; height: 34px; border-left: 1px dashed rgb(203 160 82 / 0.5); }
  .rail a:first-child::before { display: none; }
  .rail-dot { width: 10px; height: 10px; border-radius: 50%; border: 1.5px dashed var(--color-gold); transition: background-color var(--dur-fast) var(--curve-out), transform var(--dur-spring) var(--curve-spring); }
  .rail a.is-past .rail-dot { background: var(--color-gold); border-style: solid; }
  .rail a.is-here .rail-dot { background: var(--color-tiger); border: 1.5px solid var(--color-tiger); transform: scale(1.3); }
  .rail-lbl { position: absolute; right: calc(100% + 14px); white-space: nowrap; padding: 4px 10px; background: var(--color-ink); border: 1px solid rgb(203 160 82 / 0.45); color: var(--color-sand);
    font-family: var(--font-note); font-style: italic; font-size: 15px; opacity: 0; translate: 6px 0; transition: opacity var(--dur-fast) var(--curve-out), translate var(--dur-fast) var(--curve-out); pointer-events: none; }
  .rail a:hover .rail-lbl, .rail a:focus-visible .rail-lbl { opacity: 1; translate: 0 0; }
  /* Wide screens: the chapter you're in is always named (the margin is wide enough not to cover content). */
  @media (min-width: 1600px) { .rail a.is-here .rail-lbl { opacity: 1; translate: 0 0; } }
  .rail a:focus-visible { outline: 2px solid var(--fp-ring); outline-offset: 1px; }
  /* .read-line (created above) is styled in global.css: its scroll-timeline rule is nested in @supports and
     @media, which the scoped-style pipeline emptied when written here with :global(). */
</style>
