---
/**
 * Book a table in three taps: party size, day, time → the restaurant's own
 * booking page opens with those filled in (OpenTable / SevenRooms). One drawer
 * per page; anything with [data-book] opens it ("soho", "covent-garden", or
 * "" to let the guest choose). Without JavaScript the triggers are plain links
 * to the booking page, so nothing breaks.
 *
 * Deep-link formats (check with each provider at launch):
 *   OpenTable  /restref/client/?rid=&restref=&datetime=YYYY-MM-DDTHH:MM&covers=N
 *   SevenRooms /explore/<venue>/reservations/create/search/?date=&party_size=&start_time=HH:MM
 */
import { getBranches, groupRules, preTheatreText, prettyPhone } from '@/lib/site-data';

const branches = (await getBranches()).filter((b) => b.status === 'open' && b.booking);
// Bigger parties go to the groups page; the limits come from branches.json `groups` (client, 20 Nov 2026).
const data = branches.map((b) => ({
  id: b.id,
  name: b.shortName,
  tz: b.timezone,
  hours: b.hours,
  provider: b.booking!.provider,
  url: b.booking!.url,
  widgetId: b.booking!.widgetId,
  phone: b.phone,
  phonePretty: b.phone ? prettyPhone(b.phone) : '',
  maxOnline: b.groups?.onlineMax ?? 8,
  setMenuFrom: b.groups?.setMenuFrom ?? 99,
  depositFrom: b.groups?.depositFrom ?? 99,
  deposit: groupRules(b)?.depositShort ?? '',
  pre: b.preTheatre,
  preText: preTheatreText(b),
}));
---
<dialog class="book" data-book-drawer data-lenis-prevent aria-labelledby="book-title">
  <form method="dialog" class="book-sheet" data-book-form>
    <div class="book-head">
      <p class="book-kicker">Your table</p>
      <h2 id="book-title" class="book-title">Book <span data-book-name>a table</span></h2>
      <button class="book-x" value="close" aria-label="Close">×</button>
    </div>

    <fieldset class="book-field" data-book-where>
      <legend>Where</legend>
      <div class="book-choices">
        {data.map((b, i) => <label class="book-chip"><input type="radio" name="where" value={b.id} checked={i === 0} /><span>{b.name}</span></label>)}
      </div>
    </fieldset>

    <fieldset class="book-field">
      <legend>How many</legend>
      <div class="book-step">
        <button type="button" class="book-pm" data-step="-1" aria-label="One fewer guest">−</button>
        <input class="book-size" data-book-size type="number" inputmode="numeric" min="1" max="20" value="2" aria-label="Guests" />
        <button type="button" class="book-pm" data-step="1" aria-label="One more guest">+</button>
      </div>
      <p class="book-note" data-book-deposit hidden></p>
      <span class="sr-only" data-book-size-said aria-live="polite"></span>
    </fieldset>

    <fieldset class="book-field">
      <legend>Which day</legend>
      <div class="book-days" data-book-days role="radiogroup" aria-label="Day"></div>
    </fieldset>

    <fieldset class="book-field">
      <legend>Time</legend>
      <div class="book-times" data-book-times role="radiogroup" aria-label="Time"></div>
      <p class="book-closed" data-book-closed hidden></p>
      <p class="book-note" data-book-pre hidden></p>
    </fieldset>

    <div class="book-group" data-book-group hidden>
      <div class="book-group-in">
        <p data-book-group-text></p>
        <a class="fp-btn fp-btn--primary book-go" data-book-enquire href="/private-dining/">Send a group enquiry</a>
        <p class="book-small">Ask about space for your group: call <a data-book-tel href="#"></a>.</p>
      </div>
    </div>

    <div class="book-go-wrap" data-book-go-wrap>
      <button type="submit" class="fp-btn fp-btn--primary book-go" data-book-go value="go">Find a table</button>
      <p class="book-small">Opens <span data-book-provider></span> in a new tab with your choices filled in. Or call <a data-book-tel2 href="#"></a>.</p>
    </div>
  </form>
  <!-- After the hand-off: say what opened, keep a way back to it (ux-structure.md F12). -->
  <div class="book-sheet book-done" data-book-done hidden>
    <div class="book-head">
      <p class="book-kicker">Your table</p>
      <h2 class="book-title" tabindex="-1" data-book-done-title></h2>
      <button type="button" class="book-x" data-book-close aria-label="Close">×</button>
    </div>
    <p class="book-done-what" role="status" data-book-done-what></p>
    <a class="fp-btn book-go" data-book-again href="#" target="_blank" rel="noopener"></a>
    <button type="button" class="book-link" data-book-change>Change the details</button>
  </div>
</dialog>

<script is:inline type="application/json" data-book-data set:html={JSON.stringify(data)} />

<style>
  .book { padding: 0; border: 0; margin: auto 0 0 auto; width: min(460px, 100vw); max-width: none; height: 100dvh; max-height: 100dvh; background: transparent; color: var(--color-ink); overflow-y: auto; overscroll-behavior: contain; }
  /* Travels in like the system's side dialog and leaves the same way where the browser can hold a closed
     dialog in the top layer (keyframes and the pattern in components.css "Dialogs"); a bottom sheet on phones. */
  .book { transform: translateX(100%); transition: transform var(--dur-panel) var(--curve-in); }
  .book[open] { transform: none; animation: fp-in-right var(--dur-panel) var(--curve-panel); }
  .book::backdrop { background: rgb(26 23 20 / 0.6); opacity: 0; transition: opacity var(--dur-panel) var(--curve-out); }
  .book[open]::backdrop { opacity: 1; }
  @starting-style { .book[open]::backdrop { opacity: 0; } }
  @supports (overlay: auto) { .book, .book::backdrop { transition-property: transform, opacity, overlay, display; transition-behavior: allow-discrete; } }
  @media (max-width: 640px) {
    .book { width: 100vw; height: auto; max-height: 92dvh; margin: auto 0 0; transform: translateY(100%); }
    .book[open] { animation-name: fp-in-up; }
  }
  .book-sheet { box-sizing: border-box; min-height: 100%; background: var(--color-sand); padding: 24px clamp(18px, 4vw, 32px) 28px; display: flex; flex-direction: column; gap: 18px; border-left: 3px solid var(--color-ink); }
  @media (max-width: 640px) { .book-sheet { border-left: 0; border-top: 3px solid var(--color-ink); } }
  .book-head { position: relative; padding-right: 48px; }
  .book-kicker { margin: 0; font-family: var(--font-note); font-style: italic; font-size: 19px; color: var(--color-tiger-deep); }
  .book-title { margin: 2px 0 0; font-size: clamp(26px, 6vw, 34px); text-transform: uppercase; letter-spacing: 0.04em; line-height: 1.05; }
  .book-x { position: absolute; top: -4px; right: -6px; width: 48px; height: 48px; font-size: 32px; line-height: 1; background: none; border: 2px solid var(--color-ink); color: var(--color-ink); cursor: pointer; }
  .book-field { border: 0; margin: 0; padding: 0; min-width: 0; }
  .book-field legend { padding: 0; margin-bottom: 8px; font-weight: 700; font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase; }
  .book-choices, .book-times { display: flex; flex-wrap: wrap; gap: 8px; }
  .book-chip { position: relative; }
  .book-chip input { position: absolute; opacity: 0; pointer-events: none; }
  .book-chip span, .book :global(.book-time), .book :global(.book-day) { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 16px; border: 2px solid var(--color-ink); background: var(--color-paper-light); font: inherit; font-weight: 700; color: var(--color-ink); cursor: pointer; }
  .book-chip input:checked + span, .book :global(.book-time[aria-checked='true']), .book :global(.book-day[aria-checked='true']) { background: var(--color-ink); color: var(--color-sand); }
  /* Chips and the +/− have weight: a press (one press beat), then the spring settles them; the chosen chip stamps in. */
  .book :global(.book-time), .book :global(.book-day), .book-pm { transition: transform var(--dur-spring) var(--curve-spring); }
  .book :global(.book-time:active), .book :global(.book-day:active), .book-pm:active:not(:disabled) { transform: scale(0.92); transition-duration: var(--dur-press); transition-timing-function: var(--curve-out); }
  .book :global(.book-time[aria-checked='true']), .book :global(.book-day[aria-checked='true']) { animation: book-stamp var(--dur-spring) var(--curve-spring); }
  @keyframes book-stamp { from { transform: scale(1.1); } }
  .book-size.is-bump { animation: book-bump var(--dur-spring) var(--curve-spring); }
  @keyframes book-bump { 40% { transform: scale(1.14); } }
  .book-chip input:focus-visible + span, .book :global(.book-time:focus-visible), .book :global(.book-day:focus-visible), .book-pm:focus-visible { outline: 3px solid var(--fp-ring); outline-offset: 2px; }
  .book-step { display: inline-flex; align-items: center; border: 2px solid var(--color-ink); background: var(--color-paper-light); }
  .book-pm { width: 52px; height: 48px; font-size: 26px; background: none; border: 0; color: var(--color-ink); cursor: pointer; }
  .book-pm:disabled { opacity: 0.35; cursor: default; }
  .book-size { width: 64px; min-height: 48px; border: 0; border-inline: 2px solid var(--color-ink); background: none; color: var(--color-ink); font: inherit; font-size: 24px; font-weight: 700; text-align: center; -moz-appearance: textfield; }
  .book-size::-webkit-inner-spin-button, .book-size::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .book-size:focus-visible { outline: 3px solid var(--fp-ring); outline-offset: 2px; }
  .book-note { margin: 8px 0 0; font-size: 15px; }
  /* The group route unfolds to its own height and folds back: a grid row from 0fr to 1fr (every browser;
     `height: auto` does not interpolate for a flex item, which this is in the sheet's column). The inner
     box clips its content while the row grows; its 8px of transparent padding keeps focus rings whole.
     Where the browser transitions `display`, the fold-back plays before the box is hidden. */
  .book-group { display: grid; grid-template-rows: 0fr; transition-property: grid-template-rows, display; transition-duration: var(--dur-panel); transition-timing-function: var(--curve-in); transition-behavior: allow-discrete; }
  .book-group:not([hidden]) { grid-template-rows: 1fr; transition-timing-function: var(--curve-panel); }
  @starting-style { .book-group:not([hidden]) { grid-template-rows: 0fr; } }
  .book-group-in { display: grid; gap: 12px; min-height: 0; overflow: clip; padding: 8px; margin: -8px; }
  .book-group-in > p:first-child { margin: 0; font-family: var(--font-note); font-style: italic; font-size: 18px; }
  .book-done-what { margin: 0; font-size: 18px; }
  .book-link { justify-self: start; min-height: 44px; padding: 0; border: 0; background: none; color: var(--color-tiger-deep); font: inherit; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .book-done[hidden], .book-sheet[hidden] { display: none; }
  .book-go-wrap { display: grid; gap: 18px; }
  /* More days scroll sideways: the strip fades at its far edge so the cut chip reads as "more", and the end
     padding lets the last day clear the fade (AUDIT B-10). */
  .book-days { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; padding-inline-end: 32px; scroll-snap-type: x mandatory; scroll-padding-inline: 0 32px;
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent); }
  .book :global(.book-day) { flex: none; flex-direction: column; min-width: 64px; padding: 6px 10px; line-height: 1.15; scroll-snap-align: start; }
  .book :global(.book-day small) { display: block; font-size: 12px; font-weight: 400; }
  .book :global(.book-time) { min-width: 84px; padding: 0 10px; }
  .book-closed { margin: 0; font-family: var(--font-note); font-style: italic; font-size: 18px; }
  .book-small a { color: var(--color-tiger-deep); font-weight: 700; }
  .book-go { width: 100%; margin-top: 4px; justify-content: center; }
  .book-go[aria-disabled='true'] { opacity: 0.45; pointer-events: none; }
  .book-small { margin: 0; font-size: 14px; }
</style>

<script>
  import { lockScroll, unlockScroll } from '@/lib/smooth-scroll';
  import { KEYS, PROVIDER, local, addDays, wd, toMin, hhmm, prettyMin, slots as slotsFor, providerLink, type Span } from '@/lib/booking';
  interface B { id: string; name: string; tz: string; hours: Record<string, Span[]>; provider: string; url: string; widgetId?: string; phone?: string; phonePretty: string; maxOnline: number; setMenuFrom: number; depositFrom: number; deposit: string; pre: Span | null; preText: string | null }
  const dlg = document.querySelector<HTMLDialogElement>('[data-book-drawer]');
  const raw = document.querySelector('[data-book-data]')?.textContent;
  if (dlg && raw) {
    const all: B[] = JSON.parse(raw);
    const $ = <T extends Element>(s: string) => dlg.querySelector<T>(s)!;
    const form = $<HTMLFormElement>('[data-book-form]');
    const sizeIn = $<HTMLInputElement>('[data-book-size]');
    const form$ = $<HTMLElement>('[data-book-form]');
    const done = dlg.querySelector<HTMLElement>('[data-book-done]')!;
    const daysEl = $<HTMLElement>('[data-book-days]');
    const timesEl = $<HTMLElement>('[data-book-times]');
    const go = $<HTMLButtonElement>('[data-book-go]');
    let b = all[0];
    let size = 2;
    let day = '';
    let time = '';
    let opener: HTMLElement | null = null;

    const pretty = prettyMin;
    // Last booking 45 minutes before closing, every half hour (src/lib/booking.ts).
    const slots = (ymd: string) => slotsFor(b.hours, b.tz, ymd);

    const radio = (el: HTMLElement, cls: string, on: boolean, label: string, html: string, onPick: () => void) => {
      const btn = document.createElement('button');
      btn.type = 'button'; btn.className = cls; btn.setAttribute('role', 'radio'); btn.setAttribute('aria-checked', String(on)); btn.setAttribute('aria-label', label);
      // One tab stop per group (the chosen one); arrow keys move between options.
      btn.tabIndex = on ? 0 : -1;
      btn.innerHTML = html;
      btn.addEventListener('click', () => { const had = el.contains(document.activeElement); onPick(); if (had) el.querySelector<HTMLElement>('[aria-checked="true"]')?.focus(); });
      el.append(btn);
    };

    const drawDays = () => {
      daysEl.replaceChildren();
      const today = local(b.tz).ymd;
      for (let i = 0; i < 21; i++) {
        const ymd = addDays(today, i);
        const d = new Date(`${ymd}T12:00:00Z`);
        const wdName = i === 0 ? 'Today' : i === 1 ? 'Tmrw' : d.toLocaleDateString('en-GB', { weekday: 'short', timeZone: 'UTC' });
        const full = d.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
        // The name starts with the words on the chip ("Today 24 Nov"), then the full date (WCAG 2.5.3, AUDIT B-09).
        const short = `${d.getUTCDate()} ${d.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' })}`;
        radio(daysEl, 'book-day', ymd === day, `${wdName} ${short}, ${full}`, `${wdName}<small>${d.getUTCDate()} ${d.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' })}</small>`, () => { day = ymd; time = ''; draw(); });
      }
    };
    const drawTimes = () => {
      timesEl.replaceChildren();
      const list = slots(day);
      const closed = $<HTMLElement>('[data-book-closed]');
      closed.hidden = list.length > 0;
      // Name the room and the reason: closed all day, or no tables left today.
      closed.textContent = (b.hours[KEYS[wd(day)]] ?? []).length
        ? `No more tables at ${b.name} ${day === local(b.tz).ymd ? 'today' : 'that day'}. Pick another day.`
        : `${b.name} is closed on ${new Date(`${day}T12:00:00Z`).toLocaleDateString('en-GB', { weekday: 'long', timeZone: 'UTC' })}s. Pick another day.`;
      if (!list.some((m) => hhmm(m) === time)) time = list.find((m) => m >= 19 * 60) !== undefined ? hhmm(list.find((m) => m >= 19 * 60)!) : list[0] !== undefined ? hhmm(list[0]) : '';
      for (const m of list) radio(timesEl, 'book-time', hhmm(m) === time, pretty(m), pretty(m), () => { time = hhmm(m); drawTimes(); update(); });
    };
    const update = () => {
      const tooMany = size > b.maxOnline;
      $<HTMLElement>('[data-book-group]').hidden = !tooMany;
      $<HTMLElement>('[data-book-go-wrap]').hidden = tooMany;
      $<HTMLElement>('[data-book-group-text]').textContent = size >= b.setMenuFrom
        ? `For ${b.setMenuFrom} or more, ${b.name} plans a set menu with you.`
        : `${b.name} books online for up to ${b.maxOnline}. For ${size}, please call or send an enquiry.`;
      const q = new URLSearchParams({ branch: b.id, guests: String(size), ...(day ? { date: day } : {}), ...(time ? { time } : {}) });
      $<HTMLAnchorElement>('[data-book-enquire]').href = `/private-dining/?${q}`;
      const dep = $<HTMLElement>('[data-book-deposit]');
      dep.hidden = size < b.depositFrom || !b.deposit;
      dep.textContent = b.deposit;
      const pre = $<HTMLElement>('[data-book-pre]');
      const tm = time ? toMin(time) : -1;
      pre.hidden = !(b.pre && b.preText && tm >= toMin(b.pre[0]) && tm <= toMin(b.pre[1]));
      pre.textContent = `Pre-theatre menu: seated ${b.preText}.`;
      $<HTMLElement>('[data-book-size-said]').textContent = `${size} guest${size === 1 ? '' : 's'}`;
      for (const a of dlg.querySelectorAll<HTMLAnchorElement>('[data-book-tel],[data-book-tel2]')) { a.href = `tel:${b.phone}`; a.textContent = b.phonePretty; }
      $<HTMLElement>('[data-book-name]').textContent = `at ${b.name}`;
      $<HTMLElement>('[data-book-provider]').textContent = PROVIDER[b.provider] ?? 'the booking page';
      if (document.activeElement !== sizeIn) sizeIn.value = String(size);
      dlg.querySelector<HTMLButtonElement>('[data-step="-1"]')!.disabled = size <= 1;
      dlg.querySelector<HTMLButtonElement>('[data-step="1"]')!.disabled = size >= 20;
      go.setAttribute('aria-disabled', String(tooMany || !time));
    };
    const draw = () => { drawDays(); drawTimes(); update(); };
    sizeIn.addEventListener('input', () => { const n = Math.round(Number(sizeIn.value)); if (n >= 1 && n <= 20) { size = n; update(); } });
    sizeIn.addEventListener('change', () => { size = Math.min(20, Math.max(1, Math.round(Number(sizeIn.value)) || 2)); sizeIn.value = String(size); update(); });
    const showForm = () => { form$.hidden = false; done.hidden = true; };
    const longDay = (ymd: string) => new Date(`${ymd}T12:00:00Z`).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
    done.querySelector('[data-book-close]')!.addEventListener('click', () => dlg.close());
    done.querySelector('[data-book-change]')!.addEventListener('click', () => { showForm(); go.focus(); });
    for (const g of [daysEl, timesEl]) g.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
      const all = [...g.querySelectorAll<HTMLElement>('[role="radio"]')];
      const i = all.indexOf(document.activeElement as HTMLElement);
      if (!d || i < 0) return;
      e.preventDefault();
      all[(i + d + all.length) % all.length].click();
    });

    const link = () => providerLink(b, day, time, size);

    /** Which room and day the chips were last drawn for ("soho@2026-11-22"). */
    let drawn = '';
    const savedId = () => { try { return localStorage.getItem('fp-menu-at'); } catch { return null; } };
    const pick = (id: string) => {
      b = all.find((x) => x.id === id) ?? b;
      const r = dlg.querySelector<HTMLInputElement>(`input[name="where"][value="${b.id}"]`);
      if (r) r.checked = true;
      day = local(b.tz).ymd;
      if (!slots(day).length) for (let i = 1; i < 8 && !slots(day).length; i++) day = addDays(local(b.tz).ymd, i);
      draw();
      drawn = `${b.id}@${local(b.tz).ymd}`;
    };

    dlg.querySelectorAll<HTMLInputElement>('input[name="where"]').forEach((r) => r.addEventListener('change', () => pick(r.value)));
    dlg.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) => btn.addEventListener('click', () => {
      size = Math.min(20, Math.max(1, size + Number(btn.dataset.step)));
      update();
      // The number lands with the spring (restarted by a reflow, so quick presses each bump).
      sizeIn.classList.remove('is-bump'); void sizeIn.offsetWidth; sizeIn.classList.add('is-bump');
    }));
    form.addEventListener('submit', (e) => {
      const submitter = (e as SubmitEvent).submitter as HTMLButtonElement | null;
      if (submitter?.value !== 'go') return;
      e.preventDefault();
      if (go.getAttribute('aria-disabled') === 'true') return;
      const href = link();
      // Same pattern as the boarding passes: new tab, no opener; same tab if blocked.
      const w = window.open(href, '_blank');
      window.dispatchEvent(new CustomEvent('fp:booking-click', { detail: { branch: b.id, size } }));
      if (!w) { location.href = href; return; }
      w.opener = null;
      // Done state: confirm the hand-off and keep a way back to it.
      const provider = PROVIDER[b.provider] ?? 'The booking page';
      done.querySelector<HTMLElement>('[data-book-done-title]')!.textContent = `${provider} is open in a new tab`;
      done.querySelector<HTMLElement>('[data-book-done-what]')!.textContent = `${size} guest${size === 1 ? '' : 's'} at ${b.name}, ${longDay(day)}, ${pretty(toMin(time))}. Finish booking there. Not there? Open it again.`;
      const again = done.querySelector<HTMLAnchorElement>('[data-book-again]')!;
      again.href = href;
      again.textContent = `Open ${provider} again`;
      form$.hidden = true; done.hidden = false;
      done.querySelector<HTMLElement>('[data-book-done-title]')!.focus();
    });
    dlg.addEventListener('close', () => { opener?.focus(); unlockScroll(); });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

    // Any [data-book] link opens the drawer; its value picks the restaurant
    // (empty = let the guest choose). Delegated, so links added later work too.
    document.addEventListener('click', (e) => {
      const t = (e.target as Element).closest<HTMLElement>('[data-book]');
      if (!t || e.defaultPrevented || (e as MouseEvent).metaKey || (e as MouseEvent).ctrlKey) return;
      const id = t.dataset.book ?? '';
      if (id && !all.some((x) => x.id === id)) return;
      e.preventDefault();
      opener = t;
      $<HTMLElement>('[data-book-where]').hidden = Boolean(id) || all.length < 2;
      const want = id || savedId() || all[0].id;
      // Drawn ahead at idle (below); redrawn only for another room or a new day.
      if (drawn !== `${want}@${local(b.tz).ymd}`) pick(want);
      showForm();
      dlg.showModal();
      lockScroll();
    });
    // Drawing the 21 day chips and the times on the tap cost 250 ms at 4x CPU (scripts/tap-timing.mjs);
    // draw the likely room (this page's, else the last picked) once the page is idle instead.
    const first = document.querySelector<HTMLElement>('[data-book]:not([data-book=""])')?.dataset.book;
    const preDraw = () => { if (!dlg.open && !drawn) pick((first && all.some((x) => x.id === first) ? first : null) || savedId() || all[0].id); };
    if (typeof window.requestIdleCallback === 'function') window.requestIdleCallback(preDraw, { timeout: 3000 });
    else window.setTimeout(preDraw, 1000);
  }
</script>
