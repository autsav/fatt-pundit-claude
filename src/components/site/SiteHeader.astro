---
/**
 * The ink bar across the top of every page. On the home page the links jump to sections;
 * on a branch page they lead home, list the three rooms, and Book goes straight to that room.
 */
import type { Branch } from '@/lib/site-data';
import BookDrawer from './BookDrawer.astro';

interface Props {
  branches: Branch[];
  /** The branch whose page this is; absent on the home page. */
  current?: Branch;
}
const { branches, current } = Astro.props;
// Home page = the long story page; other pages without a branch (allergens,
// privacy…) link back to its sections.
const home = !current && Astro.url.pathname === '/';
const at = (hash: string) => (home ? hash : `/${hash}`);
const book = current?.booking
  ? { href: current.booking.url, label: `Book at ${current.shortName}`, external: true }
  : current
    ? { href: '#waitlist', label: 'Join the list', external: false }
    : { href: at('#tables'), label: 'Book a table', external: false };
const bookAttr = current?.booking ? current.id : current ? undefined : '';
---
{import.meta.env.PUBLIC_LAUNCH !== 'true' && <p class="preview-flag"><span class="pf-long">Website preview for Fatt Pundit, not the live site. Prices and photos to be confirmed</span><span class="pf-short">Website preview, not the live site</span></p>}
<header class="bar">
  <div class="wrap bar-in">
    <a class="brand" href={home ? '#top' : '/'}>FATT PUNDIT</a>
    <nav aria-label="Main" class="nav">
      {!current ? (
        <>
          <a href={at('#menu')}>Menus</a>
          <a href={at('#story')}>Our story</a>
          {branches.map((b) => <a href={`/${b.id}/`}>{b.shortName}</a>)}
        </>
      ) : (
        branches.map((b) => (
          <a href={`/${b.id}/`} aria-current={b.id === current?.id ? 'page' : undefined}>{b.shortName}</a>
        ))
      )}
      <a class="btn btn-orange btn-sm" href={book.href} data-book={bookAttr} {...(book.external ? { target: '_blank', rel: 'noopener' } : {})}><span class="lbl-long">{book.label}</span><span class="lbl-short">{current && !current.booking ? 'Join the list' : 'Book a table'}</span></a>
    </nav>
  </div>
</header>
<BookDrawer />
