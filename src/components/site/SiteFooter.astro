---
import { prettyPhone, type Branch } from '@/lib/site-data';
import Goodbye from './Goodbye.astro';

interface Props {
  branches: Branch[];
  home?: boolean;
}
const { branches, home = false } = Astro.props;
const h = (hash: string) => (home ? hash : `/${hash}`);
// Newsletter: shows once the client's email tool is set (its form POST URL,
// e.g. Mailchimp/Klaviyo embed action) in PUBLIC_NEWSLETTER_ACTION.
const newsletter = import.meta.env.PUBLIC_NEWSLETTER_ACTION as string | undefined;
// Gift vouchers: the first branch voucher link in branches.json, else the passes.
const vouchers = branches.find((b) => b.vouchersUrl)?.vouchersUrl ?? h('#tables');
---
<footer class="foot">
  <div class="wrap stack-lg">
    <!-- 9 · Goodbye: the bill holder opens and the receipt prints our hours. -->
    <div class="goodbye">
      <Goodbye branches={branches} />
      <div class="stack goodbye-text">
        <p class="kicker gold">Goodbye, for now</p>
        <p class="goodbye-h">Thank you for travelling with Fatt Pundit</p>
        <p class="note gold">Hakka cooking from Tangra, Kolkata's Chinatown.</p>
      </div>
    </div>
    <div class="foot-grid">
      <div class="stack-sm">
        <p class="brand">FATT PUNDIT</p>
      </div>
      {branches.map((b) => (
        <div class="stack-sm small">
          <a class="foot-h" href={`/${b.id}/`}>{b.shortName}</a>
          <p>{b.address.street}{b.address.postcode ? `, ${b.address.postcode}` : ''}</p>
          <p>{b.phone ? prettyPhone(b.phone) : 'Opening soon'}</p>
        </div>
      ))}
    </div>
    <nav aria-label="Footer" class="foot-nav">
      <a href={h('#menu')}>Menus</a><a href={h('#story')}>Our story</a><a href="/private-dining/">Groups and private dining</a><a href={vouchers}>Gift vouchers</a>
      <a href="https://www.instagram.com/fattpundit/" target="_blank" rel="noopener">Instagram</a>
      <a href="https://www.facebook.com/fattpundit/" target="_blank" rel="noopener">Facebook</a>
      <a href="https://x.com/FattPundit" target="_blank" rel="noopener">X</a>
    </nav>
    {newsletter && (
      <form class="news" action={newsletter} method="post" target="_blank">
        <label for="news-email">News, new dishes and Dubai's opening, now and then</label>
        <div class="news-row"><input id="news-email" type="email" name="EMAIL" autocomplete="email" required placeholder="you@example.com" /><button class="btn btn-orange btn-sm" type="submit">Join the list</button></div>
      </form>
    )}
    <nav aria-label="Good to know" class="foot-nav foot-nav-small">
      <a href="/allergens/">Allergens</a><a href="/booking-terms/">Booking terms</a><a href="/accessibility/">Accessibility</a><a href="/privacy/">Privacy</a>
    </nav>
    <p class="tiny">We make every effort to avoid cross-contamination, but cannot guarantee dishes and drinks are allergen-free. Please tell us about any dietary requirements when you book.{import.meta.env.PUBLIC_LAUNCH !== 'true' && ' Website demo: prices and photos to be confirmed.'}</p>
  </div>
</footer>
<style>
  .foot :global(p) { margin: 0; }
  .goodbye { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: clamp(32px, 6vw, 96px); padding-bottom: clamp(40px, 6vw, 72px); border-bottom: 1px solid rgb(203 160 82 / 0.35); }
  .goodbye-h { font-family: var(--font-display); font-size: clamp(28px, 4vw, 54px); line-height: 1.05; text-transform: uppercase; letter-spacing: 0.03em; color: var(--color-sand); }
  @media (max-width: 760px) { .goodbye { grid-template-columns: 1fr; text-align: center; } .goodbye-text { order: -1; align-items: center; } }
  .news { display: grid; gap: 8px; max-width: 520px; }
  .news label { font-family: var(--font-note); font-style: italic; }
  .news-row { display: flex; gap: 8px; }
  .news input { flex: 1; min-width: 0; min-height: 44px; padding: 0 12px; font: inherit; border: 2px solid var(--color-sand); background: transparent; color: var(--color-sand); }
  .foot-nav-small { font-size: 14px; opacity: 0.85; }
  .foot-h { text-decoration: none; }
  .foot-h:hover { text-decoration: underline; }
</style>
