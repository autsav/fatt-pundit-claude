---
import { prettyPhone, type Branch } from '@/lib/site-data';
import { listCta } from '@/lib/waitlist';
import Goodbye from './Goodbye.astro';

interface Props {
  branches: Branch[];
  home?: boolean;
}
const { branches, home = false } = Astro.props;
// Newsletter: shows once the client's email tool is set (its form POST URL,
// e.g. Mailchimp/Klaviyo embed action) in PUBLIC_NEWSLETTER_ACTION.
const newsletter = import.meta.env.PUBLIC_NEWSLETTER_ACTION as string | undefined;
// Gift vouchers: only when a voucher link exists in branches.json (no link that leads elsewhere).
const vouchers = branches.find((b) => b.vouchersUrl)?.vouchersUrl;
---
<footer class="foot">
  <div class="wrap stack-lg">
    <!-- 9 · Goodbye: the bill holder opens and the receipt prints our hours. The end of the home story only. -->
    {home && <div class="goodbye">
      <Goodbye branches={branches} />
      <div class="stack goodbye-text">
        <p class="kicker gold">Goodbye, for now</p>
        <p class="goodbye-h">Thank you for travelling with Fatt Pundit</p>
        <p class="note gold">Hakka cooking from Tangra, Calcutta's Chinatown.</p>
      </div>
    </div>}
    <div class="foot-grid" id="footer-menus">
      <div class="stack-sm">
        <p class="brand">FATT PUNDIT</p>
        <p class="note foot-tag">Hakka cooking from Calcutta's Chinatown, since 2019.</p>
        <div class="social">
          <a href="https://www.instagram.com/fattpundit/" target="_blank" rel="noopener" aria-label="Fatt Pundit on Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.2 6.8v.01" /></svg></a>
          <a href="https://www.facebook.com/fattpundit/" target="_blank" rel="noopener" aria-label="Fatt Pundit on Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 21v-8h3l.5-3.5h-3.5V7.3c0-1 .4-1.8 1.9-1.8H18V2.4c-.4 0-1.6-.2-2.9-.2-2.7 0-4.6 1.7-4.6 4.7v2.6H7.5V13h3v8" /></svg></a>
          <a href="https://x.com/FattPundit" target="_blank" rel="noopener" aria-label="Fatt Pundit on X"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4l16 16M20 4 4 20" /></svg></a>
        </div>
      </div>
      {branches.map((b) => (
        <div class="stack-sm small foot-branch">
          <a class="foot-h" href={`/${b.id}/`}>{b.shortName}</a>
          <p>{b.address.street}{b.address.postcode ? `, ${b.address.postcode}` : ''}</p>
          {b.status === 'open' && b.hours && <p class="foot-today" data-foot-hours={JSON.stringify(b.hours)} data-tz={b.timezone}>Hours on the {b.shortName} page</p>}
          {b.phone ? <a class="foot-tel" href={`tel:${b.phone.replace(/\s/g, '')}`}>{prettyPhone(b.phone)}</a> : <p>Opening soon</p>}
          {b.status === 'open' && <a class="foot-menus" href={`/${b.id}/menu/`}>{b.shortName} menus</a>}
          {b.status === 'open' && b.booking
            ? <a class="foot-cta" href={b.booking.url} data-book={b.id} target="_blank" rel="noopener">Book at {b.shortName}</a>
            : <a class="foot-cta" href={listCta(b).href} data-focus-list>{listCta(b).short}</a>}
        </div>
      ))}
    </div>
    <nav aria-label="Footer" class="foot-nav" id="site-index">
      {branches.map((b) => <a href={`/${b.id}/`}>{b.shortName}</a>)}<a href="/our-story/">Our story</a><a href="/private-dining/">Groups and private dining</a><a href="/book/">Book a table</a>{vouchers && <a href={vouchers} target="_blank" rel="noopener">Gift vouchers<span class="sr-only"> (opens in a new tab)</span></a>}
    </nav>
    {newsletter && (
      <form class="news" action={newsletter} method="post" target="_blank">
        <label for="news-email">News, new dishes and Dubai's opening, now and then</label>
        <div class="news-row"><input id="news-email" class="fp-input" type="email" name="EMAIL" autocomplete="email" required placeholder="you@example.com" /><button class="fp-btn fp-btn--primary fp-btn--sm" type="submit">Join the list</button></div>
      </form>
    )}
    <nav aria-label="Good to know" class="foot-nav foot-nav-small">
      <a href="/allergens/">Allergens</a><a href="/booking-terms/">Booking terms</a><a href="/accessibility/">Accessibility</a><a href="/privacy/">Privacy</a>
      <button type="button" class="motion-toggle" data-motion-toggle aria-pressed="false">Pause motion</button>
    </nav>
    <p class="tiny">We make every effort to avoid cross-contamination, but cannot guarantee dishes and drinks are allergen-free. Please tell us about any dietary requirements when you book.{import.meta.env.PUBLIC_LAUNCH !== 'true' && ' Website demo: prices and photos to be confirmed.'}</p>
  </div>
</footer>
<script>
  import { openStatus, statusLine } from '@/lib/hours';
  // Pause motion (WCAG 2.2.2): stops the rain, the loop videos and the pulsing dots. Remembered on this device.
  const html = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  const show = () => {
    const paused = html.dataset.motion === 'paused';
    if (btn) { btn.setAttribute('aria-pressed', String(paused)); btn.textContent = paused ? 'Play motion' : 'Pause motion'; }
    if (paused) for (const v of document.querySelectorAll('video')) v.pause();
  };
  btn?.addEventListener('click', () => {
    const paused = html.dataset.motion !== 'paused';
    if (paused) html.dataset.motion = 'paused'; else delete html.dataset.motion;
    try { if (paused) localStorage.setItem('fp-motion', 'paused'); else localStorage.removeItem('fp-motion'); } catch {}
    show();
    window.dispatchEvent(new Event('fp:motion'));
  });
  show();

  // Today's hours per room, in its own time zone ("Open until 10.30pm"). Far below the fold, so no layout shift.
  for (const el of document.querySelectorAll<HTMLElement>('[data-foot-hours]')) {
    try { el.textContent = statusLine('', openStatus(JSON.parse(el.dataset.footHours!), el.dataset.tz!)); } catch {}
  }
</script>
<style>
  .foot :global(p) { margin: 0; }
  .motion-toggle { min-height: 24px; padding: 0; border: 0; background: none; color: var(--color-sand); font: inherit; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .motion-toggle:hover { color: var(--color-gold); }
  .goodbye { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: clamp(32px, 6vw, 96px); padding-bottom: clamp(40px, 6vw, 72px); border-bottom: 1px solid rgb(203 160 82 / 0.35); }
  .goodbye-h { font-family: var(--font-display); font-size: clamp(28px, 4vw, 54px); line-height: 1.05; text-transform: uppercase; letter-spacing: 0.03em; color: var(--color-sand); }
  @media (max-width: 760px) { .goodbye { grid-template-columns: minmax(0, 1fr); text-align: center; } .goodbye-text { order: -1; align-items: center; } }
  /* Small phones: the long capitals must fit 288px, or the whole page scrolls sideways. */
  .goodbye > * { min-width: 0; }
  @media (max-width: 380px) { .goodbye-h { font-size: 23px; } }
  .news { display: grid; gap: 8px; max-width: 520px; }
  .news label { font-family: var(--font-note); font-style: italic; }
  .news-row { display: flex; gap: 8px; }
  .news input { flex: 1; min-width: 0; }
  .foot-nav-small { font-size: 15px; }
  .foot :global(.tiny) { font-size: 15px; line-height: 1.5; color: rgb(218 199 181 / 0.9); }
  .foot-today { color: var(--color-gold); }
  /* Branch names and Book links in sentence case (no tracked capitals on running information). */
  .foot-h { width: fit-content; color: var(--color-gold); font-size: var(--step-h4); font-weight: 700; text-decoration: none; }
  .foot-tag { font-size: 17px; color: rgb(218 199 181 / 0.85); max-width: 26ch; }
  /* Plain glyphs, no boxes (Phase 7 §3.8); each keeps a 44px target. */
  .social { display: flex; gap: 4px; margin: 10px 0 0 -10px; }
  .social a { display: grid; place-items: center; width: 44px; height: 44px; color: var(--color-sand); transition: color var(--dur-fast) var(--curve-out); }
  .social a:hover { color: var(--color-gold); }
  .social svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .foot-branch { font-size: 16px; line-height: 1.5; }
  .foot-tel { color: var(--color-sand); text-decoration: none; }
  .foot-menus { width: fit-content; color: var(--color-sand); text-underline-offset: 3px; }
  .foot-menus:hover { color: var(--color-gold); }
  .foot-tel:hover { color: var(--color-gold); }
  .foot-cta { display: inline-flex; align-items: center; width: fit-content; min-height: 44px; color: var(--color-tiger-bright); font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .foot-cta:hover { color: var(--color-gold); }
  .foot-h:hover { text-decoration: underline; }
</style>
