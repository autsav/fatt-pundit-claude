---
import { directionsUrl, hoursLines, prettyPhone, type Branch } from '@/lib/site-data';
import { listCta } from '@/lib/waitlist';
import Goodbye from './Goodbye.astro';

interface Props {
  branches: Branch[];
  home?: boolean;
}
const { branches, home = false } = Astro.props;
// Newsletter: shows once the client's email tool is set (its form POST URL,
// e.g. Mailchimp/Klaviyo embed action) in PUBLIC_NEWSLETTER_ACTION.
const newsletter = import.meta.env.PUBLIC_NEWSLETTER_ACTION as string | undefined;
// Gift vouchers: only when a voucher link exists in branches.json (no link that leads elsewhere).
const vouchers = branches.find((b) => b.vouchersUrl)?.vouchersUrl;
const path = Astro.url.pathname;
const cur = (href: string) => (path === href ? 'page' : undefined);
const year = Math.min(...branches.map((b) => Number(b.page?.opened)).filter(Boolean));
const tel = (p: string) => `tel:${p.replace(/\s/g, '')}`;
---
<footer class="foot" id="footer">
  {home && <div class="wrap goodbye">
    <Goodbye branches={branches} />
    <div class="stack goodbye-text">
      <p class="kicker gold">Goodbye, for now</p>
      <p class="goodbye-h fp-h2">Thank you for travelling with us</p>
      <p class="note gold">Hakka cooking from Tangra, Calcutta's Chinatown.</p>
    </div>
  </div>}

  <!-- 1 · The rooms: what a guest needs to get there, in text (premium footers lead with the places, not buttons;
       Book stays in the phone dock). Address, today's status, phone and the three actions are always on show;
       the week's hours and the email sit behind one disclosure. -->
  <section class="wrap rooms" id="footer-menus" aria-labelledby="foot-rooms-h">
    <h2 id="foot-rooms-h" class="sr-only">Our restaurants</h2>
    <div class="rooms-grid">
      {branches.map((b) => {
        const live = b.status === 'open';
        const addr = `${b.address.street}${b.address.postcode ? `, ${b.address.postcode}` : ''}`;
        return (
          <article class="room">
            <h3 class="room-head">
              <a class="room-name" href={`/${b.id}/`} aria-current={cur(`/${b.id}/`)}>{b.shortName}</a>
            </h3>
            {live && b.hours
              ? <p class="status" data-foot-hours={JSON.stringify(b.hours)} data-tz={b.timezone}><span class="dot" aria-hidden="true"></span><span data-status>Hours below</span></p>
              : <p class="status"><span class="dot dot--soon" aria-hidden="true"></span>Opening soon</p>}
            <address>{addr}</address>
            {live && b.phone && <a class="room-tel num" href={tel(b.phone)}>{prettyPhone(b.phone)}<span class="sr-only"> (call {b.shortName})</span></a>}
            <ul class="room-acts" role="list">
              {live && b.booking
                ? <li><a class="act act--book" href={b.booking.url} data-book={b.id} rel="noopener">Book<span class="sr-only"> at {b.shortName}</span></a></li>
                : <li><a class="act act--book" href={listCta(b).href} {...listCta(b).attrs} data-focus-list>{listCta(b).short}<span class="sr-only">{listCta(b).sr}</span></a></li>}
              {live && <li><a class="act" href={`/${b.id}/menu/`} aria-current={cur(`/${b.id}/menu/`)}>Menus<span class="sr-only"> at {b.shortName}</span></a></li>}
              <li><a class="act" href={directionsUrl(b)} target="_blank" rel="noopener">Directions<span class="sr-only"> to {b.shortName} (opens in a new tab)</span></a></li>
            </ul>
            {live && b.hours && (
              <details class="hours">
                <summary>All hours<span class="sr-only"> at {b.shortName}</span></summary>
                <dl>{hoursLines(b.hours).map((l) => <><dt>{l.days}</dt><dd>{l.text}</dd></>)}</dl>
                {b.email && <a class="room-mail" href={`mailto:${b.email}`}>{b.email}</a>}
              </details>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <!-- 2 · One quiet row: the rest of the house on the left, the tiger's socials on the right. -->
  <div class="wrap house">
    <nav class="foot-index" id="site-index" aria-label="Site index">
      <ul role="list">
        <li><a href="/book/" aria-current={cur('/book/')}>Book a table</a></li>
        <li><a href="/groups/" aria-current={cur('/groups/')}>Groups and big tables</a></li>
        <li><a href="/our-story/" aria-current={cur('/our-story/')}>Our story</a></li>
        {vouchers && <li><a href={vouchers} target="_blank" rel="noopener">Gift vouchers<span class="sr-only"> (opens in a new tab)</span></a></li>}
      </ul>
    </nav>
    {newsletter && (
      <form class="news" action={newsletter} method="post" target="_blank">
        <label for="news-email">News, now and then</label>
        <div class="news-row"><input id="news-email" class="fp-input" type="email" name="EMAIL" autocomplete="email" required placeholder="you@example.com" /><button class="fp-btn fp-btn--primary fp-btn--sm" type="submit">Sign up</button></div>
      </form>
    )}
    <ul class="social" role="list" aria-label="Follow the tiger">
      <li><a href="https://www.instagram.com/fattpundit/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.2 6.8v.01" /></svg><span class="sr-only">Instagram (opens in a new tab)</span></a></li>
      <li><a href="https://www.facebook.com/fattpundit/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 21v-8h3l.5-3.5h-3.5V7.3c0-1 .4-1.8 1.9-1.8H18V2.4c-.4 0-1.6-.2-2.9-.2-2.7 0-4.6 1.7-4.6 4.7v2.6H7.5V13h3v8" /></svg><span class="sr-only">Facebook (opens in a new tab)</span></a></li>
      <li><a href="https://x.com/FattPundit" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="x" d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.6l5.24 6.93ZM17.6 20.64h2.04L6.49 3.24H4.3Z" /></svg><span class="sr-only">X (opens in a new tab)</span></a></li>
    </ul>
  </div>

  <!-- 4 · Wordmark -->
  <div class="mark" data-foot-mark>
    <a class="mark-word" href="/" aria-label="Fatt Pundit, home">FATT PUNDIT</a>
    <p class="mark-strip">{branches.map((b) => b.shortName).join(' · ')}{Number.isFinite(year) && ` · Est. ${year}`}</p>
  </div>

  <!-- 5 · Legal -->
  <div class="legal">
    <div class="wrap legal-in">
      <p>© {new Date().getFullYear()} Fatt Pundit</p>
      <div class="legal-row">
        <nav aria-label="Legal">
          <a href="/privacy/" aria-current={cur('/privacy/')}>Privacy</a>
          <a href="/booking-terms/" aria-current={cur('/booking-terms/')}>Booking terms</a>
          <a href="/allergens/" aria-current={cur('/allergens/')}>Allergens</a>
          <a href="/accessibility/" aria-current={cur('/accessibility/')}>Accessibility</a>
        </nav>
        <button type="button" class="motion-toggle" data-motion-toggle aria-pressed="false">Pause motion</button>
        <a class="totop" href="#">Back to top <span aria-hidden="true">↑</span></a>
      </div>
      <p class="fine">We make every effort to avoid cross-contamination, but cannot guarantee dishes and drinks are allergen-free. Please tell us about any dietary requirements when you book.{import.meta.env.PUBLIC_LAUNCH !== 'true' && ' Website demo: prices and photos to be confirmed.'}</p>
    </div>
  </div>
</footer>
<script>
  import { openStatus, statusLine } from '@/lib/hours';
  // Pause motion (WCAG 2.2.2): stops the rain, the loop videos and the pulsing dots. Remembered on this device.
  const html = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  const show = () => {
    const paused = html.dataset.motion === 'paused';
    if (btn) { btn.setAttribute('aria-pressed', String(paused)); btn.textContent = paused ? 'Play motion' : 'Pause motion'; }
    if (paused) for (const v of document.querySelectorAll('video')) v.pause();
  };
  btn?.addEventListener('click', () => {
    const paused = html.dataset.motion !== 'paused';
    if (paused) html.dataset.motion = 'paused'; else delete html.dataset.motion;
    try { if (paused) localStorage.setItem('fp-motion', 'paused'); else localStorage.removeItem('fp-motion'); } catch {}
    show();
    window.dispatchEvent(new Event('fp:motion'));
  });
  show();

  // Live status per room, in its own time zone ("Open until 10.30pm"). Far below the fold, so no layout shift.
  for (const el of document.querySelectorAll<HTMLElement>('[data-foot-hours]')) {
    try {
      const s = openStatus(JSON.parse(el.dataset.footHours!), el.dataset.tz!);
      el.querySelector('[data-status]')!.textContent = statusLine('', s);
      el.dataset.state = s.open ? 'open' : 'closed';
    } catch {}
  }

  // Wordmark: slides out of its slot in till steps once on screen. No JS / calm / paused: already in place (CSS).
  const mark = document.querySelector<HTMLElement>('[data-foot-mark]');
  if (mark && !matchMedia('(prefers-reduced-motion: reduce)').matches && html.dataset.motion !== 'paused') {
    mark.classList.add('is-armed');
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      mark.classList.add('is-in');
    }, { threshold: 0.4 });
    io.observe(mark);
  }
</script>
<style>
  /* A premium, minimal footer (owner brief, 25 Nov 2026): the restaurants' facts first, set in type with room to
     breathe; text links, not a stack of buttons; one row for the rest; the gold wordmark signs off. */
  .foot :global(p), .foot :global(ul), .foot :global(address), .foot :global(dl), .foot :global(h3) { margin: 0; }
  .foot :global(ul) { list-style: none; padding: 0; }
  .foot :global(a):focus-visible, .foot :global(button):focus-visible, .foot :global(summary):focus-visible { outline: 2px solid var(--color-gold); outline-offset: 3px; }
  .foot { padding-top: clamp(40px, 5vw, 72px); color: var(--color-sand); }
  .foot a { color: inherit; text-decoration: none; }
  .foot a:hover { color: var(--color-gold); text-decoration: underline; text-underline-offset: 4px; }
  .foot a[aria-current='page'] { text-decoration: underline; text-underline-offset: 5px; }

  /* Goodbye (home only) */
  .goodbye { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: clamp(32px, 6vw, 96px); padding-bottom: clamp(40px, 5vw, 72px); }
  .goodbye > * { min-width: 0; }
  .goodbye-h { max-width: 14ch; text-transform: none; color: var(--color-sand); }
  @media (max-width: 760px) { .goodbye { grid-template-columns: minmax(0, 1fr); text-align: center; } .goodbye-text { order: -1; align-items: center; } .goodbye-h { margin-inline: auto; } }

  /* 1 · The rooms */
  .rooms { padding-block: clamp(40px, 5vw, 72px); border-top: 1px solid rgb(203 160 82 / 0.3); }
  .goodbye + .rooms { border-top-color: rgb(203 160 82 / 0.3); }
  .foot > .rooms:first-child { border-top: 0; padding-top: 0; }
  .rooms-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px clamp(32px, 5vw, 80px); }
  .room { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; min-width: 0; font-size: 16px; line-height: 1.5; font-variant-numeric: tabular-nums; }
  .room-head { font: inherit; }
  .room-name { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--font-display); font-weight: 700; font-size: clamp(20px, 1.8vw, 24px); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-gold); }
  .foot .room-name { color: var(--color-gold); }
  .status { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--color-gold); margin-bottom: 6px; }
  .dot { flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--color-gold); }
  .status[data-state='closed'] .dot { background: var(--color-tiger-bright); }
  .dot--soon { background: transparent; box-shadow: inset 0 0 0 1.5px var(--color-gold); }
  address { font-style: normal; }
  .room-tel { display: inline-flex; align-items: center; min-height: 44px; letter-spacing: 0.02em; }
  .room-acts { display: flex; flex-wrap: wrap; gap: 0 22px; }
  .foot .act { display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; text-decoration: underline; text-decoration-color: rgb(218 199 181 / 0.35); text-underline-offset: 5px; }
  .foot .act--book { text-decoration-color: var(--color-tiger-bright); text-decoration-thickness: 2px; font-weight: 700; }
  .hours > summary { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; cursor: pointer; font-size: 14px; color: rgb(218 199 181 / 0.8); list-style: none; }
  .hours > summary::-webkit-details-marker { display: none; }
  .hours > summary::after { content: '+'; color: var(--color-gold); transition: rotate var(--dur-fast) var(--curve-out); }
  .hours[open] > summary::after { rotate: 45deg; }
  .hours dl { display: grid; grid-template-columns: auto 1fr; gap: 2px 16px; font-size: 14px; padding-bottom: 6px; }
  .hours dt { color: rgb(218 199 181 / 0.8); } .hours dd { margin: 0; }
  .room-mail { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; overflow-wrap: anywhere; }
  @media (max-width: 900px) and (min-width: 641px) { .rooms-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .rooms-grid { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .room { gap: 2px; padding-block: 16px; border-top: 1px solid rgb(203 160 82 / 0.2); }
    .room:first-child { border-top: 0; padding-top: 0; }
    .room-name { min-height: 40px; }
    .status { margin-bottom: 4px; }
  }

  /* 2 · The house row */
  .house { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 32px; padding-block: 12px; border-top: 1px solid rgb(203 160 82 / 0.3); }
  .foot-index ul { display: flex; flex-wrap: wrap; gap: 0 28px; }
  .foot-index a { display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; }
  .news { display: grid; gap: 6px; flex: 1 1 320px; max-width: 420px; }
  .news label { font-size: 14px; }
  .news-row { display: flex; gap: 8px; }
  .news input { flex: 1; min-width: 0; }
  .social { display: flex; gap: 4px; margin-inline-start: auto; }
  .social a { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; }
  .social svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .social svg .x { fill: currentColor; stroke: none; }
  @media (max-width: 640px) { .foot-index ul { gap: 0 18px; } .foot-index a { font-size: 14px; } .social { margin-inline-start: -10px; } }

  /* 3 · Wordmark: a ticket half out of its slot. Default (no JS, calm, paused) is the end state. */
  .mark { overflow: clip; border-top: 1px solid rgb(203 160 82 / 0.3); padding-top: clamp(20px, 3vw, 40px); }
  .mark-word { display: block; width: fit-content; margin-inline: auto; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em; font-size: clamp(2.2rem, 9vw, 6.4rem); line-height: 0.8; white-space: nowrap;
    background: linear-gradient(180deg, #f3d89a, #cba052 55%, #8a6a2e); -webkit-background-clip: text; background-clip: text; color: transparent; translate: 0 18%; }
  .foot .mark-word, .foot .mark-word:hover { color: transparent; text-decoration: none; }
  .mark-strip { position: relative; z-index: 1; padding: 12px 16px; text-align: center; font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-sand); background: var(--color-ink); }
  .mark.is-armed .mark-word { translate: 0 40%; }
  .mark.is-armed .mark-strip { opacity: 0; }
  .mark.is-armed.is-in .mark-word { translate: 0 18%; transition: translate var(--dur-story-long, 900ms) steps(10, end); }
  .mark.is-armed.is-in .mark-strip { opacity: 1; transition: opacity var(--dur-panel) var(--curve-out) var(--dur-story-long, 900ms); }
  :global(html[data-motion='paused']) .mark.is-armed .mark-word { translate: 0 18%; transition: none; }
  :global(html[data-motion='paused']) .mark.is-armed .mark-strip { opacity: 1; transition: none; }

  /* 4 · Legal */
  .legal { background: #1f1c19; color: rgb(218 199 181 / 0.75); font-size: var(--step-fine); line-height: 1.5; }
  .legal-in { display: grid; gap: 6px; padding-block: 12px 16px; }
  .legal-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0 24px; }
  .legal nav { display: flex; flex-wrap: wrap; gap: 0 24px; }
  .legal a { display: inline-flex; align-items: center; min-height: 44px; }
  .totop { margin-left: auto; }
  .motion-toggle { min-height: 44px; padding: 0 14px; border: 1px solid rgb(203 160 82 / 0.5); border-radius: 999px; background: none; color: inherit; font: inherit; font-size: var(--step-fine); cursor: pointer; }
  .motion-toggle[aria-pressed='true'] { background: rgb(203 160 82 / 0.18); color: var(--color-gold); }
  .motion-toggle:hover { color: var(--color-gold); }
  .fine { font-size: var(--step-fine); max-width: 80ch; padding-top: 4px; }
  @media (max-width: 640px) { .totop { margin-left: 0; } }
</style>
