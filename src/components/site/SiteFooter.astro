---
import { directionsUrl, hoursLines, prettyPhone, type Branch } from '@/lib/site-data';
import { listCta } from '@/lib/waitlist';
import Goodbye from './Goodbye.astro';

interface Props {
  branches: Branch[];
  home?: boolean;
}
const { branches, home = false } = Astro.props;
// Newsletter: shows once the client's email tool is set (its form POST URL,
// e.g. Mailchimp/Klaviyo embed action) in PUBLIC_NEWSLETTER_ACTION.
const newsletter = import.meta.env.PUBLIC_NEWSLETTER_ACTION as string | undefined;
// Gift vouchers: only when a voucher link exists in branches.json (no link that leads elsewhere).
const vouchers = branches.find((b) => b.vouchersUrl)?.vouchersUrl;
const path = Astro.url.pathname;
const cur = (href: string) => (path === href ? 'page' : undefined);
const open = branches.filter((b) => b.status === 'open');
const soon = branches.find((b) => b.status !== 'open');
const year = Math.min(...branches.map((b) => Number(b.page?.opened)).filter(Boolean));
const tel = (p: string) => `tel:${p.replace(/\s/g, '')}`;
---
<footer class="foot" id="footer">
  {home && <div class="wrap goodbye">
    <Goodbye branches={branches} />
    <div class="stack goodbye-text">
      <p class="kicker gold">Goodbye, for now</p>
      <p class="goodbye-h fp-h2">Thank you for travelling with us</p>
      <p class="note gold">Hakka cooking from Tangra, Calcutta's Chinatown.</p>
    </div>
  </div>}

  <!-- 1 · Rooms -->
  <section class="wrap rooms" id="footer-menus" aria-labelledby="foot-rooms-h">
    <h2 id="foot-rooms-h" class="sr-only">Our rooms</h2>
    <div class="rooms-grid">
      <p class="lead note">Hakka cooking from Calcutta's Chinatown, since 2019.</p>
      {branches.map((b) => {
        const live = b.status === 'open';
        const call = b.phone ? tel(b.phone) : undefined;
        const addr = `${b.address.street}${b.address.postcode ? `, ${b.address.postcode}` : ''}`;
        const cta = live && b.booking
          ? <a class="fp-btn fp-btn--primary fp-btn--sm" href={b.booking.url} data-book={b.id} rel="noopener">Book {b.shortName}</a>
          : <a class="fp-btn fp-btn--primary fp-btn--sm" href={listCta(b).href} data-focus-list>{listCta(b).short}</a>;
        return (
          <article class="room">
            <a class="fp-h3 room-name" href={`/${b.id}/`} aria-current={cur(`/${b.id}/`)}>{b.shortName}</a>
            {live && b.hours
              ? <p class="status" data-foot-hours={JSON.stringify(b.hours)} data-tz={b.timezone}><span class="dot" aria-hidden="true"></span><span data-status>Hours below</span></p>
              : <p class="status"><span class="dot dot--soon" aria-hidden="true"></span>Opening soon</p>}

            <div class="room-desk">
              <address>{addr}</address>
              <a class="room-link" href={directionsUrl(b)} target="_blank" rel="noopener">Directions<span aria-hidden="true"> ↗</span><span class="sr-only"> to {b.shortName} (opens in a new tab)</span></a>
              {b.phone && <a class="room-link num" href={call}>{prettyPhone(b.phone)}</a>}
              {b.email && <a class="room-link num mail" href={`mailto:${b.email}`}>{b.email}</a>}
              {live && b.hours && (
                <details class="hours">
                  <summary>All hours</summary>
                  <dl>{hoursLines(b.hours).map((l) => <><dt>{l.days}</dt><dd>{l.text}</dd></>)}</dl>
                </details>
              )}
              {live && <a class="room-link" href={`/${b.id}/menu/`} aria-current={cur(`/${b.id}/menu/`)}>{b.shortName} menus</a>}
              {cta}
            </div>

            <div class="room-phone">
              <div class="room-btns">
                {live && call && <a class="fp-btn fp-btn--sm" href={call}>Call<span class="sr-only"> {b.shortName}</span></a>}
                {cta}
              </div>
              <details class="hours">
                <summary>Address and hours</summary>
                <address>{addr}</address>
                <a class="room-link" href={directionsUrl(b)} target="_blank" rel="noopener">Directions<span aria-hidden="true"> ↗</span><span class="sr-only"> to {b.shortName} (opens in a new tab)</span></a>
                {live && b.hours && <dl>{hoursLines(b.hours).map((l) => <><dt>{l.days}</dt><dd>{l.text}</dd></>)}</dl>}
                {b.email && <a class="room-link num mail" href={`mailto:${b.email}`}>{b.email}</a>}
                {live && <a class="room-link" href={`/${b.id}/menu/`}>{b.shortName} menus</a>}
              </details>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- 2 · Keep in touch -->
  <section class="wrap touch" aria-labelledby="foot-touch-h">
    <h2 id="foot-touch-h" class="sr-only">Keep in touch</h2>
    <div class="touch-l">
      <p class="note">News, new dishes and Dubai's opening, now and then.</p>
      {newsletter
        ? <form class="news" action={newsletter} method="post" target="_blank">
            <label for="news-email">Email address</label>
            <div class="news-row"><input id="news-email" class="fp-input" type="email" name="EMAIL" autocomplete="email" required placeholder="you@example.com" /><button class="fp-btn fp-btn--primary fp-btn--sm" type="submit">Sign up</button></div>
          </form>
        : soon && <a class="fp-btn fp-btn--sm" href={listCta(soon).href} data-focus-list>{listCta(soon).label}</a>}
    </div>
    <div class="touch-r">
      <p class="small-caps">Follow the tiger</p>
      <ul class="social">
        <li><a href="https://www.instagram.com/fattpundit/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.2 6.8v.01" /></svg>Instagram<span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></a></li>
        <li><a href="https://www.facebook.com/fattpundit/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 21v-8h3l.5-3.5h-3.5V7.3c0-1 .4-1.8 1.9-1.8H18V2.4c-.4 0-1.6-.2-2.9-.2-2.7 0-4.6 1.7-4.6 4.7v2.6H7.5V13h3v8" /></svg>Facebook<span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></a></li>
        <li><a href="https://x.com/FattPundit" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="x" d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.6l5.24 6.93ZM17.6 20.64h2.04L6.49 3.24H4.3Z" /></svg>X<span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></a></li>
      </ul>
    </div>
  </section>

  <!-- 3 · Index -->
  <nav class="wrap foot-index" id="site-index" aria-label="Site index">
    <div>
      <p class="small-caps">Visit</p>
      <ul>
        {branches.map((b) => <li><a href={`/${b.id}/`} aria-current={cur(`/${b.id}/`)}>{b.shortName}</a></li>)}
        <li><a href="/book/" aria-current={cur('/book/')}>Book a table</a></li>
      </ul>
    </div>
    <div>
      <p class="small-caps">Eat</p>
      <ul>
        {open.map((b) => <li><a href={`/${b.id}/menu/`} aria-current={cur(`/${b.id}/menu/`)}>{b.shortName} menus</a></li>)}
        <li><a href="/allergens/" aria-current={cur('/allergens/')}>Allergens</a></li>
        <li><a href="/private-dining/" aria-current={cur('/private-dining/')}>Groups and private dining</a></li>
        {vouchers && <li><a href={vouchers} target="_blank" rel="noopener">Gift vouchers<span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></a></li>}
      </ul>
    </div>
    <div>
      <p class="small-caps">House</p>
      <ul>
        <li><a href="/our-story/" aria-current={cur('/our-story/')}>Our story</a></li>
        <li><a href="/accessibility/" aria-current={cur('/accessibility/')}>Accessibility</a></li>
      </ul>
    </div>
  </nav>

  <!-- 4 · Wordmark -->
  <div class="mark" data-foot-mark>
    <a class="mark-word" href="/" aria-label="Fatt Pundit, home">FATT PUNDIT</a>
    <p class="mark-strip small-caps">{branches.map((b) => b.shortName).join(' · ')}{Number.isFinite(year) && ` · Est. ${year}`}</p>
  </div>

  <!-- 5 · Legal -->
  <div class="legal">
    <div class="wrap legal-in">
      <p>© {new Date().getFullYear()} Fatt Pundit</p>
      <div class="legal-row">
        <nav aria-label="Legal">
          <a href="/privacy/" aria-current={cur('/privacy/')}>Privacy</a>
          <a href="/booking-terms/" aria-current={cur('/booking-terms/')}>Booking terms</a>
          <a href="/allergens/" aria-current={cur('/allergens/')}>Allergens</a>
          <a href="/accessibility/" aria-current={cur('/accessibility/')}>Accessibility</a>
        </nav>
        <button type="button" class="motion-toggle" data-motion-toggle aria-pressed="false">Pause motion</button>
        <a class="totop" href="#">Back to top <span aria-hidden="true">↑</span></a>
      </div>
      <p class="fine">We make every effort to avoid cross-contamination, but cannot guarantee dishes and drinks are allergen-free. Please tell us about any dietary requirements when you book.{import.meta.env.PUBLIC_LAUNCH !== 'true' && ' Website demo: prices and photos to be confirmed.'}</p>
    </div>
  </div>
</footer>
<script>
  import { openStatus, statusLine } from '@/lib/hours';
  // Pause motion (WCAG 2.2.2): stops the rain, the loop videos and the pulsing dots. Remembered on this device.
  const html = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  const show = () => {
    const paused = html.dataset.motion === 'paused';
    if (btn) { btn.setAttribute('aria-pressed', String(paused)); btn.textContent = paused ? 'Play motion' : 'Pause motion'; }
    if (paused) for (const v of document.querySelectorAll('video')) v.pause();
  };
  btn?.addEventListener('click', () => {
    const paused = html.dataset.motion !== 'paused';
    if (paused) html.dataset.motion = 'paused'; else delete html.dataset.motion;
    try { if (paused) localStorage.setItem('fp-motion', 'paused'); else localStorage.removeItem('fp-motion'); } catch {}
    show();
    window.dispatchEvent(new Event('fp:motion'));
  });
  show();

  // Live status per room, in its own time zone ("Open until 10.30pm"). Far below the fold, so no layout shift.
  for (const el of document.querySelectorAll<HTMLElement>('[data-foot-hours]')) {
    try {
      const s = openStatus(JSON.parse(el.dataset.footHours!), el.dataset.tz!);
      el.querySelector('[data-status]')!.textContent = statusLine('', s);
      el.dataset.state = s.open ? 'open' : 'closed';
    } catch {}
  }

  // Wordmark: slides out of its slot in till steps once on screen. No JS / calm / paused: already in place (CSS).
  const mark = document.querySelector<HTMLElement>('[data-foot-mark]');
  if (mark && !matchMedia('(prefers-reduced-motion: reduce)').matches && html.dataset.motion !== 'paused') {
    mark.classList.add('is-armed');
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      mark.classList.add('is-in');
    }, { threshold: 0.4 });
    io.observe(mark);
  }
</script>
<style>
  .foot :global(p), .foot :global(ul), .foot :global(address), .foot :global(dl) { margin: 0; }
  .foot :global(ul) { list-style: none; padding: 0; }
  .foot :global(a):focus-visible, .foot :global(button):focus-visible, .foot :global(summary):focus-visible { outline: 2px solid var(--color-gold); outline-offset: 3px; }
  .small-caps { font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-gold); }
  .wrap + .wrap, .rooms, .touch, .foot-index { padding-block: clamp(32px, 4vw, 56px); }
  .foot > .wrap { border-top: 1px solid rgb(203 160 82 / 0.35); }
  .foot > .wrap:first-child { border-top: 0; }
  .foot { padding-top: clamp(32px, 4vw, 56px); }

  /* Goodbye (home only) */
  .goodbye { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: clamp(32px, 6vw, 96px); padding-top: 0 !important; }
  .goodbye > * { min-width: 0; }
  .goodbye-h { max-width: 14ch; text-transform: none; color: var(--color-sand); }
  @media (max-width: 760px) { .goodbye { grid-template-columns: minmax(0, 1fr); text-align: center; } .goodbye-text { order: -1; align-items: center; } .goodbye-h { margin-inline: auto; } }

  /* 1 · Rooms */
  .rooms-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 32px 24px; }
  .rooms-grid > * { grid-column: span 3; min-width: 0; }
  .lead { font-family: var(--font-note); font-style: italic; font-size: 20px; line-height: 1.4; color: var(--color-sand); max-width: 22ch; }
  .room { display: flex; flex-direction: column; gap: 6px; font-size: 16px; line-height: 1.5; font-variant-numeric: tabular-nums; }
  .room-name { width: fit-content; color: var(--color-gold); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .room-name:hover, .room-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .room a[aria-current='page'] { text-decoration: underline; text-underline-offset: 5px; }
  .status { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--color-gold); }
  .dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--color-gold); }
  .status[data-state='closed'] .dot { background: var(--color-tiger-bright); }
  .dot--soon { background: transparent; box-shadow: inset 0 0 0 1.5px var(--color-gold); }
  .room-desk { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
  .room-desk > .fp-btn { margin-top: 10px; }
  address { font-style: normal; color: var(--color-sand); }
  .room-link { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-sand); text-decoration: none; }
  .mail { overflow-wrap: anywhere; }
  .hours > summary { display: flex; align-items: center; min-height: 44px; cursor: pointer; color: var(--color-sand); }
  .hours dl { display: grid; grid-template-columns: auto 1fr; gap: 2px 14px; padding-bottom: 8px; }
  .hours dt { font-weight: 700; } .hours dd { margin: 0; }
  .room-phone { display: none; }
  @media (max-width: 900px) { .rooms-grid > * { grid-column: span 6; } }
  @media (max-width: 640px) {
    .rooms-grid { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .rooms-grid > * { grid-column: auto; }
    .lead { max-width: none; padding-bottom: 24px; }
    .room { padding-block: 20px; border-top: 1px solid rgb(203 160 82 / 0.25); }
    .room-desk { display: none; }
    .room-phone { display: block; }
    .room-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-block: 8px; }
    .room-btns > :only-child { grid-column: 1 / -1; }
    .room-btns > .fp-btn { white-space: normal; text-align: center; }
    .room-phone .hours > :not(summary) { display: flex; }
    .room-phone .hours address, .room-phone .hours dl { display: block; }
    .room-phone .hours dl { display: grid; }
    .room-phone .hours { display: block; }
  }
  @media (max-width: 400px) { .room-btns { grid-template-columns: minmax(0, 1fr); } }

  /* 2 · Keep in touch */
  .touch { display: grid; grid-template-columns: 1fr 1fr; gap: 32px clamp(32px, 6vw, 96px); align-items: start; }
  .touch .note { font-family: var(--font-note); font-style: italic; font-size: 20px; line-height: 1.4; margin-bottom: 16px; max-width: 32ch; }
  .news { display: grid; gap: 6px; max-width: 460px; }
  .news label { font-size: 14px; }
  .news-row { display: flex; gap: 8px; }
  .news input { flex: 1; min-width: 0; }
  .touch-r .small-caps { margin-bottom: 4px; }
  .social { display: flex; flex-wrap: wrap; gap: 0 20px; }
  .social a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--color-sand); text-decoration: none; transition: color var(--dur-fast) var(--curve-out); }
  .social a:hover { color: var(--color-gold); text-decoration: underline; text-underline-offset: 4px; }
  .social svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .social svg .x { fill: currentColor; stroke: none; }
  @media (max-width: 760px) { .touch { grid-template-columns: minmax(0, 1fr); } }

  /* 3 · Index */
  .foot-index { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px 32px; font-size: 16px; }
  .foot-index .small-caps { margin-bottom: 4px; }
  .foot-index a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-sand); text-decoration: none; }
  .foot-index a:hover { color: var(--color-gold); text-decoration: underline; text-underline-offset: 4px; }
  .foot-index a[aria-current='page'] { text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 640px) { .foot-index { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* 4 · Wordmark: a ticket half out of its slot. Default (no JS, calm, paused) is the end state. */
  .mark { overflow: clip; border-bottom: 1px solid rgb(203 160 82 / 0.35); padding-top: clamp(16px, 3vw, 40px); }
  .mark-word { display: block; width: fit-content; margin-inline: auto; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em; font-size: clamp(2.4rem, 12.4vw, 9.6rem); line-height: 0.8; white-space: nowrap; text-decoration: none;
    background: linear-gradient(180deg, #f3d89a, #cba052 55%, #8a6a2e); -webkit-background-clip: text; background-clip: text; color: transparent; translate: 0 18%; }
  .mark-strip { position: relative; z-index: 1; padding: 14px 16px; text-align: center; color: var(--color-sand); background: var(--color-ink); }
  .mark.is-armed .mark-word { translate: 0 40%; }
  .mark.is-armed .mark-strip { opacity: 0; }
  .mark.is-armed.is-in .mark-word { translate: 0 18%; transition: translate var(--dur-story-long, 900ms) steps(10, end); }
  .mark.is-armed.is-in .mark-strip { opacity: 1; transition: opacity var(--dur-panel) var(--curve-out) var(--dur-story-long, 900ms); }
  :global(html[data-motion='paused']) .mark .mark-word, :global(html[data-motion='paused']) .mark .mark-strip { translate: 0 18%; transition: none; }
  :global(html[data-motion='paused']) .mark .mark-strip { translate: none; opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .mark .mark-word { translate: 0 18% !important; transition: none !important; } .mark .mark-strip { opacity: 1 !important; transition: none !important; } }

  /* 5 · Legal */
  .legal { background: #1f1c19; color: rgb(218 199 181 / 0.75); font-size: var(--step-fine); line-height: 1.5; }
  .legal-in { display: grid; gap: 14px; padding-block: 20px; }
  .legal-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0 24px; }
  .legal nav { display: flex; flex-wrap: wrap; gap: 0 24px; }
  .legal a { display: inline-flex; align-items: center; min-height: 44px; color: inherit; text-decoration: none; }
  .legal a:hover { color: var(--color-gold); text-decoration: underline; text-underline-offset: 4px; }
  .legal a[aria-current='page'] { text-decoration: underline; text-underline-offset: 5px; }
  .totop { margin-left: auto; }
  .motion-toggle { min-height: 44px; padding: 0 14px; border: 1px solid rgb(203 160 82 / 0.5); border-radius: 999px; background: none; color: inherit; font: inherit; font-size: var(--step-fine); cursor: pointer; }
  .motion-toggle[aria-pressed='true'] { background: rgb(203 160 82 / 0.18); color: var(--color-gold); }
  .motion-toggle:hover { color: var(--color-gold); }
  .fine { font-size: var(--step-fine); max-width: 80ch; padding-top: 4px; }
  @media (max-width: 640px) { .totop { margin-left: 0; } }
</style>
