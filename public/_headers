# Cloudflare Pages / Netlify headers.
# Fingerprinted build files never change: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN
  # Content Security Policy, report-only for now: the browser logs anything that would be blocked
  # but blocks nothing. Watch the console on the live host, then rename the header to
  # Content-Security-Policy to enforce it. Inline scripts are allowed because the pages carry small
  # inline scripts and JSON-LD; plausible.io is the analytics host (off until its domain is set).
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self'; connect-src 'self' https://plausible.io; form-action 'self' https:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'
